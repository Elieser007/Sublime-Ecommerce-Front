# Public API base URL — the backend (Sublime-Ecommerce-Back) this storefront
# talks to. Unset → falls back to http://localhost:8787 (dev only).
#
# Required for production builds: `astro build` fetches all catalog data
# (products, promotions, variant graphs) at build time, so it must reach a
# running backend. Point it at a deployed backend, e.g.
#   PUBLIC_API_URL=https://api.sublimepy.store
PUBLIC_API_URL=http://localhost:8787
