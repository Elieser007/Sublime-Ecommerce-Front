---
/**
 * BaseLayout — Sublime E-commerce
 * 
 * Main layout wrapping all pages.
 * Includes: global CSS, Header, Footer, CMYK bar.
 */

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  cartCount?: number;
}

const {
  title = 'Sublime E-commerce',
  description = 'Arte & Diseño — Tu tienda de confianza',
  cartCount = 0,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#000000" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Sublime" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <Header cartCount={cartCount} />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function() {
        var saved = localStorage.getItem('theme');
        var isDark = saved === 'dark' || (saved !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        var path = location.pathname;
        var c;
        if (path === '/login')              c = isDark ? '#450a0a' : '#dc2626';
        else if (path.startsWith('/admin')) c = isDark ? '#101828' : '#ffffff';
        else                                c = isDark ? '#7f1d1d' : '#dc2626';
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', c);
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
  </body>
</html>

<script>
  import '../components/product-card.js';
  import '../components/number-input.js';
  import '../components/variant-modal.js';
  import '../components/variant-selector.js';
</script>

<style is:global>
  /* Global styles already imported via CSS file */
  main {
    min-height: 100vh;
  }
</style>
