---
/**
 * ImageUploader component — Chromatic High-Contrast
 * 
 * File input with drag-and-drop + canvas preview.
 * Uses processImage from src/lib/image.ts (Tarea 2):
 * - Validates file type (PNG, JPG, WebP)
 * - Resizes to max 1000x1000 maintaining aspect ratio
 * - Converts to WebP at 80% quality
 * - Returns Blob ready for fetch()
 */

interface Props {
  currentImage?: string;
}

const { currentImage } = Astro.props;
---

<div class="image-uploader">
  <label class="upload-label label-sm">Imagen del producto</label>

  <div class="upload-area" id="upload-area">
    {currentImage ? (
      <img src={currentImage} alt="Preview" class="upload-preview" id="upload-preview" />
    ) : (
      <div class="upload-placeholder" id="upload-placeholder">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
        <p class="body-md">Arrastra una imagen o haz clic para seleccionar</p>
        <p class="label-sm">PNG, JPG o WebP (máx. 5MB)</p>
      </div>
    )}

    <input
      type="file"
      name="image"
      id="image-input"
      accept="image/png,image/jpeg,image/webp"
      class="upload-input"
    />
  </div>

  <!-- Processing status indicator -->
  <div class="upload-status" id="upload-status" style="display: none;">
    <div class="cmyk-bar"><span></span><span></span><span></span></div>
    <p class="label-sm">Procesando imagen...</p>
  </div>

  <!-- Processed file info -->
  <div class="upload-info" id="upload-info" style="display: none;">
    <p class="label-sm" id="upload-info-text"></p>
  </div>
</div>

<style>
  .image-uploader {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .upload-label {
    color: var(--on-surface-variant);
  }

  .upload-area {
    position: relative;
    border: var(--border-hard) dashed var(--outline-variant);
    padding: var(--space-2xl);
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s ease;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .upload-area:hover {
    border-color: var(--primary);
  }

  .upload-area.dragover {
    border-color: var(--secondary);
    background-color: var(--surface-container);
  }

  .upload-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .upload-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    color: var(--outline);
  }

  .upload-preview {
    max-width: 100%;
    max-height: 300px;
    object-fit: contain;
  }

  .upload-status {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .upload-status p {
    color: var(--on-surface-variant);
  }

  .upload-info {
    padding: var(--space-sm);
    background-color: var(--surface-container);
    border: var(--border-width) solid var(--outline-variant);
  }

  .upload-info p {
    color: var(--primary);
  }
</style>

<script>
  // ImageUploader — Tarea 2 integration
  // Uses processImage() from /src/lib/image.ts for canvas-based processing

  const area = document.getElementById('upload-area');
  const input = document.getElementById('image-input') as HTMLInputElement;
  const preview = document.getElementById('upload-preview') as HTMLImageElement;
  const placeholder = document.getElementById('upload-placeholder');
  const status = document.getElementById('upload-status');
  const info = document.getElementById('upload-info');
  const infoText = document.getElementById('upload-info-text');

  if (area && input) {
    // Click to open file picker
    area.addEventListener('click', () => input.click());

    // Drag events
    area.addEventListener('dragover', (e) => {
      e.preventDefault();
      area.classList.add('dragover');
    });

    area.addEventListener('dragleave', () => {
      area.classList.remove('dragover');
    });

    area.addEventListener('drop', (e) => {
      e.preventDefault();
      area.classList.remove('dragover');
      const file = e.dataTransfer?.files[0];
      if (file) handleFile(file);
    });

    // File input change
    input.addEventListener('change', () => {
      const file = input.files?.[0];
      if (file) handleFile(file);
    });
  }

  async function handleFile(file: File) {
    try {
      // Show processing status
      if (status) status.style.display = 'flex';
      if (info) info.style.display = 'none';

      // Dynamically import processImage (client-side only, uses <canvas>)
      const { processImage, formatFileSize } = await import('/src/lib/image.ts');

      // Process image: validate, resize to 1000x1000, convert to WebP 80%
      const processedBlob = await processImage(file);

      // Show preview of processed image
      const processedUrl = URL.createObjectURL(processedBlob);
      if (placeholder) placeholder.style.display = 'none';
      if (preview) {
        preview.src = processedUrl;
        preview.style.display = 'block';
      }

      // Show file info
      if (info && infoText) {
        const savings = ((1 - processedBlob.size / file.size) * 100).toFixed(0);
        infoText.textContent = `WebP procesado: ${formatFileSize(processedBlob.size)} (${savings}% menor que original)`;
        info.style.display = 'block';
      }

      // Store processed blob globally for form submission
      // AdminProductForm reads (window).__processedImage when creating/updating product
      (window as any).__processedImage = processedBlob;
      (window as any).__processedImageName = file.name.replace(/\.[^.]+$/, '.webp');

    } catch (err: any) {
      alert(err.message || 'Error al procesar la imagen');
    } finally {
      if (status) status.style.display = 'none';
    }
  }
</script>
