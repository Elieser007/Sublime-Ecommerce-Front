---
/**
 * Footer component — Sublime E-commerce
 * 
 * Minimal footer with CMYK accent bar and brand info.
 */

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="cmyk-bar">
    <span></span><span></span><span></span>
  </div>

  <div class="footer-inner">
    <div class="footer-brand">
      <span class="footer-logo">SUBLIME</span>
      <p class="footer-tagline body-md">Arte & Diseño</p>
    </div>

    <div class="footer-links">
      <div class="footer-col">
        <h4 class="label-sm">Navegación</h4>
        <a href="/">Home</a>
        <a href="/">Shop</a>
        <a href="/cart">Cart</a>
      </div>

      <div class="footer-col">
        <h4 class="label-sm">Contacto</h4>
        <a href="https://wa.me/595000000000" target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </div>

    <div class="footer-copy label-sm">
      © {year} Sublime. Todos los derechos reservados.
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section-gap);
    background-color: var(--surface);
  }

  .footer-inner {
    padding: var(--space-3xl) var(--margin-mobile) var(--space-xl);
  }

  @media (min-width: 768px) {
    .footer-inner {
      padding: var(--space-3xl) var(--margin-desktop) var(--space-xl);
    }
  }

  .footer-brand {
    margin-bottom: var(--space-2xl);
  }

  .footer-logo {
    font-family: var(--font-display);
    font-size: 32px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--on-surface);
  }

  .footer-tagline {
    color: var(--on-surface-variant);
    margin-top: var(--space-sm);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .footer-links {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-col h4 {
    color: var(--primary);
    margin-bottom: var(--space-sm);
  }

  .footer-col a {
    color: var(--on-surface-variant);
    font-size: 14px;
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--on-surface);
  }

  .footer-copy {
    color: var(--outline);
    padding-top: var(--space-lg);
    border-top: var(--border-width) solid var(--outline-variant);
  }
</style>
