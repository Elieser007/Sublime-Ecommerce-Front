---
/**
 * SplitPromo — Image + text side by side
 * 
 * Shows promotions with image on one side and text on the other,
 * alternating direction for each item.
 */
interface Promotion {
  id: string;
  title?: string;
  description?: string;
  imageUrl: string;
  link: string;
}

interface Props {
  promotions: Promotion[];
}

const { promotions } = Astro.props;
---

<div class="split-promo">
  {promotions.map((promo, i) => (
    <a href={promo.link} class:list={['split-item', { 'split-item--reverse': i % 2 === 1 }]}>
      <div class="split-img">
        <img src={promo.imageUrl} alt={promo.title || ''} />
      </div>
      <div class="split-text">
        {promo.title && <h3 class="split-title">{promo.title}</h3>}
        {promo.description && <p class="split-desc">{promo.description}</p>}
        <span class="split-link">Ver más →</span>
      </div>
    </a>
  ))}
</div>

<style>
  .split-promo {
    display: flex;
    flex-direction: column;
  }

  .split-item {
    display: flex;
    flex-direction: row;
    text-decoration: none;
    color: inherit;
    border: var(--border-width) solid var(--outline-variant);
    border-bottom: none;
    transition: background 0.2s ease;
  }
  .split-item:last-child { border-bottom: var(--border-width) solid var(--outline-variant); }
  .split-item:hover { background: var(--surface-container-high); text-decoration: none; }
  .split-item--reverse { flex-direction: row-reverse; }

  .split-img {
    flex: 1;
    min-height: 200px;
    overflow: hidden;
  }
  .split-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .split-item:hover .split-img img { transform: scale(1.05); }

  .split-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-xl) var(--space-2xl);
    gap: var(--space-md);
  }

  .split-title {
    font-family: var(--font-display);
    font-size: clamp(20px, 3vw, 32px);
    text-transform: uppercase;
    line-height: 1.1;
    color: var(--on-surface);
  }

  .split-desc {
    font-size: 15px;
    color: var(--on-surface-variant);
    line-height: 1.5;
  }

  .split-link {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--primary);
  }

  @media (max-width: 767px) {
    .split-item,
    .split-item--reverse { flex-direction: column; }
    .split-text { padding: var(--space-lg); }
  }
</style>
