---
/**
 * TilesPromo — CSS Grid with variable tile sizes
 * 
 * Each promotion specifies tileCols and tileRows for grid placement.
 */
interface Promotion {
  id: string;
  title?: string;
  description?: string;
  imageUrl: string;
  link: string;
  tileCols: number;
  tileRows: number;
  position: number;
}

interface Props {
  promotions: Promotion[];
}

const { promotions } = Astro.props;
const gridCols = 4;
---

<div class="tiles-promo" style={`grid-template-columns: repeat(${gridCols}, 1fr); grid-auto-rows: 160px;`}>
  {promotions.map((promo) => {
    const col = (promo.position % gridCols) + 1;
    const row = Math.floor(promo.position / gridCols) + 1;
    return (
      <div class="tile" style={`grid-column: ${col} / span ${promo.tileCols}; grid-row: ${row} / span ${promo.tileRows};`}>
        <div class="tile-bg" style={`background-image: url('${promo.imageUrl}');`}></div>
        <div class="tile-overlay"></div>
        <div class="tile-content">
          {promo.title && <h3 class="tile-title">{promo.title}</h3>}
          {promo.description && <p class="tile-desc">{promo.description}</p>}
        </div>
        <a href={promo.link} class="tile-link" aria-label={promo.title || 'Promoción'}></a>
      </div>
    );
  })}
</div>

<style>
  .tiles-promo {
    display: grid;
    gap: var(--space-md);
    grid-auto-flow: dense;
  }

  .tile {
    position: relative;
    overflow: hidden;
    border: var(--border-width) solid var(--outline-variant);
    min-height: 120px;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .tile:hover {
    border-color: var(--primary);
    box-shadow: 0 0 20px rgba(130, 207, 255, 0.12);
  }
  .tile:hover .tile-bg { transform: scale(1.06); }

  .tile-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-color: var(--surface-container);
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .tile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.3) 50%, transparent 100%);
  }

  .tile-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-lg);
    z-index: 2;
    color: white;
  }

  .tile-title {
    font-family: var(--font-display);
    font-size: clamp(16px, 2vw, 24px);
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: var(--space-xs);
    text-shadow: 0 2px 8px rgba(0,0,0,0.5);
  }

  .tile-desc {
    font-size: clamp(12px, 1vw, 14px);
    opacity: 0.9;
    text-shadow: 0 1px 4px rgba(0,0,0,0.4);
  }

  .tile-link {
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  @media (max-width: 767px) {
    .tiles-promo {
      grid-template-columns: repeat(2, 1fr) !important;
      grid-auto-rows: 120px !important;
    }
    .tile-content { padding: var(--space-md); }
  }
</style>
