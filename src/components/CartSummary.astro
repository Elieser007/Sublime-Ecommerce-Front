---
/**
 * CartSummary component — Premium sidebar design
 * 
 * Order summary with item count, total and WhatsApp checkout button.
 * Reads from LocalStorage and generates wa.me link.
 */

---

<div class="cart-summary" id="cart-summary">
  <h3 class="summary-title">Resumen del Pedido</h3>
  <p class="summary-count" id="summary-count">0 productos en tu carrito</p>

  <div class="summary-rows">
    <div class="summary-row">
      <span class="body-md">Subtotal</span>
      <span class="body-md" id="summary-subtotal">Gs. 0</span>
    </div>
    <div class="summary-row">
      <span class="body-md">Envío</span>
      <span class="body-md summary-shipping">A convenir</span>
    </div>
    <div class="summary-divider"></div>
    <div class="summary-row summary-total">
      <span class="summary-total-label">Total</span>
      <span class="summary-total-value" id="summary-total">Gs. 0</span>
    </div>
  </div>

  <a
    href="#"
    class="checkout-btn"
    id="checkout-whatsapp"
    target="_blank"
    rel="noopener"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
    Finalizar por WhatsApp
  </a>

  <div class="summary-footer">
    <a href="/" class="continue-link">← Seguir comprando</a>
  </div>
</div>

<script>
  import { generateWhatsAppUrl, formatGuaranies, calculateCartTotals } from '../lib/whatsapp.ts';
  import { getCart } from '../lib/cart.js';

  const WHATSAPP_PHONE = '595991969608';

  function updateSummary() {
    const cart = getCart();
    const { subtotal, itemCount } = calculateCartTotals(cart);

    const countEl = document.getElementById('summary-count');
    const subtotalEl = document.getElementById('summary-subtotal');
    const totalEl = document.getElementById('summary-total');
    const checkoutBtn = document.getElementById('checkout-whatsapp');

    if (countEl) {
      countEl.textContent = itemCount === 1
        ? '1 producto en tu carrito'
        : `${itemCount} productos en tu carrito`;
    }
    if (subtotalEl) subtotalEl.textContent = `Gs. ${formatGuaranies(subtotal)}`;
    if (totalEl) totalEl.textContent = `Gs. ${formatGuaranies(subtotal)}`;
    if (checkoutBtn) {
      checkoutBtn.setAttribute('href', generateWhatsAppUrl(cart, WHATSAPP_PHONE));
    }
  }

  // Bind once per document lifetime: the module re-executes on every
  // ClientRouter navigation and a bare registration would stack listeners.
  if (!window.__cartSummaryStorageBound) {
    window.__cartSummaryStorageBound = true;
    window.addEventListener('cart-updated', updateSummary);
  }

  function initCartSummary() {
    updateSummary();
  }

  if (window.__cartSummaryInit) {
    document.removeEventListener('astro:page-load', window.__cartSummaryInit);
  }
  window.__cartSummaryInit = initCartSummary;
  document.addEventListener('astro:page-load', window.__cartSummaryInit);
</script>
