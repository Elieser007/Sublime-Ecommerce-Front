---
/**
 * QuantityControl component — Chromatic High-Contrast
 * 
 * +/- buttons with input field for quantity.
 * Bottom-border input style, sharp corners.
 */

interface Props {
  productId: string;
  quantity?: number;
  min?: number;
  max?: number;
}

const { productId, quantity = 1, min = 1, max = 99 } = Astro.props;
---

<div class="quantity-control">
  <button
    class="qty-btn"
    data-action="decrease"
    data-product-id={productId}
    aria-label="Disminuir cantidad"
  >−</button>
  <input
    type="number"
    class="qty-input"
    value={quantity}
    min={min}
    max={max}
    data-product-id={productId}
    aria-label="Cantidad"
    readonly
  />
  <button
    class="qty-btn"
    data-action="increase"
    data-product-id={productId}
    aria-label="Aumentar cantidad"
  >+</button>
</div>

<style>
  .quantity-control {
    display: inline-flex;
    align-items: center;
    border: var(--border-width) solid var(--outline-variant);
  }

  .qty-btn {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 18px;
    color: var(--on-surface);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .qty-btn:hover {
    background-color: var(--surface-container-high);
    color: var(--primary);
  }

  .qty-input {
    width: 48px;
    height: 40px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--on-surface);
    background: transparent;
    border: none;
    border-left: var(--border-width) solid var(--outline-variant);
    border-right: var(--border-width) solid var(--outline-variant);
    outline: none;
    -moz-appearance: textfield;
  }

  .qty-input::-webkit-outer-spin-button,
  .qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
</style>

<script>
  // Client-side quantity control
  document.querySelectorAll('[data-action]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      const action = el.dataset.action;
      const productId = el.dataset.productId;
      const input = document.querySelector(`.qty-input[data-product-id="${productId}"]`) as HTMLInputElement;

      if (!input) return;

      let value = parseInt(input.value) || 1;
      if (action === 'increase') value = Math.min(value + 1, 99);
      if (action === 'decrease') value = Math.max(value - 1, 1);

      input.value = value.toString();

      // Update LocalStorage
      const cart = JSON.parse(localStorage.getItem('cart') || '[]');
      const item = cart.find((i: any) => i.id === productId);
      if (item) {
        item.quantity = value;
        localStorage.setItem('cart', JSON.stringify(cart));
      }

      // Dispatch event for CartSummary to recalculate
      window.dispatchEvent(new CustomEvent('cart-updated'));
    });
  });
</script>
