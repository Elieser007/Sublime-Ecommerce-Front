---
/**
 * DataTable — Reusable Table Component
 * 
 * Matching Chromatic High-Contrast admin panel design.
 * Semi-transparent backgrounds, backdrop-blur, subtle borders.
 */

interface Column {
  key: string;
  label: string;
  width?: string;
}

interface Props {
  columns: Column[];
  emptyMessage?: string;
}

const { columns, emptyMessage = 'No hay datos' } = Astro.props;
---

<div class="dt-container">
  <table class="dt-table">
    <thead>
      <tr>
        {columns.map((col) => (
          <th class="label-sm" style={col.width ? `width: ${col.width}` : ''}>
            {col.label}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      <slot />
    </tbody>
  </table>
  <slot name="empty" />
</div>

<style>
  .dt-container {
    background-color: var(--surface-container);
    backdrop-filter: blur(16px);
    border-radius: 0px;
    border: 1px solid var(--outline-variant);
    padding: 24px;
    overflow-x: auto;
  }

  .dt-table {
    width: 100%;
    text-align: left;
    border-collapse: collapse;
  }

  :global(thead) {
    border-bottom: 1px solid var(--outline-variant);
  }

  :global(th) {
    padding: 0 16px 16px 0;
    color: var(--on-surface-variant);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  :global(td) {
    padding: 16px 16px 16px 0;
    vertical-align: middle;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 24px;
    color: var(--on-surface);
  }

  :global(tr) {
    border-bottom: 1px solid var(--outline-variant);
    transition: background-color 0.15s ease;
  }

  :global(tr:hover) {
    background-color: rgba(255, 255, 255, 0.03);
  }

  :global(tr:last-child) {
    border-bottom: none;
  }
</style>
