---
/**
 * PriceTierList — Full tier table for product detail page
 * 
 * Renders table: Cantidad | Precio/u | Ahorro vs base
 * Highlights tier applicable to current selectedQty (SSR first paint;
 * client events own correctness after hydration — D2).
 */

import { getTierPrice, getTierSavings, formatTierOption } from "../lib/price-utils";
import { formatPrice } from "../lib/format";

interface Props {
  priceTiers?: Array<{
    id: string;
    branch_id?: string;
    branch_name?: string;
    min_quantity: number;
    price: number;
  }>;
  selectedQty?: number;
  basePrice?: number;
}

const { priceTiers, selectedQty = 1, basePrice: basePriceProp } = Astro.props;

const tiers = priceTiers || [];
const baseTier = tiers.find((t) => t.min_quantity === 1);
// Caller-provided base price wins; otherwise derive from min_quantity === 1 row (0 when absent)
const basePrice = basePriceProp ?? baseTier?.price ?? 0;

const sortedTiers = [...tiers].sort((a, b) => a.min_quantity - b.min_quantity);
const currentTierPrice = getTierPrice(tiers, selectedQty, basePrice);
const currentTier = sortedTiers.find((t) => t.price === currentTierPrice) || sortedTiers[0];
---

{tiers.length > 0 && (
  <div class="tier-list" role="region" aria-label="Precios por volumen" data-tiers={JSON.stringify(tiers)}>
    <table class="tier-table">
      <thead>
        <tr>
          <th scope="col" class="tier-col-qty">Cantidad</th>
          <th scope="col" class="tier-col-price">Precio/u</th>
          <th scope="col" class="tier-col-savings">Ahorro</th>
        </tr>
      </thead>
      <tbody>
        {sortedTiers.map((tier) => {
          const isActive = tier.price === currentTierPrice;
          const savings = getTierSavings(tier, tiers, basePrice);
          const qtyLabel = tier.min_quantity === 1 
            ? "1 und (base)" 
            : `${tier.min_quantity}+ unds`;
          
          return (
            <tr
              class={isActive ? "tier-row--active" : ""}
              data-tier-row
              data-tier-id={tier.id}
              data-min-qty={tier.min_quantity}
            >
              <td class="tier-col-qty">
                <span class={isActive ? "tier-qty--active" : ""}>{qtyLabel}</span>
                <button
                  type="button"
                  class="tier-add-btn"
                  data-min-qty={tier.min_quantity}
                  aria-label={`Agregar ${tier.min_quantity} unidades al carrito`}
                >+</button>
              </td>
              <td class="tier-col-price">
                <span class={isActive ? "tier-price--active" : ""}>
                  Gs. {new Intl.NumberFormat("es-PY", { style: "decimal", maximumFractionDigits: 0 }).format(tier.price)}
                </span>
              </td>
              <td class="tier-col-savings">
                {savings > 0 && <span class="tier-savings">Ahorro: Gs. {formatPrice(savings)}</span>}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
)}

<script>
  import { getTierForQuantity } from '../lib/price-utils';

  // Reactive active row (D2): <number-input> is a sibling island, so its
  // number-input:change events are observed at document level.
  const tierList = document.querySelector('[data-tiers]') as HTMLElement;
  if (tierList) {
    const tiers = JSON.parse(tierList.getAttribute('data-tiers') || '[]');
    const rows = Array.from(tierList.querySelectorAll('[data-tier-row]')) as HTMLElement[];

    function highlightActiveRow(qty: number) {
      const tier = getTierForQuantity(tiers, qty);
      rows.forEach((row) => {
        const isActive = tier !== null && Number(row.getAttribute('data-min-qty')) === tier.min_quantity;
        row.classList.toggle('tier-row--active', isActive);
        if (isActive) {
          // Restart the blink each time the row becomes active (D4, client-only)
          row.classList.remove('tier-row--blink');
          void row.offsetWidth;
          row.classList.add('tier-row--blink');
        }
      });
    }

    document.addEventListener('number-input:change', ((e: CustomEvent) => {
      highlightActiveRow(e.detail.value);
    }) as EventListener);

    // Quick-add (D3): "+" dispatches tier-add; the product page consumes it
    tierList.querySelectorAll('.tier-add-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        btn.dispatchEvent(new CustomEvent('tier-add', {
          detail: { min_quantity: Number((btn as HTMLElement).dataset.minQty) },
          bubbles: true,
          composed: true,
        }));
      });
    });
  }
</script>

<style>
  .tier-list {
    margin-top: var(--space-md);
    border: var(--border-width) solid var(--outline-variant);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .tier-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
    font-size: 14px;
  }

  .tier-table th {
    text-align: left;
    padding: var(--space-sm) var(--space-md);
    background-color: var(--surface-container);
    color: var(--on-surface-variant);
    font-weight: 500;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: var(--border-width) solid var(--outline-variant);
  }

  .tier-table td {
    padding: var(--space-sm) var(--space-md);
    border-bottom: var(--border-width) solid var(--outline-variant);
    font-family: var(--font-mono);
  }

  .tier-table tbody tr:last-child td {
    border-bottom: none;
  }

  .tier-row--active {
    background-color: var(--primary-container);
  }

  .tier-row--active .tier-qty--active,
  .tier-row--active .tier-price--active {
    color: var(--on-primary-container);
    font-weight: 700;
  }

  @keyframes tier-blink {
    0%, 100% { background-color: var(--primary-container); }
    50% { background-color: var(--primary); }
  }

  .tier-row--blink {
    animation: tier-blink 0.5s ease-in-out 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .tier-row--blink {
      animation: none;
    }
  }

  .tier-add-btn {
    margin-left: var(--space-sm);
    width: 28px;
    height: 28px;
    border: var(--border-width) solid var(--outline-variant);
    background-color: var(--surface-container-high);
    color: var(--on-surface);
    font-family: var(--font-mono);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    border-radius: var(--border-radius);
  }

  .tier-add-btn:hover {
    background-color: var(--primary);
    color: var(--on-primary);
  }

  .tier-add-btn:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .tier-col-qty {
    width: 40%;
  }

  .tier-col-price {
    width: 40%;
    text-align: right;
  }

  .tier-col-savings {
    width: 20%;
    text-align: right;
  }

  .tier-savings {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    background-color: var(--secondary-container);
    color: var(--on-secondary-container);
    border-radius: var(--border-radius);
    font-size: 11px;
    font-weight: 600;
  }

  .tier-qty--active,
  .tier-price--active {
    color: var(--on-primary-container);
  }
</style>
