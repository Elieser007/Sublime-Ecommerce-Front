---
/**
 * PriceTierList — Full tier table for product detail page
 * 
 * Renders table: Cantidad | Precio/u | Ahorro vs base
 * Highlights tier applicable to current selectedQty (SSR first paint;
 * client events own correctness after hydration — D2).
 */

import { getTierPrice, getTierSavingsPercent } from "../lib/price-utils";

interface Props {
  priceTiers?: Array<{
    id: string;
    branch_id?: string;
    branch_name?: string;
    min_quantity: number;
    price: number;
  }>;
  selectedQty?: number;
  basePrice?: number;
}

const { priceTiers, selectedQty = 1, basePrice: basePriceProp } = Astro.props;

const tiers = priceTiers || [];
const baseTier = tiers.find((t) => t.min_quantity === 1);
// Caller-provided base price wins; otherwise derive from min_quantity === 1 row (0 when absent)
const basePrice = basePriceProp ?? baseTier?.price ?? 0;

const sortedTiers = [...tiers].sort((a, b) => a.min_quantity - b.min_quantity);
const currentTierPrice = getTierPrice(tiers, selectedQty, basePrice);
const currentTier = sortedTiers.find((t) => t.price === currentTierPrice) || sortedTiers[0];
---

{tiers.length > 0 && (
  <div class="tier-list" role="region" aria-label="Precios por volumen" data-tiers={JSON.stringify(tiers)}>
    <table class="tier-table">
      <thead>
        <tr>
          <th scope="col" class="tier-col-qty">Cantidad</th>
          <th scope="col" class="tier-col-price">Precio/u</th>
          <th scope="col" class="tier-col-savings">Ahorro</th>
        </tr>
      </thead>
      <tbody>
        {sortedTiers.map((tier) => {
          const isActive = tier.price === currentTierPrice;
          const savingsPct = getTierSavingsPercent(tier, tiers, basePrice);
          const qtyLabel = tier.min_quantity === 1 
            ? "1 und (base)" 
            : `${tier.min_quantity}+ unds`;
          
          return (
            <tr
              class={isActive ? "tier-row--active" : ""}
              data-tier-row
              data-tier-id={tier.id}
              data-min-qty={tier.min_quantity}
            >
              <td class="tier-col-qty">
                <button
                  type="button"
                  class="tier-use-btn"
                  data-min-qty={tier.min_quantity}
                  aria-label={`Usar ${tier.min_quantity} unidades`}
                >✓</button>
                <span class={isActive ? "tier-qty--active" : ""}>{qtyLabel}</span>
              </td>
              <td class="tier-col-price">
                <span class={isActive ? "tier-price--active" : ""}>
                  Gs. {new Intl.NumberFormat("es-PY", { style: "decimal", maximumFractionDigits: 0 }).format(tier.price)}
                </span>
              </td>
              <td class="tier-col-savings">
                {savingsPct > 0 && <span class="tier-savings">{savingsPct}%</span>}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
)}

<script>
  import { getTierForQuantity } from '../lib/price-utils';

  // ClientRouter dedupes module scripts: this bundle executes once per
  // session while astro:page-load fires on every navigation. All DOM is
  // therefore re-resolved per page-load — never captured at module scope —
  // so every product page gets its own tier-row highlight and quick-add
  // bindings (the "+" buttons were dead on the 2nd+ product page before).
  function handleTierQtyChange(e: CustomEvent) {
    const tierList = document.querySelector('[data-tiers]') as HTMLElement;
    if (!tierList) return;
    const tiers = JSON.parse(tierList.getAttribute('data-tiers') || '[]');
    const rows = Array.from(tierList.querySelectorAll('[data-tier-row]')) as HTMLElement[];

    const tier = getTierForQuantity(tiers, e.detail.value);
    rows.forEach((row) => {
      const isActive = tier !== null && Number(row.getAttribute('data-min-qty')) === tier.min_quantity;
      row.classList.toggle('tier-row--active', isActive);
      if (isActive) {
        // Restart the blink each time the row becomes active (D4, client-only)
        row.classList.remove('tier-row--blink');
        void row.offsetWidth;
        row.classList.add('tier-row--blink');
      }
    });
  }

  // Document-level listener: replace the previous one instead of stacking
  // per execution (the handler resolves the CURRENT page's DOM at call time).
  if (window.__tierQtyChangeHandler) {
    document.removeEventListener('number-input:change', window.__tierQtyChangeHandler);
  }
  window.__tierQtyChangeHandler = handleTierQtyChange;
  document.addEventListener('number-input:change', window.__tierQtyChangeHandler);

  function initTierList() {
    const tierList = document.querySelector('[data-tiers]') as HTMLElement;
    if (!tierList) return;
    // "Usar" (D3): dispatches tier-select; the product page applies the tier
    // minimum to the quantity stepper and focuses it. Document-level bindings
    // are per page-load: the rows are fresh per swap.
    tierList.querySelectorAll('.tier-use-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        btn.dispatchEvent(new CustomEvent('tier-select', {
          detail: { min_quantity: Number((btn as HTMLElement).dataset.minQty) },
          bubbles: true,
          composed: true,
        }));
      });
    });
  }

  if (window.__tierListInit) {
    document.removeEventListener('astro:page-load', window.__tierListInit);
  }
  window.__tierListInit = initTierList;
  document.addEventListener('astro:page-load', window.__tierListInit);
</script>

<style>
  .tier-list {
    margin-top: var(--space-md);
    border: var(--border-width) solid var(--outline-variant);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .tier-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
    font-size: 14px;
  }

  .tier-table th {
    text-align: left;
    padding: var(--space-sm) var(--space-md);
    background-color: var(--surface-container);
    color: var(--on-surface-variant);
    font-weight: 500;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: var(--border-width) solid var(--outline-variant);
  }

  .tier-table td {
    padding: var(--space-sm) var(--space-md);
    border-bottom: var(--border-width) solid var(--outline-variant);
    font-family: var(--font-mono);
  }

  .tier-table tbody tr:last-child td {
    border-bottom: none;
  }

  .tier-row--active {
    background-color: var(--primary-container);
  }

  .tier-row--active .tier-qty--active,
  .tier-row--active .tier-price--active {
    color: var(--on-primary-container);
    font-weight: 700;
  }

  @keyframes tier-blink {
    0%, 100% { background-color: var(--primary-container); }
    50% { background-color: var(--primary); }
  }

  .tier-row--blink {
    animation: tier-blink 0.5s ease-in-out 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .tier-row--blink {
      animation: none;
    }
  }

  .tier-use-btn {
    margin-right: var(--space-sm);
    padding: 2px 8px;
    border: var(--border-width) solid var(--outline-variant);
    background-color: var(--surface-container-high);
    color: var(--on-surface);
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.4;
    cursor: pointer;
    border-radius: var(--border-radius);
    vertical-align: middle;
  }

  .tier-use-btn:hover {
    background-color: var(--primary);
    color: var(--on-primary);
  }

  .tier-use-btn:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .tier-col-qty {
    width: 40%;
    white-space: nowrap;
  }

  .tier-col-price {
    width: 40%;
  }

  .tier-col-savings {
    width: 20%;
  }

  .tier-savings {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    background-color: var(--secondary-container);
    color: var(--on-secondary-container);
    border-radius: var(--border-radius);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }

  .tier-qty--active,
  .tier-price--active {
    color: var(--on-primary-container);
  }
</style>
