---
/**
 * AdminTable component — Chromatic High-Contrast
 * 
 * Product list table with edit/delete actions.
 * Sharp corners, border style, hover effects.
 */

interface Product {
  id: string;
  name: string;
  price: number;
  category: string;
  image: string;
  stock?: number;
}

interface Props {
  products: Product[];
}

const { products } = Astro.props;

const fmt = (n: number) =>
  new Intl.NumberFormat('es-PY', { style: 'decimal', maximumFractionDigits: 0 }).format(n);
---

<div class="admin-table-wrapper">
  <table class="admin-table">
    <thead>
      <tr>
        <th class="label-sm">Imagen</th>
        <th class="label-sm">Nombre</th>
        <th class="label-sm">Precio</th>
        <th class="label-sm">Categoría</th>
        <th class="label-sm">Acciones</th>
      </tr>
    </thead>
    <tbody>
      {products.map((product) => (
        <tr data-product-id={product.id}>
          <td>
            <div class="table-image">
              <img src={product.image} alt={product.name} width="48" height="48" loading="lazy" />
            </div>
          </td>
          <td class="body-md">{product.name}</td>
          <td class="body-md">Gs. {fmt(product.price)}</td>
          <td>
            <span class="table-chip label-sm">{product.category}</span>
          </td>
          <td>
            <div class="table-actions">
              <a href={`/admin/editar/${product.id}`} class="action-btn" aria-label="Editar">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                  <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
              </a>
              <button class="action-btn action-btn--delete" data-delete-id={product.id} aria-label="Eliminar">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="3 6 5 6 21 6"/>
                  <path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
                </svg>
              </button>
            </div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .admin-table-wrapper {
    overflow-x: auto;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
  }

  .admin-table th {
    text-align: left;
    padding: var(--space-md);
    color: var(--primary);
    border-bottom: var(--border-hard) solid var(--outline-variant);
  }

  .admin-table td {
    padding: var(--space-md);
    border-bottom: var(--border-width) solid var(--outline-variant);
    vertical-align: middle;
  }

  .admin-table tr:hover {
    background-color: var(--surface-container);
  }

  .table-image {
    width: 48px;
    height: 48px;
    overflow: hidden;
    background-color: var(--surface-container-high);
  }

  .table-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .table-chip {
    display: inline-flex;
    padding: var(--space-xs) var(--space-sm);
    background-color: var(--secondary);
    color: var(--on-secondary);
  }

  .table-actions {
    display: flex;
    gap: var(--space-sm);
  }

  .action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: transparent;
    border: var(--border-width) solid var(--outline-variant);
    color: var(--on-surface-variant);
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
  }

  .action-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .action-btn--delete:hover {
    border-color: var(--error);
    color: var(--error);
  }
</style>

<script>
  // Client-side delete confirmation
  document.querySelectorAll('[data-delete-id]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      const productId = el.dataset.deleteId;

      if (confirm('¿Estás seguro de que quieres eliminar este producto?')) {
        // TODO: Call backend API to delete
        console.log('Delete product:', productId);
        const row = el.closest('tr');
        row?.remove();
      }
    });
  });
</script>
