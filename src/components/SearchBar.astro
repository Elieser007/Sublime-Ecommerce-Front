---
/**
 * SearchBar component — Chromatic High-Contrast
 * 
 * Bottom-border input with search icon.
 * Client-side filtering of products by name.
 */

interface Props {
  placeholder?: string;
}

const { placeholder = 'Buscar productos...' } = Astro.props;
---

<div class="search-bar">
  <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="11" cy="11" r="8"/>
    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
  </svg>
  <input
    type="text"
    class="search-input"
    placeholder={placeholder}
    id="search-input"
  />
</div>

<style>
  .search-bar {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 0;
    color: var(--outline);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: var(--space-md) 0 var(--space-md) var(--space-xl);
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--on-surface);
    background: transparent;
    border: none;
    border-bottom: var(--border-hard) solid var(--on-surface);
    border-radius: var(--border-radius);
    outline: none;
    transition: border-color 0.15s ease;
  }

  .search-input::placeholder {
    color: var(--outline);
  }

  .search-input:focus {
    border-bottom-color: var(--tertiary);
  }
</style>

<script>
  // Client-side search filtering
  const searchInput = document.getElementById('search-input');
  searchInput?.addEventListener('input', () => {
    const query = (searchInput as HTMLInputElement).value.toLowerCase();

    document.querySelectorAll('[data-product-name]').forEach((card) => {
      const el = card as HTMLElement;
      const name = el.dataset.productName?.toLowerCase() || '';
      el.style.display = name.includes(query) ? '' : 'none';
    });
  });
</script>
