---
/**
 * MobileCategoryPanel — Slide-in from Left
 * 
 * Shows category tree in a slide-in panel from the left side.
 * Triggered by "Categorías" button on mobile.
 */

interface Category {
  id: string;
  name: string;
  slug: string;
  children?: Category[];
}

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<!-- Overlay -->
<div class="panel-overlay" id="category-overlay"></div>

<!-- Panel -->
<div class="panel panel--left" id="category-panel">
  <div class="panel-header">
    <h2 class="headline-lg-mobile">Categorías</h2>
    <button class="panel-close" id="category-close" aria-label="Cerrar">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <div class="panel-content">
    <button class="filter-btn body-md active" data-filter="all">Todos</button>
    {categories.map((cat) => (
      <div class="filter-group">
        <button class="filter-btn body-md" data-filter={cat.id}>
          {cat.name}
          {cat.children && cat.children.length > 0 && (
            <span class="filter-count label-sm">{cat.children.length}</span>
          )}
        </button>
        {cat.children && cat.children.length > 0 && (
          <div class="filter-children">
            {cat.children.map((child) => (
              <button class="filter-btn filter-btn--child body-md" data-filter={child.id}>
                {child.name}
              </button>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>
</div>

<script>
  // Open panel
  document.getElementById('open-categories')?.addEventListener('click', () => {
    document.getElementById('category-panel')?.classList.add('open');
    document.getElementById('category-overlay')?.classList.add('open');
    document.body.style.overflow = 'hidden';
  });

  // Close panel
  function closePanel() {
    document.getElementById('category-panel')?.classList.remove('open');
    document.getElementById('category-overlay')?.classList.remove('open');
    document.body.style.overflow = '';
  }

  document.getElementById('category-close')?.addEventListener('click', closePanel);
  document.getElementById('category-overlay')?.addEventListener('click', closePanel);

  // Filter selection
  document.querySelectorAll('#category-panel [data-filter]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;
      // Update active state
      document.querySelectorAll('#category-panel .filter-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      // Dispatch event
      window.dispatchEvent(new CustomEvent('category-select', { detail: { category: filter } }));
      // Close panel
      closePanel();
    });
  });
</script>

<style>
  .panel-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 200;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .panel-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .panel {
    position: fixed;
    top: 0;
    bottom: 0;
    width: 300px;
    max-width: 85vw;
    background-color: var(--surface);
    z-index: 201;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .panel--left {
    left: 0;
  }

  .panel.open {
    transform: translateX(0);
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg);
    border-bottom: var(--border-width) solid var(--outline-variant);
  }

  .panel-header h2 {
    color: var(--on-surface);
    font-size: 20px;
  }

  .panel-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    color: var(--on-surface);
    cursor: pointer;
  }

  .panel-content {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-lg);
  }

  .filter-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--space-md);
    background: none;
    border: none;
    border-bottom: var(--border-width) solid var(--outline-variant);
    color: var(--on-surface-variant);
    cursor: pointer;
    text-align: left;
    transition: all 0.15s ease;
  }

  .filter-btn:hover {
    background-color: var(--surface-container-high);
    color: var(--on-surface);
  }

  .filter-btn.active {
    color: var(--primary);
    background-color: var(--surface-container);
  }

  .filter-count {
    color: var(--outline);
  }

  .filter-children {
    padding-left: var(--space-lg);
  }

  .filter-btn--child {
    font-size: 14px;
  }
</style>
