---
/**
 * PromotionWall — Dynamic Lego-style Promotion Grid
 * 
 * Fetches promotions from API and renders them in a CSS Grid.
 * Each promotion has: position (x, y), size (width, height), type, content.
 *
 * Supports:
 * - "image" tiles: full background image with overlay + text
 * - "text" tiles: compact announcement bar with background color
 * 
 * Usage: <PromotionWall section="always-catalog-top" />
 */

interface Props {
  section: string;
  class?: string;
}

const { section, class: className = "" } = Astro.props;
---

<div class={`promotion-wall ${className}`} data-section={section}>
  <!-- Loading state -->
  <div class="promo-loading" id={`promo-loading-${section}`}>
    <div class="cmyk-bar"><span></span><span></span><span></span></div>
  </div>
  
  <!-- Promotions grid (populated by JS) -->
  <div class="promo-grid" id={`promo-grid-${section}`} style="display: none;"></div>
</div>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
  
  async function loadPromotions(sectionSlug: string) {
    const grid = document.getElementById(`promo-grid-${sectionSlug}`);
    const loading = document.getElementById(`promo-loading-${sectionSlug}`);
    
    if (!grid || !loading) return;
    
    try {
      const res = await fetch(`${API_URL}/api/promotions?section=${sectionSlug}`, {
        credentials: 'include',
      });
      
      if (!res.ok) return;
      
      const { promotions } = await res.json();
      
      if (!promotions || promotions.length === 0) {
        loading.style.display = 'none';
        const wall = document.getElementById(`promo-loading-${sectionSlug}`)?.parentElement;
        if (wall) (wall as HTMLElement).style.display = 'none';
        return;
      }
      
      // Find grid dimensions from promotions
      let maxCols = 1;
      let maxRows = 1;
      promotions.forEach((p: any) => {
        const endX = p.pos_x + p.width;
        const endY = p.pos_y + p.height;
        if (endX > maxCols) maxCols = endX;
        if (endY > maxRows) maxRows = endY;
      });
      
      // Determine if these are text banners (compact announcement bars)
      const isTextGrid = promotions.every(p => p.tile_type === 'text');
      
      // Set grid template
      if (isTextGrid) {
        // Text banners: compact, proportional to viewport
        const rowHeight = maxRows <= 1 ? 48 : maxRows <= 2 ? 56 : 64;
        grid.style.gridTemplateColumns = `repeat(${maxCols}, 1fr)`;
        grid.style.gridTemplateRows = `repeat(${maxRows}, ${rowHeight}px)`;
      } else {
        // Image banners: taller, proportional to grid rows
        const rowHeight = maxRows <= 1 ? 120 : maxRows <= 2 ? 160 : 200;
        grid.style.gridTemplateColumns = `repeat(${maxCols}, 1fr)`;
        grid.style.gridTemplateRows = `repeat(${maxRows}, minmax(${rowHeight}px, auto))`;
      }
      
      // Render each promotion
      grid.innerHTML = promotions.map((promo: any) => {
        const gridColumn = `${promo.pos_x + 1} / span ${promo.width}`;
        const gridRow = `${promo.pos_y + 1} / span ${promo.height}`;
        
        if (promo.tile_type === 'text') {
          // Compact announcement bar
          return `
            <div 
              class="promo-tile promo-tile--text"
              style="grid-column: ${gridColumn}; grid-row: ${gridRow};"
              data-promo-id="${promo.id}"
            >
              <div class="promo-text-inner">
                <span class="promo-text-title">${promo.title}</span>
                ${promo.subtitle ? `<span class="promo-text-subtitle">${promo.subtitle}</span>` : ''}
                ${promo.link ? `<a href="${promo.link}" class="promo-link" aria-label="${promo.title}"></a>` : ''}
              </div>
            </div>
          `;
        }
        
        // Standard tile with image
        return `
          <div 
            class="promo-tile promo-tile--image"
            style="grid-column: ${gridColumn}; grid-row: ${gridRow};"
            data-promo-id="${promo.id}"
          >
            ${promo.image_url ? `<img src="${promo.image_url}" alt="${promo.title}" class="promo-image" loading="lazy" />` : `<div class="promo-image-placeholder"></div>`}
            <div class="promo-overlay"></div>
            <div class="promo-content">
              <h3 class="promo-title">${promo.title}</h3>
              ${promo.subtitle ? `<p class="promo-subtitle">${promo.subtitle}</p>` : ''}
              ${promo.link ? `<a href="${promo.link}" class="promo-link" aria-label="${promo.title}"></a>` : ''}
            </div>
          </div>
        `;
      }).join('');
      
      loading.style.display = 'none';
      grid.style.display = 'grid';
      
    } catch (err) {
      console.error('Error loading promotions:', err);
      loading.style.display = 'none';
    }
  }
  
  // Load promotions for each section on page
  document.querySelectorAll('.promotion-wall').forEach((wall) => {
    const section = (wall as HTMLElement).dataset.section;
    if (section) loadPromotions(section);
  });
</script>

<style>
  .promotion-wall {
    width: 100%;
  }

  .promo-loading {
    text-align: center;
    padding: var(--space-lg);
  }

  .promo-grid {
    display: grid;
    gap: var(--space-md);
    grid-auto-flow: dense;
  }

  /* ====== TEXT TILES (announcement bars) ====== */
  .promo-tile--text {
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, var(--surface-container-high), var(--surface-container));
    border: var(--border-width) solid var(--outline-variant);
    overflow: hidden;
    cursor: default;
  }

  .promo-tile--text:hover {
    border-color: var(--primary);
  }

  .promo-text-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    width: 100%;
    height: 100%;
    padding: 0 var(--space-md);
    flex-wrap: wrap;
  }

  .promo-text-title {
    font-family: var(--font-mono);
    font-size: clamp(11px, 1.2vw, 13px);
    color: var(--on-surface);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Dot separators between items (using • character in text) */
  .promo-text-subtitle {
    font-family: var(--font-body);
    font-size: clamp(11px, 1.1vw, 13px);
    color: var(--primary);
    white-space: nowrap;
  }

  /* ====== IMAGE TILES ====== */
  .promo-tile--image {
    position: relative;
    overflow: hidden;
    border: var(--border-width) solid var(--outline-variant);
    cursor: pointer;
    transition: border-color 0.2s ease;
    background-color: var(--surface-container);
    min-height: 120px;
  }

  .promo-tile--image:hover {
    border-color: var(--primary);
  }

  .promo-tile--image:hover .promo-image {
    transform: scale(1.05);
  }

  .promo-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
    transition: transform 0.3s ease;
  }

  .promo-image-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--surface-container-high), var(--surface-container));
  }

  .promo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0.3) 50%,
      transparent 100%
    );
    z-index: 1;
  }

  .promo-content {
    position: relative;
    z-index: 2;
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    color: white;
  }

  .promo-title {
    font-family: var(--font-display);
    font-size: clamp(18px, 2.5vw, 28px);
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: var(--space-xs);
  }

  .promo-subtitle {
    font-size: clamp(13px, 1.1vw, 15px);
    opacity: 0.85;
    font-family: var(--font-body);
    max-width: 80%;
  }

  .promo-link {
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  /* Responsive */
  @media (max-width: 767px) {
    .promo-grid {
      gap: var(--space-sm);
    }
    .promo-content {
      padding: var(--space-md);
    }
    .promo-subtitle {
      max-width: 100%;
    }
    .promo-text-inner {
      padding: 0 var(--space-sm);
      flex-direction: column;
      gap: 2px;
    }
    .promo-text-title {
      white-space: normal;
      text-align: center;
      font-size: 10px;
    }
    .promo-text-subtitle {
      font-size: 10px;
    }
  }
</style>
