---
/**
 * PromotionWall — Dynamic Lego-style Promotion Grid
 * 
 * Fetches promotions from API and renders them in a CSS Grid.
 * Each promotion has: position (x, y), size (width, height), type, content.
 * 
 * Landscape-first design: images are wider than tall (3/4 or 2/4 ratio).
 * 
 * Usage: <PromotionWall section="home-hero" />
 */

interface Props {
  section: string;
  class?: string;
}

const { section, class: className = "" } = Astro.props;
---

<div class={`promotion-wall ${className}`} data-section={section}>
  <!-- Loading state -->
  <div class="promo-loading" id={`promo-loading-${section}`}>
    <div class="cmyk-bar"><span></span><span></span><span></span></div>
  </div>
  
  <!-- Promotions grid (populated by JS) -->
  <div class="promo-grid" id={`promo-grid-${section}`} style="display: none;"></div>
</div>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
  
  async function loadPromotions(sectionSlug: string) {
    const grid = document.getElementById(`promo-grid-${sectionSlug}`);
    const loading = document.getElementById(`promo-loading-${sectionSlug}`);
    
    if (!grid || !loading) return;
    
    try {
      const res = await fetch(`${API_URL}/api/promotions?section=${sectionSlug}`, {
        credentials: 'include',
      });
      
      if (!res.ok) return;
      
      const { promotions } = await res.json();
      
      if (!promotions || promotions.length === 0) {
        loading.style.display = 'none';
        const wall = document.getElementById(`promo-loading-${sectionSlug}`)?.parentElement;
        if (wall) (wall as HTMLElement).style.display = 'none';
        return;
      }
      
      // Find grid dimensions from promotions
      let maxCols = 1;
      let maxRows = 1;
      promotions.forEach((p: any) => {
        const endX = p.pos_x + p.width;
        const endY = p.pos_y + p.height;
        if (endX > maxCols) maxCols = endX;
        if (endY > maxRows) maxRows = endY;
      });
      
      // Set grid template — responsive heights based on grid rows
      const rowHeight = maxRows <= 2 ? 180 : maxRows <= 3 ? 220 : 280;
      grid.style.gridTemplateColumns = `repeat(${maxCols}, 1fr)`;
      grid.style.gridTemplateRows = `repeat(${maxRows}, ${rowHeight}px)`;
      
      // Render each promotion
      grid.innerHTML = promotions.map((promo: any) => {
        const gridColumn = `${promo.pos_x + 1} / span ${promo.width}`;
        const gridRow = `${promo.pos_y + 1} / span ${promo.height}`;
        
        return `
          <div 
            class="promo-tile promo-tile--${promo.tile_type}"
            style="grid-column: ${gridColumn}; grid-row: ${gridRow};"
            data-promo-id="${promo.id}"
          >
            ${promo.image_url ? `<img src="${promo.image_url}" alt="${promo.title}" class="promo-image" loading="lazy" />` : `<div class="promo-image-placeholder"></div>`}
            <div class="promo-overlay"></div>
            <div class="promo-content">
              <h3 class="promo-title">${promo.title}</h3>
              ${promo.subtitle ? `<p class="promo-subtitle">${promo.subtitle}</p>` : ''}
              ${promo.link ? `<a href="${promo.link}" class="promo-link" aria-label="${promo.title}"></a>` : ''}
            </div>
          </div>
        `;
      }).join('');
      
      loading.style.display = 'none';
      grid.style.display = 'grid';
      
    } catch (err) {
      console.error('Error loading promotions:', err);
      loading.style.display = 'none';
    }
  }
  
  // Load promotions for each section on page
  document.querySelectorAll('.promotion-wall').forEach((wall) => {
    const section = (wall as HTMLElement).dataset.section;
    if (section) loadPromotions(section);
  });
</script>

<style>
  .promotion-wall {
    width: 100%;
    margin-bottom: var(--space-2xl);
  }

  .promo-loading {
    text-align: center;
    padding: var(--space-2xl);
  }

  .promo-grid {
    display: grid;
    gap: var(--space-md);
    grid-auto-flow: dense;
  }

  .promo-tile {
    position: relative;
    overflow: hidden;
    border: var(--border-width) solid var(--outline-variant);
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.15s ease;
    background-color: var(--surface-container);
  }

  .promo-tile:hover {
    border-color: var(--primary);
  }

  .promo-tile:hover .promo-image {
    transform: scale(1.05);
  }

  .promo-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
    transition: transform 0.3s ease;
  }

  .promo-image-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--surface-container-high), var(--surface-container));
  }

  .promo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.4) 40%,
      rgba(0, 0, 0, 0.1) 70%,
      transparent 100%
    );
    z-index: 1;
  }

  .promo-content {
    position: relative;
    z-index: 2;
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    color: white;
  }

  .promo-title {
    font-family: var(--font-display);
    font-size: clamp(18px, 2.5vw, 32px);
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: var(--space-xs);
  }

  .promo-subtitle {
    font-size: clamp(13px, 1.2vw, 16px);
    opacity: 0.85;
    font-family: var(--font-body);
    max-width: 80%;
  }

  .promo-link {
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  /* Tile type variations */
  .promo-tile--banner .promo-content {
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.8) 0%, transparent 100%);
  }

  .promo-tile--text {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background-color: var(--primary);
    color: var(--on-primary);
  }

  .promo-tile--text .promo-content {
    justify-content: center;
    align-items: center;
    background: none;
  }

  .promo-tile--text .promo-title {
    font-size: clamp(24px, 3vw, 40px);
  }

  /* Responsive: smaller gap on mobile */
  @media (max-width: 767px) {
    .promo-grid {
      gap: var(--space-sm);
    }
    .promo-content {
      padding: var(--space-md);
    }
    .promo-subtitle {
      max-width: 100%;
    }
  }
</style>
