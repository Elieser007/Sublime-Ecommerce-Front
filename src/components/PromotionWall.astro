---
/**
 * PromotionWall — Dynamic promotion renderer (SSG)
 *
 * Renders promotions by importing promo/ components with props.
 * Each display type maps to its dedicated component.
 * Carousel auto-play logic is handled by CarouselPromo.
 *
 * Usage:
 *   <PromotionWall
 *     section="always-catalog-top"
 *     promotions={[...]}
 *     sectionInfo={{ displayType: "tiles", ... }}
 *   />
 */

import HeroPromo from './promo/HeroPromo.astro';
import CarouselPromo from './promo/CarouselPromo.astro';
import TilesPromo from './promo/TilesPromo.astro';
import SplitPromo from './promo/SplitPromo.astro';
import BannerPromo from './promo/BannerPromo.astro';
import RibbonPromo from './promo/RibbonPromo.astro';

interface Promotion {
  id: string;
  title: string | null;
  description: string | null;
  imageUrl: string;
  link: string;
  position: number;
  tileCols: number;
  tileRows: number;
}

interface SectionInfo {
  id: string;
  slug: string;
  displayType: string;
}

interface Props {
  section: string;
  promotions?: Promotion[];
  sectionInfo?: SectionInfo | null;
  class?: string;
}

const {
  section,
  promotions = [],
  sectionInfo = null,
  class: className = "",
} = Astro.props;

const displayType = sectionInfo?.displayType || "tiles";
const hasPromotions = promotions.length > 0;
---

<div class:list={['promotion-wall', className]} data-section={section}>
  {hasPromotions && displayType === 'hero' && (
    <HeroPromo promotions={promotions} />
  )}
  {hasPromotions && displayType === 'carousel' && (
    <CarouselPromo promotions={promotions} id={section} />
  )}
  {hasPromotions && displayType === 'tiles' && (
    <TilesPromo promotions={promotions} />
  )}
  {hasPromotions && displayType === 'split' && (
    <SplitPromo promotions={promotions} />
  )}
  {hasPromotions && displayType === 'banner' && (
    <BannerPromo promotions={promotions} />
  )}
  {hasPromotions && displayType === 'ribbon' && (
    <RibbonPromo promotions={promotions} />
  )}
</div>

<style>
  .promotion-wall { width: 100%; }
</style>
