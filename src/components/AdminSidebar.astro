---
/**
 * AdminSidebar — Multi-Branch Navigation (Client-Side)
 * 
 * Fetches user data and branches from /api/me and /api/branches.
 * Shows different menu items based on user role.
 * Includes branch selector for admins.
 */
import Button from './Button.astro';
---

<button class="sidebar-toggle" id="sidebar-toggle" aria-expanded="false" aria-label="Abrir menú de navegación">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <line x1="3" y1="6" x2="21" y2="6"/>
    <line x1="3" y1="12" x2="21" y2="12"/>
    <line x1="3" y1="18" x2="21" y2="18"/>
  </svg>
</button>

<div class="sidebar-overlay" id="sidebar-overlay"></div>

<aside class="admin-sidebar" id="admin-sidebar" data-active={Astro.props.active || ''} role="navigation">
  <!-- User Info (populated by JS) -->
  <div class="sidebar-user" id="sidebar-user">
    <div class="user-avatar">
      <span class="avatar-text label-sm" id="user-initial">U</span>
    </div>
    <div class="user-info">
      <p class="user-name body-md" id="user-name">Cargando...</p>
      <span class="user-role label-sm" id="user-role">-</span>
    </div>
  </div>

  <!-- Branch Selector (Admin only, populated by JS) -->
  <div class="branch-selector" id="branch-selector" style="display: none;">
    <label class="label-sm">Sucursal</label>
    <select class="branch-select" id="branch-select">
      <option value="">Cargando...</option>
    </select>
  </div>

  <!-- Navigation -->
  <nav class="sidebar-nav">
    <!-- Grupo: Principal -->
    <div class="nav-group">
      <span class="nav-group-title label-sm">Principal</span>
      <a href="/dashboard" class="sidebar-link" data-section="dashboard">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"/>
          <rect x="14" y="3" width="7" height="7"/>
          <rect x="14" y="14" width="7" height="7"/>
          <rect x="3" y="14" width="7" height="7"/>
        </svg>
        <span>Dashboard</span>
      </a>
    </div>

    <!-- Grupo: Tienda -->
    <div class="nav-group">
      <span class="nav-group-title label-sm">Tienda</span>
      <a href="/admin/products" class="sidebar-link" data-section="products">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        <span>Productos</span>
      </a>
      <a href="/admin/orders" class="sidebar-link" data-section="orders">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
        </svg>
        <span>Pedidos</span>
      </a>
    </div>

    <!-- Grupo: Administración (solo admin) -->
    <div class="nav-group admin-only" style="display: none;">
      <span class="nav-group-title label-sm">Administración</span>
      <a href="/admin/users" class="sidebar-link" data-section="users">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 00-3-3.87"/>
          <path d="M16 3.13a4 4 0 010 7.75"/>
        </svg>
        <span>Usuarios</span>
      </a>
      <a href="/admin/categories" class="sidebar-link" data-section="categories">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <span>Categorías</span>
      </a>
      <a href="/admin/branches" class="sidebar-link" data-section="branches">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span>Sucursales</span>
      </a>
          <a href="/admin/promotions" class="sidebar-link" data-section="promotions">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <line x1="3" y1="9" x2="21" y2="9"/>
              <line x1="9" y1="21" x2="9" y2="9"/>
            </svg>
            <span>Promociones</span>
          </a>
          <a href="/admin/attribute-modules" class="sidebar-link" data-section="attributes">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
              <line x1="7" y1="7" x2="7.01" y2="7"/>
            </svg>
            <span>Atributos</span>
          </a>
    </div>

    <!-- Deploy (Admin only) -->
    <div class="nav-group admin-only" id="deploy-group" style="display:none">
      <button class="sidebar-link deploy-trigger" id="deploy-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/>
          <line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
        <span>Deploy Frontend</span>
      </button>
    </div>

    <!-- Logout -->
    <div class="nav-group nav-group--bottom">
      <button class="sidebar-link sidebar-link--logout" id="logout-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/>
          <polyline points="16 17 21 12 16 7"/>
          <line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
        <span>Salir</span>
      </button>
    </div>
  </nav>
</aside>

<!-- Deploy confirmation modal -->
<dialog id="deploy-modal" class="deploy-dialog">
  <div class="deploy-modal-content">
    <h3>🚀 Deploy Frontend</h3>
    <p>Este proceso puede tardar varios minutos. Se generarán nuevas páginas estáticas.</p>
    <p class="deploy-warning">⚠️ Límite: 200 builds por mes en Cloudflare Free. Los builds restantes son para emergencias.</p>
    <div id="deploy-status" class="deploy-status"></div>
    <div class="deploy-actions">
      <Button variant="secondary" id="deploy-cancel">Cancelar</Button>
      <Button variant="primary" id="deploy-confirm">Deploy</Button>
    </div>
  </div>
</dialog>

<script>
  import { getApiUrl } from '../lib/api-url';
  const API_URL = getApiUrl();

  async function initSidebar() {
    try {
      const meRes = await fetch(`${API_URL}/api/me`, { credentials: 'include' });
      if (!meRes.ok) {
        window.location.href = '/login';
        return;
      }
      const { user } = await meRes.json();
      const isAdmin = user.role === 'admin';

      const $initial = document.getElementById('user-initial');
      const $name = document.getElementById('user-name');
      const $role = document.getElementById('user-role');
      if ($initial) $initial.textContent = user.name?.charAt(0) || 'U';
      if ($name) $name.textContent = user.name || 'Usuario';
      if ($role) $role.textContent = isAdmin ? 'Administrador' : 'Cliente';

      if (isAdmin) {
        document.querySelectorAll('.admin-only').forEach(el => {
          (el as HTMLElement).style.display = '';
        });
      }

      if (isAdmin) {
        const branchRes = await fetch(`${API_URL}/api/branches`, { credentials: 'include' });
        if (branchRes.ok) {
          const { branches } = await branchRes.json();

          if (branches && branches.length > 0) {
            const selector = document.getElementById('branch-selector');
            const select = document.getElementById('branch-select') as HTMLSelectElement;

            if (selector && select) {
              select.innerHTML = '';
              branches.forEach((branch: any) => {
                const option = document.createElement('option');
                option.value = branch.id;
                option.textContent = branch.name;
                if (branch.id === user.currentBranchId) {
                  option.selected = true;
                }
                select.appendChild(option);
              });
              selector.style.display = '';
            }
          }
        }
      }
    } catch (err) {
      console.error('Sidebar init error:', err);
    }
  }

  function setActiveLink() {
    const activeSection = document.querySelector('.admin-sidebar')?.getAttribute('data-active');
    // Clear any previously highlighted link first (removes the stale
    // hardcoded active state and leftover highlights after navigation).
    document.querySelectorAll('.sidebar-link').forEach((link) => {
      link.classList.remove('active');
    });
    if (!activeSection) return;
    // /admin/new maps to the products section (no dedicated nav link).
    const section = activeSection === 'new' ? 'products' : activeSection;
    document.querySelectorAll('.sidebar-link').forEach((link) => {
      if ((link as HTMLElement).dataset.section === section) {
        link.classList.add('active');
      }
    });
  }

  async function checkDeployConfig() {
    try {
      const res = await fetch(`${API_URL}/api/deploy/config`, { credentials: 'include' });
      if (res.ok) {
        document.getElementById('deploy-group')?.setAttribute('style', '');
      }
    } catch {
    }
  }

  function initAdminSidebar() {
    document.getElementById('branch-select')?.addEventListener('change', async (e) => {
      const branchId = (e.target as HTMLSelectElement).value;
      if (!branchId) return;

      try {
        const res = await fetch(`${API_URL}/api/branches/switch`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ branchId }),
        });

        if (res.ok) {
          window.location.reload();
        } else {
          alert('Error al cambiar de sucursal');
        }
      } catch {
        alert('Error de conexión');
      }
    });

    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      try {
        const { signOut } = await import('/src/lib/auth-client.ts');
        await signOut({
          fetchOptions: {
            onSuccess: () => { window.location.href = '/login'; },
            onError: () => { window.location.href = '/login'; },
          },
        });
      } catch {
        window.location.href = '/login';
      }
    });

    const $deployBtn = document.getElementById('deploy-btn');
    const $deployModal = document.getElementById('deploy-modal') as HTMLDialogElement;
    const $deployCancel = document.getElementById('deploy-cancel');
    const $deployConfirm = document.getElementById('deploy-confirm');
    const $deployStatus = document.getElementById('deploy-status');

    $deployBtn?.addEventListener('click', () => {
      if (!$deployModal) return;
      $deployStatus.textContent = '';
      $deployStatus.className = 'deploy-status';
      $deployConfirm.disabled = false;
      $deployConfirm.textContent = 'Deploy';
      $deployModal.showModal();
    });

    $deployCancel?.addEventListener('click', () => {
      $deployModal?.close();
    });

    $deployConfirm?.addEventListener('click', async () => {
      if (!$deployConfirm || !$deployStatus) return;
      $deployConfirm.disabled = true;
      $deployConfirm.textContent = 'Desplegando...';
      $deployStatus.textContent = 'Iniciando deploy...';
      $deployStatus.className = 'deploy-status deploy-status--loading';

      try {
        const res = await fetch(`${API_URL}/api/deploy`, {
          method: 'POST',
          credentials: 'include',
        });
        const data = await res.json();

        if (res.ok) {
          $deployStatus.textContent = `✅ Deploy iniciado: ${data.url || 'Ver dashboard de Cloudflare'}`;
          $deployStatus.className = 'deploy-status deploy-status--success';
        } else {
          $deployStatus.textContent = `❌ Error: ${data.message || data.error || 'Deploy failed'}`;
          $deployStatus.className = 'deploy-status deploy-status--error';
        }
      } catch {
        $deployStatus.textContent = '❌ Error de conexión al intentar deploy';
        $deployStatus.className = 'deploy-status deploy-status--error';
      } finally {
        $deployConfirm.disabled = false;
        $deployConfirm.textContent = 'Deploy';
      }
    });

    checkDeployConfig();
    initSidebar();
    setActiveLink();

    const $sidebar = document.getElementById('admin-sidebar');
    const $toggle = document.getElementById('sidebar-toggle');
    const $overlay = document.getElementById('sidebar-overlay');

    function syncAriaHidden() {
      if (window.innerWidth <= 767) {
        $sidebar?.setAttribute('aria-hidden', 'true');
      } else {
        $sidebar?.removeAttribute('aria-hidden');
      }
    }
    syncAriaHidden();
    // Window/document-level listeners: replace the previous ones instead of
    // stacking per navigation (each execution closes over its own $sidebar).
    if (window.__adminSidebarResizeHandler) {
      window.removeEventListener('resize', window.__adminSidebarResizeHandler);
    }
    window.__adminSidebarResizeHandler = syncAriaHidden;
    window.addEventListener('resize', window.__adminSidebarResizeHandler);

    function openSidebar() {
      $sidebar?.classList.add('is-open');
      $overlay?.classList.add('is-visible');
      $sidebar?.setAttribute('aria-hidden', 'false');
      $toggle?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      const firstFocusable = $sidebar?.querySelector<HTMLElement>(
        'a[href], button:not([disabled]), select, input, [tabindex]:not([tabindex="-1"])'
      );
      firstFocusable?.focus();
    }

    function closeSidebar() {
      $sidebar?.classList.remove('is-open');
      $overlay?.classList.remove('is-visible');
      $sidebar?.setAttribute('aria-hidden', 'true');
      $toggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if ($toggle && window.getComputedStyle($toggle).display !== 'none') {
        $toggle.focus();
      }
    }

    function toggleSidebar() {
      const isOpen = $sidebar?.classList.contains('is-open');
      if (isOpen) closeSidebar(); else openSidebar();
    }

    $toggle?.addEventListener('click', toggleSidebar);
    $overlay?.addEventListener('click', closeSidebar);

    function handleSidebarKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape' && $sidebar?.classList.contains('is-open')) {
        closeSidebar();
      }
    }
    if (window.__adminSidebarKeydownHandler) {
      document.removeEventListener('keydown', window.__adminSidebarKeydownHandler);
    }
    window.__adminSidebarKeydownHandler = handleSidebarKeydown;
    document.addEventListener('keydown', window.__adminSidebarKeydownHandler);

    function handleSidebarTabTrap(e: KeyboardEvent) {
      if (e.key !== 'Tab' || !$sidebar?.classList.contains('is-open')) return;

      const focusables = $sidebar?.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), select, input, [tabindex]:not([tabindex="-1"])'
      );
      if (!focusables || focusables.length === 0) return;

      const first = focusables[0];
      const last = focusables[focusables.length - 1];

      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }
    if (window.__adminSidebarTabTrapHandler) {
      document.removeEventListener('keydown', window.__adminSidebarTabTrapHandler);
    }
    window.__adminSidebarTabTrapHandler = handleSidebarTabTrap;
    document.addEventListener('keydown', window.__adminSidebarTabTrapHandler);

    $sidebar?.querySelectorAll('.sidebar-link').forEach((link) => {
      if (link.id !== 'deploy-btn') {
        link.addEventListener('click', closeSidebar);
      }
    });
  }

  // ClientRouter re-executes this script per navigation: replace the previous
  // listener instead of stacking one per visit.
  if (window.__adminSidebarInit) {
    document.removeEventListener('astro:page-load', window.__adminSidebarInit);
  }
  window.__adminSidebarInit = initAdminSidebar;
  document.addEventListener('astro:page-load', window.__adminSidebarInit);
</script>

<style>
  .admin-sidebar {
    background-color: var(--surface-container);
    border-right: var(--border-width) solid var(--outline-variant);
    padding: var(--space-lg);
    min-height: calc(100vh - 72px);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  @media (max-width: 767px) {
    .admin-sidebar {
      border-right: none;
      border-bottom: var(--border-width) solid var(--outline-variant);
      min-height: auto;
    }
  }

  .sidebar-user {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-bottom: var(--space-lg);
    border-bottom: var(--border-width) solid var(--outline-variant);
  }

  .user-avatar {
    width: 48px;
    height: 48px;
    background-color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--border-radius);
  }

  .avatar-text {
    color: var(--on-primary);
    font-family: var(--font-display);
    font-size: 20px;
  }

  .user-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .user-name {
    color: var(--on-surface);
    font-weight: 600;
  }

  .user-role {
    color: var(--primary);
  }

  .branch-selector {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-bottom: var(--space-lg);
    border-bottom: var(--border-width) solid var(--outline-variant);
  }

  .branch-selector label {
    color: var(--on-surface-variant);
  }

  .branch-select {
    width: 100%;
    padding: var(--space-md);
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--on-surface);
    background-color: var(--surface);
    border: var(--border-width) solid var(--outline-variant);
    border-radius: var(--border-radius);
    cursor: pointer;
  }

  .branch-select:focus {
    outline: none;
    border-color: var(--primary);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    flex: 1;
  }

  .nav-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .nav-group--bottom {
    margin-top: auto;
    padding-top: var(--space-lg);
    border-top: var(--border-width) solid var(--outline-variant);
  }

  .nav-group-title {
    color: var(--primary);
    padding: 0 var(--space-md);
    margin-bottom: var(--space-xs);
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    color: var(--on-surface-variant);
    text-decoration: none;
    border-radius: var(--border-radius);
    transition: all 0.15s ease;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 14px;
    width: 100%;
    text-align: left;
  }

  .sidebar-link:hover {
    color: var(--on-surface);
    background-color: var(--surface-container-high);
    text-decoration: none;
  }

  .sidebar-link.active {
    color: var(--primary);
    background-color: var(--surface-container-high);
    border-left: 3px solid var(--primary);
  }

  .sidebar-link--logout {
    margin-top: auto;
    color: var(--error);
    border-top: var(--border-width) solid var(--outline-variant);
    padding-top: var(--space-lg);
  }

  .sidebar-link--logout:hover {
    background-color: var(--error-container);
    color: var(--on-error-container);
  }

  /* Deploy styles */
  .deploy-trigger {
    color: var(--primary);
  }

  .deploy-trigger:hover {
    background-color: var(--surface-container-high);
    color: var(--primary);
  }

  .deploy-dialog {
    border: var(--border-width) solid var(--outline-variant);
    border-radius: var(--border-radius-lg, 16px);
    padding: 0;
    max-width: 420px;
    width: calc(100% - 2 * var(--space-lg));
    background: var(--surface-container);
    color: var(--on-surface);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
  }

  .deploy-dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }

  .deploy-modal-content {
    padding: var(--space-2xl);
  }

  .deploy-modal-content h3 {
    margin: 0 0 var(--space-md) 0;
    font-size: 1.25rem;
  }

  .deploy-modal-content p {
    margin: 0 0 var(--space-md) 0;
    color: var(--on-surface-variant);
    font-size: 14px;
  }

  .deploy-warning {
    background: var(--secondary-container, #fff3e0);
    color: var(--on-secondary-container, #e65100);
    padding: var(--space-md);
    border-radius: var(--border-radius);
    font-size: 13px;
  }

  .deploy-status {
    min-height: 20px;
    margin: var(--space-md) 0;
    font-size: 14px;
  }

  .deploy-status--loading {
    color: var(--on-surface-variant);
  }

  .deploy-status--success {
    color: var(--primary);
  }

  .deploy-status--error {
    color: var(--error);
  }

  .deploy-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  @media (max-width: 767px) {
    .sidebar-nav {
      flex-direction: column;
      overflow-y: auto;
    }

    .sidebar-link.active {
      border-left: none;
      border-bottom: 3px solid var(--primary);
    }
  }
</style>
