---
/**
 * Button component — Chromatic High-Contrast design system
 * 
 * Based on admin panel design:
 * - Semi-transparent backgrounds with backdrop-blur
 * - Subtle borders with opacity
 * - Rounded corners (0.25rem)
 * - Hover effects with scale transforms
 * - Material icons
 * 
 * Variants:
 * - primary: Cyan accent, semi-transparent bg
 * - secondary: Magenta accent, semi-transparent bg
 * - ghost: Transparent, hover shows border
 */

interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  disabled?: boolean;
  icon?: string;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  class: className = '',
  disabled = false,
  icon,
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={!href ? type : undefined}
  class:list={['btn', `btn--${variant}`, className]}
  disabled={disabled}
  aria-disabled={disabled}
>
  {icon && <span class="material-symbols-outlined btn-icon">{icon}</span>}
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: 12px 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 0px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    backdrop-filter: blur(8px);
  }

  .btn:hover {
    text-decoration: none;
    transform: scale(1.02);
  }

  .btn:active {
    transform: scale(0.98);
  }

  .btn-icon {
    font-size: 18px;
  }

  /* Primary: Cyan accent, semi-transparent bg */
  .btn--primary {
    background-color: rgba(130, 207, 255, 0.1);
    color: var(--primary);
    border: 1px solid rgba(130, 207, 255, 0.5);
  }

  .btn--primary:hover {
    background-color: rgba(130, 207, 255, 0.2);
    border-color: var(--primary);
  }

  /* Secondary: Magenta accent, semi-transparent bg */
  .btn--secondary {
    background-color: rgba(255, 176, 204, 0.1);
    color: var(--secondary);
    border: 1px solid rgba(255, 176, 204, 0.5);
  }

  .btn--secondary:hover {
    background-color: rgba(255, 176, 204, 0.2);
    border-color: var(--secondary);
  }

  /* Ghost: Transparent, hover shows border */
  .btn--ghost {
    background-color: transparent;
    color: var(--on-surface-variant);
    border: 1px solid transparent;
  }

  .btn--ghost:hover {
    color: var(--on-surface);
    border-color: var(--outline-variant);
    background-color: rgba(255, 255, 255, 0.03);
  }

  /* Disabled state */
  .btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
  }
</style>
