---
/**
 * Button component — Chromatic High-Contrast design system
 * 
 * Variants:
 * - primary: Solid Cyan background, Black text
 * - secondary: Black background, Magenta border, White text
 * - ghost: Transparent, White text, hover shows border
 * 
 * All buttons use Anton font, all-caps, sharp corners (0px radius)
 */

interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  disabled?: boolean;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  class: className = '',
  disabled = false,
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={!href ? type : undefined}
  class:list={['btn', `btn--${variant}`, className]}
  disabled={disabled}
  aria-disabled={disabled}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border: var(--border-width) solid transparent;
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .btn:hover {
    text-decoration: none;
  }

  /* Primary: Solid Cyan, Black text */
  .btn--primary {
    background-color: var(--primary);
    color: var(--on-primary);
    border-color: var(--primary);
  }

  .btn--primary:hover {
    background-color: var(--primary-container);
    border-color: var(--primary-container);
  }

  /* Secondary: Black bg, Magenta border, White text */
  .btn--secondary {
    background-color: transparent;
    color: var(--on-surface);
    border-color: var(--secondary);
  }

  .btn--secondary:hover {
    background-color: var(--secondary);
    color: var(--on-secondary);
  }

  /* Ghost: Transparent, White text, hover shows border */
  .btn--ghost {
    background-color: transparent;
    color: var(--on-surface);
    border-color: transparent;
  }

  .btn--ghost:hover {
    border-color: var(--on-surface);
  }

  /* Disabled state */
  .btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
</style>
