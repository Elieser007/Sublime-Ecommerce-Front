---
/**
 * Button component — Chromatic High-Contrast design system
 * 
 * Based on admin panel design:
 * - Semi-transparent backgrounds with backdrop-blur
 * - Subtle borders with opacity
 * - Sharp corners (0px radius)
 * - Hover effects with scale transforms
 * - Material icons
 * 
 * Variants:
 * - primary: Cyan accent, semi-transparent bg
 * - secondary: Magenta accent, semi-transparent bg
 * - ghost: Transparent, hover shows border
 */

interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  disabled?: boolean;
  icon?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  class: className = '',
  disabled = false,
  icon,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={!href ? type : undefined}
  class:list={['btn', `btn--${variant}`, className]}
  disabled={disabled}
  aria-disabled={disabled}
  {...rest}
>
  {icon && <span class="material-symbols-outlined btn-icon">{icon}</span>}
  <slot />
</Tag>


