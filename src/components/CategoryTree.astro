---
/**
 * CategoryTree — Recursive Category Component (Accessible ARIA Tree)
 * 
 * Renders a hierarchical category tree with collapsible levels.
 * Implements ARIA tree role with keyboard navigation (roving tabindex).
 * Used in desktop sidebar.
 */

interface Category {
  id: string;
  name: string;
  slug: string;
  children?: Category[];
}

interface Props {
  categories: Category[];
  level?: number;
  activeCategory?: string;
}

const { categories, level = 0, activeCategory } = Astro.props;

const isRoot = level === 0;
const treeId = `category-tree-${isRoot ? 'root' : Math.random().toString(36).slice(2, 9)}`;
---

<ul 
  role="tree" 
  id={treeId}
  class:list={['category-tree', { 'category-tree--root': isRoot }]}
  aria-label={isRoot ? 'Categorías de productos' : 'Subcategorías'}
>
  {categories.map((cat, index) => {
    const hasChildren = cat.children && cat.children.length > 0;
    const isActive = activeCategory === cat.id;
    const isFirst = index === 0;
    
    return (
      <li 
        role="treeitem" 
        class="category-tree-item"
        aria-level={level + 1}
        aria-selected={isActive}
        aria-expanded={hasChildren ? true : undefined}
        tabindex={isFirst || isActive ? 0 : -1}
      >
        <div class:list={['category-tree-row', { active: isActive }]}>
          {hasChildren && (
            <button 
              class="tree-toggle" 
              data-category-id={cat.id}
              aria-label={isActive ? `Colapsar ${cat.name}` : `Expandir ${cat.name}`}
              aria-expanded={false}
              aria-controls={`${cat.id}-sublist`}
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </button>
          )}
          {hasChildren ? (
            <span class="tree-spacer" aria-hidden="true"></span>
          ) : (
            <span class="tree-spacer tree-spacer--leaf" aria-hidden="true"></span>
          )}
          <span 
            class="tree-label"
            data-filter={cat.slug}
            role="button"
            tabindex="0"
            aria-selected={isActive}
          >
            {cat.name}
          </span>
        </div>
        
        {hasChildren && (
          <ul 
            role="group" 
            id={`${cat.id}-sublist`}
            class="category-sublist"
            aria-label={`Subcategorías de ${cat.name}`}
            hidden
          >
            {cat.children!.map((child) => (
              <li 
                role="treeitem" 
                class="category-tree-item"
                aria-level={level + 2}
                aria-selected={activeCategory === child.id}
                aria-expanded={child.children && child.children.length > 0 ? true : undefined}
                tabindex={-1}
              >
                <div class:list={['category-tree-row', { active: activeCategory === child.id }]}>
                  {child.children && child.children.length > 0 && (
                    <button 
                      class="tree-toggle" 
                      data-category-id={child.id}
                      aria-label={`Expandir ${child.name}`}
                      aria-expanded={false}
                      aria-controls={`${child.id}-sublist`}
                    >
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="6 9 12 15 18 9"/>
                      </svg>
                    </button>
                  )}
                  {child.children && child.children.length > 0 ? (
                    <span class="tree-spacer" aria-hidden="true"></span>
                  ) : (
                    <span class="tree-spacer tree-spacer--leaf" aria-hidden="true"></span>
                  )}
                  <span 
                    class="tree-label"
                    data-filter={child.slug}
                    role="button"
                    tabindex="0"
                    aria-selected={activeCategory === child.id}
                  >
                    {child.name}
                  </span>
                </div>
                
                {child.children && child.children.length > 0 && (
                  <ul 
                    role="group" 
                    id={`${child.id}-sublist`}
                    class="category-sublist"
                    aria-label={`Subcategorías de ${child.name}`}
                    hidden
                  >
                    {child.children.map((subChild) => (
                      <li 
                        role="treeitem" 
                        class="category-tree-item"
                        aria-level={level + 3}
                        aria-selected={activeCategory === subChild.id}
                        tabindex={-1}
                      >
                        <div class:list={['category-tree-row', { active: activeCategory === subChild.id }]}>
                          <span class="tree-spacer tree-spacer--leaf" aria-hidden="true"></span>
                          <span 
                            class="tree-label"
                            data-filter={subChild.slug}
                            role="button"
                            tabindex="0"
                            aria-selected={activeCategory === subChild.id}
                          >
                            {subChild.name}
                          </span>
                        </div>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        )}
      </li>
    );
  })}
</ul>

<script>
  // Client-side interactivity for tree toggle and keyboard navigation
  // NOTE: cannot use `treeId` (server-side variable) in hoisted <script>
  const tree = document.querySelector('.category-tree--root');
  
  if (tree) {
    // Toggle expand/collapse
    tree.addEventListener('click', (e) => {
      const toggle = e.target.closest('.tree-toggle');
      if (!toggle) return;
      
      e.stopPropagation();
      const categoryId = toggle.dataset.categoryId;
      const sublist = document.getElementById(`${categoryId}-sublist`);
      const isExpanded = !sublist.hidden;
      
      if (sublist) {
        sublist.hidden = isExpanded;
        toggle.setAttribute('aria-expanded', (!isExpanded).toString());
        toggle.setAttribute('aria-label', isExpanded ? `Colapsar ${toggle.dataset.categoryId}` : `Expandir ${toggle.dataset.categoryId}`);
      }
    });
    
    // Keyboard navigation - roving tabindex
    tree.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      const treeitem = target.closest('[role="treeitem"]');
      if (!treeitem) return;
      
      const items = Array.from(tree.querySelectorAll('[role="treeitem"]:not([hidden])'));
      const currentIndex = items.indexOf(treeitem);
      
      switch (e.key) {
        case 'ArrowDown':
          e.preventDefault();
          const nextItem = items[currentIndex + 1];
          if (nextItem) {
            treeitem.setAttribute('tabindex', '-1');
            nextItem.setAttribute('tabindex', '0');
            (nextItem.querySelector('.tree-label') as HTMLElement)?.focus();
          }
          break;
          
        case 'ArrowUp':
          e.preventDefault();
          const prevItem = items[currentIndex - 1];
          if (prevItem) {
            treeitem.setAttribute('tabindex', '-1');
            prevItem.setAttribute('tabindex', '0');
            (prevItem.querySelector('.tree-label') as HTMLElement)?.focus();
          }
          break;
          
        case 'Home':
          e.preventDefault();
          const firstItem = items[0];
          if (firstItem) {
            treeitem.setAttribute('tabindex', '-1');
            firstItem.setAttribute('tabindex', '0');
            (firstItem.querySelector('.tree-label') as HTMLElement)?.focus();
          }
          break;
          
        case 'End':
          e.preventDefault();
          const lastItem = items[items.length - 1];
          if (lastItem) {
            treeitem.setAttribute('tabindex', '-1');
            lastItem.setAttribute('tabindex', '0');
            (lastItem.querySelector('.tree-label') as HTMLElement)?.focus();
          }
          break;
          
        case 'ArrowRight':
          // Expand if collapsed and has children
          if (treeitem.getAttribute('aria-expanded') === 'false') {
            e.preventDefault();
            const toggle = treeitem.querySelector('.tree-toggle');
            toggle?.click();
          }
          break;
          
        case 'ArrowLeft':
          // Collapse if expanded, or move to parent
          if (treeitem.getAttribute('aria-expanded') === 'true') {
            e.preventDefault();
            const toggle = treeitem.querySelector('.tree-toggle');
            toggle?.click();
          } else {
            // Move to parent treeitem
            const parentTree = treeitem.closest('[role="group"]');
            if (parentTree) {
              const parentItem = parentTree.closest('[role="treeitem"]');
              if (parentItem) {
                e.preventDefault();
                treeitem.setAttribute('tabindex', '-1');
                parentItem.setAttribute('tabindex', '0');
                (parentItem.querySelector('.tree-label') as HTMLElement)?.focus();
              }
            }
          }
          break;
          
        case 'Enter':
        case ' ':
          // Select category
          if (target.classList.contains('tree-label')) {
            e.preventDefault();
            const filter = target.dataset.filter;
            if (filter) {
              window.dispatchEvent(new CustomEvent('category-select', { 
                detail: { category: filter } 
              }));
            }
          }
          break;
      }
    });
    
    // Label click/Enter to select
    tree.addEventListener('click', (e) => {
      const label = e.target.closest('.tree-label');
      if (label) {
        const filter = label.dataset.filter;
        if (filter) {
          // Update active state
          tree.querySelectorAll('.tree-label').forEach(l => l.classList.remove('active'));
          label.classList.add('active');
          
          tree.querySelectorAll('[role="treeitem"]').forEach(item => {
            item.setAttribute('aria-selected', 'false');
          });
          const treeitem = label.closest('[role="treeitem"]');
          treeitem?.setAttribute('aria-selected', 'true');
          
          window.dispatchEvent(new CustomEvent('category-select', { 
            detail: { category: filter } 
          }));
        }
      }
    });
  }
</script>

<style>
  .category-tree {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  
  .category-tree--root {
    padding-left: 0;
  }

  .category-tree-item {
    /* Base tree item */
  }

  .category-tree-row {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 6px var(--space-sm);
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .category-tree-row:hover {
    background-color: var(--surface-container-high);
  }

  .category-tree-row.active {
    background-color: var(--primary-container);
  }

  .category-tree-row.active .tree-label {
    color: var(--on-primary-container);
    font-weight: 600;
  }

  .tree-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    background: none;
    border: none;
    color: var(--outline);
    cursor: pointer;
    transition: transform 0.2s ease, color 0.15s ease;
    flex-shrink: 0;
  }

  .tree-toggle:hover {
    color: var(--primary);
  }

  .tree-toggle[aria-expanded="true"] {
    transform: rotate(180deg);
  }

  .tree-spacer {
    width: 18px;
    flex-shrink: 0;
  }

  .tree-spacer--leaf {
    width: 18px;
  }

  .tree-label {
    flex: 1;
    text-align: left;
    background: none;
    border: none;
    color: var(--on-surface-variant);
    cursor: pointer;
    padding: 0;
    font-family: var(--font-body);
    transition: color 0.15s ease;
    font-size: 14px;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tree-label:hover {
    color: var(--primary);
  }

  .tree-label.active {
    color: var(--primary);
    font-weight: 600;
  }

  .tree-label:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: -2px;
    border-radius: var(--border-radius);
  }

  .category-sublist {
    list-style: none;
    padding-left: 12px;
    margin: 0;
    border-left: 1px solid var(--outline-variant);
    margin-left: 9px;
    overflow: hidden;
  }

  .category-sublist[hidden] {
    display: none;
  }

  /* Focus visible for tree toggles */
  .tree-toggle:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
    border-radius: var(--border-radius);
  }

  /* Active state for root level */
  .category-tree--root > .category-tree-item > .category-tree-row.active {
    font-weight: 500;
  }
</style>