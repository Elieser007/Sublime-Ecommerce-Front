---
/**
 * Header component — Sublime E-commerce
 * 
 * New layout:
 * - Left: Logo
 * - Center: Search input + button
 * - Right: Wishlist, Cart, User
 * 
 * Session state handled client-side via auth-client.
 */

interface Props {
  cartCount?: number;
}

const { cartCount = 0 } = Astro.props;
---

<header class="header">
  <!-- CMYK accent bar at top -->
  <div class="cmyk-bar">
    <span></span><span></span><span></span>
  </div>

  <div class="header-inner">
    <!-- Logo + Nav Icons -->
    <div class="logo-nav">
      <a href="/" class="logo">
        <span class="logo-text">SUBLIME</span>
      </a>
      <nav class="logo-icons">
        <a href="/" class="logo-icon" aria-label="Inicio">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
        </a>
        <a href="/" class="logo-icon" aria-label="Tienda">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 01-8 0"/>
          </svg>
        </a>
      </nav>
    </div>

    <!-- Search -->
    <form class="search-form" action="/catalogo" method="GET">
      <input
        type="search"
        name="q"
        class="search-input"
        placeholder="Buscar productos..."
        id="search-input"
      />
      <button type="submit" class="search-btn" aria-label="Buscar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>
    </form>

    <!-- Actions -->
    <div class="header-actions">
      <!-- Wishlist -->
      <a href="/deseos" class="action-btn" aria-label="Lista de deseos" id="wishlist-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span class="badge" id="wishlist-count" style="display: none;">0</span>
      </a>

      <!-- Cart -->
      <a href="/cart" class="action-btn" aria-label="Carrito de compras" id="cart-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        <span class="badge" id="cart-count">0</span>
      </a>

      <!-- User -->
      <a href="/login" class="action-btn" aria-label="Mi cuenta" id="user-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </a>

      <!-- Mobile Menu Toggle -->
      <button class="menu-toggle" aria-label="Abrir menú" id="menu-toggle">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Nav -->
  <nav class="nav-mobile" id="nav-mobile">
    <a href="/" class="nav-link">Home</a>
    <a href="/" class="nav-link">Shop</a>
    <a href="/login" class="nav-link" id="nav-auth-mobile">Iniciar Sesión</a>
  </nav>
</header>

<!-- Spacer for fixed header -->
<div class="header-spacer"></div>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('nav-mobile');
  
  toggle?.addEventListener('click', () => {
    nav?.classList.toggle('open');
    toggle?.classList.toggle('open');
  });

  // Cart count from LocalStorage
  function updateCartCount() {
    const cart = JSON.parse(localStorage.getItem('cart') || '[]');
    const total = cart.reduce((sum: number, item: any) => sum + item.quantity, 0);
    const badge = document.getElementById('cart-count');
    if (badge) {
      badge.textContent = total.toString();
      badge.style.display = total > 0 ? '' : 'none';
    }
  }
  updateCartCount();
  window.addEventListener('storage', updateCartCount);

  // Session check — update user icon
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
  
  async function checkSession() {
    try {
      const res = await fetch(`${API_URL}/api/me`, { credentials: 'include' });
      
      if (res.ok) {
        const data = await res.json();
        const userBtn = document.getElementById('user-btn');
        if (userBtn) {
          userBtn.href = '/dashboard';
        }
      }
    } catch {
      // Not logged in — keep login link
    }
  }

  checkSession();
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: var(--surface);
  }

  .header-spacer {
    height: 72px;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: var(--space-lg);
    padding: 0 var(--margin-mobile);
  }

  @media (min-width: 768px) {
    .header-inner {
      padding: 0 var(--margin-desktop);
    }
  }

  /* Logo + Nav Icons */
  .logo-nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-shrink: 0;
  }

  .logo {
    text-decoration: none;
    color: var(--on-surface);
  }

  .logo:hover {
    text-decoration: none;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: 28px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .logo-icons {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-left: var(--space-lg);
    border-left: var(--border-width) solid var(--outline-variant);
  }

  .logo-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--on-surface-variant);
    text-decoration: none;
    border-radius: var(--border-radius);
    transition: all 0.15s ease;
  }

  .logo-icon:hover {
    color: var(--primary);
    background-color: var(--surface-container);
    text-decoration: none;
  }

  /* Search */
  .search-form {
    display: flex;
    flex: 1;
    max-width: 500px;
  }

  .search-input {
    flex: 1;
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--on-surface);
    background-color: var(--surface-container);
    border: var(--border-width) solid var(--outline-variant);
    border-right: none;
    border-radius: var(--border-radius) 0 0 var(--border-radius);
    outline: none;
  }

  .search-input::placeholder {
    color: var(--outline);
  }

  .search-input:focus {
    border-color: var(--primary);
  }

  .search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-md);
    background-color: var(--primary);
    color: var(--on-primary);
    border: var(--border-width) solid var(--primary);
    border-radius: 0 var(--border-radius) var(--border-radius) 0;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .search-btn:hover {
    background-color: var(--primary-container);
  }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
  }

  .action-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--on-surface);
    text-decoration: none;
    border-radius: var(--border-radius);
    transition: all 0.15s ease;
  }

  .action-btn:hover {
    background-color: var(--surface-container);
    color: var(--primary);
    text-decoration: none;
  }

  .badge {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--on-secondary);
    background-color: var(--secondary);
    border-radius: var(--border-radius);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Mobile Menu Toggle */
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-sm);
  }

  .menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--on-surface);
    transition: all 0.2s ease;
  }

  .menu-toggle.open span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .menu-toggle.open span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.open span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  @media (max-width: 767px) {
    .search-form {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .action-btn:nth-child(1) {
      display: none;
    }
  }

  /* Mobile Nav */
  .nav-mobile {
    display: none;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-lg) var(--margin-mobile);
    background-color: var(--surface);
    border-top: var(--border-width) solid var(--outline-variant);
  }

  .nav-mobile.open {
    display: flex;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--on-surface-variant);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--primary);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .nav-mobile {
      display: none !important;
    }
  }
</style>
