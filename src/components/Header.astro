---
/**
 * Header component — Sublime E-commerce
 *
 * Layout:
 * - Left: Logo + dynamic nav icon (home or storefront)
 * - Center: Search input + button
 * - Right: Wishlist, Cart, User
 *
 * Dynamic icon logic:
 * - On catalog (`/` or `/producto/*`) → home icon → links to `/home`
 * - Everywhere else → storefront icon → links to `/`
 */

interface Props {
  cartCount?: number;
}

const { cartCount = 0 } = Astro.props;
import Logo from "./Logo.astro";

const currentPath = Astro.url.pathname;
const isCatalog = currentPath === '/' || currentPath.startsWith('/producto');
---

<header class="header">
  <!-- CMYK accent bar at top -->
  <div class="cmyk-bar">
    <span></span><span></span><span></span>
  </div>

  <div class="header-inner">
    <!-- Logo + Nav Icon (dynamic: home or storefront) -->
    <div class="logo-nav">
      <a href="/" class="logo" aria-label="Sublime — Inicio"> <Logo /> </a>
      <nav class="logo-icons">
        {isCatalog ? (
          <a href="/home" class="logo-icon" aria-label="Ir al inicio">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          </a>
        ) : (
          <a href="/" class="logo-icon" aria-label="Ir a la tienda">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9l1.5-4.5A2 2 0 016.4 3h11.2a2 2 0 011.9 1.5L21 9"></path>
              <path d="M3 9h18v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
              <path d="M9 21V13h6v8"></path>
            </svg>
          </a>
        )}
      </nav>
    </div>

    <!-- Search -->
    <form class="search-form" action="/" method="GET">
      <input
        type="search"
        name="q"
        class="search-input"
        placeholder="Buscar productos..."
        id="search-input"
      />
      <button type="submit" class="search-btn" aria-label="Buscar">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </form>

    <!-- Actions -->
    <div class="header-actions">
      <!-- Wishlist -->
      <a
        href="/deseos"
        class="action-btn"
        aria-label="Lista de deseos"
        id="wishlist-btn"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
          ></path>
        </svg>
        <span class="badge" id="wishlist-count" style="display: none;">0</span>
      </a>

      <!-- Cart -->
      <a
        href="/cart"
        class="action-btn"
        aria-label="Carrito de compras"
        id="cart-btn"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 01-8 0"></path>
        </svg>
        <span class="badge" id="cart-count">0</span>
      </a>

      <!-- User -->
      <a href="/login" class="action-btn" aria-label="Mi cuenta" id="user-btn">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>

      <!-- Mobile Search Toggle -->
      <button class="search-toggle" aria-label="Buscar" id="search-toggle">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Mobile Menu Toggle -->
      <button class="menu-toggle" aria-label="Abrir menú" id="menu-toggle">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Search Overlay -->
  <div class="search-overlay" id="search-overlay">
    <form class="search-overlay-form" action="/" method="GET">
      <input
        type="search"
        name="q"
        class="search-overlay-input"
        placeholder="Buscar productos..."
        id="search-overlay-input"
        autocomplete="off"
      />
      <button type="submit" class="search-overlay-submit" aria-label="Buscar">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
      <button type="button" class="search-overlay-close" id="search-overlay-close" aria-label="Cerrar búsqueda">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </form>
  </div>

  <!-- Mobile Nav -->
  <nav class="nav-mobile" id="nav-mobile">
    <a href="/home" class="nav-link">Home</a>
    <a href="/" class="nav-link">Tienda</a>
    <a href="/login" class="nav-link" id="nav-auth-mobile">Iniciar Sesión</a>
  </nav>
</header>

<!-- Spacer for fixed header -->
<div class="header-spacer"></div>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("nav-mobile");

  toggle?.addEventListener("click", () => {
    nav?.classList.toggle("open");
    toggle?.classList.toggle("open");
  });

  // Mobile search overlay
  const searchToggle = document.getElementById("search-toggle");
  const searchOverlay = document.getElementById("search-overlay");
  const searchOverlayClose = document.getElementById("search-overlay-close");
  const searchOverlayInput = document.getElementById("search-overlay-input") as HTMLInputElement;

  searchToggle?.addEventListener("click", () => {
    searchOverlay?.classList.add("open");
    document.body.style.overflow = "hidden";
    setTimeout(() => searchOverlayInput?.focus(), 100);
  });

  function closeSearchOverlay() {
    searchOverlay?.classList.remove("open");
    document.body.style.overflow = "";
  }

  searchOverlayClose?.addEventListener("click", closeSearchOverlay);

  // Listen for custom event from catalog page (respects component boundary)
  window.addEventListener("search-overlay-close", closeSearchOverlay);

  searchOverlay?.addEventListener("click", (e) => {
    if (e.target === searchOverlay) closeSearchOverlay();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && searchOverlay?.classList.contains("open")) {
      closeSearchOverlay();
    }
  });

  // Cart count from LocalStorage
  function updateCartCount() {
    const cart = JSON.parse(localStorage.getItem("cart") || "[]");
    const total = cart.reduce(
      (sum: number, item: any) => sum + item.quantity,
      0,
    );
    const badge = document.getElementById("cart-count");
    if (badge) {
      badge.textContent = total.toString();
      badge.style.display = total > 0 ? "" : "none";
    }
  }
  updateCartCount();
  window.addEventListener("storage", updateCartCount);
  window.addEventListener("cart-updated", updateCartCount);

  // Session check — update user icon
  const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8787";

  async function checkSession() {
    try {
      const res = await fetch(`${API_URL}/api/me`, { credentials: "include" });

      if (res.ok) {
        const data = await res.json();
        const userBtn = document.getElementById("user-btn");
        if (userBtn) {
          userBtn.href = "/dashboard";
        }
      }
    } catch {
      // Not logged in — keep login link
    }
  }

  checkSession();
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: var(--surface);
  }

  .header-spacer {
    height: 72px;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: var(--space-lg);
    padding: 0 var(--margin-mobile);
  }

  @media (min-width: 768px) {
    .header-inner {
      padding: 0 var(--margin-desktop);
    }
  }

  /* Logo + Nav Icons */
  .logo-nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-shrink: 0;
  }

  .logo {
    text-decoration: none;
    color: var(--on-surface);
    display: flex;
    align-items: center;
  }

  .logo:hover {
    text-decoration: none;
  }

  .logo-icons {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-left: var(--space-lg);
    border-left: var(--border-width) solid var(--outline-variant);
  }

  .logo-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--on-surface-variant);
    text-decoration: none;
    border-radius: var(--border-radius);
    transition: all 0.15s ease;
  }

  .logo-icon:hover {
    color: var(--primary);
    background-color: var(--surface-container);
    text-decoration: none;
  }

  /* Search */
  .search-form {
    display: flex;
    flex: 1;
    max-width: 500px;
  }

  .search-input {
    flex: 1;
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--on-surface);
    background-color: var(--surface-container);
    border: var(--border-width) solid var(--outline-variant);
    border-right: none;
    border-radius: var(--border-radius) 0 0 var(--border-radius);
    outline: none;
  }

  .search-input::placeholder {
    color: var(--outline);
  }

  .search-input:focus {
    border-color: var(--primary);
  }

  .search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-md);
    background-color: var(--primary);
    color: var(--on-primary);
    border: var(--border-width) solid var(--primary);
    border-radius: 0 var(--border-radius) var(--border-radius) 0;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .search-btn:hover {
    background-color: var(--primary-container);
  }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
  }

  .action-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--on-surface);
    text-decoration: none;
    border-radius: var(--border-radius);
    transition: all 0.15s ease;
  }

  .action-btn:hover {
    background-color: var(--surface-container);
    color: var(--primary);
    text-decoration: none;
  }

  .badge {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--on-secondary);
    background-color: var(--secondary);
    border-radius: var(--border-radius);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Mobile Search Toggle */
  .search-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    color: var(--on-surface);
    cursor: pointer;
    border-radius: var(--border-radius);
  }

  .search-toggle:hover {
    background-color: var(--surface-container);
  }

  /* Search Overlay */
  .search-overlay {
    position: fixed;
    inset: 0;
    top: 72px;
    background-color: var(--surface);
    z-index: 150;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .search-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .search-overlay-form {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--margin-mobile);
    border-bottom: var(--border-width) solid var(--outline-variant);
  }

  .search-overlay-input {
    flex: 1;
    padding: var(--space-md);
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--on-surface);
    background-color: var(--surface-container);
    border: var(--border-width) solid var(--outline-variant);
    border-radius: var(--border-radius);
    outline: none;
  }

  .search-overlay-input:focus {
    border-color: var(--primary);
  }

  .search-overlay-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: var(--primary);
    color: var(--on-primary);
    border: var(--border-width) solid var(--primary);
    cursor: pointer;
    flex-shrink: 0;
  }

  .search-overlay-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: none;
    border: var(--border-width) solid var(--outline-variant);
    color: var(--on-surface);
    cursor: pointer;
    flex-shrink: 0;
  }

  /* Mobile Menu Toggle */
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-sm);
  }

  .menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--on-surface);
    transition: all 0.2s ease;
  }

  .menu-toggle.open span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .menu-toggle.open span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.open span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  @media (max-width: 767px) {
    .search-form {
      display: none;
    }

    .search-toggle {
      display: flex;
    }

    .menu-toggle {
      display: flex;
    }

    /* Hide wishlist on mobile */
    #wishlist-btn {
      display: none;
    }
  }

  /* Mobile Nav */
  .nav-mobile {
    display: none;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-lg) var(--margin-mobile);
    background-color: var(--surface);
    border-top: var(--border-width) solid var(--outline-variant);
  }

  .nav-mobile.open {
    display: flex;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--on-surface-variant);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--primary);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .nav-mobile {
      display: none !important;
    }
  }
</style>
