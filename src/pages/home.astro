---
/**
 * Homepage — Sublime E-commerce
 * 
 * Hero section + featured products grid (loaded client-side).
 * Dark theme, CMYK accents, sharp corners.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Chip from '../components/Chip.astro';
---

<BaseLayout title="Sublime E-commerce — Arte & Diseño">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <Chip variant="primary">Nuevo Drop</Chip>
        <h1 class="hero-title display-lg">
          Arte &<br/>Diseño
        </h1>
        <p class="hero-subtitle body-lg">
          Productos únicos para mentes creativas. Calidad que se nota, estilo que se siente.
        </p>
        <div class="hero-actions">
          <a href="/" class="btn btn--primary">Ver Catálogo</a>
          <a href="https://wa.me/595991969608" class="btn btn--secondary" target="_blank" rel="noopener">
            Contactar por WhatsApp
          </a>
        </div>
      </div>

      <!-- CMYK decorative element -->
      <div class="hero-cmyk">
        <div class="cmyk-bar cmyk-bar--lg">
          <span></span><span></span><span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="featured section">
    <div class="container">
      <div class="section-header">
        <h2 class="headline-lg-mobile">Destacados</h2>
        <a href="/" class="label-sm section-link">Ver todo →</a>
      </div>

      <!-- Loading state -->
      <div id="featured-loading" class="products-grid grid">
        {[1,2,3,4].map((i) => (
          <div class="product-skeleton" key={i}>
            <div class="skeleton-image"></div>
            <div class="skeleton-text"></div>
            <div class="skeleton-text skeleton-text--short"></div>
          </div>
        ))}
      </div>

      <!-- Featured grid rendered by JS -->
      <div id="featured-grid" class="products-grid grid" style="display: none;"></div>

      <!-- Error state -->
      <div id="featured-error" style="display: none; text-align: center; padding: 48px 0;">
        <p class="body-lg" style="color: var(--on-surface-variant); margin-bottom: 16px;">
          Error al cargar productos destacados
        </p>
        <button class="btn btn--primary" id="retry-featured">Reintentar</button>
      </div>

      <!-- Empty state -->
      <div id="featured-empty" style="display: none; text-align: center; padding: 48px 0;">
        <p class="body-lg" style="color: var(--on-surface-variant);">No hay productos destacados</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../components/product-card.js';
  import {
    fetchFeaturedProducts,
    formatPrice,
    getProductImageUrl,
  } from '../lib/public-api';

  const $loading = document.getElementById('featured-loading');
  const $grid = document.getElementById('featured-grid');
  const $error = document.getElementById('featured-error');
  const $empty = document.getElementById('featured-empty');
  const $retry = document.getElementById('retry-featured');

  async function loadFeatured() {
    try {
      $loading.style.display = '';
      $grid.style.display = 'none';
      $error.style.display = 'none';
      $empty.style.display = 'none';

      const products = await fetchFeaturedProducts();

      $loading.style.display = 'none';

      if (!products || products.length === 0) {
        $empty.style.display = '';
        return;
      }

      // Render product cards using Web Component
      $grid.innerHTML = '';
      for (const product of products) {
        const imageUrl = getProductImageUrl(product.image_url);
        const card = document.createElement('product-card');
        card.setAttribute('product', JSON.stringify({
          id: product.id,
          slug: product.slug,
          name: product.name,
          price: product.base_price,
          image: imageUrl,
          category: product.section_name,
          price_tiers: product.price_tiers || [],
        }));
        $grid.appendChild(card);
      }
      $grid.style.display = '';

    } catch (err) {
      $loading.style.display = 'none';
      $error.style.display = '';
      console.error('Error loading featured:', err);
    }
  }

  $retry?.addEventListener('click', loadFeatured);
  loadFeatured();
</script>

<style>
  /* Hero */
  .hero { padding: var(--space-4xl) 0 var(--space-3xl); }
  .hero-content { display: flex; flex-direction: column; gap: var(--space-lg); max-width: 600px; }
  .hero-title { color: var(--on-surface); margin: var(--space-md) 0; }
  .hero-subtitle { color: var(--on-surface-variant); }
  .hero-actions { display: flex; flex-direction: column; gap: var(--space-md); margin-top: var(--space-md); }
  @media (min-width: 768px) { .hero-actions { flex-direction: row; } }
  .hero-cmyk { margin-top: var(--space-3xl); }
  .cmyk-bar--lg { height: 8px; }

  /* Featured Section */
  .section-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: var(--space-xl); }
  .section-link { color: var(--primary); text-decoration: none; }
  .section-link:hover { text-decoration: underline; }
  .products-grid { grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 768px) { .products-grid { grid-template-columns: repeat(4, 1fr); } }

  /* Loading skeletons */
  .product-skeleton { border: var(--border-width) solid var(--outline-variant); }
  .skeleton-image {
    aspect-ratio: 1;
    background-color: var(--surface-container);
    animation: pulse 1.5s ease-in-out infinite;
  }
  .skeleton-text {
    height: 16px; margin: var(--space-sm);
    background-color: var(--surface-container);
    animation: pulse 1.5s ease-in-out infinite;
  }
  .skeleton-text--short { width: 60%; }
  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
</style>
