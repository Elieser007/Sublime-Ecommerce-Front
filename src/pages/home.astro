---
/**
 * Homepage — Sublime E-commerce
 * 
 * Hero section + featured products grid (SSG — fetched at build time).
 * Dark theme, CMYK accents, sharp corners.
 */

import { formatPrice, getProductImageUrl } from '../lib/public-api';
import { getApiUrl } from '../lib/api-url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Chip from '../components/Chip.astro';
import Button from '../components/Button.astro';

const API_URL = getApiUrl();

// Fetch featured products at build time
let featuredProducts: any[] = [];
try {
  const res = await fetch(`${API_URL}/api/public/products/featured`);
  if (res.ok) {
    const data = await res.json();
    featuredProducts = data.products || [];
  }
} catch (err) {
  console.error('Error fetching featured products at build time:', err);
}
---

<BaseLayout title="Sublime E-commerce — Arte & Diseño">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <Chip variant="primary">Nuevo Drop</Chip>
        <h1 class="hero-title display-lg">
          Arte &<br/>Diseño
        </h1>
        <p class="hero-subtitle body-lg">
          Productos únicos para mentes creativas. Calidad que se nota, estilo que se siente.
        </p>
        <div class="hero-actions">
          <Button href="/" variant="primary">Ver Catálogo</Button>
          <Button href="https://wa.me/595991969608" variant="secondary" target="_blank" rel="noopener">
            Contactar por WhatsApp
          </Button>
        </div>
      </div>

      <!-- CMYK decorative element -->
      <div class="hero-cmyk">
        <div class="cmyk-bar cmyk-bar--lg">
          <span></span><span></span><span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="featured section">
    <div class="container">
      <div class="section-header">
        <h2 class="headline-lg-mobile">Destacados</h2>
        <a href="/" class="label-sm section-link">Ver todo →</a>
      </div>

      {featuredProducts.length > 0 ? (
        <div class="products-grid grid" id="featured-grid">
          {featuredProducts.map((product) => {
            const imageUrl = getProductImageUrl(product.image_url);
            return (
              <div class="product-wrapper">
                <product-card
                  product={JSON.stringify({
                    id: product.id,
                    slug: product.slug,
                    name: product.name,
                    price: product.base_price,
                    image: imageUrl,
                    category: product.section_name,
                    price_tiers: product.price_tiers || [],
                    has_variants: !!product.has_variants,
                  })}
                />
              </div>
            );
          })}
        </div>
      ) : (
        <div style="text-align: center; padding: 48px 0;">
          <p class="body-lg" style="color: var(--on-surface-variant);">No hay productos destacados</p>
        </div>
      )}
    </div>
  </section>

  <!-- Initialize product-card Web Components -->
  <script is:inline>
    document.querySelectorAll('product-card').forEach((el) => {
      const attr = el.getAttribute('product');
      if (attr) {
        try {
          const data = JSON.parse(attr);
          el.product = data;
        } catch (e) {}
      }
    });
  </script>
</BaseLayout>

<style>
  /* Hero */
  .hero { padding: var(--space-4xl) 0 var(--space-3xl); }
  .hero-content { display: flex; flex-direction: column; gap: var(--space-lg); max-width: 600px; }
  .hero-title { color: var(--on-surface); margin: var(--space-md) 0; }
  .hero-subtitle { color: var(--on-surface-variant); }
  .hero-actions { display: flex; flex-direction: column; gap: var(--space-md); margin-top: var(--space-md); }
  @media (min-width: 768px) { .hero-actions { flex-direction: row; } }
  .hero-cmyk { margin-top: var(--space-3xl); }
  .cmyk-bar--lg { height: 8px; }

  /* Featured Section */
  .section-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: var(--space-xl); }
  .section-link { color: var(--primary); text-decoration: none; }
  .section-link:hover { text-decoration: underline; }
  .products-grid { grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 768px) { .products-grid { grid-template-columns: repeat(4, 1fr); } }
</style>
