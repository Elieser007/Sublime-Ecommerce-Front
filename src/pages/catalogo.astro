---
/**
 * Catálogo page — Sublime E-commerce
 * 
 * Product catalog with category filter and search.
 * Uses ProductGrid, CategoryFilter, SearchBar components.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import SearchBar from '../components/SearchBar.astro';

// Placeholder categories and products
const categories = ['Ropa', 'Arte', 'Accesorios', 'Estampados'];

const products = [
  { id: '1', name: 'Camiseta Sublime Básica', price: 120000, image: '/placeholder-product.svg', category: 'Ropa' },
  { id: '2', name: 'Estampa CMYK Edición Limitada', price: 250000, image: '/placeholder-product.svg', category: 'Arte' },
  { id: '3', name: 'Tote Bag Sublime', price: 85000, image: '/placeholder-product.svg', category: 'Accesorios' },
  { id: '4', name: 'Poster High Contrast', price: 95000, image: '/placeholder-product.svg', category: 'Arte' },
  { id: '5', name: 'Camiseta Oversized Negra', price: 150000, image: '/placeholder-product.svg', category: 'Ropa' },
  { id: '6', name: 'Estampa Magenta Glow', price: 180000, image: '/placeholder-product.svg', category: 'Arte' },
  { id: '7', name: 'Gorra Sublime Logo', price: 75000, image: '/placeholder-product.svg', category: 'Accesorios' },
  { id: '8', name: 'Remera Estampada Cyan', price: 130000, image: '/placeholder-product.svg', category: 'Estampados' },
];
---

<BaseLayout title="Catálogo — Sublime E-commerce">
  <section class="catalog">
    <div class="container">
      <!-- Header -->
      <div class="catalog-header">
        <h1 class="headline-lg-mobile">Catálogo</h1>
        <p class="body-lg catalog-subtitle">
          Explora nuestra colección de productos únicos.
        </p>
      </div>

      <!-- Filters -->
      <div class="catalog-filters">
        <SearchBar placeholder="Buscar productos..." />
        <CategoryFilter categories={categories} />
      </div>

      <!-- Products Grid -->
      <ProductGrid products={products} />

      <!-- Empty state (hidden by default) -->
      <div class="empty-state" id="catalog-empty" style="display: none;">
        <p class="body-lg">No se encontraron productos.</p>
        <a href="/catalogo" class="btn btn--secondary">Limpiar filtros</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .catalog {
    padding: var(--space-3xl) 0;
  }

  .catalog-header {
    margin-bottom: var(--space-2xl);
  }

  .catalog-header h1 {
    color: var(--on-surface);
    margin-bottom: var(--space-sm);
  }

  .catalog-subtitle {
    color: var(--on-surface-variant);
  }

  .catalog-filters {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .catalog-filters {
      flex-direction: row;
      align-items: center;
    }
  }

  .empty-state {
    text-align: center;
    padding: var(--space-4xl) 0;
  }

  .empty-state p {
    color: var(--on-surface-variant);
    margin-bottom: var(--space-lg);
  }
</style>
