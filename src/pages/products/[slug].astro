---
/**
 * Product Detail — /products/[slug]
 *
 * SSG: pre-rendered at build time via getStaticPaths().
 * Product data comes from Astro.props (build-time fetch).
 * Variant selection remains client-side (fetched on interaction).
 * Add-to-cart uses LocalStorage. WhatsApp checkout with tier info.
 */

import { getProductImageUrl } from '../../lib/public-api';
import { formatPrice } from '../../lib/public-api';
import { getApiUrl } from '../../lib/api-url';
import { getRelatedProducts } from '../../lib/product-related';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PriceTierList from '../../components/PriceTierList.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import Button from '../../components/Button.astro';

const API_URL = getApiUrl();

export async function getStaticPaths() {
  const apiUrl = getApiUrl();

  try {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 10000);

    const listRes = await fetch(`${apiUrl}/api/public/products?limit=1000`, {
      signal: controller.signal,
    });
    clearTimeout(timeout);

    if (!listRes.ok) {
      console.warn(`[getStaticPaths] API returned ${listRes.status} — skipping product pages`);
      return [];
    }

    const listData = await listRes.json();
    const products = listData.data || [];

    // NOTE: This uses an N+1 fetch pattern (1 list + N detail requests).
    // Acceptable for ~500 products with daily deploys. The backend's
    // /api/public/products endpoint doesn't return full product details
    // (images, variants, all price tiers), so individual fetches are needed.
    // If product count grows beyond 1000, consider adding a batch endpoint
    // to the backend that returns all products with full details.
    const paths = [];
    for (const product of products) {
      const detailRes = await fetch(`${apiUrl}/api/public/products/slug/${product.slug}`);
      if (!detailRes.ok) continue;
      const detailData = await detailRes.json();
      paths.push({
        params: { slug: product.slug },
        props: {
          product: detailData.product,
          // Build-time recommendations from the in-memory list (D6/REQ-10):
          // deterministic, zero runtime fetches.
          related: getRelatedProducts(products, product.slug, product.section_slug || ''),
        },
      });
    }

    return paths;
  } catch (err) {
    console.warn(`[getStaticPaths] API unreachable at ${apiUrl} — skipping product pages`);
    return [];
  }
}

const { product, related = [] } = Astro.props;

// Pre-compute values for template
const primaryImage = product.images && product.images.length > 0
  ? product.images.find((img: any) => img.is_primary) || product.images[0]
  : null;
const imageUrl = getProductImageUrl(primaryImage?.url);
const breadcrumbs = [
  product.section_name,
  product.category_name,
  product.subcategory_name,
].filter(Boolean).join(' / ') || 'Producto';
const tiers = product.price_tiers || [];
const basePriceFormatted = formatPrice(product.base_price);
---

<BaseLayout title={`${product.name} — Sublime`}>
  <!-- Product detail — pre-rendered with build-time data -->
  <div id="detail-content" class="detail-section">
    <div class="detail-layout">
      <!-- Image Gallery -->
      <div class="detail-image-container">
        {product.images && product.images.length > 0 ? (
          <ProductGallery images={product.images} alt={product.name} />
        ) : (
          <img id="detail-image" class="detail-image" src={imageUrl} alt={product.name} width="600" height="600" />
        )}
      </div>

      <!-- Info -->
      <div class="detail-info">
        <!-- Breadcrumb -->
        <nav class="detail-breadcrumb body-sm" id="detail-breadcrumb">{breadcrumbs}</nav>

        <h1 class="detail-name headline-lg-mobile" id="detail-name">{product.name}</h1>
        <p class="detail-price headline-xl" id="detail-price">Gs. {basePriceFormatted}</p>
        
        <!-- Volume Price Tier Table -->
        <div id="volume-price-section">
          {tiers.length > 0 && (
            <PriceTierList priceTiers={tiers} selectedQty={1} basePrice={product.base_price} />
          )}
        </div>

        <!-- Variant Selector (attribute modules — loaded client-side) -->
        <div id="variant-section"></div>
        
        <!-- Quantity Stepper (shows when tier selected) -->
        <div id="quantity-stepper-section" class="quantity-stepper-section" style={tiers.length > 0 ? "display: block;" : "display: none;"}>
          <label class="quantity-label label-sm">Cantidad</label>
          <number-input data-value="1" data-min="1" data-max="999" data-label="Cantidad"></number-input>
        </div>

        <div class="detail-description body-lg" id="detail-description">
          {product.description && <span>{product.description}</span>}
        </div>

        <div class="detail-actions">
          <Button variant="primary" size="lg" class="detail-add-btn" id="detail-add-cart">
            Agregar al carrito
          </Button>
          <Button variant="secondary" size="lg" id="detail-whatsapp" href="#" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
              <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/>
            </svg>
            Comprar por WhatsApp
          </Button>
        </div>
      </div>
    </div>

    <!-- Related products (D6): static same-section recommendations from build time -->
    {related.length > 0 && (
      <section id="related-products" class="related-products">
        <h2 class="related-products__title">Productos relacionados</h2>
        <div class="related-products__grid">
          {related.map((relatedProduct: any) => (
            <product-card
              product={JSON.stringify({
                id: relatedProduct.id,
                slug: relatedProduct.slug,
                name: relatedProduct.name,
                price: relatedProduct.base_price,
                image: getProductImageUrl(relatedProduct.image_url),
                category: relatedProduct.section_name,
                price_tiers: relatedProduct.price_tiers || [],
                has_variants: !!relatedProduct.has_variants,
              })}
            />
          ))}
        </div>
      </section>
    )}
  </div>

  <!-- Inject build-time product data for client-side script -->
  <script is:inline set:html={`window.__PRODUCT_DATA__ = ${JSON.stringify(product).replace(/<\//g, '<\\/')};`} />
</BaseLayout>

<script>
  import {
    formatPrice,
    getProductImageUrl,
  } from '../../lib/public-api';
  import { getTierPrice, getTierForQuantity } from '../../lib/price-utils';
  import { buildCartMessage } from '../../lib/whatsapp';
  import { computeFinalPrice, isSelectionComplete } from '../../lib/variant-logic';
  import { addToCartWithOptions, updateCartBadge } from '../../lib/cart.js';
  import { getApiUrl } from '../../lib/api-url';

  const API_URL = getApiUrl();

  const $variantSection = document.getElementById('variant-section');
  const $qtySection = document.getElementById('quantity-stepper-section');
  const $numberInput = $qtySection?.querySelector('number-input') as any;
  const $addCart = document.getElementById('detail-add-cart');
  const $whatsappBtn = document.getElementById('detail-whatsapp');
  const $price = document.getElementById('detail-price');

  const currentProduct: any = (window as any).__PRODUCT_DATA__;
  let currentTiers: any[] = currentProduct?.price_tiers || [];
  let selectedTier: any = null;
  let selectedQty = 1;
  let currentVariantModules: any[] = [];
  let variantFinalPrice: number | null = null;
  let selectedAttributesMap = new Map<string, string>();
  let selectedModifiersMap = new Map<string, number>();

  let $variantSelector: any = null;

  function renderVariantSelector() {
    $variantSelector = document.createElement('variant-selector');
    $variantSelector.setAttribute('modules', JSON.stringify(currentVariantModules));
    $variantSelector.setAttribute('selected', JSON.stringify(Object.fromEntries(selectedAttributesMap)));
    $variantSection.appendChild($variantSelector);

    $variantSelector.addEventListener('variant-change', ((e: CustomEvent) => {
      const { moduleId, valueId, priceModifier } = e.detail;
      selectedAttributesMap.set(moduleId, valueId);
      selectedModifiersMap.set(moduleId, priceModifier);

      const baseForTier = selectedTier ? selectedTier.price : currentProduct.base_price;
      const modifiers = Array.from(selectedModifiersMap.values());
      variantFinalPrice = computeFinalPrice(baseForTier, modifiers);

      const complete = isSelectionComplete(currentVariantModules, selectedAttributesMap);
      if ($addCart) $addCart.disabled = !complete;

      updatePriceDisplay();
      refreshVariants();
    }) as EventListener);
  }

  function buildSelectedParam(): Record<string, string> {
    const selected: Record<string, string> = {};
    for (const [moduleId, valueId] of selectedAttributesMap) {
      const mod = currentVariantModules.find((m: any) => m.module_id === moduleId);
      if (!mod) continue;
      const val = mod.values.find((v: any) => v.value_id === valueId);
      if (val) {
        selected[mod.slug] = val.raw_value;
      }
    }
    return selected;
  }

  async function refreshVariants() {
    const selected = buildSelectedParam();
    await loadVariants(currentProduct.id, selected);
  }

  async function loadVariants(productId: string, selected?: Record<string, string>) {
    try {
      let url = `${API_URL}/api/public/products/${productId}/variants`;
      if (selected && Object.keys(selected).length > 0) {
        url += `?selected=${encodeURIComponent(JSON.stringify(selected))}`;
      }
      const res = await fetch(url);
      if (!res.ok) return;

      const json = await res.json();
      const modules = json.data?.available_modules || json.available_modules || [];

      if (modules.length === 0) {
        $variantSection.innerHTML = '';
        return;
      }

      currentVariantModules = modules;
      variantFinalPrice = json.data?.final_price ?? json.final_price ?? null;

      if (!$variantSelector) {
        renderVariantSelector();
      } else {
        $variantSelector.setAttribute('modules', JSON.stringify(currentVariantModules));
        $variantSelector.setAttribute('selected', JSON.stringify(Object.fromEntries(selectedAttributesMap)));
      }
    } catch (err) {
      console.error('Failed to load variants:', err);
    }
  }

  function buildSelectedAttributes() {
    const selectedAttributes: Record<string, { value_id: string; label: string; raw_value: string; price_modifier: number; type_name?: string }> = {};

    for (const [moduleId, valueId] of selectedAttributesMap) {
      const mod = currentVariantModules.find((m: any) => m.module_id === moduleId);
      if (!mod) continue;
      const val = mod.values.find((v: any) => v.value_id === valueId);
      if (val) {
        selectedAttributes[moduleId] = {
          value_id: valueId,
          label: val.label,
          raw_value: val.raw_value,
          price_modifier: val.price_modifier,
          type_name: mod.name,
        };
      }
    }

    return selectedAttributes;
  }

  function updatePriceDisplay() {
    const basePrice = currentProduct.base_price;
    const tierPrice = currentTiers.length > 0 ? getTierPrice(currentTiers, selectedQty, basePrice) : basePrice;
    const applicableTier = currentTiers.length > 0 ? getTierForQuantity(currentTiers, selectedQty) : null;

    const modifierSum = Array.from(selectedModifiersMap.values()).reduce((a, b) => a + b, 0);
    const displayPrice = Math.max(0, tierPrice + modifierSum);

    $price.textContent = `Gs. ${formatPrice(displayPrice)}`;

    updateWhatsAppLink(applicableTier);
  }

  function updateWhatsAppLink(tier: any) {
    if (!$whatsappBtn) return;

    const baseForTier = tier ? tier.price : currentProduct.base_price;

    const selectedAttributes = buildSelectedAttributes();

    const cartItem = {
      id: currentProduct.id,
      name: currentProduct.name,
      price: baseForTier,
      quantity: selectedQty,
      image: getProductImageUrl(
        currentProduct.images && currentProduct.images.length > 0
          ? currentProduct.images[0]?.url
          : null
      ),
      selected_tier_id: tier?.id,
      selected_tier_price: tier ? tier.price : undefined,
      selected_tier_min_qty: tier?.min_quantity,
      ...(Object.keys(selectedAttributes).length > 0 ? { selected_attributes: selectedAttributes } : {}),
    };

    const message = buildCartMessage([cartItem]);
    const encoded = encodeURIComponent(message);
    const phone = '595991969608';
    $whatsappBtn.href = `https://wa.me/${phone}?text=${encoded}`;
  }

  document.addEventListener('astro:page-load', () => {
    $addCart?.addEventListener('click', () => {
      if (!currentProduct) return;

      const tierMinQty = selectedTier?.min_quantity || 1;

      const selectedAttributes = buildSelectedAttributes();

      const hasAttributes = Object.keys(selectedAttributes).length > 0;

      addToCartWithOptions({
        id: currentProduct.id,
        name: currentProduct.name,
        price: currentProduct.base_price,
        image: getProductImageUrl(
          currentProduct.images && currentProduct.images.length > 0
            ? currentProduct.images[0]?.url
            : null
        ),
        quantity: selectedQty,
        price_tiers: currentProduct.price_tiers || [],
        selected_tier_id: selectedTier?.id,
        selected_tier_price: selectedTier?.price,
        selected_tier_min_qty: tierMinQty,
        ...(hasAttributes ? { selected_attributes: selectedAttributes } : {}),
      });

      updateCartBadge();

      $addCart.textContent = '¡Agregado!';
      setTimeout(() => { $addCart.textContent = 'Agregar al carrito'; }, 1500);

      updateWhatsAppLink(selectedTier);
    });

    if (currentProduct) {
      loadVariants(currentProduct.id);
    }

    if (currentTiers.length > 0) {
      $qtySection.style.display = 'block';
      selectedQty = 1;
      if ($numberInput) $numberInput.value = 1;
      selectedTier = getTierForQuantity(currentTiers, selectedQty);

      $qtySection.addEventListener('number-input:change', ((e: CustomEvent) => {
        selectedQty = e.detail.value;
        selectedTier = getTierForQuantity(currentTiers, selectedQty);
        updatePriceDisplay();
      }) as EventListener);

      // Quick-add (D3): tier "+" buttons dispatch tier-add with the tier minimum;
      // the setter clamps to 999 and fires number-input:change once, reusing the
      // existing listener above for price/WhatsApp updates. No-op when unchanged.
      document.addEventListener('tier-add', ((e: CustomEvent) => {
        const qty = e.detail?.min_quantity;
        if (typeof qty !== 'number' || !$numberInput) return;
        $numberInput.value = Math.min(999, qty);
      }) as EventListener);

      updatePriceDisplay();
    }
  });
</script>

<style is:global>
  .detail-section {
    padding: var(--space-2xl) var(--margin-mobile);
    max-width: 1000px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .detail-section { padding: var(--space-3xl) var(--margin-desktop); }
  }

  .detail-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }
  @media (min-width: 768px) {
    .detail-layout { grid-template-columns: 1fr 1fr; }
  }

  /* Image */
  .detail-image-container {
    border: var(--border-width) solid var(--outline-variant);
    background-color: var(--surface-container);
    aspect-ratio: 1;
    overflow: hidden;
  }
  .detail-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Related products */
  .related-products {
    margin-top: var(--space-3xl);
    border-top: var(--border-width) solid var(--outline-variant);
    padding-top: var(--space-2xl);
  }

  .related-products__title {
    font-family: var(--font-mono);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--on-surface-variant);
    margin-bottom: var(--space-lg);
  }

  .related-products__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  @media (min-width: 768px) {
    .related-products__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Info */
  .detail-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .detail-breadcrumb {
    color: var(--on-surface-variant);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .detail-name {
    color: var(--on-surface);
  }
  .detail-price {
    color: var(--primary);
    font-weight: 700;
  }
  .detail-description {
    color: var(--on-surface-variant);
    line-height: 1.6;
  }

  /* Quantity stepper */
  .quantity-stepper-section {
    padding: var(--space-md);
    background-color: var(--surface-container);
    border: var(--border-width) solid var(--outline-variant);
    border-radius: var(--border-radius);
    margin-bottom: var(--space-lg);
  }

  .quantity-label {
    display: block;
    margin-bottom: var(--space-sm);
    color: var(--on-surface-variant);
  }

  /* Detail actions */
  .detail-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  @media (min-width: 768px) {
    .detail-actions {
      flex-direction: row;
      align-items: center;
    }
  }

  .detail-add-btn,
  #detail-whatsapp {
    flex: 1;
    padding: var(--space-lg) var(--space-2xl);
    text-align: center;
  }

  #detail-whatsapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  /* Error / Loading states */
  .detail-state {
    text-align: center;
    padding: var(--space-4xl) var(--margin-mobile);
  }
  .detail-actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Mobile product detail */
  @media (max-width: 639px) {
    .detail-image-container {
      aspect-ratio: 1;
      max-height: 400px;
    }

    .detail-actions {
      flex-direction: column;
      gap: var(--space-md);
    }

    .detail-add-btn,
    #detail-whatsapp {
      width: 100%;
      min-height: 48px;
      padding: var(--space-lg) var(--space-xl);
      justify-content: center;
    }
  }

  /* Skeleton loading */
  .detail-image-skeleton {
    aspect-ratio: 1;
    background-color: var(--surface-container);
    animation: pulse 1.5s ease-in-out infinite;
  }
  .detail-info-skeleton {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .skeleton-line {
    height: 20px;
    background-color: var(--surface-container);
    animation: pulse 1.5s ease-in-out infinite;
  }
  .skeleton-line--lg { width: 100%; }
  .skeleton-line--md { width: 70%; }
  .skeleton-line--sm { width: 40%; }

  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  /* variant-selector component host styles */
  variant-selector {
    display: block;
    padding: var(--space-md);
    background-color: var(--surface-container);
    border: var(--border-width) solid var(--outline-variant);
    border-radius: var(--border-radius);
    margin-bottom: var(--space-lg);
  }
</style>