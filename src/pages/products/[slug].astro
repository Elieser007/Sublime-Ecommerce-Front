---
/**
 * Product Detail — /products/[slug]
 *
 * SSG: pre-rendered at build time via getStaticPaths().
 * Product data + variant graph (attribute modules, dependency rules, base
 * price) come from Astro.props (build-time fetch) and are injected as
 * window globals — variant selection resolves fully client-side, with zero
 * runtime backend requests on catalog pages.
 * Add-to-cart uses LocalStorage. WhatsApp checkout with tier info.
 */

import { getProductImageUrl } from '../../lib/public-api';
import { formatPrice } from '../../lib/public-api';
import { getApiUrl } from '../../lib/api-url';
import { getRelatedProducts } from '../../lib/product-related';
import { getCatalogBuildData, EMPTY_VARIANTS_DATA, type BakedVariantData } from '../../lib/catalog-build';
import { resolveVariantUiState } from '../../lib/variant-fallback';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PriceTierList from '../../components/PriceTierList.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import Button from '../../components/Button.astro';

const API_URL = getApiUrl();

export async function getStaticPaths() {
  const apiUrl = getApiUrl();

  // One batched catalog fetch for the whole build (src/lib/catalog-build.ts
  // memoizes it, so index/home/[slug] share a single pipeline run). The batch
  // pipeline owns the per-batch 10s abort timeouts and fails loudly when the
  // backend is unreachable — no try/catch here, the build must fail.
  const { products, variantsByProduct, bakeFailedByProduct } = await getCatalogBuildData(apiUrl);

  const paths = [];
  for (const product of products) {
    const related = getRelatedProducts(products, product.slug, product.section_slug || '');
    const relatedVariants: Record<string, BakedVariantData> = {};
    for (const relatedProduct of related) {
      const baked = variantsByProduct.get(relatedProduct.id);
      if (baked) relatedVariants[relatedProduct.id] = baked;
    }

    paths.push({
      params: { slug: product.slug },
      props: {
        product,
        // Build-time recommendations from the in-memory list (D6/REQ-10):
        // deterministic, zero runtime fetches.
        related,
        // Baked attribute-variant graph for this product (SSG).
        variantsData: variantsByProduct.get(product.id) ?? EMPTY_VARIANTS_DATA,
        // Baked graphs for the related product cards (they open the modal).
        relatedVariants,
        // Bake-outcome signal: payload said modules should exist but the
        // graph is missing/corrupt → fallback notice + blocked add-to-cart.
        bakeFailed: bakeFailedByProduct.get(product.id) ?? false,
      },
    });
  }

  return paths;
}

const { product, related = [], variantsData = EMPTY_VARIANTS_DATA, relatedVariants = {}, bakeFailed = false } = Astro.props;

// Server-side fallback decision: bake-outcome based (see
// src/lib/variant-fallback.ts). Products with a clean payload and zero
// modules (seeded size products: SKUs but no attribute modules) render as
// genuine "no variants" — purchasable, no notice.
const variantUi = resolveVariantUiState(product, variantsData.modules, variantsData.dependencies, bakeFailed);

// Pre-compute values for template
const primaryImage = product.images && product.images.length > 0
  ? product.images.find((img: any) => img.is_primary) || product.images[0]
  : null;
const imageUrl = getProductImageUrl(primaryImage?.url);
const breadcrumbs = [
  product.section_name,
  product.category_name,
  product.subcategory_name,
].filter(Boolean).join(' / ') || 'Producto';
const tiers = product.price_tiers || [];
const basePriceFormatted = formatPrice(product.base_price);
---

<BaseLayout title={`${product.name} — Sublime`}>
  <!-- Product detail — pre-rendered with build-time data -->
  <div id="detail-content" class="detail-section">
    <div class="detail-layout">
      <!-- Image column: gallery + description below -->
      <div class="detail-media">
        {product.images && product.images.length > 0 ? (
          <ProductGallery images={product.images} alt={product.name} />
        ) : (
          <div class="detail-image-container">
            <img id="detail-image" class="detail-image" src={imageUrl} alt={product.name} width="600" height="600" />
          </div>
        )}

        <div class="detail-description body-lg" id="detail-description">
          {product.description && <span>{product.description}</span>}
        </div>
      </div>

      <!-- Info -->
      <div class="detail-info">
        <!-- Breadcrumb -->
        <nav class="detail-breadcrumb body-sm" id="detail-breadcrumb">{breadcrumbs}</nav>

        <h1 class="detail-name headline-lg-mobile" id="detail-name">{product.name}</h1>
        <p class="detail-price headline-xl" id="detail-price">Gs. {basePriceFormatted}</p>
        
        <!-- Volume Price Tier Table -->
        <div id="volume-price-section">
          {tiers.length > 0 && (
            <PriceTierList priceTiers={tiers} selectedQty={1} basePrice={product.base_price} />
          )}
        </div>

        <!-- Variant Selector (attribute modules — loaded client-side) -->
        <div id="variant-section">
          {variantUi.showFallbackNotice && (
            <p class="variant-fallback-notice" role="status" id="variant-fallback-notice">
              No se pudieron cargar las variantes. Consultanos por WhatsApp.
            </p>
          )}
        </div>
        
        <!-- Quantity Stepper (shows when tier selected) -->
        <div id="quantity-stepper-section" class="quantity-stepper-section" style={tiers.length > 0 ? "display: block;" : "display: none;"}>
          <label class="quantity-label label-sm">Cantidad</label>
          <number-input data-value="1" data-min="1" data-max="999" data-label="Cantidad"></number-input>
        </div>

        <div class="detail-actions">
          <Button
            variant="primary"
            size="lg"
            class="detail-add-btn"
            id="detail-add-cart"
            disabled={variantUi.showFallbackNotice}
          >
            Agregar al carrito
          </Button>
          <Button variant="secondary" size="lg" id="detail-whatsapp" href="#" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
              <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/>
            </svg>
            Comprar por WhatsApp
          </Button>
        </div>
      </div>
    </div>

    <!-- Related products (D6): static same-section recommendations from build time -->
    {related.length > 0 && (
      <section id="related-products" class="related-products">
        <h2 class="related-products__title">Productos relacionados</h2>
        <div class="related-products__grid">
          {related.map((relatedProduct: any) => {
            const baked = relatedVariants[relatedProduct.id];
            const variantsAttr = baked && baked.modules.length > 0 ? JSON.stringify(baked) : null;
            return (
              <product-card
                product={JSON.stringify({
                  id: relatedProduct.id,
                  slug: relatedProduct.slug,
                  name: relatedProduct.name,
                  price: relatedProduct.base_price,
                  image: getProductImageUrl(relatedProduct.image_url),
                  category: relatedProduct.section_name,
                  price_tiers: relatedProduct.price_tiers || [],
                  bakeFailed: !!relatedProduct.bakeFailed,
                })}
                {...(variantsAttr ? { variants: variantsAttr } : {})}
              />
            );
          })}
        </div>
      </section>
    )}
  </div>

  <!-- Inject build-time product data for client-side script -->
  <script is:inline set:html={`window.__PRODUCT_DATA__ = ${JSON.stringify(product).replace(/<\//g, '<\\/')};`} />
  <!-- Inject the build-time attribute-variant graph (modules + dependency rules + base price) -->
  <script is:inline set:html={`window.__VARIANTS_DATA__ = ${JSON.stringify(variantsData).replace(/<\//g, '<\\/')};`} />
</BaseLayout>

<script>
  import {
    formatPrice,
    getProductImageUrl,
  } from '../../lib/public-api';
  import { getTierPrice, getTierForQuantity } from '../../lib/price-utils';
  import { buildCartMessage } from '../../lib/whatsapp';
  import { isSelectionComplete } from '../../lib/variant-logic';
  import { resolveAvailable, resolveFinalPrice } from '../../lib/variant-filter';
  import { resolveVariantUiState } from '../../lib/variant-fallback';
  import { addToCartWithOptions, updateCartBadge } from '../../lib/cart.js';

  // ClientRouter dedupes module scripts: this bundle executes once per
  // session while astro:page-load fires on every navigation. All captured
  // elements and baked data below are re-resolved at the top of
  // initDetailPage so every product page binds to its OWN DOM + data.
  let $variantSection: HTMLElement | null;
  let $qtySection: HTMLElement | null;
  let $numberInput: any;
  let $addCart: HTMLElement | null;
  let $whatsappBtn: HTMLElement | null;
  let $price: HTMLElement | null;

  let currentProduct: any;
  let bakedVariants: any;

  // Variant data is baked into the page at build time (SSG). The client only
  // resolves availability + price locally — no runtime /variants requests.
  let currentVariantModules: any[];
  let currentDependencies: any[];
  let currentTiers: any[];
  let selectedTier: any;
  let selectedQty: number;
  let selectedAttributesMap: Map<string, string>;

  // Bake-failure fallback (see src/lib/variant-fallback.ts): bake-outcome
  // based. The batch payload carries the resolved bakeFailed flag; when true
  // (payload said modules should exist but the graph is missing/corrupt) the
  // notice renders and add-to-cart stays blocked. Re-resolved per page-load.
  let bakeFailed: boolean;
  let variantUi: ReturnType<typeof resolveVariantUiState>;

  let $variantSelector: any;

  function renderVariantFallbackNotice() {
    if (document.getElementById('variant-fallback-notice')) return;
    const notice = document.createElement('p');
    notice.id = 'variant-fallback-notice';
    notice.className = 'variant-fallback-notice';
    notice.setAttribute('role', 'status');
    notice.textContent = 'No se pudieron cargar las variantes. Consultanos por WhatsApp.';
    $variantSection.appendChild(notice);
  }

  // Recompute value availability from the baked dependency graph and re-sync
  // the selector. Selections that became unavailable are dropped (mirrors the
  // backend filtering values out when a parent forbids them).
  function recomputeVariants() {
    const resolved = resolveAvailable(currentVariantModules, currentDependencies, selectedAttributesMap);

    for (const [moduleId, valueId] of Array.from(selectedAttributesMap.entries())) {
      const mod = resolved.find((m: any) => m.module_id === moduleId);
      const value = mod?.values.find((v: any) => v.value_id === valueId);
      if (!value || value.available === false) {
        selectedAttributesMap.delete(moduleId);
      }
    }

    currentVariantModules = resolved;
    if ($variantSelector) {
      $variantSelector.setAttribute('modules', JSON.stringify(currentVariantModules));
      $variantSelector.setAttribute('selected', JSON.stringify(Object.fromEntries(selectedAttributesMap)));
    }
  }

  function renderVariantSelector() {
    $variantSelector = document.createElement('variant-selector');
    $variantSection.appendChild($variantSelector);
    $variantSelector.setAttribute('modules', JSON.stringify(currentVariantModules));
    $variantSelector.setAttribute('selected', JSON.stringify(Object.fromEntries(selectedAttributesMap)));

    $variantSelector.addEventListener('variant-change', ((e: CustomEvent) => {
      const { moduleId, valueId } = e.detail;
      if (valueId) {
        selectedAttributesMap.set(moduleId, valueId);
      } else {
        selectedAttributesMap.delete(moduleId);
      }

      recomputeVariants();

      const complete = isSelectionComplete(currentVariantModules, selectedAttributesMap);
      if ($addCart) $addCart.disabled = variantUi.showFallbackNotice || !complete;

      updatePriceDisplay();
    }) as EventListener);
  }

  function buildSelectedAttributes() {
    const selectedAttributes: Record<string, { value_id: string; label: string; raw_value: string; price_modifier: number; type_name?: string }> = {};

    for (const [moduleId, valueId] of selectedAttributesMap) {
      const mod = currentVariantModules.find((m: any) => m.module_id === moduleId);
      if (!mod) continue;
      const val = mod.values.find((v: any) => v.value_id === valueId);
      if (val) {
        selectedAttributes[moduleId] = {
          value_id: valueId,
          label: val.label,
          raw_value: val.raw_value,
          price_modifier: val.price_modifier,
          type_name: mod.name,
        };
      }
    }

    return selectedAttributes;
  }

  function updatePriceDisplay() {
    const basePrice = currentProduct.base_price;
    const tierPrice = currentTiers.length > 0 ? getTierPrice(currentTiers, selectedQty, basePrice) : basePrice;
    const applicableTier = currentTiers.length > 0 ? getTierForQuantity(currentTiers, selectedQty) : null;

    const displayPrice = resolveFinalPrice(tierPrice, currentVariantModules, selectedAttributesMap);

    $price.textContent = `Gs. ${formatPrice(displayPrice)}`;

    updateWhatsAppLink(applicableTier);
  }

  function updateWhatsAppLink(tier: any) {
    if (!$whatsappBtn) return;

    const baseForTier = tier ? tier.price : currentProduct.base_price;

    const selectedAttributes = buildSelectedAttributes();

    const cartItem = {
      id: currentProduct.id,
      name: currentProduct.name,
      price: baseForTier,
      quantity: selectedQty,
      image: getProductImageUrl(
        currentProduct.images && currentProduct.images.length > 0
          ? currentProduct.images[0]?.url
          : null
      ),
      selected_tier_id: tier?.id,
      selected_tier_price: tier ? tier.price : undefined,
      selected_tier_min_qty: tier?.min_quantity,
      ...(Object.keys(selectedAttributes).length > 0 ? { selected_attributes: selectedAttributes } : {}),
    };

    const message = buildCartMessage([cartItem]);
    const encoded = encodeURIComponent(message);
    const phone = '595991969608';
    $whatsappBtn.href = `https://wa.me/${phone}?text=${encoded}`;
  }

  function initDetailPage() {
    // Cross-page guard: this listener persists on the document and fires on
    // every navigation; only run against an actual product page DOM.
    if (!document.getElementById('detail-add-cart')) return;
    // Re-resolve every captured element + injected data against the CURRENT
    // document (module scope ran once, for the session's first product page).
    $variantSection = document.getElementById('variant-section');
    $qtySection = document.getElementById('quantity-stepper-section');
    $numberInput = $qtySection?.querySelector('number-input') as any;
    $addCart = document.getElementById('detail-add-cart');
    $whatsappBtn = document.getElementById('detail-whatsapp');
    $price = document.getElementById('detail-price');

    currentProduct = (window as any).__PRODUCT_DATA__;
    bakedVariants = (window as any).__VARIANTS_DATA__;

    currentVariantModules = bakedVariants?.modules || [];
    currentDependencies = bakedVariants?.dependencies || [];
    currentTiers = currentProduct?.price_tiers || [];
    selectedTier = null;
    selectedQty = 1;
    selectedAttributesMap = new Map<string, string>();

    $variantSelector = null;

    bakeFailed = !!(currentProduct as any)?.bakeFailed;
    variantUi = resolveVariantUiState(currentProduct, currentVariantModules, currentDependencies, bakeFailed);

    $addCart?.addEventListener('click', () => {
      // Bake-failure fallback: never add a variant product without options.
      if (!currentProduct || variantUi.showFallbackNotice) return;

      const tierMinQty = selectedTier?.min_quantity || 1;

      const selectedAttributes = buildSelectedAttributes();

      const hasAttributes = Object.keys(selectedAttributes).length > 0;

      addToCartWithOptions({
        id: currentProduct.id,
        name: currentProduct.name,
        price: currentProduct.base_price,
        image: getProductImageUrl(
          currentProduct.images && currentProduct.images.length > 0
            ? currentProduct.images[0]?.url
            : null
        ),
        quantity: selectedQty,
        price_tiers: currentProduct.price_tiers || [],
        selected_tier_id: selectedTier?.id,
        selected_tier_price: selectedTier?.price,
        selected_tier_min_qty: tierMinQty,
        ...(hasAttributes ? { selected_attributes: selectedAttributes } : {}),
      });

      updateCartBadge();

      $addCart.textContent = '¡Agregado!';
      setTimeout(() => { $addCart.textContent = 'Agregar al carrito'; }, 1500);

      updateWhatsAppLink(selectedTier);
    });

    if (currentProduct) {
      recomputeVariants();
      if (currentVariantModules.length > 0) {
        renderVariantSelector();
      } else if (variantUi.showFallbackNotice) {
        renderVariantFallbackNotice();
      }
      const complete = isSelectionComplete(currentVariantModules, selectedAttributesMap);
      if ($addCart) $addCart.disabled = variantUi.showFallbackNotice || !complete;
      updatePriceDisplay();
    }

    if (currentTiers.length > 0) {
      $qtySection.style.display = 'block';
      selectedQty = 1;
      if ($numberInput) $numberInput.value = 1;
      selectedTier = getTierForQuantity(currentTiers, selectedQty);

      $qtySection.addEventListener('number-input:change', ((e: CustomEvent) => {
        selectedQty = e.detail.value;
        selectedTier = getTierForQuantity(currentTiers, selectedQty);
        updatePriceDisplay();
      }) as EventListener);

      // "Usar" (D3): tier buttons dispatch tier-select with the tier minimum;
      // the setter clamps to 999 and fires number-input:change once, reusing the
      // existing listener above for price/WhatsApp updates. No-op when unchanged.
      // The stepper input gets focus so the customer sees exactly what changed.
      // Document-level listener: replace the previous one instead of stacking
      // per navigation (each execution closes over its own $numberInput).
      function handleTierSelect(e: CustomEvent) {
        const qty = e.detail?.min_quantity;
        if (typeof qty !== 'number' || !$numberInput) return;
        $numberInput.value = Math.min(999, qty);
        $numberInput.shadowRoot?.querySelector('.qty-display')?.focus();
      }
      if (window.__detailTierSelectHandler) {
        document.removeEventListener('tier-select', window.__detailTierSelectHandler);
      }
      window.__detailTierSelectHandler = handleTierSelect;
      document.addEventListener('tier-select', window.__detailTierSelectHandler);

      updatePriceDisplay();
    }
  }

  // ClientRouter re-executes this script per navigation: replace the previous
  // listener instead of stacking one per visit (stale closures would bind
  // multiple add-to-cart / qty handlers to the fresh DOM).
  if (window.__detailPageInit) {
    document.removeEventListener('astro:page-load', window.__detailPageInit);
  }
  window.__detailPageInit = initDetailPage;
  document.addEventListener('astro:page-load', window.__detailPageInit);
</script>

<style is:global>
  .detail-section {
    padding: var(--space-2xl) var(--margin-mobile);
    max-width: 1000px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .detail-section { padding: var(--space-3xl) var(--margin-desktop); }
  }

  .detail-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }
  @media (min-width: 768px) {
    .detail-layout { grid-template-columns: 1fr 1fr; }
  }

  /* Image column (gallery + description) */
  .detail-media {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    /* Allow the gallery's horizontally-scrollable thumb strip to shrink to
       the column width instead of overflowing it (grid min-width: auto). */
    min-width: 0;
  }

  /* Image */
  .detail-image-container {
    border: var(--border-width) solid var(--outline-variant);
    background-color: var(--surface-container);
    aspect-ratio: 1;
    overflow: hidden;
  }
  .detail-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Related products */
  .related-products {
    margin-top: var(--space-3xl);
    border-top: var(--border-width) solid var(--outline-variant);
    padding-top: var(--space-2xl);
  }

  .related-products__title {
    font-family: var(--font-mono);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--on-surface-variant);
    margin-bottom: var(--space-lg);
  }

  .related-products__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  @media (min-width: 768px) {
    .related-products__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Info */
  .detail-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .detail-breadcrumb {
    color: var(--on-surface-variant);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .detail-name {
    color: var(--on-surface);
  }
  .detail-price {
    color: var(--primary);
    font-weight: 700;
  }
  .detail-description {
    color: var(--on-surface-variant);
    line-height: 1.6;
  }

  /* Quantity stepper */
  .quantity-stepper-section {
    padding: var(--space-md);
    background-color: var(--surface-container);
    border: var(--border-width) solid var(--outline-variant);
    border-radius: var(--border-radius);
    margin-bottom: var(--space-lg);
  }

  .quantity-label {
    display: block;
    margin-bottom: var(--space-sm);
    color: var(--on-surface-variant);
  }

  /* Detail actions */
  .detail-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  @media (min-width: 768px) {
    .detail-actions {
      flex-direction: row;
      align-items: center;
    }
  }

  .detail-add-btn,
  #detail-whatsapp {
    flex: 1;
    padding: var(--space-lg) var(--space-2xl);
    text-align: center;
  }

  #detail-whatsapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  /* Error / Loading states */
  .detail-state {
    text-align: center;
    padding: var(--space-4xl) var(--margin-mobile);
  }
  .detail-actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Mobile product detail */
  @media (max-width: 639px) {
    .detail-image-container {
      aspect-ratio: 1;
      max-height: 400px;
    }

    .detail-actions {
      flex-direction: column;
      gap: var(--space-md);
    }

    .detail-add-btn,
    #detail-whatsapp {
      width: 100%;
      min-height: 48px;
      padding: var(--space-lg) var(--space-xl);
      justify-content: center;
    }
  }

  /* Skeleton loading */
  .detail-image-skeleton {
    aspect-ratio: 1;
    background-color: var(--surface-container);
    animation: pulse 1.5s ease-in-out infinite;
  }
  .detail-info-skeleton {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .skeleton-line {
    height: 20px;
    background-color: var(--surface-container);
    animation: pulse 1.5s ease-in-out infinite;
  }
  .skeleton-line--lg { width: 100%; }
  .skeleton-line--md { width: 70%; }
  .skeleton-line--sm { width: 40%; }

  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  /* variant-selector component host styles */
  variant-selector {
    display: block;
    padding: var(--space-md);
    background-color: var(--surface-container);
    border: var(--border-width) solid var(--outline-variant);
    border-radius: var(--border-radius);
    margin-bottom: var(--space-lg);
  }

  /* Bake-failure fallback notice (variant product with no baked modules) */
  .variant-fallback-notice {
    margin: 0 0 var(--space-lg);
    padding: var(--space-md);
    background-color: var(--surface-container);
    border: var(--border-width) solid var(--outline-variant);
    border-radius: var(--border-radius);
    color: var(--on-surface-variant);
    font-family: var(--font-body);
  }
</style>