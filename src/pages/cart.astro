---
/**
 * Carrito page — Sublime E-commerce
 * 
 * Shopping cart with item list and summary.
 * Cart data lives in LocalStorage (client-side only).
 * Checkout generates WhatsApp link.
 *
 * Design: skeleton → real items (no placeholder flash).
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import CartSummary from '../components/CartSummary.astro';
---

<BaseLayout title="Carrito — Sublime E-commerce">
  <section class="cart-page">
    <div class="container">
      <h1 class="cart-title headline-lg-mobile">Carrito</h1>

      <div class="cart-layout">
        <!-- Cart Items -->
        <div class="cart-items" id="cart-items">
          <!-- Skeleton: shown while JS loads -->
          <div class="skeleton-item">
            <div class="skeleton-img skeleton-shimmer"></div>
            <div class="skeleton-text">
              <div class="skeleton-line skeleton-line--lg skeleton-shimmer"></div>
              <div class="skeleton-line skeleton-line--sm skeleton-shimmer"></div>
            </div>
            <div class="skeleton-qty skeleton-shimmer"></div>
            <div class="skeleton-text" style="align-items: flex-end;">
              <div class="skeleton-line skeleton-line--xs skeleton-shimmer"></div>
              <div class="skeleton-line skeleton-line--md skeleton-shimmer"></div>
            </div>
          </div>
          <div class="skeleton-item">
            <div class="skeleton-img skeleton-shimmer"></div>
            <div class="skeleton-text">
              <div class="skeleton-line skeleton-line--lg skeleton-shimmer"></div>
              <div class="skeleton-line skeleton-line--sm skeleton-shimmer"></div>
            </div>
            <div class="skeleton-qty skeleton-shimmer"></div>
            <div class="skeleton-text" style="align-items: flex-end;">
              <div class="skeleton-line skeleton-line--xs skeleton-shimmer"></div>
              <div class="skeleton-line skeleton-line--md skeleton-shimmer"></div>
            </div>
          </div>
        </div>

        <!-- Cart Summary -->
        <aside class="cart-aside">
          <CartSummary />
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== PAGE LAYOUT ===== */
  .cart-page {
    padding: var(--space-3xl) 0;
  }

  .cart-title {
    color: var(--on-surface);
    margin-bottom: var(--space-2xl);
  }

  .cart-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .cart-layout {
      grid-template-columns: 1fr 380px;
    }
  }

  .cart-items {
    display: flex;
    flex-direction: column;
  }

  .cart-aside {
    position: sticky;
    top: 100px;
    align-self: start;
  }

  /* ===== SKELETON LOADING ===== */
  .skeleton-item {
    display: grid;
    grid-template-columns: 80px 1fr 100px 100px;
    gap: var(--space-md);
    align-items: center;
    padding: var(--space-lg) 0;
    border-bottom: var(--border-width) solid var(--outline-variant);
  }

  .skeleton-img {
    width: 80px;
    height: 80px;
    background-color: var(--surface-container);
  }

  .skeleton-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .skeleton-line {
    height: 14px;
    background-color: var(--surface-container);
    border-radius: 2px;
  }

  .skeleton-line--lg { width: 180px; }
  .skeleton-line--md { width: 100px; }
  .skeleton-line--sm { width: 120px; }
  .skeleton-line--xs { width: 60px; }

  .skeleton-qty {
    width: 100px;
    height: 40px;
    background-color: var(--surface-container);
  }

  .skeleton-shimmer {
    position: relative;
    overflow: hidden;
  }

  .skeleton-shimmer::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.04) 50%,
      transparent 100%
    );
    animation: shimmer 1.5s infinite;
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  @media (max-width: 639px) {
    .skeleton-item {
      grid-template-columns: 60px 1fr 40px;
      grid-template-rows: auto auto;
    }
    .skeleton-img { grid-row: 1 / 3; }
    .skeleton-item > .skeleton-text:first-of-type { grid-column: 2 / 4; }
    .skeleton-qty { grid-column: 1 / 2; }
    .skeleton-text:last-child { grid-column: 2 / 3; align-items: flex-end; }
  }

  /* ===== CART ITEMS (rendered by JS) ===== */
  :global(.cart-item) {
    display: grid;
    grid-template-columns: 80px 1fr 140px 110px 40px;
    gap: var(--space-md) var(--space-xl);
    align-items: center;
    padding: var(--space-lg) 0;
    border-bottom: var(--border-width) solid var(--outline-variant);
    opacity: 0;
    animation: fadeInUp 0.3s ease-out forwards;
    transition: background-color 0.2s ease;
  }

  :global(.cart-item:hover) {
    background-color: rgba(31, 31, 31, 0.5);
  }

  :global(.cart-item.removing) {
    animation: slideOutLeft 0.3s ease-in forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideOutLeft {
    to {
      opacity: 0;
      transform: translateX(-40px);
    }
  }

  /* Stagger animation for cart items */
  :global(.cart-item:nth-child(1)) { animation-delay: 0ms; }
  :global(.cart-item:nth-child(2)) { animation-delay: 60ms; }
  :global(.cart-item:nth-child(3)) { animation-delay: 120ms; }
  :global(.cart-item:nth-child(4)) { animation-delay: 180ms; }
  :global(.cart-item:nth-child(5)) { animation-delay: 240ms; }

  /* Image */
  :global(.cart-item-image) {
    width: 80px;
    height: 80px;
    overflow: hidden;
    background-color: var(--surface-container);
    border: var(--border-width) solid var(--outline-variant);
  }

  :global(.cart-item-image img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  :global(.cart-item:hover .cart-item-image img) {
    transform: scale(1.05);
  }

  /* Info */
  :global(.cart-item-info) {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 0;
  }

  :global(.cart-item-name) {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--on-surface);
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.cart-item-price) {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-surface-variant);
    letter-spacing: 0.05em;
  }

  :global(.cart-item-attrs) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--primary);
    letter-spacing: 0.04em;
    margin: 2px 0;
  }

  :global(.cart-item-tier-badge) {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--tertiary);
    background-color: rgba(213, 202, 0, 0.1);
    border: 1px solid rgba(213, 202, 0, 0.3);
    padding: 2px 6px;
    margin-top: 4px;
    letter-spacing: 0.03em;
  }

  /* Quantity Control — rendered by client-side JS */
  :global(.cart-item-qty) {
    display: flex;
    align-items: center;
  }

  /* Subtotal */
  :global(.cart-item-subtotal) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: right;
    min-width: 100px;
  }

  :global(.cart-item-subtotal .label-sm) {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--outline);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.cart-item-total) {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 700;
    color: var(--primary);
    transition: transform 0.2s ease;
  }

  :global(.cart-item-total.pulse) {
    animation: pulse 0.3s ease;
  }

  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.08); }
    100% { transform: scale(1); }
  }

  /* Remove Button */
  :global(.cart-item-remove) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    color: var(--outline);
    cursor: pointer;
    transition: all 0.15s ease;
    border-radius: var(--border-radius);
  }

  :global(.cart-item-remove:hover) {
    color: var(--error);
    background-color: rgba(255, 180, 171, 0.08);
  }

  :global(.cart-item-remove:active) {
    transform: scale(0.9);
  }

  /* ===== EMPTY STATE ===== */
  :global(.empty-state) {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-4xl) var(--space-lg);
    animation: fadeIn 0.4s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }

  :global(.empty-state-icon) {
    width: 80px;
    height: 80px;
    color: var(--outline);
    margin-bottom: var(--space-xl);
    opacity: 0.6;
  }

  :global(.empty-state h2) {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 400;
    color: var(--on-surface);
    text-transform: uppercase;
    margin-bottom: var(--space-sm);
  }

  :global(.empty-state p) {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--on-surface-variant);
    margin-bottom: var(--space-xl);
    max-width: 320px;
    line-height: 1.5;
  }

  :global(.empty-state .btn) {
    margin-bottom: var(--space-lg);
  }

  :global(.continue-shopping) {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-surface-variant);
    text-decoration: none;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.15s ease;
  }

  :global(.continue-shopping:hover) {
    color: var(--primary);
    text-decoration: none;
  }

  /* ===== MOBILE RESPONSIVE (< 640px) ===== */
  @media (max-width: 639px) {
    :global(.cart-item) {
      grid-template-columns: 60px 1fr 36px;
      grid-template-rows: auto auto auto;
      gap: var(--space-sm);
      padding: var(--space-md) 0;
    }

    :global(.cart-item-image) {
      width: 60px;
      height: 60px;
      grid-row: 1 / 3;
      grid-column: 1;
    }

    :global(.cart-item-info) {
      grid-column: 2 / 4;
      grid-row: 1;
    }

    :global(.cart-item-name) {
      font-size: 15px;
    }

    :global(.cart-item-qty) {
      grid-column: 2;
      grid-row: 2;
      margin-top: var(--space-xs);
    }

    :global(.cart-item-subtotal) {
      grid-column: 2;
      grid-row: 3;
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      min-width: unset;
      text-align: left;
      margin-top: var(--space-xs);
    }

    :global(.cart-item-remove) {
      grid-column: 3;
      grid-row: 1;
      align-self: start;
    }
  }

  /* ===== TABLET (640-767px) ===== */
  @media (min-width: 640px) and (max-width: 767px) {
    :global(.cart-item) {
      grid-template-columns: 70px 1fr 130px 110px 36px;
      gap: var(--space-sm) var(--space-xl);
    }

    :global(.cart-item-image) {
      width: 70px;
      height: 70px;
    }

    :global(.cart-item-name) {
      font-size: 15px;
      white-space: nowrap;
    }

    :global(.cart-item-subtotal) {
      min-width: 100px;
    }
  }

  /* ===== SUMMARY OVERRIDES ===== */
  :global(.cart-summary) {
    background-color: var(--surface-container);
    padding: var(--space-xl);
    border: var(--border-width) solid var(--outline-variant);
  }

  :global(.cart-summary h3) {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 400;
    color: var(--on-surface);
    text-transform: uppercase;
    margin-bottom: var(--space-lg);
  }

  :global(.summary-count) {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-surface-variant);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-lg);
  }

  :global(.summary-rows) {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  :global(.summary-row) {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  :global(.summary-row .body-md) {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--on-surface-variant);
  }

  :global(.summary-shipping) {
    color: var(--on-surface-variant);
    font-style: italic;
    font-size: 13px;
  }

  :global(.summary-divider) {
    height: var(--border-width);
    background-color: var(--outline-variant);
    margin: var(--space-sm) 0;
  }

  :global(.summary-total) {
    color: var(--primary);
  }

  :global(.summary-total .headline-lg-mobile) {
    font-family: var(--font-display);
    font-size: 28px;
    text-transform: uppercase;
  }

  /* WhatsApp CTA */
  :global(.checkout-btn) {
    width: 100%;
    justify-content: center;
    gap: var(--space-sm);
    padding: 14px 24px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background-color: var(--primary);
    color: var(--on-primary);
    border: 2px solid var(--primary);
    border-radius: 0;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  :global(.checkout-btn:hover) {
    background-color: var(--primary-container);
    border-color: var(--primary-container);
    transform: scale(1.02);
    text-decoration: none;
  }

  :global(.checkout-btn:active) {
    transform: scale(0.98);
  }

  /* Continue shopping link below summary */
  :global(.summary-footer) {
    text-align: center;
    margin-top: var(--space-lg);
  }

  :global(.summary-footer a) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--on-surface-variant);
    text-decoration: none;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.15s ease;
  }

  :global(.summary-footer a:hover) {
    color: var(--primary);
    text-decoration: none;
  }
</style>

<script>
  import { getCart, updateCartQuantity, removeFromCart, formatPrice } from '../lib/cart.js';

  // ─── <number-input> Web Component ───────────────────────────────
  // Shared component also used in producto/[slug].astro.
  // Defined here because Astro doesn't auto-bundle imported component scripts.
  if (!customElements.get('number-input')) {
    class NumberInput extends HTMLElement {
      private _value = 1;
      private _min = 1;
      private _max = 999;
      private _step = 1;
      private _disabled = false;
      private _shadow: ShadowRoot;

      static get observedAttributes() {
        return ['data-value', 'data-min', 'data-max', 'data-step', 'data-disabled'];
      }

      constructor() {
        super();
        this._shadow = this.attachShadow({ mode: 'open' });
      }

      connectedCallback() {
        this._min = parseInt(this.dataset.min || '1', 10);
        this._max = parseInt(this.dataset.max || '999', 10);
        this._step = parseInt(this.dataset.step || '1', 10);
        this._value = parseInt(this.dataset.value || '1', 10);
        this._disabled = this.dataset.disabled === 'true';
        this._value = Math.max(this._min, Math.min(this._max, this._value));
        this._render();
        this._attachEvents();
      }

      get value() { return this._value; }
      set value(v: number) {
        const clamped = Math.max(this._min, Math.min(this._max, v));
        if (clamped === this._value) return;
        this._value = clamped;
        this._updateDisplay();
        this._updateButtons();
        this.dispatchEvent(new CustomEvent('number-input:change', {
          bubbles: true, composed: true, detail: { value: this._value },
        }));
      }

      private _updateDisplay() {
        const input = this._shadow.querySelector('.qty-display') as HTMLInputElement;
        if (input) input.value = String(this._value);
      }

      private _updateButtons() {
        const dec = this._shadow.querySelector('.qty-btn--dec') as HTMLButtonElement;
        const inc = this._shadow.querySelector('.qty-btn--inc') as HTMLButtonElement;
        if (dec) dec.disabled = this._disabled || this._value <= this._min;
        if (inc) inc.disabled = this._disabled || this._value >= this._max;
      }

      private _attachEvents() {
        this._shadow.querySelector('.qty-btn--dec')?.addEventListener('click', () => {
          if (!this._disabled) this.value = this._value - this._step;
        });
        this._shadow.querySelector('.qty-btn--inc')?.addEventListener('click', () => {
          if (!this._disabled) this.value = this._value + this._step;
        });
        (this._shadow.querySelector('.qty-display') as HTMLInputElement)?.addEventListener('keydown', (e: KeyboardEvent) => {
          if (this._disabled) return;
          if (e.key === 'ArrowUp') { e.preventDefault(); this.value = this._value + this._step; }
          if (e.key === 'ArrowDown') { e.preventDefault(); this.value = this._value - this._step; }
        });
      }

      private _render() {
        const d = this._disabled || this._value <= this._min;
        const i = this._disabled || this._value >= this._max;
        this._shadow.innerHTML = `
          <style>
            :host { display: inline-block; --_sch: var(--surface-container-high, #2a2a2a); --_ov: var(--outline-variant, #3e4850); --_os: var(--on-surface, #e2e2e2); --_p: var(--primary, #82cfff); --_op: var(--on-primary, #00344b); --_bw: var(--border-width, 1px); --_br: var(--border-radius, 0px); --_fm: var(--font-mono, 'Space Mono', monospace); }
            .quantity-control { display: inline-flex; align-items: center; }
            .qty-btn { display:flex;align-items:center;justify-content:center;width:40px;height:40px;background:var(--_sch);border:var(--_bw) solid var(--_ov);border-radius:var(--_br);color:var(--_os);cursor:pointer;font-size:20px;font-family:var(--_fm);transition:all .15s ease;user-select:none;flex-shrink:0; }
            .qty-btn:hover:not(:disabled) { background:var(--_p);border-color:var(--_p);color:var(--_op); }
            .qty-btn:active:not(:disabled) { transform:scale(.95); }
            .qty-btn:focus-visible { outline:2px solid var(--_p);outline-offset:2px; }
            .qty-btn:disabled { opacity:.3;cursor:not-allowed; }
            .qty-display { width:52px;height:40px;text-align:center;background:var(--_sch);border-top:var(--_bw) solid var(--_ov);border-bottom:var(--_bw) solid var(--_ov);border-left:none;border-right:none;border-radius:0;color:var(--_os);font-family:var(--_fm);font-size:15px;font-weight:600;-moz-appearance:textfield;appearance:textfield; }
            .qty-display::-webkit-outer-spin-button,.qty-display::-webkit-inner-spin-button { -webkit-appearance:none;margin:0; }
            .qty-display:focus { outline:none;background:rgba(130,207,255,.08); }
            @media(max-width:639px){.qty-btn{width:44px;height:44px;font-size:22px}.qty-display{width:48px;height:44px;font-size:16px}}
          </style>
          <div class="quantity-control" part="control">
            <button class="qty-btn qty-btn--dec" type="button" aria-label="Disminuir" ${d ? 'disabled' : ''}>−</button>
            <input class="qty-display" type="number" value="${this._value}" min="${this._min}" max="${this._max}" step="${this._step}" ${this._disabled ? 'disabled' : ''} aria-label="Cantidad" readonly />
            <button class="qty-btn qty-btn--inc" type="button" aria-label="Aumentar" ${i ? 'disabled' : ''}>+</button>
          </div>`;
      }
    }
    customElements.define('number-input', NumberInput);
  }

  function renderEmptyState(container: HTMLElement) {
    container.innerHTML = `
      <div class="empty-state">
        <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        <h2>Tu carrito está vacío</h2>
        <p>Explorá nuestro catálogo y encontrá lo que buscás</p>
        <a href="/" class="btn btn--primary" style="display: inline-flex; align-items: center; justify-content: center; padding: 12px 24px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; text-decoration: none; background-color: rgba(130, 207, 255, 0.1); color: #ffffff; border: 1px solid rgba(130, 207, 255, 0.5); cursor: pointer; transition: all 0.2s ease;">Ir a la tienda</a>
        <a href="/" class="continue-shopping">← Seguir comprando</a>
      </div>
    `;
  }

  function renderItem(item: any): string {
    const subtotal = formatPrice(item.price * item.quantity);
    const key = item.composite_key || item.id;

    let attributeHtml = '';
    if (item.selected_attributes && Object.keys(item.selected_attributes).length > 0) {
      const labels = Object.values(item.selected_attributes)
        .map((a: any) => a.label)
        .filter(Boolean);
      if (labels.length > 0) {
        attributeHtml = `<p class="cart-item-attrs">${labels.join(' | ')}</p>`;
      }
    }

    let tierBadgeHtml = '';
    if (item.price_tiers && item.price_tiers.length > 1) {
      const volumeTiers = item.price_tiers.filter((t: any) => t.min_quantity > 1);
      if (volumeTiers.length > 0) {
        const best = volumeTiers.reduce((a: any, b: any) => a.price < b.price ? a : b);
        tierBadgeHtml = `<span class="cart-item-tier-badge">Desde ${best.min_quantity} unds: Gs. ${formatPrice(best.price)}</span>`;
      }
    }

    return `
      <div class="cart-item" data-product-id="${key}">
        <div class="cart-item-image">
          <img src="${item.image}" alt="${item.name}" width="80" height="80" loading="lazy" />
        </div>
        <div class="cart-item-info">
          <h3 class="cart-item-name">${item.name}</h3>
          ${attributeHtml}
          <p class="cart-item-price">Gs. ${formatPrice(item.price)} c/u</p>
          ${tierBadgeHtml}
        </div>
        <div class="cart-item-qty">
          <number-input
            data-value="${item.quantity}"
            data-min="1"
            data-max="99"
            data-product-id="${key}"
            data-label="Cantidad de ${item.name}"
          ></number-input>
        </div>
        <div class="cart-item-subtotal">
          <span class="label-sm">Subtotal</span>
          <p class="cart-item-total" data-subtotal-for="${key}">Gs. ${subtotal}</p>
        </div>
        <button class="cart-item-remove" data-remove-id="${key}" aria-label="Eliminar ${item.name}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    `;
  }

  function pulseSubtotal(productId: string) {
    const el = document.querySelector(`[data-subtotal-for="${productId}"]`);
    if (el) {
      el.classList.remove('pulse');
      void (el as HTMLElement).offsetWidth; // force reflow
      el.classList.add('pulse');
    }
  }

  function attachCartListeners() {
    // Quantity changes via <number-input> web component
    document.querySelectorAll('.cart-item-qty').forEach((qtyEl) => {
      qtyEl.addEventListener('number-input:change', ((e: CustomEvent) => {
        const numInput = qtyEl.querySelector('number-input') as any;
        const productId = numInput?.dataset.productId;
        const value = e.detail.value;

        updateCartQuantity(productId, value);
        pulseSubtotal(productId);

        // Update subtotal display
        const cart = getCart();
        const item = cart.find((i: any) => i.id === productId);
        if (item) {
          const subtotalEl = document.querySelector(`[data-subtotal-for="${productId}"]`);
          if (subtotalEl) subtotalEl.textContent = `Gs. ${formatPrice(item.price * item.quantity)}`;
        }

        window.dispatchEvent(new CustomEvent('cart-updated'));
      }) as EventListener);
    });

    // Remove buttons
    document.querySelectorAll('[data-remove-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        const productId = el.dataset.removeId;
        const cartItem = el.closest('.cart-item') as HTMLElement;

        // Animate out
        if (cartItem) {
          cartItem.classList.add('removing');
          cartItem.addEventListener('animationend', () => {
            const updated = removeFromCart(productId!);
            cartItem.remove();
            window.dispatchEvent(new CustomEvent('cart-updated'));

            if (updated.length === 0) {
              const container = document.getElementById('cart-items');
              if (container) renderEmptyState(container);
            }
          }, { once: true });
        }
      });
    });
  }

  // Load cart on DOM ready
  document.addEventListener('DOMContentLoaded', () => {
    const cart = getCart();
    const container = document.getElementById('cart-items');
    if (!container) return;

    if (cart.length === 0) {
      renderEmptyState(container);
      return;
    }

    // Render real cart items
    container.innerHTML = cart.map((item: any) => renderItem(item)).join('');
    attachCartListeners();
  });
</script>
