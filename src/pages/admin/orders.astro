---
/**
 * Admin Orders — Order Management
 * DataTable with search, filters, pagination, detail modal with status change
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import DataTable from '../../components/admin/DataTable.astro';
import Button from '../../components/Button.astro';

const columns = [
  { key: 'id', label: 'ID', width: '80px' },
  { key: 'customer', label: 'Cliente', sortable: true },
  { key: 'phone', label: 'Teléfono' },
  { key: 'branch', label: 'Sucursal' },
  { key: 'total', label: 'Total', sortable: true, align: 'right' },
  { key: 'status', label: 'Estado' },
  { key: 'created', label: 'Creado', sortable: true },
  { key: 'actions', label: 'Acciones', width: '60px' },
];
---

<AdminLayout title="Pedidos — Admin">
  <AdminSidebar active="orders" />
  <main class="admin-main">
    <div class="admin-header">
      <h1 class="headline-lg-mobile">Pedidos</h1>
      <p class="body-md admin-subtitle">Visualiza y actualiza el estado de los pedidos</p>
    </div>

    <div class="content-header">
      <div class="toolbar">
        <input type="text" id="search" class="form-input body-md" placeholder="Buscar cliente, email o ID..." />
        <select id="status-filter" class="form-select body-md">
          <option value="">Todos</option>
          <option value="pending">Pendiente</option>
          <option value="confirmed">Confirmado</option>
          <option value="preparing">Preparando</option>
          <option value="shipped">Enviado</option>
          <option value="delivered">Entregado</option>
          <option value="cancelled">Cancelado</option>
        </select>
        <select id="branch-filter" class="form-select body-md"><option value="">Todas las sucursales</option></select>
      </div>
    </div>

    <DataTable id="orders-table" columns={columns} emptyMessage="No hay pedidos" ariaLabel="Lista de pedidos" />
  </main>

<div class="modal-overlay" id="modal-overlay" style="display: none;">
  <div class="modal modal--wide">
    <div class="modal-header">
      <h3 class="headline-lg-mobile" id="modal-title">Detalle del Pedido</h3>
      <button class="modal-close" id="modal-close">✕</button>
    </div>
    <div class="modal-body">
      <div class="detail-grid">
        <div class="detail-group"><span class="label-sm">Cliente</span><span class="body-md" id="detail-customer"></span></div>
        <div class="detail-group"><span class="label-sm">Teléfono</span><span class="body-md" id="detail-phone"></span></div>
        <div class="detail-group"><span class="label-sm">Email</span><span class="body-md" id="detail-email"></span></div>
        <div class="detail-group"><span class="label-sm">Sucursal</span><span class="body-md" id="detail-branch"></span></div>
        <div class="detail-group"><span class="label-sm">Total</span><span class="body-md" id="detail-total"></span></div>
        <div class="detail-group"><span class="label-sm">Creado</span><span class="body-md" id="detail-created"></span></div>
      </div>
      <div class="detail-section">
        <span class="label-sm">Items</span>
        <table class="items-table">
          <thead><tr><th class="label-sm">Producto</th><th class="label-sm">Variante</th><th class="label-sm">Cant.</th><th class="label-sm">Precio</th><th class="label-sm">Total</th></tr></thead>
          <tbody id="detail-items"></tbody>
        </table>
      </div>
      <div class="detail-section"><span class="label-sm">Notas</span><p class="body-md" id="detail-notes"></p></div>
      <form class="status-form" id="status-form">
        <div class="form-group"><label class="label-sm">Cambiar Estado</label><select id="status-select" class="form-select body-md" required></select></div>
        <div class="form-group"><label class="label-sm">Agregar Nota</label><input type="text" id="notes-input" class="form-input body-md" placeholder="Nota adicional..." /></div>
        <div class="form-error" id="form-error"></div>
        <div class="form-actions">
          <Button variant="secondary" type="button" id="modal-cancel">Cerrar</Button>
          <Button variant="primary" type="submit">Guardar Estado</Button>
        </div>
      </form>
    </div>
  </div>
</div>
</AdminLayout>

<script>
  import { wrapModal } from '../../lib/modalHelper';
  import { getApiUrl } from '../../lib/api-url';
  import { escapeHtml } from '../../lib/escape-html';
  import { createDataTable } from '../../lib/data-table-widget';
  const orderModal = wrapModal('modal-overlay');

  const API_URL = getApiUrl();
  const STATUS_LABELS: Record<string, string> = { pending: 'Pendiente', confirmed: 'Confirmado', preparing: 'Preparando', shipped: 'Enviado', delivered: 'Entregado', cancelled: 'Cancelado' };
  const ALLOWED_TRANSITIONS: Record<string, string[]> = { pending: ['confirmed', 'cancelled'], confirmed: ['preparing', 'cancelled'], preparing: ['shipped', 'cancelled'], shipped: ['delivered'], delivered: [], cancelled: [] };

  let items: any[] = [];
  let currentPage = 1;
  let limit = 25;
  let totalItems = 0;
  let totalPages = 0;
  let currentSearch = '';
  let currentStatus = '';
  let currentBranch = '';
  let branches: any[] = [];
  let currentOrderId: string | null = null;
  let currentOrderStatus: string = '';

  const $ = (id: string) => document.getElementById(id);
  const formatPrice = (cents: number) => `₲ ${(cents || 0).toLocaleString('es-PY')}`;
  const shortId = (id: string) => (id || '').slice(0, 8);
  const statusBadge = (status: string) => `<span class="badge badge--${escapeHtml(status)}"><span class="badge-dot"></span>${escapeHtml(STATUS_LABELS[status] || status)}</span>`;

  async function loadBranches() {
    const res = await fetch(`${API_URL}/api/branches`, { credentials: 'include' });
    if (!res.ok) return;
    const data = await res.json();
    branches = data.branches || [];
    ($('branch-filter') as HTMLSelectElement).innerHTML = '<option value="">Todas las sucursales</option>' + branches.map((b: any) => `<option value="${escapeHtml(b.id)}">${escapeHtml(b.name)}</option>`).join('');
  }

  async function loadOrders() {
    ordersTable.setLoading();
    const params = new URLSearchParams();
    params.set('page', String(currentPage));
    params.set('limit', String(limit));
    if (currentSearch) params.set('search', currentSearch);
    if (currentStatus) params.set('status', currentStatus);
    if (currentBranch) params.set('branch_id', currentBranch);
    try {
      const res = await fetch(`${API_URL}/api/orders?${params.toString()}`, { credentials: 'include' });
      if (res.status === 401) { window.location.href = '/login'; return; }
      if (!res.ok) throw new Error('Error');
      const data = await res.json();
      items = data.data || [];
      totalItems = data.total ?? items.length;
      totalPages = data.pages ?? Math.max(1, Math.ceil(items.length / 25));
      ordersTable.setRows(items, { total: totalItems, totalPages });
    } catch (err) {
      ordersTable.setError('Error al cargar');
    }
  }

  function renderOrderCell(col: any, o: any): string {
    switch (col.key) {
      case 'id':
        return `<code class="id-badge">${escapeHtml(shortId(o.id))}</code>`;
      case 'customer':
        return `<strong>${escapeHtml(o.customer_name)}</strong>`;
      case 'phone':
        return escapeHtml(o.customer_phone);
      case 'branch':
        return escapeHtml(o.branch_name) || '—';
      case 'total':
        return formatPrice(o.total);
      case 'status':
        return statusBadge(o.status);
      case 'created':
        return new Date(o.created_at * 1000).toLocaleDateString('es-PY');
      case 'actions':
        return `<div class="cell-actions"><button class="ta-btn" onclick="viewOrder('${escapeHtml(o.id)}')" title="Ver">👁️</button></div>`;
      default:
        return '';
    }
  }

  const ordersTable = createDataTable({
    container: $('orders-table')!,
    renderCell: renderOrderCell,
    emptyMessage: 'No hay pedidos',
    onPageChange: (page: number) => { currentPage = page; loadOrders(); },
    onPageSizeChange: (size: number) => { limit = size; currentPage = 1; loadOrders(); },
  });

  async function viewOrder(id: string) {
    currentOrderId = id;
    try {
      const res = await fetch(`${API_URL}/api/orders/${id}`, { credentials: 'include' });
      if (!res.ok) throw new Error('No se pudo cargar');
      const { order } = await res.json();
      $('detail-customer')!.textContent = order.customer_name;
      $('detail-phone')!.textContent = order.customer_phone;
      $('detail-email')!.textContent = order.customer_email || '—';
      $('detail-branch')!.textContent = order.branch_name || '—';
      $('detail-total')!.textContent = formatPrice(order.total);
      $('detail-created')!.textContent = new Date(order.created_at * 1000).toLocaleString('es-PY');
      $('detail-notes')!.textContent = order.notes || 'Sin notas';
      ($('detail-items') as HTMLTableSectionElement).innerHTML = (order.items || []).map((item: any) => `<tr>
        <td>${escapeHtml(item.product_name) || '—'}</td><td>${escapeHtml(item.variant_name) || '—'}</td><td>${item.quantity}</td><td>${formatPrice(item.unit_price)}</td><td>${formatPrice(item.total_price)}</td>
      </tr>`).join('');
      const statusSelect = $('status-select') as HTMLSelectElement;
      const allowed = ALLOWED_TRANSITIONS[order.status] || [];
      currentOrderStatus = order.status;
      statusSelect.innerHTML = `<option value="${escapeHtml(order.status)}" selected>${escapeHtml(STATUS_LABELS[order.status])} (actual)</option>` + allowed.map((s: string) => `<option value="${escapeHtml(s)}">${escapeHtml(STATUS_LABELS[s])}</option>`).join('');
      $('modal-title')!.textContent = `Pedido ${shortId(order.id)}`;
      orderModal.open();
      $('form-error')!.textContent = '';
    } catch (err) { console.error(err); }
  }

  function closeModal() { orderModal.close(); currentOrderId = null; }

  (window as any).viewOrder = viewOrder;

  let searchTimeout: any;
  document.addEventListener('astro:page-load', () => {
    $('modal-close')?.addEventListener('click', closeModal);
    $('modal-cancel')?.addEventListener('click', closeModal);
    $('modal-overlay')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) closeModal(); });

    $('search')?.addEventListener('input', (e) => { clearTimeout(searchTimeout); searchTimeout = setTimeout(() => { currentSearch = (e.target as HTMLInputElement).value; currentPage = 1; loadOrders(); }, 300); });
    $('status-filter')?.addEventListener('change', (e) => { currentStatus = (e.target as HTMLSelectElement).value; currentPage = 1; loadOrders(); });
    $('branch-filter')?.addEventListener('change', (e) => { currentBranch = (e.target as HTMLSelectElement).value; currentPage = 1; loadOrders(); });

    $('status-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentOrderId) return;
      const status = ($('status-select') as HTMLSelectElement).value;
      const notes = ($('notes-input') as HTMLInputElement).value;

      // The backend rejects status == current status (state machine) and also
      // rejects a missing status (VALID_STATUSES.includes(undefined) is false),
      // so a note-only save is impossible. Guard the no-op submit instead of
      // sending a request that always 400s.
      if (status === currentOrderStatus) {
        $('form-error')!.textContent = 'Seleccioná un estado distinto para guardar.';
        return;
      }

      const body: Record<string, string> = { status };
      if (notes.trim()) body.notes = notes.trim();
      const res = await fetch(`${API_URL}/api/orders/${currentOrderId}`, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify(body),
      });
      if (!res.ok) { const err = await res.json(); $('form-error')!.textContent = err.error || 'Error'; return; }
      closeModal(); loadOrders();
    });

    async function init() { await loadBranches(); await loadOrders(); }
    init();
  });
</script>

<style>
  /* ─── Orders-specific styles ──────────────────────────────── */
  .id-badge {
    display: inline-block;
    padding: 4px 8px;
    background-color: rgba(53, 53, 53, 0.5);
    border: 1px solid rgba(62, 72, 80, 0.3);
    color: var(--on-surface-variant);
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    border-radius: 0px;
  }
  .detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 16px;
  }
  .detail-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .detail-group .label-sm { color: var(--primary); }
  .detail-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .detail-section .label-sm { color: var(--primary); }
  .items-table { width: 100%; border-collapse: collapse; }
  .items-table th,
  .items-table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid rgba(62, 72, 80, 0.2);
    color: var(--on-surface);
    font-size: 14px;
  }
  .items-table th {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    color: var(--on-surface-variant);
  }
  .status-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(62, 72, 80, 0.3);
  }
  :global(.badge--pending) { background-color: rgba(213, 202, 0, 0.15); color: #d5ca00; border: 1px solid rgba(213, 202, 0, 0.4); }
  :global(.badge--confirmed) { background-color: rgba(130, 207, 255, 0.1); color: var(--primary); border: 1px solid rgba(130, 207, 255, 0.3); }
  :global(.badge--preparing) { background-color: rgba(0, 188, 212, 0.1); color: #00bcd4; border: 1px solid rgba(0, 188, 212, 0.3); }
  :global(.badge--shipped) { background-color: rgba(179, 157, 219, 0.15); color: #b39ddb; border: 1px solid rgba(179, 157, 219, 0.4); }
  :global(.badge--delivered) { background-color: rgba(129, 199, 132, 0.15); color: #81c784; border: 1px solid rgba(129, 199, 132, 0.4); }
  :global(.badge--cancelled) { background-color: rgba(255, 180, 171, 0.1); color: #ffb4ab; border: 1px solid rgba(255, 180, 171, 0.3); }
</style>
