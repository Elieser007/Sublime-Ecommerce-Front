---
/**
 * Admin Promotions — Promotion Management
 * 
 * Left: Section list with display_type selector
 * Right: Promotions for selected section + live preview
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import Button from '../../components/Button.astro';
import PromotionWall from '../../components/PromotionWall.astro';
import HeroPromo from '../../components/promo/HeroPromo.astro';
import CarouselPromo from '../../components/promo/CarouselPromo.astro';
import TilesPromo from '../../components/promo/TilesPromo.astro';
import SplitPromo from '../../components/promo/SplitPromo.astro';
import BannerPromo from '../../components/promo/BannerPromo.astro';
import RibbonPromo from '../../components/promo/RibbonPromo.astro';
---

<AdminLayout title="Promociones — Admin">
  <AdminSidebar active="promotions" />
  <main class="admin-main">
    <div class="admin-header">
      <h1 class="headline-lg-mobile">Promociones</h1>
      <p class="body-md admin-subtitle">Gestiona los anuncios del sitio</p>
    </div>

    <div class="promo-layout">
      <!-- LEFT: Sections -->
      <aside class="promo-sections">
        <h2 class="label-sm sections-title">Secciones</h2>
        <div id="sections-list" class="sections-list">
          <p class="body-sm">Cargando...</p>
        </div>
      </aside>

      <!-- RIGHT: Promotions Manager -->
      <section class="promo-manager" id="promo-manager" style="display: none;">
        <div class="manager-header">
          <div>
            <h2 class="headline-lg-mobile" id="section-name">-</h2>
            <code class="slug-badge" id="section-slug">-</code>
          </div>
          <div class="manager-actions">
            <select class="form-select body-md" id="display-type-select">
              <option value="tiles">Tiles — Grid de cuadros</option>
              <option value="carousel">Carousel — Slideshow</option>
              <option value="hero">Hero — Banner full-width</option>
              <option value="split">Split — Imagen + texto</option>
              <option value="banner">Banner — Franja de texto</option>
              <option value="ribbon">Ribbon — Cinta horizontal</option>
            </select>
            <Button variant="primary" id="add-promo-btn">+ Nuevo Anuncio</Button>
          </div>
        </div>

        <!-- Preview -->
        <div class="preview-section">
          <h3 class="label-sm">Vista Previa</h3>
          <div id="live-preview-container"><p class="body-sm" style="color:var(--on-surface-variant);">Seleccioná una sección para ver la vista previa</p></div>
        </div>

        <!-- Promotions List -->
        <div class="promos-list" id="promos-list"></div>
      </section>
    </div>
  </main>

<!-- Modal: Create/Edit Promotion -->
<div class="modal-overlay" id="modal-overlay" style="display: none;">
  <div class="modal modal--wide">
    <div class="modal-header">
      <h3 class="headline-lg-mobile" id="modal-title">Nuevo Anuncio</h3>
      <button class="modal-close" id="modal-close">✕</button>
    </div>

    <!-- Image Delete Confirmation -->
    <div class="modal-overlay" id="delete-overlay" style="display: none;">
      <div class="modal modal--confirm">
        <div class="modal-header">
          <h3 class="headline-lg-mobile">⚠️ Eliminar imagen</h3>
          <button class="modal-close" id="delete-cancel-x">✕</button>
        </div>
        <div class="modal-body">
          <p class="body-md">Esta acción no se puede deshacer. La imagen se eliminará permanentemente.</p>
          <div class="form-actions">
            <Button variant="secondary" id="delete-cancel">Cancelar</Button>
            <Button variant="danger" id="delete-confirm">Eliminar</Button>
          </div>
        </div>
      </div>
    </div>
    <form class="modal-form" id="promo-form">
      <input type="hidden" id="promo-id" />

      <div class="form-row">
        <div class="form-group form-group--wide">
          <label class="label-sm">Imagen del anuncio *</label>
          <div class="promo-upload-area" id="promo-upload-area">
            <div class="promo-upload-content" id="promo-upload-content">
              <div class="promo-empty" id="promo-empty">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
                <p class="body-md">Arrastra una imagen o haz clic</p>
                <p class="label-sm">PNG, JPG o WebP (max 5MB)</p>
              </div>
              <img src="" alt="" class="promo-image" id="promo-image" style="display: none;" />
            </div>
            <button type="button" class="promo-remove-btn" id="promo-remove" style="display: none;" title="Eliminar imagen">✕</button>
          </div>
          <input type="file" name="promo-image" id="promo-input" accept="image/png,image/jpeg,image/webp" class="upload-input" />
          <div class="upload-status" id="promo-upload-status" style="display: none;">
            <p class="label-sm">Procesando imagen...</p>
          </div>
          <input type="hidden" name="imageUrl" id="promo-image-url" />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="label-sm">Título</label>
          <input type="text" name="title" class="form-input body-md" placeholder="Ej: Nueva Colección" />
        </div>
        <div class="form-group">
          <label class="label-sm">Link *</label>
          <input type="text" name="link" class="form-input body-md" required placeholder="/producto/..." />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group form-group--wide">
          <label class="label-sm">Descripción</label>
          <input type="text" name="description" class="form-input body-md" placeholder="Texto corto descriptivo" />
        </div>
      </div>

      <div class="form-row" id="tile-options">
        <div class="form-group">
          <label class="label-sm">Columnas (tile)</label>
          <select name="tileCols" class="form-select body-md">
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
          </select>
        </div>
        <div class="form-group">
          <label class="label-sm">Filas (tile)</label>
          <select name="tileRows" class="form-select body-md">
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
          </select>
        </div>
        <div class="form-group">
          <label class="label-sm">Posición</label>
          <input type="number" name="position" class="form-input body-md" value="0" min="0" />
        </div>
      </div>

      <div class="form-error" id="form-error"></div>
      <div class="form-actions">
        <Button variant="secondary" type="button" id="modal-cancel">Cancelar</Button>
        <Button variant="primary" type="submit">Guardar</Button>
      </div>
    </form>
  </div>
</div>
</AdminLayout>

<script>
  import { escapeHtml } from '../../lib/escape-html';
  import { uploadImage, associateImage, deleteImage, fetchEntityImages } from '../../lib/image-utils';
  import { wrapModal } from '../../lib/modalHelper';
  const promoModal = wrapModal('modal-overlay');
  import {
    createEmptyPromoImageState,
    hasPromoImage,
    setPromoImageFromBlob,
    setPromoImageFromUrl,
    clearPromoImage,
    getPromoPreviewUrl,
    type PromoImageState,
  } from '../../lib/promo-upload';

  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
  const $ = (id: string) => document.getElementById(id);

  let sections: any[] = [];
  let selectedSection: any = null;
  let promotions: any[] = [];
  let currentDisplayType = 'tiles';
  let promoImageState: PromoImageState = createEmptyPromoImageState();

  // ─── LOAD SECTIONS ──────────────────────────────────────
  async function loadSections() {
    try {
      const res = await fetch(`${API_URL}/api/promotion-sections`, { credentials: 'include' });
      if (res.status === 401) { window.location.href = '/login'; return; }
      if (!res.ok) throw new Error('Error');
      const data = await res.json();
      sections = data.sections || [];
      renderSections();
    } catch (err) {
      $('sections-list')!.innerHTML = '<p class="body-sm">Error al cargar</p>';
    }
  }

  function renderSections() {
    if (sections.length === 0) {
      $('sections-list')!.innerHTML = '<p class="body-sm">No hay secciones</p>';
      return;
    }

    function explainSlug(slug: string): string {
      const parts = slug.split('-');
      const explains: Record<string, string> = {
        always: 'Se muestra siempre',
        catalog: 'Página de catálogo',
        home: 'Página principal',
        top: 'Arriba',
        bottom: 'Abajo',
        hero: 'Sección principal grande',
      };
      return parts.map(p => explains[p] || p).join(' · ');
    }

    $('sections-list')!.innerHTML = sections.map((s: any) => `
      <div class="section-card ${selectedSection?.id === s.id ? 'active' : ''}" data-id="${escapeHtml(s.id)}">
        <div class="section-card-header">
          <div>
            <strong class="body-md">${escapeHtml(s.name)}</strong>
            <code class="slug-badge">${escapeHtml(s.slug)}</code>
          </div>
          <span class="badge badge--active">${escapeHtml(s.display_type)}</span>
        </div>
        <p class="section-card-slug body-sm">${escapeHtml(explainSlug(s.slug))}</p>
      </div>
    `).join('');

    $('sections-list')!.querySelectorAll('.section-card').forEach((card) => {
      card.addEventListener('click', () => {
        const id = (card as HTMLElement).dataset.id;
        selectSection(id);
      });
    });
  }

  const typeInfo: Record<string, string> = {
    tiles: "El tipo Tiles muestra tus anuncios en un grid de cuadros. Cada anuncio puede ocupar diferente cantidad de espacio (1x1, 2x2, etc).",
    carousel: "El tipo Carousel muestra un anuncio a la vez como un slideshow que cambia automaticamente.",
    hero: "El tipo Hero es un banner grande que ocupa todo el ancho con imagen de fondo y texto centrado.",
    split: "El tipo Split muestra imagen a un lado y texto al otro, alternando la direccion.",
    banner: "El tipo Banner es una franja con texto centrado y borde decorativo. Sin imagenes.",
    ribbon: "El tipo Ribbon es una cinta horizontal con varios anuncios lado a lado.",
  };

  async function selectSection(sectionId: string) {
    selectedSection = sections.find((s: any) => s.id === sectionId);
    if (!selectedSection) return;

    currentDisplayType = selectedSection.display_type;

    $('section-name')!.textContent = selectedSection.name;
    $('section-slug')!.textContent = selectedSection.slug;
    ($('display-type-select') as HTMLSelectElement).value = currentDisplayType;
    $('promo-manager')!.style.display = '';
    $('tile-options')!.style.display = currentDisplayType === 'tiles' ? '' : 'none';

    renderSections();
    await loadPromotions();
  }

  // ─── LOAD PROMOTIONS ────────────────────────────────────
  async function loadPromotions() {
    if (!selectedSection) return;

    try {
      const res = await fetch(`${API_URL}/api/promotions?section=${selectedSection.slug}`, { credentials: 'include' });
      if (!res.ok) throw new Error('Error');
      const data = await res.json();
      promotions = data.promotions || [];
      renderPromotions();
      renderPreview();
    } catch (err) {
      $('promos-list')!.innerHTML = '<p class="body-sm">Error al cargar promociones</p>';
    }
  }

  function renderPromotions() {
    if (promotions.length === 0) {
      $('promos-list')!.innerHTML = '<p class="body-sm empty-msg">No hay anuncios en esta sección. Crea uno nuevo.</p>';
      return;
    }

    $('promos-list')!.innerHTML = promotions.map((p: any) => `
      <div class="promo-card" data-id="${escapeHtml(p.id)}">
        <div class="promo-card-img">
          <img src="${escapeHtml(p.imageUrl)}" alt="${escapeHtml(p.title || '')}" />
        </div>
        <div class="promo-card-info">
          <strong class="body-md">${escapeHtml(p.title || '(sin título)')}</strong>
          <span class="body-sm">${escapeHtml(p.description || '')}</span>
          <code class="slug-badge">${escapeHtml(p.link)}</code>
          ${currentDisplayType === 'tiles' ? `<span class="body-sm">${escapeHtml(p.tileCols)}×${escapeHtml(p.tileRows)} · pos ${escapeHtml(p.position)}</span>` : ''}
        </div>
        <div class="promo-card-actions">
          <button class="ta-btn" onclick="editPromo('${escapeHtml(p.id)}')" title="Editar">✏️</button>
          <button class="ta-btn ta-btn--delete" onclick="deletePromo('${escapeHtml(p.id)}')" title="Eliminar">🗑️</button>
        </div>
      </div>
    `).join('');
  }

  // ─── LIVE PREVIEW ───────────────────────────────────────
  function initPreviewCarousel(container: Element) {
    const slides = container.querySelectorAll('.carousel-slide');
    const dots = container.querySelectorAll('.carousel-dot');
    const prevBtn = container.querySelector('.carousel-arrow--left');
    const nextBtn = container.querySelector('.carousel-arrow--right');
    let current = 0;
    let timer: ReturnType<typeof setInterval>;

    function goTo(index: number) {
      slides[current].classList.remove('active');
      dots[current].classList.remove('active');
      current = index;
      slides[current].classList.add('active');
      dots[current].classList.add('active');
    }

    function next() { goTo((current + 1) % slides.length); }
    function prev() { goTo((current - 1 + slides.length) % slides.length); }
    function startAuto() { timer = setInterval(next, 5000); }
    function stopAuto() { clearInterval(timer); }

    prevBtn?.addEventListener('click', () => { stopAuto(); prev(); startAuto(); });
    nextBtn?.addEventListener('click', () => { stopAuto(); next(); startAuto(); });
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        stopAuto();
        goTo(parseInt((dot as HTMLElement).dataset.slide || '0'));
        startAuto();
      });
    });

    container.addEventListener('mouseenter', stopAuto);
    container.addEventListener('mouseleave', startAuto);

    if (slides.length > 1) startAuto();
  }

  function renderPreview() {
    const container = $('live-preview-container');
    if (!container || !selectedSection) return;
    if (promotions.length === 0) {
      container.innerHTML = '<p class="body-sm">Sin anuncios</p>';
      return;
    }
    container.innerHTML = '';
    let html = '';
    switch (currentDisplayType) {
      case 'hero': {
        const p = promotions[0];
        html = `<div class="hero-promo"><div class="hero-bg" style="background-image:url('${escapeHtml(p.imageUrl)}')"></div><div class="hero-overlay"></div><div class="hero-content">${p.title ? `<h2 class="hero-title">${escapeHtml(p.title)}</h2>` : ''}${p.description ? `<p class="hero-desc">${escapeHtml(p.description)}</p>` : ''}<a href="${escapeHtml(p.link)}" class="hero-btn">Ver más</a></div></div>`;
        break;
      }
      case 'carousel':
        html = '<div class="carousel-promo" data-carousel-id="preview"><div class="carousel-track">';
        promotions.forEach((pt: any, i: number) => {
          html += `<div class="carousel-slide ${i === 0 ? 'active' : ''}" data-index="${i}"><div class="slide-bg" style="background-image:url('${escapeHtml(pt.imageUrl)}')"></div><div class="slide-overlay"></div><div class="slide-content">${pt.title ? `<h3 class="slide-title">${escapeHtml(pt.title)}</h3>` : ''}${pt.description ? `<p class="slide-desc">${escapeHtml(pt.description)}</p>` : ''}</div><a href="${escapeHtml(pt.link)}" class="slide-link" aria-label="${escapeHtml(pt.title || 'Promocion')}"></a></div>`;
        });
        html += '</div>';
        if (promotions.length > 1) {
          html += '<div class="carousel-dots">';
          promotions.forEach((_: any, i: number) => {
            html += `<button class="carousel-dot ${i === 0 ? 'active' : ''}" data-slide="${i}" aria-label="Slide ${i + 1}"></button>`;
          });
          html += '</div>';
          html += '<button class="carousel-arrow carousel-arrow--left" aria-label="Anterior"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg></button>';
          html += '<button class="carousel-arrow carousel-arrow--right" aria-label="Siguiente"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg></button>';
        }
        html += '</div>';
        break;
      case 'tiles':
        html = '<div class="tiles-promo" style="grid-template-columns:repeat(4,1fr);grid-auto-rows:160px;">';
        promotions.forEach((pt: any) => {
          const col = (pt.position % 4) + 1;
          const row = Math.floor(pt.position / 4) + 1;
          html += `<div class="tile" style="grid-column:${col}/span ${pt.tileCols};grid-row:${row}/span ${pt.tileRows};"><div class="tile-bg" style="background-image:url('${escapeHtml(pt.imageUrl)}')"></div><div class="tile-overlay"></div><div class="tile-content">${pt.title ? `<h3 class="tile-title">${escapeHtml(pt.title)}</h3>` : ''}${pt.description ? `<p class="tile-desc">${escapeHtml(pt.description)}</p>` : ''}</div><a href="${escapeHtml(pt.link)}" class="tile-link" aria-label="${escapeHtml(pt.title || 'Promocion')}"></a></div>`;
        });
        html += '</div>';
        break;
      case 'split':
        html = '<div class="split-promo">';
        promotions.forEach((pt: any, i: number) => {
          const rev = i % 2 === 1 ? ' split-item--reverse' : '';
          html += `<a href="${escapeHtml(pt.link)}" class="split-item${rev}"><div class="split-img"><img src="${escapeHtml(pt.imageUrl)}" alt="${escapeHtml(pt.title || '')}" /></div><div class="split-text">${pt.title ? `<h3 class="split-title">${escapeHtml(pt.title)}</h3>` : ''}${pt.description ? `<p class="split-desc">${escapeHtml(pt.description)}</p>` : ''}<span class="split-link">Ver más →</span></div></a>`;
        });
        html += '</div>';
        break;
      case 'banner':
        html = '<div class="banner-promo">';
        promotions.forEach((pt: any) => {
          html += `<a href="${escapeHtml(pt.link)}" class="banner-item">${pt.title ? `<span class="banner-title">${escapeHtml(pt.title)}</span>` : ''}${pt.description ? `<span class="banner-desc">${escapeHtml(pt.description)}</span>` : ''}</a>`;
        });
        html += '</div>';
        break;
      case 'ribbon':
        html = '<div class="ribbon-promo">';
        promotions.forEach((pt: any) => {
          html += `<a href="${escapeHtml(pt.link)}" class="ribbon-item"><div class="ribbon-bg" style="background-image:url('${escapeHtml(pt.imageUrl)}')"></div><div class="ribbon-overlay"></div><div class="ribbon-content">${pt.title ? `<span class="ribbon-title">${escapeHtml(pt.title)}</span>` : ''}${pt.description ? `<span class="ribbon-desc">${escapeHtml(pt.description)}</span>` : ''}</div></a>`;
        });
        html += '</div>';
        break;
    }
    container.innerHTML = html;
    const carousel = container.querySelector(".carousel-promo");
    if (carousel) initPreviewCarousel(carousel);
  }

  // ─── IMAGE UPLOAD HANDLERS ──────────────────────────────
  const promoUploadArea = $('promo-upload-area');
  const promoInput = $('promo-input') as HTMLInputElement;
  const promoImageEl = $('promo-image') as HTMLImageElement;
  const promoEmpty = $('promo-empty');
  const promoRemove = $('promo-remove');
  const promoUploadStatus = $('promo-upload-status');
  const promoImageUrlInput = $('promo-image-url') as HTMLInputElement;

  function renderPromoImage() {
    const hasImage = hasPromoImage(promoImageState);
    if (promoEmpty) promoEmpty.style.display = hasImage ? 'none' : 'flex';
    if (promoImageEl) {
      if (hasImage) {
        promoImageEl.src = getPromoPreviewUrl(promoImageState) || '';
        promoImageEl.style.display = 'block';
      } else {
        promoImageEl.style.display = 'none';
      }
    }
    if (promoRemove) promoRemove.style.display = hasImage ? 'flex' : 'none';
  }

  async function handlePromoFile(file: File) {
    if (file.size > 5 * 1024 * 1024) {
      $('form-error')!.textContent = 'Imagen muy grande (max 5MB)';
      return;
    }

    try {
      if (promoUploadStatus) promoUploadStatus.style.display = 'flex';
      const { processImage } = await import('/src/lib/image.ts');
      const processedBlob = await processImage(file);
      promoImageState = setPromoImageFromBlob(promoImageState, processedBlob);
      renderPromoImage();
    } catch (err: any) {
      $('form-error')!.textContent = err.message || 'Error al procesar imagen';
    } finally {
      if (promoUploadStatus) promoUploadStatus.style.display = 'none';
      if (promoInput) promoInput.value = '';
    }
  }

  promoUploadArea?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.promo-remove-btn')) return;
    promoInput.click();
  });

  promoInput?.addEventListener('change', () => {
    const file = promoInput.files?.[0];
    if (file) handlePromoFile(file);
  });

  promoRemove?.addEventListener('click', (e) => {
    e.stopPropagation();
    promoImageState = clearPromoImage(promoImageState);
    if (promoImageUrlInput) promoImageUrlInput.value = '';
    renderPromoImage();
  });

  // Drag & drop
  promoUploadArea?.addEventListener('dragover', (e) => {
    e.preventDefault();
    promoUploadArea.classList.add('promo-upload-area--dragover');
  });
  promoUploadArea?.addEventListener('dragleave', () => {
    promoUploadArea.classList.remove('promo-upload-area--dragover');
  });
  promoUploadArea?.addEventListener('drop', (e) => {
    e.preventDefault();
    promoUploadArea.classList.remove('promo-upload-area--dragover');
    const file = e.dataTransfer?.files?.[0];
    if (file && file.type.startsWith('image/')) handlePromoFile(file);
  });

  // ─── DISPLAY TYPE CHANGE ────────────────────────────────
  $('display-type-select')?.addEventListener('change', async (e) => {
    const newType = (e.target as HTMLSelectElement).value;
    if (!selectedSection) return;

    const res = await fetch(`${API_URL}/api/promotion-sections/${selectedSection.id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ displayType: newType }),
    });

    if (res.ok) {
      currentDisplayType = newType;
      selectedSection.display_type = newType;
      $('tile-options')!.style.display = newType === 'tiles' ? '' : 'none';
      renderSections();
      renderPreview();
    }
  });

  // ─── MODAL ──────────────────────────────────────────────
  function openModal(isEdit: boolean, promo?: any) {
    const form = $('promo-form') as HTMLFormElement;
    form.reset();
    $('form-error')!.textContent = '';
    $('modal-title')!.textContent = isEdit ? 'Editar Anuncio' : 'Nuevo Anuncio';
    ($('promo-id') as HTMLInputElement).value = promo?.id || '';
    $('tile-options')!.style.display = currentDisplayType === 'tiles' ? '' : 'none';

    // Reset image state
    promoImageState = createEmptyPromoImageState();
    if (promoImageUrlInput) promoImageUrlInput.value = '';
    renderPromoImage();

    if (promo) {
      form.title.value = promo.title || '';
      form.description.value = promo.description || '';
      form.link.value = promo.link || '';
      form.tileCols.value = promo.tileCols || 1;
      form.tileRows.value = promo.tileRows || 1;
      form.position.value = promo.position || 0;

      // Load existing image
      if (promo.imageUrl) {
        promoImageState = setPromoImageFromUrl(promoImageState, promo.imageUrl, promo.imageId || '');
        promoImageUrlInput.value = promo.imageUrl;
        renderPromoImage();
      }
    }

    promoModal.open();
  }

  function closeModal() { promoModal.close(); }

  (window as any).editPromo = (id: string) => {
    const promo = promotions.find((p: any) => p.id === id);
    if (promo) openModal(true, promo);
  };

  (window as any).deletePromo = async (id: string) => {
    if (!confirm('¿Eliminar este anuncio?')) return;
    const res = await fetch(`${API_URL}/api/promotions/${id}`, { method: 'DELETE', credentials: 'include' });
    if (res.ok) loadPromotions();
  };

  document.addEventListener('astro:page-load', () => {
    promoUploadArea?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.promo-remove-btn')) return;
      promoInput.click();
    });

    promoInput?.addEventListener('change', () => {
      const file = promoInput.files?.[0];
      if (file) handlePromoFile(file);
    });

    promoRemove?.addEventListener('click', (e) => {
      e.stopPropagation();
      promoImageState = clearPromoImage(promoImageState);
      if (promoImageUrlInput) promoImageUrlInput.value = '';
      renderPromoImage();
    });

    promoUploadArea?.addEventListener('dragover', (e) => {
      e.preventDefault();
      promoUploadArea.classList.add('promo-upload-area--dragover');
    });
    promoUploadArea?.addEventListener('dragleave', () => {
      promoUploadArea.classList.remove('promo-upload-area--dragover');
    });
    promoUploadArea?.addEventListener('drop', (e) => {
      e.preventDefault();
      promoUploadArea.classList.remove('promo-upload-area--dragover');
      const file = e.dataTransfer?.files?.[0];
      if (file && file.type.startsWith('image/')) handlePromoFile(file);
    });

    $('display-type-select')?.addEventListener('change', async (e) => {
      const newType = (e.target as HTMLSelectElement).value;
      if (!selectedSection) return;

      const res = await fetch(`${API_URL}/api/promotion-sections/${selectedSection.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ displayType: newType }),
      });

      if (res.ok) {
        currentDisplayType = newType;
        selectedSection.display_type = newType;
        $('tile-options')!.style.display = newType === 'tiles' ? '' : 'none';
        renderSections();
        renderPreview();
      }
    });

    $('promo-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const id = ($('promo-id') as HTMLInputElement).value;
      const isEdit = !!id;
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Guardando...';

      try {
        let imageUrl = promoImageUrlInput.value;
        if (promoImageState.isNew && promoImageState.blob) {
          const fileName = 'promo.webp';
          const file = new File([promoImageState.blob], fileName, { type: 'image/webp' });
          const uploadResult = await uploadImage(file, API_URL);
          if (!uploadResult.url) {
            $('form-error')!.textContent = uploadResult.error || 'Error al subir imagen';
            submitBtn.disabled = false;
            submitBtn.textContent = 'Guardar';
            return;
          }
          imageUrl = uploadResult.url;
        }

        if (!imageUrl) {
          $('form-error')!.textContent = 'La imagen es requerida';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Guardar';
          return;
        }

        const body: any = {
          sectionId: selectedSection.id,
          imageUrl,
          title: form.title.value || null,
          description: form.description.value || null,
          link: form.link.value,
          tileCols: parseInt(form.tileCols.value) || 1,
          tileRows: parseInt(form.tileRows.value) || 1,
          position: parseInt(form.position.value) || 0,
        };

        const res = await fetch(isEdit ? `${API_URL}/api/promotions/${id}` : `${API_URL}/api/promotions`, {
          method: isEdit ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(body),
        });

        if (!res.ok) {
          const err = await res.json();
          $('form-error')!.textContent = err.error || 'Error al guardar';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Guardar';
          return;
        }

        const result = await res.json();
        const promoId = result.promotion?.id || id;

        if (promoImageState.isNew && promoId) {
          await associateImage('promotions', promoId, imageUrl, API_URL, form.title.value || undefined, { is_primary: 1, sort_order: 0 });
        }

        closeModal();
        await loadPromotions();
      } catch (err: any) {
        $('form-error')!.textContent = err.message || 'Error al guardar';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Guardar';
      }
    });

    $('add-promo-btn')?.addEventListener('click', () => openModal(false));
    $('modal-close')?.addEventListener('click', closeModal);
    $('modal-cancel')?.addEventListener('click', closeModal);
    $('modal-overlay')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) closeModal(); });

    loadSections();
  });
</script>

