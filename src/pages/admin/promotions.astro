---
/**
 * Admin Promotions — Visual Promo Editor (PM-1..PM-5, AR-2)
 *
 * Local-first WYSIWYG editor:
 *   - tiles section → grid canvas with grid-lines, percent-positioned tiles,
 *     8 resize handles (≥44px hit area), pointer-event drag/resize session
 *   - carousel/split/ribbon → reorder strip; hero/banner → simple edit form
 *   - edits are LOCAL-ONLY (zero per-interaction network); one Guardar sends
 *     the batch PUT; Cancelar/Revertir restores the snapshot
 *   - undo/redo (Ctrl/Cmd+Z/Y, cap 50), Esc cancels, arrows nudge, Delete
 *     removes, Duplicate adds on first free cell; beforeunload warns when dirty
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import Button from '../../components/Button.astro';
import PromotionWall from '../../components/PromotionWall.astro';
---

<AdminLayout title="Promociones — Admin">
  <AdminSidebar active="promotions" />
  <main class="admin-main">
    <div class="admin-header">
      <h1 class="headline-lg-mobile">Promociones</h1>
      <p class="body-md admin-subtitle">Gestiona los anuncios del sitio</p>
    </div>

    <div class="promo-layout">
      <!-- LEFT: Sections -->
      <aside class="promo-sections">
        <h2 class="label-sm sections-title">Secciones</h2>
        <div id="sections-list" class="sections-list">
          <p class="body-sm">Cargando...</p>
        </div>
      </aside>

      <!-- RIGHT: Promotions Manager -->
      <section class="promo-manager" id="promo-manager" style="display: none;">
        <div class="manager-header">
          <div>
            <h2 class="headline-lg-mobile" id="section-name">-</h2>
            <code class="slug-badge" id="section-slug">-</code>
          </div>
          <div class="manager-actions">
            <select class="form-select body-md" id="grid-cols-select" aria-label="Columnas del grid">
              <option value="1">1 columna</option>
              <option value="2">2 columnas</option>
              <option value="3">3 columnas</option>
              <option value="4">4 columnas</option>
              <option value="5">5 columnas</option>
              <option value="6">6 columnas</option>
              <option value="7">7 columnas</option>
              <option value="8">8 columnas</option>
            </select>
            <select class="form-select body-md" id="grid-rows-select" aria-label="Filas del grid">
              <option value="1">1 fila</option>
              <option value="2">2 filas</option>
              <option value="3">3 filas</option>
              <option value="4">4 filas</option>
            </select>
            <select class="form-select body-md" id="display-type-select" aria-label="Tipo de anuncio">
              <option value="tiles">Tiles</option>
              <option value="carousel">Carousel</option>
              <option value="hero">Hero</option>
              <option value="split">Split</option>
              <option value="banner">Banner</option>
              <option value="ribbon">Ribbon</option>
            </select>
            <Button variant="primary" id="add-promo-btn">+ Nuevo Anuncio</Button>
          </div>
        </div>

        <div class="type-info">
          <h4 class="label-sm type-info-title">Sobre este tipo</h4>
          <p class="body-sm type-info-desc" id="type-info-desc"></p>
        </div>

        <!-- Editor status bar: dirty state + undo/redo -->
        <div class="editor-bar">
          <span class="editor-status" id="editor-status">Sin cambios</span>
          <span class="editor-actions">
            <Button variant="secondary" id="undo-btn" type="button">↩ Deshacer</Button>
            <Button variant="secondary" id="redo-btn" type="button">↪ Rehacer</Button>
            <Button variant="secondary" id="revert-btn" type="button">Cancelar</Button>
            <Button variant="primary" id="save-btn" type="button" disabled>Guardar</Button>
          </span>
        </div>
        <p class="save-error" id="save-error" role="alert" aria-live="polite"></p>

        <!-- Onboarding hint (one-time) -->
        <div class="onboarding-hint" id="onboarding-hint">
          <p class="body-sm">Arrastrá los tiles para moverlos, usá los bordes para redimensionar y los botones de abajo para editar o reordenar. Todo se guarda con un solo clic en <strong>Guardar</strong>.</p>
          <button type="button" class="ta-btn" id="hint-dismiss">✕</button>
        </div>

        <!-- Canvas editor (tiles only) -->
        <div class="canvas-section" id="canvas-section" style="display:none;">
          <h3 class="label-sm">Editor de Tiles</h3>
          <div class="canvas-scroll" id="canvas-scroll">
            <div class="promo-canvas" id="promo-canvas"></div>
          </div>
          <p class="collision-hint" id="collision-hint" role="alert" style="display:none;"></p>
        </div>

        <!-- Reorder strip (carousel/split/ribbon) -->
        <div class="strip-section" id="strip-section" style="display:none;">
          <h3 class="label-sm">Orden de Anuncios</h3>
          <p class="body-sm strip-hint">Arrastrá para reordenar. El orden se guarda con Guardar.</p>
          <div class="promo-strip" id="promo-strip"></div>
        </div>

        <!-- Hero/banner: the real visual is the editing surface -->
        <div class="simple-section" id="simple-section" style="display:none;">
          <h3 class="label-sm">Vista del Anuncio</h3>
          <div class="simple-list" id="simple-list"></div>
        </div>
      </section>
    </div>
  </main>

<!-- Modal: Create/Edit Promotion -->
<div class="modal-overlay" id="modal-overlay" style="display: none;">
  <div class="modal modal--wide">
    <div class="modal-header">
      <h3 class="headline-lg-mobile" id="modal-title">Nuevo Anuncio</h3>
      <button class="modal-close" id="modal-close">✕</button>
    </div>
    <form class="modal-form" id="promo-form">
      <input type="hidden" id="promo-id" />
      <input type="hidden" id="promo-image-id" />

      <div class="form-row">
        <div class="form-group form-group--wide">
          <label class="label-sm">Imagen del anuncio</label>
          <div class="promo-upload-area" id="promo-upload-area">
            <div class="promo-upload-content" id="promo-upload-content">
              <div class="promo-empty" id="promo-empty">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
                <p class="body-md">Arrastra una imagen o haz clic</p>
                <p class="label-sm">PNG, JPG o WebP (max 5MB)</p>
              </div>
              <img src="" alt="" class="promo-image" id="promo-image" style="display: none;" />
            </div>
            <button type="button" class="promo-remove-btn" id="promo-remove" style="display: none;" title="Quitar imagen">✕</button>
          </div>
          <input type="file" name="promo-image" id="promo-input" accept="image/png,image/jpeg,image/webp" class="upload-input" />
          <div class="upload-status" id="promo-upload-status" style="display: none;">
            <p class="label-sm">Procesando imagen...</p>
          </div>
          <input type="hidden" name="imageUrl" id="promo-image-url" />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="label-sm">Título</label>
          <input type="text" name="title" class="form-input body-md" placeholder="Ej: Nueva Colección" />
        </div>
        <div class="form-group">
          <label class="label-sm">Link</label>
          <input type="text" name="link" class="form-input body-md" placeholder="/products/..." />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group form-group--wide">
          <label class="label-sm">Descripción</label>
          <input type="text" name="description" class="form-input body-md" placeholder="Texto corto descriptivo" />
        </div>
      </div>

      <div class="form-row" id="tile-options">
        <div class="form-group">
          <label class="label-sm">Ancho (tile)</label>
          <select name="width" class="form-select body-md">
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
            <option value="7">7</option>
            <option value="8">8</option>
          </select>
        </div>
        <div class="form-group">
          <label class="label-sm">Alto (tile)</label>
          <select name="height" class="form-select body-md">
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
          </select>
        </div>
      </div>

      <div class="form-error" id="form-error"></div>
      <div class="form-actions">
        <Button variant="secondary" type="button" id="modal-cancel">Cancelar</Button>
        <Button variant="primary" type="submit">Guardar</Button>
      </div>
    </form>
  </div>
</div>
</AdminLayout>

<script>
  import { escapeHtml } from '../../lib/escape-html';
  import { getProductImageUrl } from '../../lib/public-api';
  import { buildPromoPreviewHtml, type PromoPreview } from '../../lib/promo-preview';
  import { processImage } from '../../lib/image';
  import { uploadImageBlob, associateImage, deleteImage, deleteUploadedFile, fetchEntityImages } from '../../lib/image-utils';
  import { wrapModal } from '../../lib/modalHelper';
  import { getApiUrl } from '../../lib/api-url';
  import {
    clampTile, dragToCell, resizeToSpans, detectCollisions, renumberOrder,
    autoSuggestPosition, type Grid, type GridTile,
  } from '../../lib/promo-grid';
  import {
    createEditorState, createSnapshot, isDirty, revert, toSavePayload,
    applySavedResponse, movePromotion, removePromotion, duplicatePromotion,
    addPromotion, updatePromotion, setSection, createHistory, pushHistory,
    undoEditor, redoEditor, shouldWarnBeforeUnload, validatePromotionsForSave,
    extractFilename, resolvePromoImage, orphanedDraftUrls, draftUrlReferenced, localKey,
    historyDraftUrls, revokeDraftUrlsOnce, survivingImageReferences,
    stripHoverIndex, isPromoEditorRoute,
    type EditorPromotion, type PromoEditorState, type EditorHistory,
  } from '../../lib/promo-editor';
  import {
    clientToCell, cellSizeForGrid, renderTileCanvasHtml, renderGridLines,
  } from '../../lib/promo-canvas';

  const API_URL = getApiUrl();
  const $ = (id: string) => document.getElementById(id);

  // ─── STATE ─────────────────────────────────────────────────────────
  let sections: any[] = [];
  let state: PromoEditorState | null = null;
  let snapshot: PromoEditorState | null = null;
  let history: EditorHistory = createHistory();
  let selectedId: string | null = null;
  let currentDisplayType = 'tiles';
  // Empty-cell tap target: when the new-promo modal saves, the promo lands on
  // this cell instead of autoSuggestPosition.
  let pendingPromoCell: { x: number; y: number } | null = null;
  // Canvas MutationObserver for the selected-tile highlight; disconnected on
  // ClientRouter teardown so it cannot leak the old page's DOM.
  let canvasObserver: MutationObserver | null = null;

  // Modal image fields (local-only until Guardar).
  let modalImageBlob: Blob | null = null;
  let modalImageUrl: string | null = null;
  let modalImageId: string | null = null;
  let modalPreviousUrl: string | null = null;
  // Draft object URL for the current modal session (applied to the working
  // promo immediately on pick) plus the promo's draft when the modal opened.
  let modalDraftUrl: string | null = null;
  let modalPrevDraftUrl: string | null = null;

  // R2 cleanup targets gathered at save time.
  let cleanupUrls: string[] = [];
  let uploadedThisSave: string[] = [];
  // Auto-clear timer for the success status shown in #save-error.
  let saveStatusTimer: ReturnType<typeof setTimeout> | null = null;

  const typeInfo: Record<string, string> = {
    tiles: "El tipo Tiles muestra tus anuncios en un grid de cuadros. Cada anuncio puede ocupar diferente cantidad de espacio (1x1, 2x2, etc). Arrastrá para mover, redimensioná desde los bordes.",
    carousel: "El tipo Carousel muestra un anuncio a la vez como un slideshow que cambia automaticamente. Arrastrá la franja para ordenar.",
    hero: "El tipo Hero es un banner grande que ocupa todo el ancho con imagen de fondo y texto centrado. Solo muestra el primer anuncio.",
    split: "El tipo Split muestra imagen a un lado y texto al otro, alternando la direccion.",
    banner: "El tipo Banner es una franja con texto centrado y borde decorativo. Sin imagenes.",
    ribbon: "El tipo Ribbon es una cinta horizontal con varios anuncios lado a lado.",
  };

  function updateTypeInfo(type: string) {
    const desc = $('type-info-desc');
    if (desc) desc.textContent = typeInfo[type] || '';
  }

  function isTiles(): boolean {
    return currentDisplayType === 'tiles';
  }

  // ─── LOAD SECTIONS ────────────────────────────────────────────────
  async function loadSections() {
    try {
      const res = await fetch(`${API_URL}/api/promotion-sections`, { credentials: 'include' });
      if (res.status === 401) { window.location.href = '/login'; return; }
      if (!res.ok) throw new Error('Error');
      const data = await res.json();
      sections = data.sections || [];
      renderSections();
    } catch (err) {
      $('sections-list')!.innerHTML = '<p class="body-sm">Error al cargar</p>';
    }
  }

  function renderSections() {
    if (sections.length === 0) {
      $('sections-list')!.innerHTML = '<p class="body-sm">No hay secciones</p>';
      return;
    }
    $('sections-list')!.innerHTML = sections.map((s: any) => `
      <div class="section-card ${selectedSectionId() === s.id ? 'active' : ''}" data-id="${escapeHtml(s.id)}">
        <div class="section-card-header">
          <div>
            <strong class="body-md">${escapeHtml(s.name)}</strong>
            <code class="slug-badge">${escapeHtml(s.slug)}</code>
          </div>
          <span class="badge badge--active">${escapeHtml(s.grid_cols)}×${escapeHtml(s.grid_rows)}</span>
        </div>
      </div>
    `).join('');

    $('sections-list')!.querySelectorAll('.section-card').forEach((card) => {
      card.addEventListener('click', () => {
        const id = (card as HTMLElement).dataset.id;
        if (id && !warnIfDirty()) selectSection(id);
      });
    });
  }

  function selectedSectionId(): string | null {
    return state ? state.section.id : null;
  }

  async function selectSection(sectionId: string) {
    const serverSection = sections.find((s: any) => s.id === sectionId);
    if (!serverSection) return;

    // Fetch promotions for the section.
    let promotions: any[] = [];
    try {
      const res = await fetch(`${API_URL}/api/promotions?section=${serverSection.slug}`, { credentials: 'include' });
      if (res.ok) {
        const data = await res.json();
        promotions = data.promotions || [];
      }
    } catch { /* keep empty */ }

    const editorSection = {
      id: serverSection.id,
      name: serverSection.name,
      slug: serverSection.slug,
      gridCols: serverSection.grid_cols || 4,
      gridRows: serverSection.grid_rows || 1,
      displayType: serverSection.display_type || 'tiles',
    };

    const outgoing = state;
    const nextState = createEditorState(editorSection, promotions);
    const discardedDrafts = outgoing
      ? [
          ...historyDraftUrls(history),
          ...orphanedDraftUrls(outgoing.promotions, nextState.promotions, { past: [], future: [] }),
          ...outgoing.removedDraftUrls,
        ]
      : [];
    state = nextState;
    snapshot = createSnapshot(state);
    history = createHistory();
    // Superseded picks survive only in discarded history stacks: release them
    // once, skipping any draft the new section state still holds.
    revokeDraftUrlsOnce(discardedDrafts, state.promotions);
    currentDisplayType = editorSection.displayType;
    selectedId = null;

    $('section-name')!.textContent = editorSection.name;
    $('section-slug')!.textContent = editorSection.slug;
    ($('grid-cols-select') as HTMLSelectElement).value = String(editorSection.gridCols);
    ($('grid-rows-select') as HTMLSelectElement).value = String(editorSection.gridRows);
    ($('display-type-select') as HTMLSelectElement).value = currentDisplayType;
    $('promo-manager')!.style.display = '';
    updateTypeInfo(currentDisplayType);
    renderSections();
    renderAll();
  }

  // ─── RENDERING ────────────────────────────────────────────────────
  function renderAll() {
    if (!state) return;
    renderEditor();
    renderStatus();
  }

  function renderEditor() {
    if (!state) return;
    const canvasSection = $('canvas-section')!;
    const stripSection = $('strip-section')!;
    const simpleSection = $('simple-section')!;
    const tileOptions = $('tile-options')!;

    canvasSection.style.display = isTiles() ? '' : 'none';
    stripSection.style.display = isTiles() ? 'none' : (currentDisplayType === 'hero' || currentDisplayType === 'banner' ? 'none' : '');
    simpleSection.style.display = currentDisplayType === 'hero' || currentDisplayType === 'banner' ? '' : 'none';
    tileOptions.style.display = isTiles() ? '' : 'none';

    if (isTiles()) renderCanvas();
    else if (currentDisplayType === 'hero' || currentDisplayType === 'banner') renderSimpleEdit();
    else renderStrip();
  }

  function grid(): Grid {
    return { cols: state?.section.gridCols || 4, rows: state?.section.gridRows || 1 };
  }

  function renderCanvas() {
    if (!state) return;
    const container = $('promo-canvas');
    if (!container) return;

    const scroll = $('canvas-scroll')!;
    const desktop = window.innerWidth >= 768;
    const availW = scroll.clientWidth || container.clientWidth || 600;
    const cell = cellSizeForGrid(grid(), availW, desktop);
    container.style.width = `${grid().cols * cell}px`;
    container.style.height = `${grid().rows * cell}px`;

    const tiles = state.promotions.map((p) => ({
      id: localKey(p),
      posX: p.posX,
      posY: p.posY,
      width: p.width,
      height: p.height,
      title: p.title,
      subtitle: p.subtitle,
      imageUrl: p.imageUrl,
      localImageUrl: p.localImageUrl,
      link: p.link,
    }));

    container.innerHTML = renderGridLines(grid(), cell) + renderTileCanvasHtml(tiles, grid(), selectedId);
    if (selectedId) {
      const sel = container.querySelector<HTMLElement>(`.canvas-tile[data-id="${selectedId}"]`);
      if (sel) {
        const dup = document.createElement('button');
        dup.type = 'button';
        dup.className = 'tile-dup';
        dup.dataset.action = 'duplicate';
        dup.setAttribute('aria-label', 'Duplicar tile');
        dup.textContent = '⧉';
        dup.addEventListener('pointerdown', (e) => e.stopPropagation());
        dup.addEventListener('click', (e) => {
          e.stopPropagation();
          doDuplicate(selectedId);
        });
        sel.appendChild(dup);
      }
    }
  }

  function renderStrip() {
    if (!state) return;
    const strip = $('promo-strip')!;
    strip.innerHTML = state.promotions.map((p, i) => {
      const imgSrc = resolvePromoImage(p);
      const hasImage = !!(p.imageUrl || p.localImageUrl);
      return `
        <div class="strip-item" data-index="${i}" data-id="${escapeHtml(localKey(p))}">
          <span class="strip-grip">⋮⋮</span>
          ${hasImage ? `<img src="${escapeHtml(imgSrc)}" alt="" />` : '<span class="strip-noimg">Sin imagen</span>'}
          <div class="strip-info">
            <strong class="body-sm">${escapeHtml(p.title || '(sin título)')}</strong>
            <span class="body-xs">${escapeHtml(p.link)}</span>
          </div>
          <span class="badge badge--active">#${i + 1}</span>
          <button type="button" class="strip-delete" data-action="delete" data-local-key="${escapeHtml(localKey(p))}" aria-label="Eliminar anuncio">🗑</button>
        </div>
      `;
    }).join('');

    strip.querySelectorAll<HTMLElement>('.strip-item').forEach((item) => {
      item.addEventListener('pointerdown', beginStripPointerSession);
    });
    strip.querySelectorAll<HTMLElement>('[data-action="delete"]').forEach((btn) => {
      const key = btn.dataset.localKey;
      if (!key) return;
      btn.addEventListener('pointerdown', (e) => e.stopPropagation());
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        doRemove(key);
      });
    });
  }

  /**
   * Pointer-session reorder for the carousel/split/ribbon strip. HTML5
   * drag-and-drop does not work on touch; pointer events do. One history entry
   * per completed gesture; a tap without a drag opens the edit modal.
   */
  function beginStripPointerSession(e: PointerEvent) {
    if (!state) return;
    const strip = $('promo-strip')!;
    const item = (e.target as HTMLElement)?.closest?.('.strip-item') as HTMLElement | null;
    if (!item || !strip.contains(item)) return;
    const items = Array.from(strip.querySelectorAll<HTMLElement>('.strip-item'));
    const from = items.indexOf(item);
    if (from < 0) return;

  const pointerId = e.pointerId;
    try { item.setPointerCapture(pointerId); } catch { /* synthetic event */ }

    const prevState = state;
    const startY = e.clientY;
    const DRAG_THRESHOLD_PX = 5;
    let didDrag = false;
    let hoverIndex = from;

    const clearHover = () => {
      strip.querySelectorAll('.strip-item--target').forEach((el) => el.classList.remove('strip-item--target'));
    };

    const moveHandler = (ev: PointerEvent) => {
      if (Math.abs(ev.clientY - startY) > DRAG_THRESHOLD_PX) didDrag = true;
      const current = Array.from(strip.querySelectorAll<HTMLElement>('.strip-item'));
      const boxes = current.map((el) => {
        const r = el.getBoundingClientRect();
        return { top: r.top, bottom: r.bottom };
      });
      const target = stripHoverIndex(boxes, ev.clientY);
      clearHover();
      if (target >= 0 && target !== from) {
        hoverIndex = target;
        current[target].classList.add('strip-item--target');
      } else {
        hoverIndex = from;
      }
    };

    const upHandler = () => {
      try { item.releasePointerCapture(pointerId); } catch { /* synthetic event */ }
      strip.removeEventListener('pointermove', moveHandler);
      strip.removeEventListener('pointerup', upHandler);
      strip.removeEventListener('pointercancel', upHandler);
      clearHover();
      if (!state) return;
      if (didDrag) {
        if (hoverIndex !== from) {
          const reordered = movePromotion(state, from, hoverIndex);
          state = { ...reordered, promotions: renumberOrder(reordered.promotions) };
          history = pushHistory(history, prevState);
          selectedId = state.promotions[hoverIndex]?.id || null;
          renderAll();
        }
        return;
      }
      // Tap without a drag opens the edit modal.
      const promo = state.promotions[from];
      if (promo) openModal(true, promo);
    };

    strip.addEventListener('pointermove', moveHandler);
    strip.addEventListener('pointerup', upHandler);
    strip.addEventListener('pointercancel', upHandler);
  }

  function renderSimpleEdit() {
    if (!state) return;
    const list = $('simple-list')!;
    if (state.promotions.length === 0) {
      list.innerHTML = '<p class="body-sm">Sin anuncios</p>';
      return;
    }
    const previews: PromoPreview[] = state.promotions.map((p) => ({
      id: p.id || localKey(p),
      title: p.title,
      subtitle: p.subtitle,
      imageUrl: p.imageUrl || '',
      localImageUrl: p.localImageUrl,
      link: p.link,
      position: p.posX,
      posY: p.posY,
      tileCols: p.width,
      tileRows: p.height,
    }));
    list.innerHTML = buildPromoPreviewHtml(currentDisplayType, previews, grid().cols);
    list.querySelectorAll<HTMLElement>('[data-action="edit"]').forEach((btn) => {
      const key = btn.dataset.localKey;
      const p = key ? state!.promotions.find((pp) => localKey(pp) === key) : undefined;
      if (p) btn.addEventListener('click', () => openModal(true, p));
    });
    list.querySelectorAll<HTMLElement>('[data-action="delete"]').forEach((btn) => {
      const key = btn.dataset.localKey;
      const p = key ? state!.promotions.find((pp) => localKey(pp) === key) : undefined;
      if (p) btn.addEventListener('click', (e) => {
        e.stopPropagation();
        doRemove(key);
      });
    });
  }

  /** Toggle a button's disabled state AND its aria-disabled (a11y sync). */
  function setButtonDisabled(id: string, disabled: boolean) {
    const btn = $(id) as HTMLButtonElement | null;
    if (!btn) return;
    btn.disabled = disabled;
    btn.setAttribute('aria-disabled', String(disabled));
  }

  function renderStatus() {
    if (!state || !snapshot) return;
    const dirty = isDirty(state, snapshot);
    $('editor-status')!.textContent = dirty ? 'Cambios sin guardar' : 'Sin cambios';
    setButtonDisabled('save-btn', !dirty);
    setButtonDisabled('undo-btn', history.past.length === 0);
    setButtonDisabled('redo-btn', history.future.length === 0);
  }

  // ─── POINTER SESSION (canvas drag/resize) ─────────────────────────
  /**
   * Convert a pointer event to grid cells. `rect` is the canvas rect FROZEN at
   * pointerdown: the canvas can shift mid-drag (the collision hint appearing,
   * the onboarding hint reflowing), and re-reading getBoundingClientRect per
   * event would corrupt the cell mapping. Anchoring every move to the
   * gesture-start geometry keeps the tile under the pointer.
   */
  function canvasCellForEvent(e: PointerEvent, rect?: DOMRect): { x: number; y: number } | null {
    const canvas = $('promo-canvas');
    if (!canvas) return null;
    const r = rect || canvas.getBoundingClientRect();
    const cell = cellSizeForGrid(grid(), canvas.clientWidth || r.width, window.innerWidth >= 768);
    return clientToCell(e.clientX - r.left, e.clientY - r.top, cell, grid());
  }

  /**
   * Geometric fallback for the pointer's hit target. Synthetic PointerEvents
   * (e2e dispatch) fire on the canvas itself (e.target = canvas), and the
   * canvas routinely sits BELOW the viewport fold — so document.elementFromPoint
   * returns null there. getBoundingClientRect still yields true viewport
   * coordinates off-screen, so we hit-test the tiles' boxes directly.
   * Topmost tile wins (reverse DOM order); a resize handle wins over its tile
   * when the pointer is inside the handle's visible 12px box.
   */
  function pointerHitElement(e: PointerEvent): HTMLElement | null {
    const canvas = $('promo-canvas');
    if (!canvas) return null;
    const tiles = Array.from(canvas.querySelectorAll<HTMLElement>('.canvas-tile'));
    for (let i = tiles.length - 1; i >= 0; i--) {
      const r = tiles[i].getBoundingClientRect();
      if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) continue;
      const handles = Array.from(tiles[i].querySelectorAll<HTMLElement>('.resize-handle'));
      for (const h of handles) {
        const hr = h.getBoundingClientRect();
        if (e.clientX >= hr.left && e.clientX <= hr.right && e.clientY >= hr.top && e.clientY <= hr.bottom) return h;
      }
      return tiles[i];
    }
    return null;
  }

  function beginPointerSession(e: PointerEvent) {
    if (!state) return;
    const canvas = $('promo-canvas') as HTMLElement;
    if (!canvas) return;
    // Resolve the tile/handle UNDER THE POINTER. Real pointerdown already
    // targets the correct element; synthetic PointerEvents (e2e touch/mouse
    // dispatch) fire on the canvas itself, so fall back to a geometric
    // hit-test that also works when the canvas is below the fold.
    const hitEl = (e.target as HTMLElement)?.closest?.('.canvas-tile, .resize-handle') as HTMLElement | null
      ?? pointerHitElement(e);
    const target = hitEl?.closest('.canvas-tile') as HTMLElement | null;
    const handleEl = hitEl?.closest('.resize-handle') as HTMLElement | null;
    if (!target) {
      // Pointer on the canvas background: a tap (no movement) opens the
      // new-promo modal pre-positioned at the tapped cell (FIX-2).
      beginEmptyCellTap(e);
      return;
    }

    // Freeze the canvas geometry for the whole gesture (see canvasCellForEvent).
    const sessionRect = canvas.getBoundingClientRect();

    const tileId = target.dataset.id;
    if (!tileId) return;
    const promoIndex = state.promotions.findIndex((p) => localKey(p) === tileId);
    const promo = state.promotions[promoIndex];
    if (!promo) return;

    // NOTE: no e.preventDefault() here — canceling pointerdown would suppress
    // the compatibility `click` event, breaking click-to-edit on tiles.
    // Text selection during drags is prevented by `user-select: none` on the
    // canvas; the post-drag click is suppressed in upHandler.
    const handle = handleEl?.dataset.handle || null;

    // Grab offset: keep the tile under the finger (AD "Drag anchor").
    const cell = canvasCellForEvent(e, sessionRect);
    if (!cell) return;
    const grabDx = cell.x - promo.posX;
    const grabDy = cell.y - promo.posY;

    const pointerId = e.pointerId;
    // Synthetic PointerEvents (e2e touch dispatch) have no active pointer, so
    // capture is best-effort — real input still captures to keep tracking
    // stable outside the canvas.
    try { canvas.setPointerCapture(pointerId); } catch { /* synthetic event */ }

    // Pre-gesture snapshot: undo must return the tile to its prior cell
    // (PM-3), so the history entry is the pointerdown state, not the end one.
    const gestureStart = state;

    // Set once the gesture actually moves the tile; used to suppress the
    // click that follows a real drag (so dragging does NOT open the modal).
    let didDrag = false;

    const moveHandler = (ev: PointerEvent) => {
      if (!state) return;
      const c = canvasCellForEvent(ev, sessionRect);
      if (!c) return;
      const tile: GridTile = {
        id: promo.id || 'local',
        posX: promo.posX, posY: promo.posY, width: promo.width, height: promo.height,
      };
      const next = handle
        ? resizeToSpans(tile, c, handle as any, grid())
        : dragToCell(tile, { x: c.x - grabDx, y: c.y - grabDy }, grid());
      if (next.posX !== promo.posX || next.posY !== promo.posY || next.width !== promo.width || next.height !== promo.height) {
        didDrag = true;
      }
      const movedKey = localKey(promo);
      state = {
        ...state,
        promotions: state.promotions.map((p, i) =>
          i === promoIndex
            ? { ...p, posX: next.posX, posY: next.posY, width: next.width, height: next.height }
            : p
        ),
      };
      renderCanvas();
      // The moved tile's localKey changes with its position, so derive it from
      // the CURRENT state (post-update) or the hint lookup misses unsaved tiles.
      const moved = state.promotions[promoIndex];
      showCollisionHint(moved ? localKey(moved) : movedKey);
    };

    const upHandler = (ev: PointerEvent) => {
      try { canvas.releasePointerCapture(pointerId); } catch { /* synthetic event */ }
      canvas.removeEventListener('pointermove', moveHandler);
      canvas.removeEventListener('pointerup', upHandler);
      canvas.removeEventListener('pointercancel', upHandler);
      // Click-to-edit: pointerdown+up WITHOUT movement is a click on the tile.
      // setPointerCapture on pointerdown suppresses the native `click` event,
      // so the editor owns click detection (dragging never opens the modal).
      if (!didDrag && !handle) {
        const id = target.dataset.id;
        const promo = state?.promotions.find((p) => localKey(p) === id);
        if (promo) {
          selectedId = localKey(promo);
          openModal(true, promo);
          return;
        }
      }
      if (!state) return;
      // One history entry per completed gesture: the PRE-gesture snapshot,
      // so Ctrl+Z returns the tile to its prior cell instead of a no-op.
      history = pushHistory(history, gestureStart);
      renderAll();
    };

    canvas.addEventListener('pointermove', moveHandler);
    canvas.addEventListener('pointerup', upHandler);
    canvas.addEventListener('pointercancel', upHandler);
  }

  /**
   * Tap on the canvas background: open the new-promo modal pre-positioned at
   * the tapped cell. Pointer capture retargets the native click to the canvas
   * itself, so a click listener cannot tell tile clicks from background
   * clicks — the tap is detected in the pointer session like tile click-to-edit.
   */
  function beginEmptyCellTap(e: PointerEvent) {
    if (!state || !isTiles()) return;
    const canvas = $('promo-canvas') as HTMLElement;
    if (!canvas) return;
    const cell = canvasCellForEvent(e);
    if (!cell) return;

    const startX = e.clientX;
    const startY = e.clientY;
    const TAP_SLOP_PX = 5;

    const cleanup = () => {
      canvas.removeEventListener('pointermove', onMove);
      canvas.removeEventListener('pointerup', onUp);
      canvas.removeEventListener('pointercancel', onCancel);
    };
    const onMove = (ev: PointerEvent) => {
      // Moving beyond the slop turns the tap into a no-op background drag.
      if (Math.abs(ev.clientX - startX) > TAP_SLOP_PX || Math.abs(ev.clientY - startY) > TAP_SLOP_PX) cleanup();
    };
    const onUp = () => {
      cleanup();
      if (!state || !isTiles()) return;
      pendingPromoCell = cell;
      openModal(false);
    };
    const onCancel = cleanup;

    canvas.addEventListener('pointermove', onMove);
    canvas.addEventListener('pointerup', onUp);
    canvas.addEventListener('pointercancel', onCancel);
  }

  function showCollisionHint(movedId: string) {
    if (!state) return;
    const hint = $('collision-hint')!;
    const tiles: GridTile[] = state.promotions.map((p) => ({
      id: localKey(p), posX: p.posX, posY: p.posY, width: p.width, height: p.height,
    }));
    const collisions = detectCollisions(tiles, movedId || tiles[0]?.id || '');
    if (collisions.length > 0) {
      hint.textContent = `⚠️ Este tile se superpone con otro. Podés dejarlo así o moverlo.`;
      hint.style.display = '';
    } else {
      hint.style.display = 'none';
    }
  }

  // ─── KEYBOARD ─────────────────────────────────────────────────────
  function onKeydown(e: KeyboardEvent) {
    if (!state) return;
    if ((e.target as HTMLElement)?.closest?.('input, select, textarea')) return;

    const isUndo = (e.ctrlKey || e.metaKey) && (e.key === 'z' || e.key === 'Z');
    const isRedo = (e.ctrlKey || e.metaKey) && (e.key === 'y' || e.key === 'Y');
    const isDuplicate = (e.ctrlKey || e.metaKey) && (e.key === 'd' || e.key === 'D');
    if (isUndo) { e.preventDefault(); doUndo(); return; }
    if (isRedo) { e.preventDefault(); doRedo(); return; }
    if (isDuplicate) {
      if (selectedId && isTiles()) { e.preventDefault(); doDuplicate(selectedId); }
      return;
    }

    if (e.key === 'Escape') {
      selectedId = null;
      renderCanvas();
      return;
    }
    if (e.key === 'Delete' || e.key === 'Backspace') {
      if (selectedId) { e.preventDefault(); doRemove(selectedId); }
      return;
    }
    if (e.key.startsWith('Arrow') && selectedId && isTiles()) {
      e.preventDefault();
      if (e.repeat) return; // coalesce repeats (AD "Undo granularity")
      const promo = state.promotions.find((p) => localKey(p) === selectedId);
      if (!promo) return;
      const prev = state;
      const dx = e.key === 'ArrowLeft' ? -1 : e.key === 'ArrowRight' ? 1 : 0;
      const dy = e.key === 'ArrowUp' ? -1 : e.key === 'ArrowDown' ? 1 : 0;
      const next = clampTile(
        { id: promo.id || 'local', posX: promo.posX + dx, posY: promo.posY + dy, width: promo.width, height: promo.height },
        grid()
      );
      state = {
        ...state,
        promotions: state.promotions.map((p) =>
          localKey(p) === selectedId
            ? { ...p, posX: next.posX, posY: next.posY }
            : p
        ),
      };
      history = pushHistory(history, prev);
      renderAll();
    }
  }

  function doUndo() {
    if (!state) return;
    const undone = undoEditor(history, state);
    if (!undone) return;
    orphanedDraftUrls(state.promotions, undone.state.promotions, undone.history).forEach((u) => URL.revokeObjectURL(u));
    state = undone.state;
    history = undone.history;
    renderAll();
  }

  function doRedo() {
    if (!state) return;
    const redone = redoEditor(history, state);
    if (!redone) return;
    orphanedDraftUrls(state.promotions, redone.state.promotions, redone.history).forEach((u) => URL.revokeObjectURL(u));
    state = redone.state;
    history = redone.history;
    renderAll();
  }

  // ─── MUTATIONS ────────────────────────────────────────────────────
  function doRemove(id: string) {
    if (!state) return;
    const prev = state;
    const before = state.promotions;
    const next = removePromotion(state, id);
    const nextHistory = pushHistory(history, prev);
    orphanedDraftUrls(before, next.promotions, nextHistory).forEach((u) => URL.revokeObjectURL(u));
    state = next;
    history = nextHistory;
    selectedId = null;
    renderAll();
  }

  function doDuplicate(id: string) {
    if (!state) return;
    const prev = state;
    state = duplicatePromotion(state, id);
    if (state !== prev) {
      history = pushHistory(history, prev);
      const added = state.promotions.find((p) => p.id === null && !prev.promotions.includes(p));
      selectedId = added ? localKey(added) : null;
      renderAll();
    }
  }

  function doAdd() {
    if (!state) return;
    pendingPromoCell = null;
    openModal(false);
  }

  function doRevert() {
    if (!state || !snapshot) return;
    if (!confirm('¿Descartar los cambios sin guardar?')) return;
    const before = state.promotions;
    const discardedDrafts = [
      ...historyDraftUrls(history),
      ...orphanedDraftUrls(before, snapshot.promotions),
      ...state.removedDraftUrls,
    ];
    state = revert(state, snapshot);
    history = createHistory();
    // Superseded picks and removed promos die with the discarded stacks: the
    // union revokes each once, skipping drafts the reverted state still holds.
    revokeDraftUrlsOnce(discardedDrafts, state.promotions);
    selectedId = null;
    renderAll();
  }

  function warnIfDirty(): boolean {
    if (!state || !snapshot) return false;
    if (shouldWarnBeforeUnload(state, snapshot)) {
      return !confirm('Hay cambios sin guardar. ¿Descartarlos?');
    }
    return false;
  }

  // ─── MODAL ────────────────────────────────────────────────────────
  // Esc/browser-back close via modalStack.closeTop() never reaches
  // cancelModal, so onClose owns the cleanup for an uncommitted draft.
  let modalSubmitted = false;

  const promoModal = wrapModal('modal-overlay', {
    onClose: () => {
      if (modalSubmitted) return;
      discardModalDraft();
      pendingPromoCell = null;
      renderAll();
    },
  });

  function openModal(isEdit: boolean, promo?: EditorPromotion) {
    const form = $('promo-form') as HTMLFormElement;
    form.reset();
    modalSubmitted = false;
    $('form-error')!.textContent = '';
    $('modal-title')!.textContent = isEdit ? 'Editar Anuncio' : 'Nuevo Anuncio';
    // Key the modal by localKey so editing an UNSAVED promo updates the working
    // copy instead of addPromotion creating a duplicate (F5).
    ($('promo-id') as HTMLInputElement).value = promo ? localKey(promo) : '';
    ($('promo-image-id') as HTMLInputElement).value = promo?.imageId || '';

    modalImageBlob = null;
    modalImageUrl = promo?.imageUrl || null;
    modalImageId = promo?.imageId || null;
    modalPreviousUrl = promo?.imageUrl || null;
    modalDraftUrl = promo?.localImageUrl || null;
    modalPrevDraftUrl = promo?.localImageUrl || null;
    renderModalImage();

    if (promo) {
      form.title.value = promo.title || '';
      form.description.value = promo.subtitle || '';
      form.link.value = promo.link || '';
      form.width.value = String(promo.width || 1);
      form.height.value = String(promo.height || 1);
    } else {
      form.width.value = '1';
      form.height.value = '1';
    }

    promoModal.open();
  }

  function closeModal() { promoModal.close(); }

  function discardModalDraft() {
    if (state) {
      const id = ($('promo-id') as HTMLInputElement).value;
      if (id) {
        const before = state.promotions;
        state = updatePromotion(state, id, { localImageUrl: modalPrevDraftUrl });
        orphanedDraftUrls(before, state.promotions).forEach((u) => URL.revokeObjectURL(u));
      } else if (modalDraftUrl) {
        URL.revokeObjectURL(modalDraftUrl);
      }
    } else if (modalDraftUrl) {
      URL.revokeObjectURL(modalDraftUrl);
    }
    modalDraftUrl = null;
  }

  function cancelModal() {
    discardModalDraft();
    promoModal.close();
  }

  function renderModalImage() {
    const hasImage = !!(modalImageBlob || modalImageUrl || modalDraftUrl);
    $('promo-empty')!.style.display = hasImage ? 'none' : 'flex';
    const img = $('promo-image') as HTMLImageElement;
    if (hasImage) {
      img.src = modalDraftUrl || getProductImageUrl(modalImageUrl);
      img.style.display = 'block';
    } else {
      img.style.display = 'none';
    }
    ($('promo-remove') as HTMLElement).style.display = hasImage ? 'flex' : 'none';
    ($('promo-image-url') as HTMLInputElement).value = modalImageUrl || '';
  }

  async function handlePromoFile(file: File) {
    if (file.size > 5 * 1024 * 1024) {
      $('form-error')!.textContent = 'Imagen muy grande (max 5MB)';
      return;
    }
    try {
      $('promo-upload-status')!.style.display = 'flex';
      const processed = await processImage(file);
      // If replacing an existing image, remember the old R2 url for cleanup.
      if (modalImageUrl && !modalPreviousUrl) modalPreviousUrl = modalImageUrl;
      const url = URL.createObjectURL(processed);
      // A URL created earlier in THIS session is superseded; the pre-modal
      // draft stays alive until Cancelar/Guardar decides its fate.
      if (modalDraftUrl && modalDraftUrl !== modalPrevDraftUrl) URL.revokeObjectURL(modalDraftUrl);
      modalImageBlob = processed;
      modalImageUrl = null;
      modalDraftUrl = url;
      // Reflect the draft on the working promo immediately (before Guardar).
      const id = ($('promo-id') as HTMLInputElement).value;
      if (id && state) {
        state = updatePromotion(state, id, { localImageUrl: url });
        renderAll();
      }
      renderModalImage();
    } catch (err: any) {
      $('form-error')!.textContent = err.message || 'Error al procesar imagen';
    } finally {
      $('promo-upload-status')!.style.display = 'none';
      ($('promo-input') as HTMLInputElement).value = '';
    }
  }

  function removeModalImage() {
    if (modalImageUrl && !modalPreviousUrl) modalPreviousUrl = modalImageUrl;
    // Drop the session draft; the pre-modal draft stays alive until
    // Cancelar/Guardar decides its fate.
    if (modalDraftUrl && modalDraftUrl !== modalPrevDraftUrl) URL.revokeObjectURL(modalDraftUrl);
    modalImageBlob = null;
    modalImageUrl = null;
    modalDraftUrl = null;
    // The draft was applied to the working promo at pick time: clear it there
    // too so the surface never holds a revoked URL (cancel restores the old).
    const id = ($('promo-id') as HTMLInputElement).value;
    if (id && state) {
      state = updatePromotion(state, id, { localImageUrl: null });
      renderAll();
    }
    renderModalImage();
  }

  // ─── SAVE (single Guardar → batch PUT) ───────────────────────────
  async function doSave() {
    if (!state || !snapshot) return;
    if (!isDirty(state, snapshot)) return;

    // Per-tile title validation BEFORE Guardar: the backend 400s the WHOLE
    // batch on a blank title, so name the offending tile here (F10). Surfaced
    // in #save-error (always visible), not #form-error (hidden modal).
    if (saveStatusTimer) { clearTimeout(saveStatusTimer); saveStatusTimer = null; }
    $('save-error')!.classList.remove('save-error--success');
    $('save-error')!.textContent = '';
    const validationError = validatePromotionsForSave(state.promotions);
    if (validationError) {
      $('save-error')!.textContent = validationError;
      return;
    }

    const saveBtn = $('save-btn') as HTMLButtonElement;
    setButtonDisabled('save-btn', true);
    saveBtn.textContent = 'Guardando...';
    uploadedThisSave = [];
    let committed = false;

    try {
      // 1. Upload pending blobs (best-effort per blob).
      const resolvedUrls: Record<string, string | null> = {};
      // New promos have no server id yet: their uploaded URL lands directly
      // in the payload item (toSavePayload reads state.imageUrl).
      let saveState = state;
      for (const p of saveState.promotions) {
        if (!p.imageBlob) continue;
        try {
          const result = await uploadImageBlob(p.imageBlob, 'promo.webp', API_URL);
          if (!result.url) throw new Error('Upload falló');
          uploadedThisSave.push(result.url);
          if (p.id) {
            resolvedUrls[p.id] = result.url;
          } else {
            saveState = {
              ...saveState,
              promotions: saveState.promotions.map((pp) => (pp === p ? { ...pp, imageUrl: result.url } : pp)),
            };
          }
        } catch {
          throw new Error('Error al subir imagen');
        }
      }

      // 2. Build payload with resolved upload URLs.
      const payload = toSavePayload(saveState, resolvedUrls);

      // 2b. Capture R2 cleanup targets BEFORE applySavedResponse resets
      // state.deletedImageUrls (F6): removed promos' image URLs live there.
      const removedImageUrls = [...saveState.deletedImageUrls];
      // Same for removed promos' draft object URLs: they leave the live set
      // once their history snapshot is discarded at the end of doSave.
      const removedDraftUrls = [...saveState.removedDraftUrls];

      // 3. Batch PUT.
      const res = await fetch(`${API_URL}/api/promotion-sections/${state.section.id}/promotions`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(payload),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.error || 'Error al guardar');
      }

      committed = true;
      const saved = await res.json();

      // 4. Re-sync from server truth.
      const preSavePromotions = saveState.promotions;
      // Superseded picks live only in history snapshots: gather them before
      // createHistory() discards the stacks.
      const discardedDrafts = historyDraftUrls(history);
      state = applySavedResponse(state, saved);
      snapshot = createSnapshot(state);
      history = createHistory();
      // Draft object URLs are replaced by server URLs: the union releases the
      // orphan scan, removed-promo, and history-only drafts, each exactly once.
      revokeDraftUrlsOnce(
        [...discardedDrafts, ...removedDraftUrls, ...orphanedDraftUrls(preSavePromotions, state.promotions)],
        state.promotions
      );

      // 4b. Associate uploaded blobs with their server ids (legacy table sync).
      // resolvedUrls is keyed by the payload item's OWN server id, so the
      // association targets that id directly — the response is ordered by
      // pos_x and array-index correlation would map to the WRONG promo (F7).
      for (const [serverId, url] of Object.entries(resolvedUrls)) {
        if (url) {
          try {
            await associateImage('promotions', serverId, url, API_URL, undefined, { is_primary: 1, sort_order: 0 });
          } catch { /* best-effort association */ }
        }
      }

      // 5. Best-effort R2 cleanup: replaced/removed image URLs + removed promos.
      // Reference-check every deletion: R2 objects are immutable, and a
      // duplicated promo shares the original's imageUrl — deleting a URL that
      // a surviving promo still references would break that promo forever.
      const survivingRefs = survivingImageReferences(saveState.promotions, resolvedUrls);
      const cleanupTargets = new Set<string>(removedImageUrls);
      for (const p of preSavePromotions) {
        if (p.previousImageUrl && p.previousImageUrl !== p.imageUrl) cleanupTargets.add(p.previousImageUrl);
        // Replaced associations: drop the legacy promotion_image row.
        if (p.imageId && p.imageBlob) {
          try { await deleteImage('promotions', p.id || '', p.imageId, API_URL); } catch { /* best-effort */ }
        }
      }
      for (const url of cleanupTargets) {
        if (survivingRefs.has(url)) continue;
        const filename = extractFilename(url);
        if (filename) {
          // Await the R2 delete so the object is gone before the save reports
          // success (the e2e R2-proof relies on this ordering).
          try { await deleteUploadedFile(filename, API_URL); } catch { /* best-effort */ }
        }
      }
      cleanupUrls = [];

      renderAll();
      $('save-error')!.classList.add('save-error--success');
      $('save-error')!.textContent = 'Guardado correctamente';
      saveStatusTimer = setTimeout(() => {
        const el = $('save-error');
        if (el) {
          el.textContent = '';
          el.classList.remove('save-error--success');
        }
      }, 3000);
    } catch (err: any) {
      // Orphan guard: delete blobs uploaded this save ONLY when the batch is
      // known to have failed (rejected response or error before completion).
      // A 200 batch commit followed by a parse failure must NOT delete the
      // uploaded files — the committed promos reference them.
      if (!committed) {
        for (const url of uploadedThisSave) {
          const filename = extractFilename(url);
          if (filename) {
            try { await deleteUploadedFile(filename, API_URL); } catch { /* best-effort */ }
          }
        }
      }
      $('save-error')!.textContent = err.message || 'Error al guardar';
    } finally {
      if (state && snapshot) {
        setButtonDisabled('save-btn', !isDirty(state, snapshot));
      }
      saveBtn.textContent = 'Guardar';
    }
  }

  // ─── WIRING ───────────────────────────────────────────────────────
  function initCanvasEvents() {
    const canvas = $('promo-canvas');
    // ClientRouter re-runs this script on every page-load: on other pages
    // #promo-canvas does not exist and observe(null) would throw.
    if (!canvas) return;

    canvas.addEventListener('pointerdown', beginPointerSession);

    // Keyboard activation: tiles and their edit affordances are focusable
    // (role=button/tabindex=0) but inert without an Enter/Space handler.
    canvas.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      if (!state) return;
      const tile = (e.target as HTMLElement)?.closest?.('.canvas-tile') as HTMLElement | null;
      if (!tile) return;
      const id = tile.dataset.id;
      const promo = id ? state.promotions.find((p) => localKey(p) === id) : undefined;
      if (!promo) return;
      e.preventDefault();
      e.stopPropagation();
      selectedId = localKey(promo);
      openModal(true, promo);
    });

    // Re-select after render: highlight selected tile.
    const highlight = () => {
      canvas.querySelectorAll('.canvas-tile').forEach((el) => {
        el.classList.toggle('selected', el.getAttribute('data-id') === selectedId);
      });
    };
    canvasObserver?.disconnect();
    const mo = new MutationObserver(highlight);
    canvasObserver = mo;
    mo.observe(canvas, { childList: true, subtree: true });
  }

  function initEvents() {
    $('grid-cols-select')?.addEventListener('change', (e) => {
      if (!state) return;
      const prev = state;
      state = setSection(state, { gridCols: parseInt((e.target as HTMLSelectElement).value, 10) || 4 });
      history = pushHistory(history, prev);
      renderAll();
    });
    $('grid-rows-select')?.addEventListener('change', (e) => {
      if (!state) return;
      const prev = state;
      state = setSection(state, { gridRows: parseInt((e.target as HTMLSelectElement).value, 10) || 1 });
      history = pushHistory(history, prev);
      renderAll();
    });
    $('display-type-select')?.addEventListener('change', (e) => {
      if (!state) return;
      const prev = state;
      const type = (e.target as HTMLSelectElement).value;
      state = setSection(state, { displayType: type });
      history = pushHistory(history, prev);
      currentDisplayType = type;
      updateTypeInfo(type);
      renderAll();
    });

    $('save-btn')?.addEventListener('click', doSave);
    $('revert-btn')?.addEventListener('click', doRevert);
    $('undo-btn')?.addEventListener('click', doUndo);
    $('redo-btn')?.addEventListener('click', doRedo);
    $('add-promo-btn')?.addEventListener('click', doAdd);
    $('hint-dismiss')?.addEventListener('click', () => {
      $('onboarding-hint')!.style.display = 'none';
      try { localStorage.setItem('promo-editor-hint-dismissed', '1'); } catch { /* private mode */ }
    });
    $('modal-close')?.addEventListener('click', cancelModal);
    $('modal-cancel')?.addEventListener('click', cancelModal);
    $('modal-overlay')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) cancelModal(); });

    // Image upload wiring.
    const area = $('promo-upload-area');
    const input = $('promo-input') as HTMLInputElement;
    area?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.promo-remove-btn')) return;
      input.click();
    });
    input?.addEventListener('change', () => {
      const file = input.files?.[0];
      if (file) handlePromoFile(file);
    });
    $('promo-remove')?.addEventListener('click', (e) => {
      e.stopPropagation();
      removeModalImage();
    });
    area?.addEventListener('dragover', (e) => {
      e.preventDefault();
      area.classList.add('promo-upload-area--dragover');
    });
    area?.addEventListener('dragleave', () => area.classList.remove('promo-upload-area--dragover'));
    area?.addEventListener('drop', (e) => {
      e.preventDefault();
      area.classList.remove('promo-upload-area--dragover');
      const file = e.dataTransfer?.files?.[0];
      if (file && file.type.startsWith('image/')) handlePromoFile(file);
    });

    // Modal submit → update local state only (zero network).
    $('promo-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!state) return;
      const form = e.target as HTMLFormElement;
      const id = ($('promo-id') as HTMLInputElement).value;
      const prev = state;

      if (id) {
        const patch: Partial<EditorPromotion> = {
          title: form.title.value || '',
          subtitle: form.description.value || null,
          link: form.link.value || '/',
          width: parseInt(form.width.value, 10) || 1,
          height: parseInt(form.height.value, 10) || 1,
          imageBlob: modalImageBlob,
          imageUrl: modalImageBlob ? null : modalImageUrl,
          localImageUrl: modalDraftUrl,
          previousImageUrl: modalPreviousUrl && (modalImageBlob || modalImageUrl !== modalPreviousUrl) ? modalPreviousUrl : null,
        };
        const replacedDraft = modalPrevDraftUrl && modalPrevDraftUrl !== modalDraftUrl ? modalPrevDraftUrl : null;
        state = updatePromotion(state, id, patch);
        // Release the pre-modal draft only when nothing references it: not the
        // current state, not any past/future snapshot, not the prev about to be
        // pushed — undo must be able to restore it.
        if (replacedDraft && !draftUrlReferenced(replacedDraft, state.promotions, history, [prev])) {
          URL.revokeObjectURL(replacedDraft);
        }
      } else {
        // New promo: image is either an existing url or a pending blob.
        const fields: Partial<EditorPromotion> = {
          title: form.title.value || '',
          subtitle: form.description.value || null,
          link: form.link.value || '/',
          width: parseInt(form.width.value, 10) || 1,
          height: parseInt(form.height.value, 10) || 1,
          imageBlob: modalImageBlob,
          imageUrl: modalImageBlob ? null : modalImageUrl,
          localImageUrl: modalDraftUrl,
        };
        state = addPromotion(state, fields);
        const addedKey = localKey(state.promotions[state.promotions.length - 1]);
        // Empty-cell tap: pin the new promo to the tapped cell instead of the
        // auto-suggested position.
        if (pendingPromoCell) {
          state = updatePromotion(state, addedKey, { posX: pendingPromoCell.x, posY: pendingPromoCell.y });
        }
        pendingPromoCell = null;
        showCollisionHint(addedKey);
      }

      modalDraftUrl = null;
      modalPrevDraftUrl = null;
      modalSubmitted = true;
      history = pushHistory(history, prev);
      closeModal();
      renderAll();
    });

    window.addEventListener('keydown', onKeydown);
    window.addEventListener('beforeunload', (e) => {
      if (!state || !snapshot) return;
      if (shouldWarnBeforeUnload(state, snapshot)) {
        e.preventDefault();
        e.returnValue = '';
      }
    });
    // ClientRouter SPA navigation guard (F9): beforeunload never fires on
    // view-transition navigations (sidebar clicks), and astro:before-preparation
    // preventDefault degrades to a full page load — so intercept same-origin
    // anchor clicks in the capture phase (before the router's own listener)
    // and confirm when dirty. preventDefault blocks the navigation outright.
    installNavGuard();
    window.addEventListener('resize', () => { if (isTiles()) renderCanvas(); });
  }

  // Astro ClientRouter re-executes the page script on every navigation, so a
  // bare document.addEventListener('click', ...) inside initEvents would stack
  // one stale guard per visit (each closing over an old `state`). Keep exactly
  // one active guard per live page by storing the handler on window and
  // removing the previous one before installing the current.
  const NAV_GUARD_KEY = '__sublimePromoNavGuard';

  function installNavGuard() {
    const win = window as unknown as Record<string, unknown>;
    const previous = win[NAV_GUARD_KEY] as ((e: MouseEvent) => void) | undefined;
    if (previous) {
      document.removeEventListener('click', previous, true);
      win[NAV_GUARD_KEY] = undefined;
    }
    const handler = (e: MouseEvent) => {
      if (!isPromoEditorRoute(location.pathname)) return;
      if (!state || !snapshot) return;
      if (!shouldWarnBeforeUnload(state, snapshot)) return;
      const raw = (e.composedPath?.() || [])[0] || e.target;
      const link = raw instanceof Element ? raw.closest?.('a[href]') : null;
      if (!(link instanceof HTMLAnchorElement)) return;
      if (link.target && link.target !== '_self') return;
      if (link.hasAttribute('download')) return;
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      let sameOrigin = false;
      try { sameOrigin = new URL(link.href, location.href).origin === location.origin; } catch { return; }
      if (!sameOrigin) return;
      if (!confirm('Hay cambios sin guardar. ¿Descartarlos?')) {
        e.preventDefault();
        e.stopPropagation();
      }
    };
    win[NAV_GUARD_KEY] = handler;
    document.addEventListener('click', handler, true);
  }

  // Disconnect the canvas observer before ClientRouter swaps this document out
  // (the page script re-runs per navigation; the observer would otherwise keep
  // the outgoing page's DOM alive through its highlight closure).
  document.addEventListener('astro:before-swap', () => {
    canvasObserver?.disconnect();
    canvasObserver = null;
  });

  document.addEventListener('astro:page-load', () => {
    initCanvasEvents();
    initEvents();

    // One-time onboarding hint.
    let dismissed = '0';
    try { dismissed = localStorage.getItem('promo-editor-hint-dismissed') || '0'; } catch { /* private mode */ }
    if (dismissed !== '1') {
      $('onboarding-hint')!.style.display = 'flex';
    }

    loadSections();
  });
</script>

