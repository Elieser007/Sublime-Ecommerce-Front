---
/**
 * Admin Dashboard — Sublime E-commerce
 * 
 * Product list with edit/delete actions.
 * Uses AdminSidebar + AdminTable components.
 */

import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import AdminTable from '../../components/AdminTable.astro';

// Placeholder products
const products = [
  { id: '1', name: 'Camiseta Sublime Básica', price: 120000, category: 'Ropa', image: '/placeholder-product.svg' },
  { id: '2', name: 'Estampa CMYK Edición Limitada', price: 250000, category: 'Arte', image: '/placeholder-product.svg' },
  { id: '3', name: 'Tote Bag Sublime', price: 85000, category: 'Accesorios', image: '/placeholder-product.svg' },
  { id: '4', name: 'Poster High Contrast', price: 95000, category: 'Arte', image: '/placeholder-product.svg' },
];
---

<AdminLayout title="Admin — Sublime E-commerce">
  <div class="admin-layout">
    <AdminSidebar active="productos" />

    <main class="admin-main">
      <div class="admin-header">
        <h1 class="headline-lg-mobile">Productos</h1>
        <div class="admin-header-actions">
          <a href="/admin/nuevo" class="btn btn--primary">
            + Nuevo Producto
          </a>
          <button class="btn btn--secondary" id="deploy-btn">
            Deploy
          </button>
        </div>
      </div>

      <!-- Deploy status -->
      <div id="deploy-status" style="display: none; margin-bottom: var(--space-lg); padding: var(--space-md); border: var(--border-width) solid var(--outline-variant); border-radius: var(--border-radius);">
        <p id="deploy-message" class="body-sm"></p>
      </div>

      <AdminTable products={products} />
    </main>
  </div>
</AdminLayout>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
  const $deployBtn = document.getElementById('deploy-btn') as HTMLButtonElement;
  const $deployStatus = document.getElementById('deploy-status');
  const $deployMessage = document.getElementById('deploy-message');

  // Check deploy config availability on page load
  async function checkDeployConfig() {
    try {
      const res = await fetch(`${API_URL}/api/deploy`, {
        method: 'POST',
        credentials: 'include',
      });
      const data = await res.json();

      if (res.status === 500 && data.message === 'Deploy configuration missing') {
        // Config not set — disable button with explanation
        $deployBtn.disabled = true;
        $deployBtn.title = 'Deploy no disponible: faltan variables de entorno (CF_API_TOKEN, CF_ACCOUNT_ID, CF_PROJECT_NAME)';
        $deployBtn.textContent = 'Deploy (sin configurar)';
        $deployStatus.style.display = '';
        $deployStatus.style.borderColor = 'var(--outline-variant)';
        $deployMessage.textContent = 'Deploy no configurado. Setea CF_API_TOKEN, CF_ACCOUNT_ID y CF_PROJECT_NAME como secrets en Cloudflare.';
        $deployMessage.style.color = 'var(--on-surface-variant)';
      }
    } catch {
      // Backend not reachable — leave button enabled for retry
    }
  }

  checkDeployConfig();

  $deployBtn?.addEventListener('click', async () => {
    $deployBtn.disabled = true;
    $deployBtn.textContent = 'Desplegando...';
    $deployStatus.style.display = 'none';

    try {
      const res = await fetch(`${API_URL}/api/deploy`, {
        method: 'POST',
        credentials: 'include',
      });
      const data = await res.json();

      if (res.ok) {
        $deployStatus.style.display = '';
        $deployStatus.style.borderColor = 'var(--primary)';
        $deployMessage.textContent = `Deploy iniciado: ${data.url || 'Ver dashboard de Cloudflare'}`;
        $deployMessage.style.color = 'var(--primary)';
      } else {
        $deployStatus.style.display = '';
        $deployStatus.style.borderColor = 'var(--error)';
        $deployMessage.textContent = `Error: ${data.message || data.error || 'Deploy failed'}`;
        $deployMessage.style.color = 'var(--error)';
      }
    } catch (err) {
      $deployStatus.style.display = '';
      $deployStatus.style.borderColor = 'var(--error)';
      $deployMessage.textContent = 'Error de conexión al intentar deploy';
      $deployMessage.style.color = 'var(--error)';
    } finally {
      $deployBtn.disabled = false;
      $deployBtn.textContent = 'Deploy';
    }
  });
</script>

<style>
  .admin-layout {
    display: grid;
    grid-template-columns: 1fr;
    min-height: calc(100vh - 72px);
  }

  @media (min-width: 768px) {
    .admin-layout {
      grid-template-columns: 240px 1fr;
    }
  }

  .admin-main {
    padding: var(--space-2xl);
  }

  .admin-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2xl);
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .admin-header-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .admin-header h1 {
    color: var(--on-surface);
  }
</style>
