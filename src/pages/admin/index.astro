---
/**
 * /admin — Redirect to the real product management page.
 *
 * Zero-JS meta refresh (SSG-friendly, no flash of placeholder content).
 * The auth guard on /admin/products handles the unauthenticated case,
 * redirecting to /login as required.
 */
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirigiendo a Productos… — Sublime</title>
    <meta http-equiv="refresh" content="0; url=/admin/products" />
  </head>
  <body>
    <main>
      <p>Redirigiendo a <a href="/admin/products">/admin/products</a>…</p>
    </main>
  </body>
</html>
