---
/**
 * Admin Products — Product Management
 * Cascade: Section → Category → Subcategory
 * Multi-branch assignment
 * Pricing per branch with volume discounts
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import DataTable from '../../components/admin/DataTable.astro';

const columns = [
  { key: 'name', label: 'Nombre' },
  { key: 'section', label: 'Sección' },
  { key: 'category', label: 'Categoría' },
  { key: 'subcategory', label: 'Subcategoría' },
  { key: 'price', label: 'Precio Base' },
  { key: 'branches', label: 'Sucursales' },
  { key: 'status', label: 'Estado' },
  { key: 'actions', label: 'Acciones', width: '120px' },
];
---

<BaseLayout title="Productos — Admin">
  <div class="admin-layout">
    <AdminSidebar active="products" />
    <main class="admin-main">
      <div class="admin-header">
        <h1 class="headline-lg-mobile">Productos</h1>
        <p class="body-md admin-subtitle">Gestiona el catálogo, precios y sucursales</p>
      </div>

      <div class="content-header">
        <div class="toolbar">
          <input type="text" id="search" class="form-input body-md" placeholder="Buscar nombre..." />
          <select id="section-filter" class="form-select body-md"><option value="">Todas las secciones</option></select>
          <select id="category-filter" class="form-select body-md"><option value="">Todas las categorías</option></select>
          <select id="subcategory-filter" class="form-select body-md"><option value="">Todas las subcategorías</option></select>
          <select id="branch-filter" class="form-select body-md"><option value="">Todas las sucursales</option></select>
          <select id="limit" class="form-select body-md">
            <option value="10">10</option><option value="25" selected>25</option><option value="50">50</option><option value="100">100</option>
          </select>
        </div>
        <button class="btn btn--primary" id="add-product"><span class="btn-icon">+</span> Nuevo</button>
      </div>

      <DataTable columns={columns}>
        <tr><td colspan="8" class="empty-cell">Cargando...</td></tr>
      </DataTable>

      <div class="pagination-bar">
        <span class="body-md" id="showing">Mostrando 0 de 0</span>
        <div class="page-nav">
          <button class="btn btn--secondary" id="prev" disabled>Anterior</button>
          <span class="body-md" id="page-info">Página 1 de 1</span>
          <button class="btn btn--secondary" id="next" disabled>Siguiente</button>
        </div>
      </div>
    </main>
  </div>

  <!-- Product Modal -->
  <div class="modal-overlay" id="modal-overlay" style="display: none;">
    <div class="modal modal--wide">
      <div class="modal-header">
        <h3 class="headline-lg-mobile" id="modal-title">Nuevo Producto</h3>
        <button class="modal-close" id="modal-close">✕</button>
      </div>
      <form class="modal-form" id="modal-form">
        <input type="hidden" id="modal-id" />
        <div class="form-row">
          <div class="form-group"><label class="label-sm">Nombre *</label><input type="text" name="name" class="form-input body-md" required /></div>
          <div class="form-group"><label class="label-sm">Precio Base (Gs.) *</label><input type="number" name="basePrice" class="form-input body-md" min="0" step="1" required /></div>
        </div>
        <div class="form-group"><label class="label-sm">Descripción</label><textarea name="description" class="form-textarea body-md" rows="2"></textarea></div>
        <div class="form-row">
          <div class="form-group"><label class="label-sm">Sección *</label><select name="sectionId" id="section-select" class="form-select body-md" required><option value="">Seleccionar...</option></select></div>
          <div class="form-group"><label class="label-sm">Categoría *</label><select name="categoryId" id="category-select" class="form-select body-md" required><option value="">Seleccionar sección primero</option></select></div>
          <div class="form-group"><label class="label-sm">Subcategoría</label><select name="subcategoryId" id="subcategory-select" class="form-select body-md"><option value="">Seleccionar categoría primero</option></select></div>
        </div>
        <div class="form-group">
          <label class="label-sm">Sucursales *</label>
          <div class="checkbox-group" id="branch-checkboxes"></div>
        </div>
        <div class="form-error" id="form-error"></div>
        <div class="form-actions">
          <button type="button" class="btn btn--secondary" id="modal-cancel">Cancelar</button>
          <button type="submit" class="btn btn--primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Pricing Modal -->
  <div class="modal-overlay" id="price-overlay" style="display: none;">
    <div class="modal modal--wide">
      <div class="modal-header">
        <h3 class="headline-lg-mobile" id="price-modal-title">Precios</h3>
        <button class="modal-close" id="price-modal-close">✕</button>
      </div>
      <div class="modal-body">
        <div class="price-product-info" id="price-product-info"></div>
        <div class="price-form-row">
          <select id="price-branch-select" class="form-select body-md"><option value="">Sucursal...</option></select>
          <input type="number" id="price-min-qty" class="form-input body-md" placeholder="Cant. mín." min="1" value="1" />
          <input type="number" id="price-value" class="form-input body-md" placeholder="Precio (Gs.)" min="0" />
          <button class="btn btn--primary" id="add-price-btn"><span class="btn-icon">+</span> Agregar</button>
        </div>
        <table class="prices-table">
          <thead><tr><th class="label-sm">Sucursal</th><th class="label-sm">Desde Cant.</th><th class="label-sm">Precio</th><th class="label-sm">Acciones</th></tr></thead>
          <tbody id="prices-tbody"></tbody>
        </table>
        <div class="form-actions"><button type="button" class="btn btn--secondary" id="price-modal-cancel">Cerrar</button></div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
  const fmt = (c: number) => `₲ ${(c || 0).toLocaleString('es-PY')}`;

  let items: any[] = [];
  let currentPage = 1, limit = 25, totalItems = 0, totalPages = 0;
  let currentSearch = '', currentSection = '', currentCategory = '', currentSubcategory = '', currentBranch = '';
  let sections: any[] = [], categories: any[] = [], subcategories: any[] = [], branches: any[] = [];
  let editingProductId: string | null = null;
  let pricingProductId: string | null = null;

  const $ = (id: string) => document.getElementById(id);

  // ─── LOAD DEPENDENCIES ────────────────────────────────
  async function loadDependencies() {
    const [sec, cats, subs, brs] = await Promise.all([
      fetch(`${API_URL}/api/sections`, { credentials: 'include' }).then(r => r.ok ? r.json() : { sections: [] }),
      fetch(`${API_URL}/api/categories`, { credentials: 'include' }).then(r => r.ok ? r.json() : { categories: [] }),
      fetch(`${API_URL}/api/subcategories`, { credentials: 'include' }).then(r => r.ok ? r.json() : { subcategories: [] }),
      fetch(`${API_URL}/api/branches`, { credentials: 'include' }).then(r => r.ok ? r.json() : { branches: [] }),
    ]);
    sections = sec.sections || [];
    categories = cats.categories || [];
    subcategories = subs.subcategories || [];
    branches = brs.branches || [];

    // Populate filter selects
    populateSelect('section-filter', sections, 'Todas las secciones');
    populateSelect('branch-filter', branches, 'Todas las sucursales');

    // Populate modal section select
    populateSelect('section-select', sections, 'Seleccionar...');
  }

  function populateSelect(id: string, data: any[], placeholder: string, valueKey = 'id', labelKey = 'name') {
    const el = $(id) as HTMLSelectElement;
    if (!el) return;
    el.innerHTML = `<option value="">${placeholder}</option>` + data.map((d: any) => `<option value="${d[valueKey]}">${d[labelKey]}</option>`).join('');
  }

  // ─── CASCADE: Section → Category → Subcategory ────────
  function onSectionFilterChange() {
    currentSection = ($('section-filter') as HTMLSelectElement).value;
    currentCategory = '';
    currentSubcategory = '';
    const filtered = currentSection ? categories.filter((c: any) => c.section_id === currentSection) : categories;
    populateSelect('category-filter', filtered, 'Todas las categorías');
    populateSelect('subcategory-filter', [], 'Todas las subcategorías');
    currentPage = 1;
    loadProducts();
  }

  function onCategoryFilterChange() {
    currentCategory = ($('category-filter') as HTMLSelectElement).value;
    currentSubcategory = '';
    const filtered = currentCategory ? subcategories.filter((s: any) => s.category_id === currentCategory) : [];
    populateSelect('subcategory-filter', filtered, 'Todas las subcategorías');
    currentPage = 1;
    loadProducts();
  }

  function onSectionSelectChange() {
    const sectionId = ($('section-select') as HTMLSelectElement).value;
    const filtered = sectionId ? categories.filter((c: any) => c.section_id === sectionId) : [];
    populateSelect('category-filter-modal', filtered, 'Seleccionar...', 'id', 'name');
    // Use the actual element id
    const catSelect = $('category-select') as HTMLSelectElement;
    catSelect.innerHTML = '<option value="">Seleccionar...</option>' + filtered.map((c: any) => `<option value="${c.id}">${c.name}</option>`).join('');
    const subSelect = $('subcategory-select') as HTMLSelectElement;
    subSelect.innerHTML = '<option value="">Seleccionar categoría primero</option>';
  }

  function onCategorySelectChange() {
    const categoryId = ($('category-select') as HTMLSelectElement).value;
    const filtered = categoryId ? subcategories.filter((s: any) => s.category_id === categoryId) : [];
    const subSelect = $('subcategory-select') as HTMLSelectElement;
    subSelect.innerHTML = '<option value="">Seleccionar...</option>' + filtered.map((s: any) => `<option value="${s.id}">${s.name}</option>`).join('');
  }

  // ─── LOAD PRODUCTS ────────────────────────────────────
  async function loadProducts() {
    const tbody = document.querySelector('tbody');
    if (tbody) tbody.innerHTML = '<tr><td colspan="8" class="empty-cell">Cargando...</td></tr>';
    const params = new URLSearchParams();
    params.set('page', String(currentPage));
    params.set('limit', String(limit));
    if (currentSearch) params.set('search', currentSearch);
    if (currentSection) params.set('section_id', currentSection);
    if (currentCategory) params.set('category_id', currentCategory);
    if (currentSubcategory) params.set('subcategory_id', currentSubcategory);
    if (currentBranch) params.set('branch_id', currentBranch);
    try {
      const res = await fetch(`${API_URL}/api/products?${params.toString()}`, { credentials: 'include' });
      if (res.status === 401) { window.location.href = '/login'; return; }
      const data = await res.json();
      items = data.data || [];
      totalItems = data.total || 0;
      totalPages = data.pages || 1;
      render();
    } catch { if (tbody) tbody.innerHTML = '<tr><td colspan="8" class="empty-cell">Error</td></tr>'; }
  }

  function render() {
    const tbody = document.querySelector('tbody');
    if (!tbody) return;
    if (items.length === 0) { tbody.innerHTML = '<tr><td colspan="8" class="empty-cell">No hay productos</td></tr>'; }
    else {
      tbody.innerHTML = items.map((p: any) => `<tr>
        <td><strong>${p.name}</strong></td>
        <td><span class="tag tag--section">${p.section_name || '—'}</span></td>
        <td>${p.category_name || '—'}</td>
        <td>${p.subcategory_name || '—'}</td>
        <td>${fmt(p.base_price)}</td>
        <td><span class="branch-list">${p.branch_names || '—'}</span></td>
        <td><span class="badge ${p.is_active ? 'badge--active' : 'badge--inactive'}"><span class="badge-dot"></span>${p.is_active ? 'Activo' : 'Inactivo'}</span></td>
        <td><div class="cell-actions">
          <button class="ta-btn" onclick="editProduct('${p.id}')" title="Editar">✏️</button>
          <button class="ta-btn ta-btn--price" onclick="openPricing('${p.id}')" title="Precios">💰</button>
          <button class="ta-btn ta-btn--delete" onclick="deleteProduct('${p.id}')" title="Desactivar">🗑️</button>
        </div></td>
      </tr>`).join('');
    }
    updatePagination();
  }

  function updatePagination() {
    const start = totalItems === 0 ? 0 : (currentPage - 1) * limit + 1;
    const end = Math.min(currentPage * limit, totalItems);
    $('showing')!.textContent = `Mostrando ${start}–${end} de ${totalItems}`;
    $('page-info')!.textContent = `Página ${currentPage} de ${totalPages}`;
    ($('prev') as HTMLButtonElement).disabled = currentPage <= 1;
    ($('next') as HTMLButtonElement).disabled = currentPage >= totalPages;
  }

  // ─── PRODUCT MODAL ────────────────────────────────────
  function renderBranchCheckboxes(selectedIds: string[] = []) {
    const container = $('branch-checkboxes')!;
    const allSelected = selectedIds.length === branches.length;
    container.innerHTML = `
      <label class="checkbox-label checkbox-label--all">
        <input type="checkbox" id="select-all-branches" ${allSelected ? 'checked' : ''} />
        <span>Seleccionar todas</span>
      </label>
      <div class="branch-options">
        ${branches.map((b: any) => `
          <label class="checkbox-label">
            <input type="checkbox" name="branchIds" value="${b.id}" ${selectedIds.includes(b.id) ? 'checked' : ''} />
            <span>${b.name}</span>
          </label>
        `).join('')}
      </div>
    `;
    // Select all toggle
    $('select-all-branches')?.addEventListener('change', (e) => {
      const checked = (e.target as HTMLInputElement).checked;
      document.querySelectorAll('input[name="branchIds"]').forEach((el: any) => { el.checked = checked; });
    });
  }

  function openModal(isEdit: boolean, product?: any) {
    const form = $('modal-form') as HTMLFormElement;
    form.reset();
    $('form-error')!.textContent = '';
    $('modal-title')!.textContent = isEdit ? 'Editar Producto' : 'Nuevo Producto';
    ($('modal-id') as HTMLInputElement).value = product?.id || '';
    editingProductId = product?.id || null;

    // Reset cascade
    $('category-select')!.innerHTML = '<option value="">Seleccionar sección primero</option>';
    $('subcategory-select')!.innerHTML = '<option value="">Seleccionar categoría primero</option>';

    if (isEdit && product) {
      form.name.value = product.name || '';
      form.description.value = product.description || '';
      form.basePrice.value = product.base_price || '';
      // Set section and cascade
      ($('section-select') as HTMLSelectElement).value = product.section_id || '';
      onSectionSelectChange();
      ($('category-select') as HTMLSelectElement).value = product.category_id || '';
      onCategorySelectChange();
      ($('subcategory-select') as HTMLSelectElement).value = product.subcategory_id || '';
      const branchIds = product.branch_ids ? product.branch_ids.split(',') : [];
      renderBranchCheckboxes(branchIds);
    } else {
      renderBranchCheckboxes();
    }
    $('modal-overlay')!.style.display = '';
  }

  function closeModal() { $('modal-overlay')!.style.display = 'none'; }

  // ─── PRICING MODAL ────────────────────────────────────
  async function openPricing(productId: string) {
    pricingProductId = productId;
    const product = items.find((p: any) => p.id === productId);
    $('price-product-info')!.innerHTML = product ? `<strong>${product.name}</strong> — Precio base: ${fmt(product.base_price)}` : '';

    // Populate branch select
    populateSelect('price-branch-select', branches, 'Sucursal...');

    await loadPrices(productId);
    $('price-overlay')!.style.display = '';
  }

  async function loadPrices(productId: string) {
    const res = await fetch(`${API_URL}/api/products/${productId}/prices`, { credentials: 'include' });
    if (!res.ok) return;
    const { prices } = await res.json();
    const tbody = $('prices-tbody')!;
    if (!prices || prices.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4" class="empty-cell">Sin precios configurados</td></tr>';
    } else {
      tbody.innerHTML = prices.map((p: any) => `<tr>
        <td>${p.branch_name}</td>
        <td>${p.min_quantity}</td>
        <td>${fmt(p.price)}</td>
        <td><div class="cell-actions">
          <button class="ta-btn ta-btn--delete" onclick="deletePrice('${p.id}')" title="Eliminar">🗑️</button>
        </div></td>
      </tr>`).join('');
    }
  }

  function closePricingModal() { $('price-overlay')!.style.display = 'none'; pricingProductId = null; }

  // ─── EVENT LISTENERS ──────────────────────────────────
  // Filters
  let searchTimeout: any;
  $('search')?.addEventListener('input', (e) => { clearTimeout(searchTimeout); searchTimeout = setTimeout(() => { currentSearch = (e.target as HTMLInputElement).value; currentPage = 1; loadProducts(); }, 300); });
  $('section-filter')?.addEventListener('change', onSectionFilterChange);
  $('category-filter')?.addEventListener('change', onCategoryFilterChange);
  $('subcategory-filter')?.addEventListener('change', (e) => { currentSubcategory = (e.target as HTMLSelectElement).value; currentPage = 1; loadProducts(); });
  $('branch-filter')?.addEventListener('change', (e) => { currentBranch = (e.target as HTMLSelectElement).value; currentPage = 1; loadProducts(); });
  $('limit')?.addEventListener('change', (e) => { limit = parseInt((e.target as HTMLSelectElement).value); currentPage = 1; loadProducts(); });
  $('prev')?.addEventListener('click', () => { if (currentPage > 1) { currentPage--; loadProducts(); } });
  $('next')?.addEventListener('click', () => { if (currentPage < totalPages) { currentPage++; loadProducts(); } });

  // Modal cascade
  $('section-select')?.addEventListener('change', onSectionSelectChange);
  $('category-select')?.addEventListener('change', onCategorySelectChange);

  // Modal open/close
  $('add-product')?.addEventListener('click', () => openModal(false));
  $('modal-close')?.addEventListener('click', closeModal);
  $('modal-cancel')?.addEventListener('click', closeModal);
  $('modal-overlay')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) closeModal(); });

  // Product save
  $('modal-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const id = ($('modal-id') as HTMLInputElement).value;
    const isEdit = !!id;
    const branchIds = Array.from(document.querySelectorAll('input[name="branchIds"]:checked')).map((el: any) => el.value);
    const body = {
      name: form.name.value, description: form.description.value || null,
      sectionId: form.sectionId.value, categoryId: form.categoryId.value,
      subcategoryId: form.subcategoryId.value || null,
      basePrice: parseInt(form.basePrice.value) || 0, branchIds,
    };
    const res = await fetch(isEdit ? `${API_URL}/api/products/${id}` : `${API_URL}/api/products`, {
      method: isEdit ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify(body),
    });
    if (!res.ok) { const err = await res.json(); $('form-error')!.textContent = err.error || 'Error'; return; }
    closeModal(); loadProducts();
  });

  // Pricing modal
  $('price-modal-close')?.addEventListener('click', closePricingModal);
  $('price-modal-cancel')?.addEventListener('click', closePricingModal);
  $('price-overlay')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) closePricingModal(); });

  $('add-price-btn')?.addEventListener('click', async () => {
    if (!pricingProductId) return;
    const branchId = ($('price-branch-select') as HTMLSelectElement).value;
    const minQuantity = parseInt(($('price-min-qty') as HTMLInputElement).value) || 1;
    const price = parseInt(($('price-value') as HTMLInputElement).value);
    if (!branchId || !price) { alert('Selecciona sucursal y precio'); return; }
    const res = await fetch(`${API_URL}/api/products/${pricingProductId}/prices`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
      body: JSON.stringify({ branchId, minQuantity, price }),
    });
    if (res.ok) {
      ($('price-min-qty') as HTMLInputElement).value = '1';
      ($('price-value') as HTMLInputElement).value = '';
      loadPrices(pricingProductId);
    }
  });

  (window as any).editProduct = (id: string) => {
    const product = items.find((p: any) => p.id === id);
    if (product) openModal(true, product);
  };

  (window as any).deleteProduct = async (id: string) => {
    if (!confirm('¿Desactivar este producto?')) return;
    const res = await fetch(`${API_URL}/api/products/${id}`, { method: 'DELETE', credentials: 'include' });
    if (res.ok) loadProducts();
  };

  (window as any).openPricing = openPricing;

  (window as any).deletePrice = async (priceId: string) => {
    if (!pricingProductId || !confirm('¿Eliminar este precio?')) return;
    const res = await fetch(`${API_URL}/api/products/${pricingProductId}/prices/${priceId}`, { method: 'DELETE', credentials: 'include' });
    if (res.ok) loadPrices(pricingProductId);
  };

  async function init() { await loadDependencies(); await loadProducts(); }
  init();
</script>

<style>
  .admin-layout { display: grid; grid-template-columns: 1fr; min-height: calc(100vh - 72px); }
  @media (min-width: 768px) { .admin-layout { grid-template-columns: 260px 1fr; } }
  .admin-main { padding: var(--space-2xl); overflow-y: auto; }
  .admin-header { margin-bottom: var(--space-2xl); }
  .admin-header h1 { color: var(--on-surface); margin-bottom: var(--space-sm); }
  .admin-subtitle { color: var(--on-surface-variant); }
  .content-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-md); flex-wrap: wrap; gap: var(--space-md); }
  .toolbar { display: flex; gap: 12px; flex-wrap: wrap; flex: 1; }
  .form-input, .form-select, .form-textarea { padding: 12px; background-color: rgba(31, 31, 31, 0.5); border: 1px solid rgba(62, 72, 80, 0.3); border-radius: 0px; color: #e2e2e2; font-family: 'Hanken Grotesk', sans-serif; font-size: 14px; min-width: 130px; }
  .form-input:focus, .form-select:focus, .form-textarea:focus { outline: none; border-color: #82cfff; box-shadow: 0 0 0 2px rgba(130, 207, 255, 0.2); }
  .form-row { display: flex; gap: 16px; }
  .form-row .form-group { flex: 1; }
  .empty-cell { text-align: center; padding: 48px !important; color: #bdc8d1; }
  .cell-actions { display: flex; gap: 6px; justify-content: flex-end; opacity: 0.6; transition: opacity 0.2s ease; }
  tr:hover .cell-actions { opacity: 1; }
  .branch-list { font-size: 13px; color: #bdc8d1; }
  .tag { display: inline-block; padding: 2px 8px; font-family: 'Space Mono', monospace; font-size: 11px; border-radius: 0px; }
  .tag--section { background: rgba(130, 207, 255, 0.1); color: #82cfff; border: 1px solid rgba(130, 207, 255, 0.3); }
  .pagination-bar { display: flex; align-items: center; justify-content: space-between; margin-top: var(--space-xl); flex-wrap: wrap; gap: var(--space-md); }
  .page-nav { display: flex; gap: 12px; align-items: center; }
  .modal-overlay { position: fixed; inset: 0; background-color: rgba(0, 0, 0, 0.8); backdrop-filter: blur(4px); z-index: 300; display: flex; align-items: center; justify-content: center; padding: 16px; }
  .modal { background-color: #131313; border: 1px solid rgba(62, 72, 80, 0.3); border-radius: 0px; width: 100%; max-width: 520px; max-height: 90vh; overflow-y: auto; }
  .modal--wide { max-width: 700px; }
  .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 24px; border-bottom: 1px solid rgba(62, 72, 80, 0.3); }
  .modal-header h3 { color: #e2e2e2; }
  .modal-close { background: none; border: 1px solid rgba(62, 72, 80, 0.3); border-radius: 0px; width: 36px; height: 36px; color: #bdc8d1; cursor: pointer; font-size: 18px; }
  .modal-close:hover { border-color: #ffb4ab; color: #ffb4ab; }
  .modal-form, .modal-body { padding: 24px; display: flex; flex-direction: column; gap: 16px; }
  .form-group { display: flex; flex-direction: column; gap: 8px; }
