---
/**
 * Admin Products — Product Management
 * Cascade: Section → Category → Subcategory
 * Auto-slug from name
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import DataTable from '../../components/admin/DataTable.astro';
import AttributeManager from '../../components/admin/AttributeManager.astro';
import Button from '../../components/Button.astro';

const columns = [
  { key: 'name', label: 'Nombre' },
  { key: 'slug', label: 'Slug' },
  { key: 'section', label: 'Sección' },
  { key: 'category', label: 'Categoría' },
  { key: 'subcategory', label: 'Subcategoría' },
  { key: 'price', label: 'Precio Base' },
  { key: 'attributes', label: 'Atributos' },
  { key: 'status', label: 'Estado' },
  { key: 'actions', label: 'Acciones', width: '150px' },
];
---

<AdminLayout title="Productos — Admin">
  <AdminSidebar active="products" />
  <main class="admin-main">
    <div class="admin-header">
      <h1 class="headline-lg-mobile">Productos</h1>
      <p class="body-md admin-subtitle">Gestiona el catálogo y precios por volumen</p>
    </div>

    <div class="content-header">
      <div class="toolbar">
        <input type="text" id="search" class="form-input body-md" placeholder="Buscar nombre o slug..." />
        <select id="section-filter" class="form-select body-md"><option value="">Todas las secciones</option></select>
        <select id="category-filter" class="form-select body-md"><option value="">Todas las categorías</option></select>
        <select id="subcategory-filter" class="form-select body-md"><option value="">Todas las subcategorías</option></select>
        <select id="limit" class="form-select body-md">
          <option value="10">10</option><option value="25" selected>25</option><option value="50">50</option><option value="100">100</option>
        </select>
        <select id="status-filter" class="form-select body-md">
          <option value="">Todos</option><option value="1">Activos</option><option value="0">Inactivos</option>
        </select>
      </div>
      <Button variant="primary" id="add-product">+ Nuevo</Button>
    </div>

    <DataTable columns={columns}>
      <tr><td colspan="9" class="empty-cell">Cargando...</td></tr>
    </DataTable>

    <div class="pagination-bar">
      <span class="body-md" id="showing">Mostrando 0 de 0</span>
      <div class="page-nav">
        <Button variant="secondary" id="prev" disabled>Anterior</Button>
        <span class="body-md" id="page-info">Página 1 de 1</span>
        <Button variant="secondary" id="next" disabled>Siguiente</Button>
      </div>
    </div>
  </main>

<!-- Product Modal -->
<div class="modal-overlay" id="modal-overlay" style="display: none;">
  <div class="modal modal--wide">
    <div class="modal-header">
      <h3 class="headline-lg-mobile" id="modal-title">Nuevo Producto</h3>
      <button class="modal-close" id="modal-close">✕</button>
    </div>
    <form class="modal-form" id="modal-form">
      <input type="hidden" id="modal-id" />

      <!-- ═══════════════════════════════════════════════════════ -->
      <!-- SECTION 1: IMAGEN PRINCIPAL                            -->
      <!-- ═══════════════════════════════════════════════════════ -->
      <div class="form-group" id="primary-section">
        <label class="label-sm">Imagen principal del producto</label>
        <div class="primary-upload-area" id="primary-upload-area">
          <div class="primary-preview" id="primary-preview">
            <div class="primary-empty" id="primary-empty">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <p class="body-md">Arrastra una imagen o haz clic</p>
              <p class="label-sm">Imagen para el catálogo y búsqueda</p>
            </div>
            <img src="" alt="" class="primary-image" id="primary-image" style="display: none;" />
          </div>
          <button type="button" class="primary-remove-btn" id="primary-remove" style="display: none;" title="Eliminar imagen principal">✕</button>
        </div>
        <input type="file" name="primary-image" id="primary-input" accept="image/png,image/jpeg,image/webp" class="upload-input" />
        <div class="upload-status" id="primary-upload-status" style="display: none;">
          <div class="cmyk-bar"><span></span><span></span><span></span></div>
          <p class="label-sm">Procesando imagen...</p>
        </div>
        <div class="upload-info" id="primary-upload-info" style="display: none;">
          <p class="label-sm" id="primary-upload-info-text"></p>
        </div>
      </div>

      <!-- ═══════════════════════════════════════════════════════ -->
      <!-- SECTION 2: GALERÍA DE IMÁGENES                         -->
      <!-- ═══════════════════════════════════════════════════════ -->
      <div class="form-group" id="gallery-section">
        <label class="label-sm">Galería de imágenes</label>
        <div class="gallery-strip-container" id="gallery-strip-container">
          <div class="gallery-strip" id="gallery-strip"></div>
          <button type="button" class="gallery-add-btn" id="gallery-add-btn" title="Agregar imagen a galería">
            <span class="btn-icon">+</span>
          </button>
        </div>
        <input type="file" name="gallery-image" id="gallery-input" accept="image/png,image/jpeg,image/webp" class="upload-input" multiple />
        <div class="upload-status" id="gallery-upload-status" style="display: none;">
          <div class="cmyk-bar"><span></span><span></span><span></span></div>
          <p class="label-sm">Procesando imagen...</p>
        </div>
        <div class="upload-info" id="gallery-upload-info" style="display: none;">
          <p class="label-sm" id="gallery-upload-info-text"></p>
        </div>
        <p class="label-sm gallery-count" id="gallery-count"></p>
      </div>

      <div class="form-row">
        <div class="form-group"><label class="label-sm">Nombre *</label><input type="text" name="name" id="modal-name" class="form-input body-md" required /></div>
        <div class="form-group"><label class="label-sm">Slug (URL)</label><input type="text" name="slug" id="modal-slug" class="form-input body-md" placeholder="auto-generado" /></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="label-sm">Precio Base (Gs.) *</label><input type="number" name="basePrice" class="form-input body-md" min="0" step="1" required /></div>
      </div>
      <div class="form-group"><label class="label-sm">Descripción</label><textarea name="description" class="form-textarea body-md" rows="2"></textarea></div>
      <div class="form-row">
        <div class="form-group"><label class="label-sm">Sección *</label><select name="sectionId" id="section-select" class="form-select body-md" required><option value="">Seleccionar...</option></select></div>
        <div class="form-group"><label class="label-sm">Categoría *</label><select name="categoryId" id="category-select" class="form-select body-md" required><option value="">Seleccionar sección primero</option></select></div>
        <div class="form-group"><label class="label-sm">Subcategoría</label><select name="subcategoryId" id="subcategory-select" class="form-select body-md"><option value="">Seleccionar categoría primero</option></select></div>
      </div>
      <div class="form-error" id="form-error"></div>
      <div class="form-actions">
        <Button variant="secondary" id="modal-cancel">Cancelar</Button>
        <Button variant="primary" id="modal-submit" type="submit">Guardar</Button>
      </div>
    </form>
  </div>
</div>

<!-- Attribute Manager Modal -->
<AttributeManager productId="" productName="" />

<!-- Image Delete Confirmation Modal -->
<div class="modal-overlay" id="delete-overlay" style="display: none;">
  <div class="modal modal--confirm">
    <div class="modal-header">
      <h3 class="headline-lg-mobile">⚠️ Eliminar imagen</h3>
      <button class="modal-close" id="delete-cancel-x">✕</button>
    </div>
    <div class="modal-body">
      <p class="body-md delete-message">
        Esta acción no se puede deshacer. La imagen se eliminará permanentemente del almacenamiento.
      </p>
      <div class="form-actions">
        <Button variant="secondary" id="delete-cancel">Cancelar</Button>
        <Button variant="danger" id="delete-confirm">Eliminar</Button>
      </div>
    </div>
  </div>
</div>

<!-- Pricing Modal -->
<div class="modal-overlay" id="price-overlay" style="display: none;">
  <div class="modal modal--wide">
    <div class="modal-header">
      <h3 class="headline-lg-mobile" id="price-modal-title">Precios por Volumen</h3>
      <button class="modal-close" id="price-modal-close">✕</button>
    </div>
    <div class="modal-body">
      <div class="price-product-info" id="price-product-info"></div>
      <div class="price-form-row">
        <input type="number" id="price-min-qty" class="form-input body-md" placeholder="Cant. mín." min="1" value="1" />
        <input type="number" id="price-value" class="form-input body-md" placeholder="Precio (Gs.)" min="0" />
        <Button variant="primary" id="add-price-btn">+ Agregar</Button>
      </div>
      <div class="form-error" id="price-error" role="alert" hidden></div>
      <table class="prices-table">
        <thead><tr><th class="label-sm">Desde Cant.</th><th class="label-sm">Precio</th><th class="label-sm">Acciones</th></tr></thead>
        <tbody id="prices-tbody"></tbody>
      </table>
      <div class="form-actions"><Button variant="secondary" id="price-modal-cancel">Cerrar</Button></div>
    </div>
  </div>
</div>

<!-- Status Toggle Confirmation Modal -->
<div class="modal-overlay" id="status-overlay" style="display: none;">
  <div class="modal modal--confirm">
    <div class="modal-header">
      <h3 class="headline-lg-mobile" id="status-modal-title">⚠️ Cambiar estado</h3>
      <button class="modal-close" id="status-cancel-x">✕</button>
    </div>
    <div class="modal-body">
      <p class="body-md" id="status-modal-message"></p>
      <div class="form-actions">
        <Button variant="secondary" id="status-cancel">Cancelar</Button>
        <Button variant="primary" id="status-confirm-activate" style="display: none;">Reactivar</Button>
        <Button variant="danger" id="status-confirm-deactivate">Desactivar</Button>
      </div>
    </div>
  </div>
</div>
</AdminLayout>

<script>
  import { removeImage } from '../../lib/admin-gallery';
  import { getImageById, getImageCount } from '../../lib/gallery-utils';
  import { deleteImage, associateImage, uploadImageBlob, deleteUploadedFile } from '../../lib/image-utils';
  import { loadProductList, uploadGalleryImages } from '../../lib/admin-products';
  import { wrapModal } from '../../lib/modalHelper';
  import { getApiUrl } from '../../lib/api-url';
  import { escapeHtml } from '../../lib/escape-html';

  const productModal = wrapModal('modal-overlay');
  const deleteModal = wrapModal('delete-overlay');
  const pricingModal = wrapModal('price-overlay');
  const statusModal = wrapModal('status-overlay');

  const API_URL = getApiUrl();
  const fmt = (c: number) => `₲ ${(c || 0).toLocaleString('es-PY')}`;

  let items: any[] = [];
  let currentPage = 1, limit = 25, totalItems = 0, totalPages = 0;
  let currentSearch = '', currentSection = '', currentCategory = '', currentSubcategory = '', currentStatus = '';
  let sections: any[] = [], categories: any[] = [], subcategories: any[] = [];
  let editingProductId: string | null = null;
  let pricingProductId: string | null = null;

  const $ = (id: string) => document.getElementById(id);

  // ═══════════════════════════════════════════════════════════
  // IMAGE STATE — Two separate sections
  // ═══════════════════════════════════════════════════════════
  let primaryImage = {
    blob: null as Blob | null,
    url: null as string | null,
    imageId: null as string | null,
    isNew: false,
  };

  let gallery = {
    images: [] as any[],        // {id, url, alt, is_primary, sort_order}
    newImages: [] as any[],     // {blob, previewUrl, tempId}
    deletedIds: [] as string[], // IDs to delete on save
  };

  // ═══════════════════════════════════════════════════════════
  // DELETE CONFIRMATION — pending delete state
  // ═══════════════════════════════════════════════════════════
  type PendingDelete =
    | { type: 'primary'; imageId: string; imageUrl: string }
    | { type: 'gallery'; index: number; imageId?: string; imageUrl?: string };

  let pendingDelete: PendingDelete | null = null;

  function extractFilename(url: string): string | null {
    try {
      const parts = url.split('/');
      return parts[parts.length - 1] || null;
    } catch {
      return null;
    }
  }

  function openDeleteModal(deleteInfo: PendingDelete) {
    pendingDelete = deleteInfo;
    deleteModal.open();
  }

  function closeDeleteModal() {
    pendingDelete = null;
    deleteModal.close();
  }

  async function confirmDelete() {
    if (!pendingDelete) return;
    const info = pendingDelete;
    closeDeleteModal();

    if (info.type === 'primary') {
      // Delete from DB if exists
      if (info.imageId && editingProductId) {
        await deleteImage('products', editingProductId, info.imageId, API_URL);
      }
      // Delete from R2 if URL exists
      const filename = info.imageUrl ? extractFilename(info.imageUrl) : null;
      if (filename) {
        await deleteUploadedFile(filename, API_URL);
      }
      // Clear UI state
      primaryImage = { blob: null, url: null, imageId: null, isNew: false };
      if (primaryUploadInfo) primaryUploadInfo.style.display = 'none';
      renderPrimary();
    } else {
      // Gallery delete — use module for existing images, manual for new
      const existingCount = gallery.images.length;
      if (info.index < existingCount) {
        // Existing image — delete from DB + R2
        const img = getImageById(gallery.images, gallery.images[info.index].id);
        if (img?.id && editingProductId) {
          await deleteImage('products', editingProductId, img.id, API_URL);
        }
        const filename = img?.url ? extractFilename(img.url) : null;
        if (filename) {
          await deleteUploadedFile(filename, API_URL);
        }
        // Use admin-gallery module to remove and reindex
        gallery.images = removeImage(gallery.images, img!.id);
      } else {
        // New image — just remove from state
        const newIndex = info.index - existingCount;
        gallery.newImages.splice(newIndex, 1);
      }
      gallerySelectedIndex = null;
      renderGallery();
    }
  }

  // ═══════════════════════════════════════════════════════════
  // SLUG GENERATION
  // ═══════════════════════════════════════════════════════════
  function generateSlug(name: string): string {
    return name.toLowerCase()
      .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/(^-|-$)/g, "");
  }

  // ═══════════════════════════════════════════════════════════
  // PRIMARY IMAGE — Upload Area
  // ═══════════════════════════════════════════════════════════
  const primaryUploadArea = $('primary-upload-area');
  const primaryInput = $('primary-input') as HTMLInputElement;
  const primaryImageEl = $('primary-image') as HTMLImageElement;
  const primaryEmpty = $('primary-empty');
  const primaryRemove = $('primary-remove');
  const primaryUploadStatus = $('primary-upload-status');
  const primaryUploadInfo = $('primary-upload-info');
  const primaryUploadInfoText = $('primary-upload-info-text');

  function renderPrimary() {
    const hasImage = primaryImage.blob || primaryImage.url;
    if (primaryEmpty) primaryEmpty.style.display = hasImage ? 'none' : 'flex';
    if (primaryImageEl) {
      if (hasImage) {
        primaryImageEl.src = primaryImage.blob ? URL.createObjectURL(primaryImage.blob) : (primaryImage.url || '');
        primaryImageEl.style.display = 'block';
      } else {
        primaryImageEl.style.display = 'none';
      }
    }
    if (primaryRemove) primaryRemove.style.display = hasImage ? 'flex' : 'none';
  }

  async function handlePrimaryFile(file: File) {
    try {
      if (primaryUploadStatus) primaryUploadStatus.style.display = 'flex';
      if (primaryUploadInfo) primaryUploadInfo.style.display = 'none';

      const { processImage, formatFileSize } = await import('/src/lib/image.ts');
      const processedBlob = await processImage(file);

      primaryImage.blob = processedBlob;
      primaryImage.isNew = true;
      primaryImage.url = null;

      if (primaryUploadInfo && primaryUploadInfoText) {
        const savings = ((1 - processedBlob.size / file.size) * 100).toFixed(0);
        primaryUploadInfoText.textContent = `WebP procesado: ${formatFileSize(processedBlob.size)} (${savings}% menor que original)`;
        primaryUploadInfo.style.display = 'block';
      }

      renderPrimary();
    } catch (err: any) {
      alert(err.message || 'Error al procesar la imagen');
    } finally {
      if (primaryUploadStatus) primaryUploadStatus.style.display = 'none';
      if (primaryInput) primaryInput.value = '';
    }
  }

  // ═══════════════════════════════════════════════════════════
  // GALLERY — Horizontal Scrollable Strip
  // ═══════════════════════════════════════════════════════════
  const galleryStrip = $('gallery-strip');
  const galleryInput = $('gallery-input') as HTMLInputElement;
  const galleryAddBtn = $('gallery-add-btn');
  const galleryUploadStatus = $('gallery-upload-status');
  const galleryUploadInfo = $('gallery-upload-info');
  const galleryUploadInfoText = $('gallery-upload-info-text');
  const galleryCount = $('gallery-count');
  const galleryStripContainer = $('gallery-strip-container');

  let gallerySelectedIndex: number | null = null;

  function renderGallery() {
    const allImages = [...gallery.images, ...gallery.newImages.map((n: any, i: number) => ({
      id: n.tempId,
      url: n.previewUrl,
      isNew: true,
      tempIndex: i,
    }))];

    const hasImages = allImages.length > 0;

    // Show/hide strip container
    if (galleryStripContainer) {
      galleryStripContainer.style.display = hasImages ? 'flex' : 'flex';
    }

    // Render thumbnails
    if (galleryStrip) {
      galleryStrip.innerHTML = allImages.map((img: any, i: number) => {
        const isSelected = i === gallerySelectedIndex;
        return `<div class="gallery-thumb ${isSelected ? 'gallery-thumb--selected' : ''}" data-index="${i}">
          <img src="${img.url}" alt="" />
          <div class="gallery-thumb-actions">
            <button type="button" class="ta-btn ta-btn--delete gallery-remove-btn" data-index="${i}" title="Eliminar">✕</button>
          </div>
        </div>`;
      }).join('');

      // Add click handlers
      galleryStrip.querySelectorAll('.gallery-thumb').forEach(thumb => {
        thumb.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('.gallery-remove-btn')) return;
          const index = parseInt(thumb.getAttribute('data-index') || '0');
          gallerySelectedIndex = gallerySelectedIndex === index ? null : index;
          renderGallery();
        });
      });

      // Remove button handlers
      galleryStrip.querySelectorAll('.gallery-remove-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const index = parseInt(btn.getAttribute('data-index') || '0');
          removeGalleryImage(index);
        });
      });
    }

    // Update count using gallery-utils
    if (galleryCount) {
      const count = getImageCount([...gallery.images, ...gallery.newImages.map((n: any) => ({ id: n.tempId }))]);
      galleryCount.textContent = `${count} imagen${count !== 1 ? 'es' : ''}`;
    }
  }

  function removeGalleryImage(index: number) {
    const existingCount = gallery.images.length;
    if (index < existingCount) {
      // Existing image — confirm delete from DB + R2
      const img = getImageById(gallery.images, gallery.images[index].id);
      openDeleteModal({ type: 'gallery', index, imageId: img?.id, imageUrl: img?.url });
    } else {
      // New image — just remove from state (never uploaded)
      const newIndex = index - existingCount;
      gallery.newImages.splice(newIndex, 1);
      gallerySelectedIndex = null;
      renderGallery();
    }
  }

  async function handleGalleryFiles(files: FileList) {
    try {
      if (galleryUploadStatus) galleryUploadStatus.style.display = 'flex';
      if (galleryUploadInfo) galleryUploadInfo.style.display = 'none';

      const { processImage, formatFileSize } = await import('/src/lib/image.ts');
      let totalSaved = 0;
      let totalOriginal = 0;

      for (const file of Array.from(files)) {
        if (!file.type.startsWith('image/')) continue;
        const processedBlob = await processImage(file);
        const previewUrl = URL.createObjectURL(processedBlob);
        const tempId = `new-${Date.now()}-${Math.random().toString(36).slice(2, 9)}`;

        gallery.newImages.push({
          blob: processedBlob,
          previewUrl,
          tempId,
          originalName: file.name,
        });

        totalOriginal += file.size;
        totalSaved += processedBlob.size;
      }

      if (galleryUploadInfo && galleryUploadInfoText && totalOriginal > 0) {
        const savings = ((1 - totalSaved / totalOriginal) * 100).toFixed(0);
        galleryUploadInfoText.textContent = `${files.length} imagen${files.length !== 1 ? 'es' : ''} procesada${files.length !== 1 ? 's' : ''} a WebP (${savings}% menor)`;
        galleryUploadInfo.style.display = 'block';
      }

      renderGallery();
    } catch (err: any) {
      alert(err.message || 'Error al procesar imágenes');
    } finally {
      if (galleryUploadStatus) galleryUploadStatus.style.display = 'none';
      if (galleryInput) galleryInput.value = '';
    }
  }

  // ═══════════════════════════════════════════════════════════
  // LOAD DEPENDENCIES
  // ═══════════════════════════════════════════════════════════
  async function loadDependencies() {
    const [sec, cats, subs] = await Promise.all([
      fetch(`${API_URL}/api/sections`, { credentials: 'include' }).then(r => r.ok ? r.json() : { sections: [] }),
      fetch(`${API_URL}/api/categories`, { credentials: 'include' }).then(r => r.ok ? r.json() : { categories: [] }),
      fetch(`${API_URL}/api/subcategories`, { credentials: 'include' }).then(r => r.ok ? r.json() : { subcategories: [] }),
    ]);
    sections = sec.sections || [];
    categories = cats.categories || [];
    subcategories = subs.subcategories || [];

    populateSelect('section-filter', sections, 'Todas las secciones');
    populateSelect('section-select', sections, 'Seleccionar...');
  }

  function populateSelect(id: string, data: any[], placeholder: string, valueKey = 'id', labelKey = 'name') {
    const el = $(id) as HTMLSelectElement;
    if (!el) return;
    el.innerHTML = `<option value="">${escapeHtml(placeholder)}</option>` + data.map((d: any) => `<option value="${escapeHtml(d[valueKey])}">${escapeHtml(d[labelKey])}</option>`).join('');
  }

  // ═══════════════════════════════════════════════════════════
  // CASCADE: Section → Category → Subcategory
  // ═══════════════════════════════════════════════════════════
  function onSectionFilterChange() {
    currentSection = ($('section-filter') as HTMLSelectElement).value;
    currentCategory = '';
    currentSubcategory = '';
    const filtered = currentSection ? categories.filter((c: any) => c.section_id === currentSection) : categories;
    populateSelect('category-filter', filtered, 'Todas las categorías');
    populateSelect('subcategory-filter', [], 'Todas las subcategorías');
    currentPage = 1;
    loadProducts();
  }

  function onCategoryFilterChange() {
    currentCategory = ($('category-filter') as HTMLSelectElement).value;
    currentSubcategory = '';
    const filtered = currentCategory ? subcategories.filter((s: any) => s.category_id === currentCategory) : [];
    populateSelect('subcategory-filter', filtered, 'Todas las subcategorías');
    currentPage = 1;
    loadProducts();
  }

  function onSectionSelectChange() {
    const sectionId = ($('section-select') as HTMLSelectElement).value;
    const filtered = sectionId ? categories.filter((c: any) => c.section_id === sectionId) : [];
    const catSelect = $('category-select') as HTMLSelectElement;
    catSelect.innerHTML = '<option value="">Seleccionar...</option>' + filtered.map((c: any) => `<option value="${escapeHtml(c.id)}">${escapeHtml(c.name)}</option>`).join('');
    const subSelect = $('subcategory-select') as HTMLSelectElement;
    subSelect.innerHTML = '<option value="">Seleccionar categoría primero</option>';
  }

  function onCategorySelectChange() {
    const categoryId = ($('category-select') as HTMLSelectElement).value;
    const filtered = categoryId ? subcategories.filter((s: any) => s.category_id === categoryId) : [];
    const subSelect = $('subcategory-select') as HTMLSelectElement;
    subSelect.innerHTML = '<option value="">Seleccionar...</option>' + filtered.map((s: any) => `<option value="${escapeHtml(s.id)}">${escapeHtml(s.name)}</option>`).join('');
  }

  // ═══════════════════════════════════════════════════════════
  // LOAD PRODUCTS
  // ═══════════════════════════════════════════════════════════
  async function loadProducts() {
    const tbody = document.querySelector('tbody');
    if (tbody) tbody.innerHTML = '<tr><td colspan="9" class="empty-cell">Cargando...</td></tr>';
    try {
      const result = await loadProductList(API_URL, {
        page: currentPage,
        limit,
        search: currentSearch || undefined,
        sectionId: currentSection || undefined,
        categoryId: currentCategory || undefined,
        subcategoryId: currentSubcategory || undefined,
        isActive: currentStatus !== '' ? currentStatus === '1' : undefined,
      });
      items = result.items;
      totalItems = result.total;
      totalPages = result.totalPages;
      render();
    } catch (err: any) {
      if (err?.status === 401) { window.location.href = '/login'; return; }
      if (err?.status === 403) { if (tbody) tbody.innerHTML = '<tr><td colspan="9" class="empty-cell">Sin autorización</td></tr>'; return; }
      if (tbody) tbody.innerHTML = '<tr><td colspan="9" class="empty-cell">Error</td></tr>';
    }
  }

  function render() {
    const tbody = document.querySelector('tbody');
    if (!tbody) return;
    if (items.length === 0) { tbody.innerHTML = '<tr><td colspan="9" class="empty-cell">No hay productos</td></tr>'; }
    else {
      tbody.innerHTML = items.map((p: any) => {
        const isActive = !!p.is_active;
        const rowClass = isActive ? '' : 'row--inactive';
        const statusAction = isActive
          ? `<button class="ta-btn ta-btn--delete" onclick="confirmToggleStatus('${escapeHtml(p.id)}', false)" title="Desactivar">🗑️</button>`
          : `<button class="ta-btn ta-btn--warning" onclick="confirmToggleStatus('${escapeHtml(p.id)}', true)" title="Reactivar">🔄</button>`;
        return `<tr class="${rowClass}">
          <td data-label="Nombre"><strong>${escapeHtml(p.name)}</strong></td>
          <td data-label="Slug"><code class="slug-display">${escapeHtml(p.slug) || '—'}</code></td>
          <td data-label="Sección"><span class="tag tag--section">${escapeHtml(p.section_name) || '—'}</span></td>
          <td data-label="Categoría">${escapeHtml(p.category_name) || '—'}</td>
          <td data-label="Subcategoría">${escapeHtml(p.subcategory_name) || '—'}</td>
          <td data-label="Precio Base">${fmt(p.base_price)}</td>
          <td data-label="Atributos"><span class="attr-badge">${p.attribute_count || 0} módulos</span></td>
          <td data-label="Estado"><span class="badge ${isActive ? 'badge--active' : 'badge--inactive'}"><span class="badge-dot"></span>${isActive ? 'Activo' : 'Inactivo'}</span></td>
          <td data-label="Acciones"><div class="cell-actions">
            <button class="ta-btn ta-btn--attr" onclick="openAttributeManager('${escapeHtml(p.id)}')" title="Atributos">🏷️</button>
            <button class="ta-btn" onclick="editProduct('${escapeHtml(p.id)}')" title="Editar">✏️</button>
            <button class="ta-btn ta-btn--price" onclick="openPricing('${escapeHtml(p.id)}')" title="Precios">💰</button>
            ${statusAction}
          </div></td>
        </tr>`;
      }).join('');
    }
    updatePagination();
  }

  function updatePagination() {
    const start = totalItems === 0 ? 0 : (currentPage - 1) * limit + 1;
    const end = Math.min(currentPage * limit, totalItems);
    $('showing')!.textContent = `Mostrando ${start}–${end} de ${totalItems}`;
    $('page-info')!.textContent = `Página ${currentPage} de ${totalPages}`;
    ($('prev') as HTMLButtonElement).disabled = currentPage <= 1;
    ($('next') as HTMLButtonElement).disabled = currentPage >= totalPages;
  }

  // ═══════════════════════════════════════════════════════════
  // PRODUCT MODAL
  // ═══════════════════════════════════════════════════════════
  function openModal(isEdit: boolean, product?: any) {
    const form = $('modal-form') as HTMLFormElement;
    form.reset();
    $('form-error')!.textContent = '';
    $('modal-title')!.textContent = isEdit ? 'Editar Producto' : 'Nuevo Producto';
    ($('modal-id') as HTMLInputElement).value = product?.id || '';
    editingProductId = product?.id || null;

    // Reset primary image state
    primaryImage = { blob: null, url: null, imageId: null, isNew: false };
    renderPrimary();
    if (primaryUploadInfo) primaryUploadInfo.style.display = 'none';

    // Reset gallery state
    gallery = { images: [], newImages: [], deletedIds: [] };
    gallerySelectedIndex = null;
    renderGallery();
    if (galleryUploadInfo) galleryUploadInfo.style.display = 'none';

    // Reset slug manual flag
    const slugInput = $('modal-slug') as HTMLInputElement;
    slugInput.dataset.manual = '';

    // Reset cascade
    $('category-select')!.innerHTML = '<option value="">Seleccionar sección primero</option>';
    $('subcategory-select')!.innerHTML = '<option value="">Seleccionar categoría primero</option>';

    if (isEdit && product) {
      form.name.value = product.name || '';
      slugInput.value = product.slug || '';
      slugInput.dataset.manual = 'true';
      form.description.value = product.description || '';
      form.basePrice.value = product.base_price || '';
      ($('section-select') as HTMLSelectElement).value = product.section_id || '';
      onSectionSelectChange();
      ($('category-select') as HTMLSelectElement).value = product.category_id || '';
      onCategorySelectChange();
      ($('subcategory-select') as HTMLSelectElement).value = product.subcategory_id || '';

      loadProductImages(product.id);
    }
    productModal.open();
  }

  async function loadProductImages(productId: string) {
    try {
      const res = await fetch(`${API_URL}/api/products/${productId}`, { credentials: 'include' });
      if (!res.ok) return;
      const data = await res.json();
      const images = data.product?.images || [];

      // Separate primary from gallery using gallery-utils
      const primaryImg = images.find((img: any) => img.is_primary === 1 || img.is_primary === true);
      const galleryImgs = images.filter((img: any) => img.is_primary !== 1 && img.is_primary !== true)
        .sort((a: any, b: any) => (a.sort_order || 0) - (b.sort_order || 0));

      // Set primary image
      if (primaryImg) {
        primaryImage.url = primaryImg.url;
        primaryImage.imageId = primaryImg.id;
        primaryImage.isNew = false;
      }

      // Set gallery images — use admin-gallery to ensure correct sort_order
      gallery.images = galleryImgs.map((img: any, i: number) => ({
        id: img.id,
        url: img.url,
        alt: img.alt || '',
        is_primary: img.is_primary,
        sort_order: img.sort_order ?? i,
      }));

      renderPrimary();
      renderGallery();
    } catch {
      // Silently fail — image preview is non-critical
    }
  }

  function closeModal() {
    productModal.close();
  }

  // Exposed on window because the table renders `onclick="editProduct('${p.id}')"`.
  (window as any).editProduct = (id: string) => {
    const product = items.find((p: any) => p.id === id);
    if (product) openModal(true, product);
  };

  // ═══════════════════════════════════════════════════════════
  // PRICING MODAL
  // ═══════════════════════════════════════════════════════════
  async function openPricing(productId: string) {
    pricingProductId = productId;
    const product = items.find((p: any) => p.id === productId);
    $('price-product-info')!.innerHTML = product ? `<strong>${escapeHtml(product.name)}</strong> — Precio base: ${fmt(product.base_price)}` : '';

    // Clear any previous error before a fresh open.
    const el = $('price-error');
    if (el) { el.textContent = ''; el.hidden = true; }

    await loadPrices(productId);
    pricingModal.open();
  }

  async function loadPrices(productId: string) {
    const res = await fetch(`${API_URL}/api/products/${productId}/prices`, { credentials: 'include' });
    if (!res.ok) return;
    const { prices } = await res.json();
    const tbody = $('prices-tbody')!;
    if (!prices || prices.length === 0) {
      tbody.innerHTML = '<tr><td colspan="3" class="empty-cell">Sin precios configurados</td></tr>';
    } else {
      tbody.innerHTML = prices.map((p: any) => `<tr>
        <td>${p.min_quantity}+ unds</td>
        <td>${fmt(p.price)}</td>
        <td><div class="cell-actions">
          <button class="ta-btn ta-btn--delete" onclick="deletePrice('${p.id}')" title="Eliminar">🗑️</button>
        </div></td>
      </tr>`).join('');
    }
  }

  function closePricingModal() { pricingModal.close(); pricingProductId = null; }

  // ═══════════════════════════════════════════════════════════
  // EVENT LISTENERS
  // ═══════════════════════════════════════════════════════════
  let searchTimeout: any;

  // ═══════════════════════════════════════════════════════════
  // STATUS TOGGLE — Modal confirmation
  // ═══════════════════════════════════════════════════════════
  let pendingStatusToggle: { id: string; name: string; activate: boolean } | null = null;

  (window as any).confirmToggleStatus = (id: string, activate: boolean) => {
    const product = items.find((p: any) => p.id === id);
    if (!product) return;
    const name = product.name;
    pendingStatusToggle = { id, name, activate };
    $('status-modal-title')!.textContent = activate ? '🔄 Reactivar producto' : '⚠️ Desactivar producto';
    $('status-modal-message')!.textContent = activate
      ? `¿Reactivar "${name}"? El producto volverá a estar visible en la tienda.`
      : `¿Desactivar "${name}"? El producto dejará de aparecer en la tienda.`;
    const activateBtn = $('status-confirm-activate') as HTMLElement;
    const deactivateBtn = $('status-confirm-deactivate') as HTMLElement;
    if (activateBtn) activateBtn.style.display = activate ? '' : 'none';
    if (deactivateBtn) deactivateBtn.style.display = activate ? 'none' : '';
    statusModal.open();
  };

  async function executeStatusToggle() {
    if (!pendingStatusToggle) return;
    const { id, activate } = pendingStatusToggle;

    const confirmActivate = $('status-confirm-activate') as HTMLButtonElement;
    const confirmDeactivate = $('status-confirm-deactivate') as HTMLButtonElement;
    const cancelBtn = $('status-cancel') as HTMLButtonElement;
    const activeBtn = activate ? confirmActivate : confirmDeactivate;
    const origText = activeBtn?.textContent || '';
    if (activeBtn) { activeBtn.disabled = true; activeBtn.textContent = 'Procesando...'; }
    if (cancelBtn) cancelBtn.disabled = true;

    try {
      const res = await fetch(`${API_URL}/api/products/${id}/status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ isActive: activate }),
      });
      statusModal.close();
      pendingStatusToggle = null;
      if (res.ok) {
        loadProducts();
      } else {
        const err = await res.json().catch(() => ({}));
        alert(err.error || `Error al ${activate ? 'reactivar' : 'desactivar'} el producto`);
      }
    } catch {
      statusModal.close();
      pendingStatusToggle = null;
      alert(`Error de conexión al ${activate ? 'reactivar' : 'desactivar'} el producto`);
    } finally {
      if (activeBtn) { activeBtn.disabled = false; activeBtn.textContent = origText; }
      if (cancelBtn) cancelBtn.disabled = false;
    }
  }

  (window as any).openPricing = openPricing;

  // ═══════════════════════════════════════════════════════════
  // ATTRIBUTE MANAGER
  // ═══════════════════════════════════════════════════════════
  let attributeManagerProductId: string | null = null;

  (window as any).openAttributeManager = (id: string) => {
    const product = items.find((p: any) => p.id === id);
    attributeManagerProductId = id;
    const overlay = document.getElementById('attr-overlay');
    if (overlay) {
      overlay.dataset.productId = id;
      const title = overlay.querySelector('h3');
      if (title) title.textContent = `Atributos — ${product?.name || ''}`;
      overlay.style.display = '';
      window.dispatchEvent(new CustomEvent('open-attributes', { detail: { productId: id } }));
    }
  };

  (window as any).deletePrice = async (priceId: string) => {
    if (!pricingProductId || !confirm('¿Eliminar este precio?')) return;
    const res = await fetch(`${API_URL}/api/products/${pricingProductId}/prices/${priceId}`, { method: 'DELETE', credentials: 'include' });
    if (res.ok) loadPrices(pricingProductId);
  };

  async function init() { await loadDependencies(); await loadProducts(); }
  document.addEventListener('astro:page-load', () => {
    $('search')?.addEventListener('input', (e) => { clearTimeout(searchTimeout); searchTimeout = setTimeout(() => { currentSearch = (e.target as HTMLInputElement).value; currentPage = 1; loadProducts(); }, 300); });
    $('section-filter')?.addEventListener('change', onSectionFilterChange);
    $('category-filter')?.addEventListener('change', onCategoryFilterChange);
    $('subcategory-filter')?.addEventListener('change', (e) => { currentSubcategory = (e.target as HTMLSelectElement).value; currentPage = 1; loadProducts(); });
    $('limit')?.addEventListener('change', (e) => { limit = parseInt((e.target as HTMLSelectElement).value); currentPage = 1; loadProducts(); });
    $('status-filter')?.addEventListener('change', (e) => { currentStatus = (e.target as HTMLSelectElement).value; currentPage = 1; loadProducts(); });
    $('prev')?.addEventListener('click', () => { if (currentPage > 1) { currentPage--; loadProducts(); } });
    $('next')?.addEventListener('click', () => { if (currentPage < totalPages) { currentPage++; loadProducts(); } });

    $('section-select')?.addEventListener('change', onSectionSelectChange);
    $('category-select')?.addEventListener('change', onCategorySelectChange);

    $('add-product')?.addEventListener('click', () => openModal(false));
    $('modal-close')?.addEventListener('click', closeModal);
    $('modal-cancel')?.addEventListener('click', closeModal);
    $('modal-overlay')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) closeModal(); });

    $('delete-cancel')?.addEventListener('click', closeDeleteModal);
    $('delete-cancel-x')?.addEventListener('click', closeDeleteModal);
    $('delete-overlay')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) closeDeleteModal(); });
    $('delete-confirm')?.addEventListener('click', confirmDelete);

    $('modal-name')?.addEventListener('input', (e) => {
      const name = (e.target as HTMLInputElement).value;
      const slugInput = $('modal-slug') as HTMLInputElement;
      if (!slugInput.dataset.manual || slugInput.dataset.manual !== 'true') {
        slugInput.value = generateSlug(name);
      }
    });

    $('modal-slug')?.addEventListener('input', (e) => {
      (e.target as HTMLInputElement).dataset.manual = 'true';
    });

    primaryUploadArea?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.primary-remove-btn')) return;
      primaryInput.click();
    });

    primaryInput?.addEventListener('change', () => {
      const file = primaryInput.files?.[0];
      if (file) handlePrimaryFile(file);
    });

    primaryRemove?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (primaryImage.imageId && primaryImage.url) {
        openDeleteModal({ type: 'primary', imageId: primaryImage.imageId, imageUrl: primaryImage.url });
      } else if (primaryImage.blob) {
        primaryImage = { blob: null, url: null, imageId: null, isNew: false };
        if (primaryUploadInfo) primaryUploadInfo.style.display = 'none';
        renderPrimary();
      }
    });

    primaryUploadArea?.addEventListener('dragover', (e) => {
      e.preventDefault();
      primaryUploadArea.classList.add('primary-upload-area--dragover');
    });
    primaryUploadArea?.addEventListener('dragleave', () => {
      primaryUploadArea.classList.remove('primary-upload-area--dragover');
    });
    primaryUploadArea?.addEventListener('drop', (e) => {
      e.preventDefault();
      primaryUploadArea.classList.remove('primary-upload-area--dragover');
      const file = e.dataTransfer?.files?.[0];
      if (file && file.type.startsWith('image/')) handlePrimaryFile(file);
    });

    galleryAddBtn?.addEventListener('click', () => galleryInput.click());
    galleryInput?.addEventListener('change', () => {
      if (galleryInput.files?.length) handleGalleryFiles(galleryInput.files);
    });

    $('modal-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const id = ($('modal-id') as HTMLInputElement).value;
      const isEdit = !!id;
      const slug = ($('modal-slug') as HTMLInputElement).value.trim();
      const submitBtn = $('modal-submit') as HTMLButtonElement;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Guardando...';

      try {
        let primaryUrl: string | null = primaryImage.url;
        if (primaryImage.isNew && primaryImage.blob) {
          try {
            const uploadData = await uploadImageBlob(primaryImage.blob, 'primary.webp', API_URL);
            primaryUrl = uploadData.url;
          } catch (err: any) {
            $('form-error')!.textContent = err.message || 'Error al subir la imagen principal';
            submitBtn.disabled = false;
            submitBtn.textContent = 'Guardar';
            return;
          }
        }

        const body: any = {
          name: form.name.value,
          description: form.description.value || null,
          sectionId: form.sectionId.value,
          categoryId: form.categoryId.value,
          subcategoryId: form.subcategoryId.value || null,
          basePrice: parseInt(form.basePrice.value) || 0,
        };
        if (slug) body.slug = slug;

        const res = await fetch(isEdit ? `${API_URL}/api/products/${id}` : `${API_URL}/api/products`, {
          method: isEdit ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(body),
        });

        if (!res.ok) {
          const err = await res.json();
          $('form-error')!.textContent = err.error || 'Error';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Guardar';
          return;
        }

        const productResult = await res.json();
        const productId = productResult.product?.id || id;

        if (primaryUrl && productId) {
          if (primaryImage.isNew) {
            await associateImage('products', productId, primaryUrl, API_URL, undefined, { is_primary: 1, sort_order: 0 });
          }
        }

        if (gallery.newImages.length > 0) {
          // Processed images are plain Blobs (no .name) — wrap them in File
          // objects so uploadGalleryImages can derive a filename.
          const files = gallery.newImages.map((img: any) =>
            new File([img.blob], img.originalName || 'gallery.webp', { type: 'image/webp' })
          );
          // Append new images after existing ones so ordering is preserved.
          const maxSort = gallery.images.reduce((max: number, img: any) => Math.max(max, img.sort_order ?? 0), 0);
          const uploadResults = await uploadGalleryImages(files, productId, API_URL, maxSort + 1);

          // Surface partial failures instead of closing the modal as if everything
          // persisted — otherwise images can silently never reach R2 (e.g. upload
          // rate limit) while the user sees "guardado OK".
          const failures = uploadResults
            .map((r: any, i: number) => ({ result: r, index: i }))
            .filter(({ result }) => result.status === 'rejected');

          if (failures.length > 0) {
            // Drop the images that already uploaded+associated so a retry doesn't
            // duplicate them; keep only the failed ones pending.
            const succeeded = new Set(
              uploadResults
                .map((r: any, i: number) => ({ result: r, index: i }))
                .filter(({ result }) => result.status === 'fulfilled')
                .map(({ index }) => index)
            );
            gallery.newImages = gallery.newImages.filter((_: any, i: number) => !succeeded.has(i));
            renderGallery();

            const reasons = failures
              .map(({ result }) => result.reason?.message || 'Error de subida')
              .join(' · ');
            $('form-error')!.textContent =
              `${failures.length} imagen(es) de galería no se subieron (${reasons}). ` +
              `El producto se guardó; volvé a tocar Guardar para reintentar las restantes.`;
            return; // keep modal open — product/primary are already persisted
          }
        }

        closeModal();
        loadProducts();
      } catch (err: any) {
        $('form-error')!.textContent = err.message || 'Error al guardar';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Guardar';
      }
    });

    $('price-modal-close')?.addEventListener('click', closePricingModal);
    $('price-modal-cancel')?.addEventListener('click', closePricingModal);
    $('price-overlay')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) closePricingModal(); });

    $('add-price-btn')?.addEventListener('click', async () => {
      if (!pricingProductId) return;
      const minQuantity = parseInt(($('price-min-qty') as HTMLInputElement).value) || 1;
      const price = parseInt(($('price-value') as HTMLInputElement).value);
      if (!price) { alert('Ingresá un precio'); return; }
      const res = await fetch(`${API_URL}/api/products/${pricingProductId}/prices`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
        body: JSON.stringify({ minQuantity, price }),
      });
      const el = $('price-error');
      if (res.ok) {
        if (el) { el.textContent = ''; el.hidden = true; }
        ($('price-min-qty') as HTMLInputElement).value = '1';
        ($('price-value') as HTMLInputElement).value = '';
        loadPrices(pricingProductId);
      } else {
        let msg = 'Error al guardar el precio';
        try { const b = await res.json(); if (b?.error) msg = b.error; } catch {}
        if (el) { el.textContent = msg; el.hidden = false; }
      }
    });

    $('status-confirm-activate')?.addEventListener('click', executeStatusToggle);
    $('status-confirm-deactivate')?.addEventListener('click', executeStatusToggle);
    $('status-cancel')?.addEventListener('click', () => { statusModal.close(); pendingStatusToggle = null; });
    $('status-cancel-x')?.addEventListener('click', () => { statusModal.close(); pendingStatusToggle = null; });
    $('status-overlay')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) { statusModal.close(); pendingStatusToggle = null; } });

    init();
  });
</script>

<style>
  /* ═══════════════════════════════════════════════════════════ */
  /* PRIMARY IMAGE — Upload Area (products-specific)            */
  /* ═══════════════════════════════════════════════════════════ */
  .primary-upload-area {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1;
    max-height: 320px;
    background: var(--surface-container);
    border: 2px dashed var(--outline-variant);
    cursor: pointer;
    transition: all 0.2s ease;
    overflow: hidden;
  }
  .primary-upload-area:hover {
    border-color: var(--primary);
    background: rgba(130, 207, 255, 0.03);
  }
  .primary-upload-area--dragover {
    border-color: var(--primary);
    background: rgba(130, 207, 255, 0.08);
  }
  .primary-preview {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .primary-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--on-surface-variant);
  }
  .primary-empty svg { opacity: 0.4; }
  .primary-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .primary-remove-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 180, 171, 0.15);
    border: 1px solid rgba(255, 180, 171, 0.4);
    color: var(--error);
    cursor: pointer;
    font-size: 14px;
    transition: all 0.15s ease;
    z-index: 2;
  }
  .primary-remove-btn:hover {
    background: rgba(255, 180, 171, 0.3);
    border-color: var(--error);
  }

  /* ═══════════════════════════════════════════════════════════ */
  /* GALLERY — Horizontal Scrollable Strip (products-specific)  */
  /* ═══════════════════════════════════════════════════════════ */
  .gallery-strip-container {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    padding: 4px 0;
    scroll-behavior: smooth;
  }
  .gallery-strip-container::-webkit-scrollbar { height: 4px; }
  .gallery-strip-container::-webkit-scrollbar-track { background: var(--surface-container); }
  .gallery-strip-container::-webkit-scrollbar-thumb { background: rgba(130, 207, 255, 0.3); }

  .gallery-strip {
    display: flex;
    gap: 8px;
