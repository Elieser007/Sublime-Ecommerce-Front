---
/**
 * Admin Users — User Management
 * DataTable with search, filters, pagination, create/edit modal
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import DataTable from '../../components/admin/DataTable.astro';

const columns = [
  { key: 'avatar', label: '', width: '48px' },
  { key: 'name', label: 'Nombre' },
  { key: 'email', label: 'Email' },
  { key: 'role', label: 'Rol' },
  { key: 'branches', label: 'Sucursal(es)' },
  { key: 'created', label: 'Creado' },
  { key: 'actions', label: 'Acciones', width: '100px' },
];
---

<AdminLayout title="Usuarios — Admin">
  <div class="admin-layout">
    <AdminSidebar active="users" />
    <main class="admin-main">
      <div class="admin-header">
        <h1 class="headline-lg-mobile">Usuarios</h1>
        <p class="body-md admin-subtitle">Administra usuarios y sus sucursales</p>
      </div>

      <div class="content-header">
        <div class="toolbar">
          <input type="text" id="search" class="form-input body-md" placeholder="Buscar nombre o email..." />
          <select id="role-filter" class="form-select body-md">
            <option value="">Todos los roles</option>
            <option value="admin">Admin</option>
            <option value="client">Cliente</option>
          </select>
          <select id="limit" class="form-select body-md">
            <option value="10">10</option>
            <option value="25" selected>25</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
        </div>
        <button class="btn btn--primary" id="add-user">
          <span class="btn-icon">+</span> Nuevo
        </button>
      </div>

      <DataTable columns={columns}>
        <tr><td colspan="7" class="empty-cell">Cargando...</td></tr>
      </DataTable>

      <div class="pagination-bar">
        <span class="body-md" id="showing">Mostrando 0 de 0</span>
        <div class="page-nav">
          <button class="btn btn--secondary" id="prev" disabled>Anterior</button>
          <span class="body-md" id="page-info">Página 1 de 1</span>
          <button class="btn btn--secondary" id="next" disabled>Siguiente</button>
        </div>
      </div>
    </main>
  </div>

  <div class="modal-overlay" id="modal-overlay" style="display: none;">
    <div class="modal">
      <div class="modal-header">
        <h3 class="headline-lg-mobile" id="modal-title">Nuevo Usuario</h3>
        <button class="modal-close" id="modal-close">✕</button>
      </div>
      <form class="modal-form" id="modal-form">
        <input type="hidden" id="modal-id" />
        <input type="hidden" name="avatarUrl" id="avatar-url-input" />

        <div class="form-group">
          <label class="label-sm">Avatar</label>
          <div class="avatar-upload-area" id="avatar-upload-area">
            <div class="avatar-preview" id="avatar-preview">
              <div class="avatar-empty" id="avatar-empty">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
                <p class="body-md">Subir avatar</p>
                <p class="label-sm">PNG, JPG o WebP (max 2MB)</p>
              </div>
              <img src="" alt="" class="avatar-image" id="avatar-image" style="display: none;" />
            </div>
            <button type="button" class="avatar-remove-btn" id="avatar-remove" style="display: none;" title="Eliminar avatar">✕</button>
          </div>
          <input type="file" name="avatar-file" id="avatar-input" accept="image/png,image/jpeg,image/webp" class="upload-input" />
          <div class="upload-status" id="avatar-upload-status" style="display: none;">
            <p class="label-sm">Procesando imagen...</p>
          </div>
        </div>

        <div class="form-group">
          <label class="label-sm">Nombre *</label>
          <input type="text" name="name" class="form-input body-md" required />
        </div>
        <div class="form-group">
          <label class="label-sm">Email *</label>
          <input type="email" name="email" class="form-input body-md" required />
        </div>
        <div class="form-group" id="password-group">
          <label class="label-sm">Contraseña *</label>
          <input type="password" name="password" class="form-input body-md" />
        </div>
        <div class="form-group">
          <label class="label-sm">Rol *</label>
          <select name="role" class="form-select body-md" required>
            <option value="admin">Administrador</option>
            <option value="client">Cliente</option>
          </select>
        </div>
        <div class="form-group">
          <label class="label-sm">Sucursales</label>
          <select name="branchIds" id="branch-ids" class="form-select body-md" multiple size="4"></select>
        </div>
        <div class="form-error" id="form-error"></div>
        <div class="form-actions">
          <button type="button" class="btn btn--secondary" id="modal-cancel">Cancelar</button>
          <button type="submit" class="btn btn--primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  import { uploadImage } from '../../lib/image-utils';
  import {
    createEmptyAvatarState,
    hasAvatar,
    setAvatarFromBlob,
    setAvatarFromUrl,
    clearAvatar,
    getAvatarPreviewUrl,
    type AvatarState,
  } from '../../lib/user-avatar';

  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
  let items: any[] = [];
  let currentPage = 1;
  let limit = 25;
  let totalItems = 0;
  let totalPages = 0;
  let currentSearch = '';
  let currentRole = '';
  let branches: any[] = [];
  let currentUserId: string | null = null;
  let avatarState: AvatarState = createEmptyAvatarState();

  const $ = (id: string) => document.getElementById(id);

  async function loadBranches() {
    const res = await fetch(`${API_URL}/api/branches`, { credentials: 'include' });
    if (!res.ok) return;
    const data = await res.json();
    branches = data.branches || [];
    const select = $('branch-ids') as HTMLSelectElement;
    select.innerHTML = branches.map((b: any) => `<option value="${b.id}">${b.name}</option>`).join('');
  }

  async function loadUsers() {
    const tbody = document.querySelector('tbody');
    if (tbody) tbody.innerHTML = '<tr><td colspan="7" class="empty-cell">Cargando...</td></tr>';
    const params = new URLSearchParams();
    params.set('page', String(currentPage));
    params.set('limit', String(limit));
    if (currentSearch) params.set('search', currentSearch);
    if (currentRole) params.set('role', currentRole);
    try {
      const res = await fetch(`${API_URL}/api/users?${params.toString()}`, { credentials: 'include' });
      if (res.status === 401) { window.location.href = '/login'; return; }
      if (!res.ok) throw new Error('Error');
      const data = await res.json();
      items = data.data || [];
      totalItems = data.total || 0;
      totalPages = data.pages || 1;
      render();
    } catch (err) {
      if (tbody) tbody.innerHTML = '<tr><td colspan="7" class="empty-cell">Error al cargar</td></tr>';
    }
  }

  function render() {
    const tbody = document.querySelector('tbody');
    if (!tbody) return;
    if (items.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="empty-cell">No hay usuarios</td></tr>';
    } else {
      tbody.innerHTML = items.map((u: any) => {
        const isSelf = u.id === currentUserId;
        const avatarHtml = u.image
          ? `<img src="${u.image}" alt="${u.name}" class="user-avatar" />`
          : `<div class="user-avatar user-avatar--placeholder">${u.name?.charAt(0)?.toUpperCase() || '?'}</div>`;
        return `<tr>
          <td data-label="Avatar">${avatarHtml}</td>
          <td data-label="Nombre"><strong>${u.name}</strong></td>
          <td data-label="Email">${u.email}</td>
          <td data-label="Rol"><span class="badge ${u.role === 'admin' ? 'badge--active' : 'badge--inactive'}"><span class="badge-dot"></span>${u.role === 'admin' ? 'Admin' : 'Cliente'}</span></td>
          <td data-label="Sucursal">${u.branch_names || '—'}</td>
          <td data-label="Creado">${new Date(u.created_at * 1000).toLocaleDateString('es-PY')}</td>
          <td data-label="Acciones"><div class="cell-actions">
            <button class="ta-btn" onclick="editUser('${u.id}')" title="Editar">✏️</button>
            ${isSelf ? '<span class="self-tag">Tú</span>' : `<button class="ta-btn ta-btn--delete" onclick="deleteUser('${u.id}')" title="Eliminar">🗑️</button>`}
          </div></td>
        </tr>`;
      }).join('');
    }
    updatePagination();
  }

  function updatePagination() {
    const start = totalItems === 0 ? 0 : (currentPage - 1) * limit + 1;
    const end = Math.min(currentPage * limit, totalItems);
    $('showing')!.textContent = `Mostrando ${start}–${end} de ${totalItems}`;
    $('page-info')!.textContent = `Página ${currentPage} de ${totalPages}`;
    ($('prev') as HTMLButtonElement).disabled = currentPage <= 1;
    ($('next') as HTMLButtonElement).disabled = currentPage >= totalPages;
  }

  // ─── AVATAR UPLOAD ──────────────────────────────────────
  const avatarUploadArea = $('avatar-upload-area');
  const avatarInput = $('avatar-input') as HTMLInputElement;
  const avatarImageEl = $('avatar-image') as HTMLImageElement;
  const avatarEmpty = $('avatar-empty');
  const avatarRemove = $('avatar-remove');
  const avatarUploadStatus = $('avatar-upload-status');
  const avatarUrlInput = $('avatar-url-input') as HTMLInputElement;

  function renderAvatar() {
    const hasImg = hasAvatar(avatarState);
    if (avatarEmpty) avatarEmpty.style.display = hasImg ? 'none' : 'flex';
    if (avatarImageEl) {
      if (hasImg) {
        avatarImageEl.src = getAvatarPreviewUrl(avatarState) || '';
        avatarImageEl.style.display = 'block';
      } else {
        avatarImageEl.style.display = 'none';
      }
    }
    if (avatarRemove) avatarRemove.style.display = hasImg ? 'flex' : 'none';
  }

  async function handleAvatarFile(file: File) {
    if (file.size > 2 * 1024 * 1024) {
      $('form-error')!.textContent = 'Avatar muy grande (max 2MB)';
      return;
    }

    try {
      if (avatarUploadStatus) avatarUploadStatus.style.display = 'flex';
      const { processImage } = await import('/src/lib/image.ts');
      const processedBlob = await processImage(file);
      avatarState = setAvatarFromBlob(avatarState, processedBlob);
      renderAvatar();
    } catch (err: any) {
      $('form-error')!.textContent = err.message || 'Error al procesar imagen';
    } finally {
      if (avatarUploadStatus) avatarUploadStatus.style.display = 'none';
      if (avatarInput) avatarInput.value = '';
    }
  }

  avatarUploadArea?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.avatar-remove-btn')) return;
    avatarInput.click();
  });

  avatarInput?.addEventListener('change', () => {
    const file = avatarInput.files?.[0];
    if (file) handleAvatarFile(file);
  });

  avatarRemove?.addEventListener('click', (e) => {
    e.stopPropagation();
    avatarState = clearAvatar(avatarState);
    if (avatarUrlInput) avatarUrlInput.value = '';
    renderAvatar();
  });

  // Drag & drop
  avatarUploadArea?.addEventListener('dragover', (e) => {
    e.preventDefault();
    avatarUploadArea.classList.add('avatar-upload-area--dragover');
  });
  avatarUploadArea?.addEventListener('dragleave', () => {
    avatarUploadArea.classList.remove('avatar-upload-area--dragover');
  });
  avatarUploadArea?.addEventListener('drop', (e) => {
    e.preventDefault();
    avatarUploadArea.classList.remove('avatar-upload-area--dragover');
    const file = e.dataTransfer?.files?.[0];
    if (file && file.type.startsWith('image/')) handleAvatarFile(file);
  });

  // ─── MODAL ──────────────────────────────────────────────
  function openModal(isEdit: boolean, user?: any) {
    const form = $('modal-form') as HTMLFormElement;
    form.reset();
    $('form-error')!.textContent = '';
    $('modal-title')!.textContent = isEdit ? 'Editar Usuario' : 'Nuevo Usuario';
    ($('modal-id') as HTMLInputElement).value = user?.id || '';
    ($('password-group') as HTMLElement).style.display = isEdit ? 'none' : 'block';

    // Reset avatar state
    avatarState = createEmptyAvatarState();
    if (avatarUrlInput) avatarUrlInput.value = '';
    renderAvatar();

    if (user) {
      form.name.value = user.name || '';
      form.email.value = user.email || '';
      form.role.value = user.role || 'client';

      // Load existing avatar
      if (user.image) {
        avatarState = setAvatarFromUrl(avatarState, user.image);
        avatarUrlInput.value = user.image;
        renderAvatar();
      }
    }
    $('modal-overlay')!.style.display = '';
  }

  function closeModal() { $('modal-overlay')!.style.display = 'none'; }

  $('add-user')?.addEventListener('click', () => openModal(false));
  $('modal-close')?.addEventListener('click', closeModal);
  $('modal-cancel')?.addEventListener('click', closeModal);
  $('modal-overlay')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) closeModal(); });

  let searchTimeout: any;
  $('search')?.addEventListener('input', (e) => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => { currentSearch = (e.target as HTMLInputElement).value; currentPage = 1; loadUsers(); }, 300);
  });
  $('role-filter')?.addEventListener('change', (e) => { currentRole = (e.target as HTMLSelectElement).value; currentPage = 1; loadUsers(); });
  $('limit')?.addEventListener('change', (e) => { limit = parseInt((e.target as HTMLSelectElement).value); currentPage = 1; loadUsers(); });
  $('prev')?.addEventListener('click', () => { if (currentPage > 1) { currentPage--; loadUsers(); } });
  $('next')?.addEventListener('click', () => { if (currentPage < totalPages) { currentPage++; loadUsers(); } });

  $('modal-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const id = ($('modal-id') as HTMLInputElement).value;
    const isEdit = !!id;
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Guardando...';

    try {
      // Step 1: Upload avatar if new
      let avatarUrl = avatarUrlInput.value;
      if (avatarState.isNew && avatarState.blob) {
        const file = new File([avatarState.blob], 'avatar.webp', { type: 'image/webp' });
        const uploadResult = await uploadImage(file, API_URL);
        if (!uploadResult.url) {
          $('form-error')!.textContent = uploadResult.error || 'Error al subir avatar';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Guardar';
          return;
        }
        avatarUrl = uploadResult.url;
      }

      // Step 2: Create or update user
      const body: any = {
        name: form.name.value,
        email: form.email.value,
        role: form.role.value,
        avatarUrl: avatarUrl || null,
      };
      if (!isEdit) body.password = form.password.value;
      body.branchIds = Array.from((form.branchIds as unknown as HTMLSelectElement).selectedOptions).map((o) => o.value);

      const res = await fetch(isEdit ? `${API_URL}/api/users/${id}` : `${API_URL}/api/users`, {
        method: isEdit ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(body),
      });

      if (!res.ok) {
        const err = await res.json();
        $('form-error')!.textContent = err.error || 'Error';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Guardar';
        return;
      }

      closeModal();
      loadUsers();
    } catch (err: any) {
      $('form-error')!.textContent = err.message || 'Error al guardar';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Guardar';
    }
  });

  (window as any).editUser = (id: string) => { const user = items.find((u: any) => u.id === id); if (user) openModal(true, user); };
  (window as any).deleteUser = async (id: string) => {
    if (id === currentUserId) { alert('No puedes eliminarte a ti mismo'); return; }
    if (!confirm('¿Eliminar este usuario?')) return;
    const res = await fetch(`${API_URL}/api/users/${id}`, { method: 'DELETE', credentials: 'include' });
    if (res.ok) loadUsers();
  };

  async function init() {
    const me = await fetch(`${API_URL}/api/me`, { credentials: 'include' });
    if (me.ok) { const { user } = await me.json(); currentUserId = user.id; }
    await loadBranches();
    await loadUsers();
  }
  init();
</script>

<style>
  /* ─── Users-specific styles ───────────────────────────────── */
  .self-tag {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    color: var(--primary);
    border: 1px solid rgba(130, 207, 255, 0.3);
    padding: 2px 6px;
  }

  /* User Avatar */
  :global(.user-avatar) {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(62, 72, 80, 0.3);
  }
  :global(.user-avatar--placeholder) {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(130, 207, 255, 0.1);
    color: var(--primary);
    font-family: 'Space Mono', monospace;
    font-size: 14px;
    font-weight: 600;
  }

  /* Avatar Upload Area */
  .avatar-upload-area {
    border: 2px dashed rgba(62, 72, 80, 0.3);
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .avatar-upload-area:hover { border-color: var(--primary); }
  .avatar-upload-area--dragover { border-color: var(--primary); background: rgba(130, 207, 255, 0.05); }
  .avatar-preview { width: 100%; text-align: center; }
  .avatar-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--on-surface-variant);
    padding: 16px;
  }
  .avatar-empty svg { opacity: 0.5; }
  .avatar-image {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    margin: 8px auto;
    border: 2px solid rgba(62, 72, 80, 0.3);
  }
  .avatar-remove-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 24px;
    height: 24px;
    background: rgba(0,0,0,0.7);
    border: 1px solid rgba(255,255,255,0.3);
    color: white;
    cursor: pointer;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
  }
  .avatar-remove-btn:hover { background: #ffb4ab; }
</style>
