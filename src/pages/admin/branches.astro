---
/**
 * Admin Branches — Branch Management
 * DataTable with search, filters, pagination, create/edit modal
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import DataTable from '../../components/admin/DataTable.astro';
import Button from '../../components/Button.astro';

const columns = [
  { key: 'name', label: 'Nombre' },
  { key: 'slug', label: 'Slug' },
  { key: 'address', label: 'Dirección' },
  { key: 'phone', label: 'Teléfono' },
  { key: 'status', label: 'Estado' },
  { key: 'actions', label: 'Acciones', width: '100px' },
];
---

<AdminLayout title="Sucursales — Admin">
  <AdminSidebar active="branches" />
  <main class="admin-main">
    <div class="admin-header">
      <h1 class="headline-lg-mobile">Sucursales</h1>
      <p class="body-md admin-subtitle">Administra las sucursales del negocio</p>
    </div>

    <div class="content-header">
      <div class="toolbar">
        <input type="text" id="search" class="form-input body-md" placeholder="Buscar nombre o dirección..." />
        <select id="status-filter" class="form-select body-md">
          <option value="">Todos</option>
          <option value="1">Activas</option>
          <option value="0">Inactivas</option>
        </select>
        <select id="limit" class="form-select body-md">
          <option value="10">10</option>
          <option value="25" selected>25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
      </div>
      <Button variant="primary" id="add-branch">+ Nueva</Button>
    </div>

    <DataTable columns={columns}>
      <tr><td colspan="6" class="empty-cell">Cargando...</td></tr>
    </DataTable>

    <div class="pagination-bar">
      <span class="body-md" id="showing">Mostrando 0 de 0</span>
      <div class="page-nav">
        <Button variant="secondary" id="prev" disabled>Anterior</Button>
        <span class="body-md" id="page-info">Página 1 de 1</span>
        <Button variant="secondary" id="next" disabled>Siguiente</Button>
      </div>
    </div>
  </main>

<div class="modal-overlay" id="modal-overlay" style="display: none;">
  <div class="modal">
    <div class="modal-header">
      <h3 class="headline-lg-mobile" id="modal-title">Nueva Sucursal</h3>
      <button class="modal-close" id="modal-close">✕</button>
    </div>
    <form class="modal-form" id="modal-form">
      <input type="hidden" id="modal-id" />
      <div class="form-group">
        <label class="label-sm">Nombre *</label>
        <input type="text" name="name" class="form-input body-md" required />
      </div>
      <div class="form-group">
        <label class="label-sm">Dirección</label>
        <input type="text" name="address" class="form-input body-md" />
      </div>
      <div class="form-group">
        <label class="label-sm">Teléfono</label>
        <input type="text" name="phone" class="form-input body-md" />
      </div>
      <div class="form-group" id="slug-group" style="display: none;">
        <label class="label-sm">Slug</label>
        <code class="slug-display" id="slug-display"></code>
      </div>
      <div class="form-error" id="form-error"></div>
      <div class="form-actions">
        <Button variant="secondary" id="modal-cancel">Cancelar</Button>
        <Button variant="primary" type="submit">Guardar</Button>
      </div>
    </form>
  </div>
</div>
</AdminLayout>

<script>
  import { wrapModal } from '../../lib/modalHelper';
  const branchModal = wrapModal('modal-overlay');

  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
  let items: any[] = [];
  let currentPage = 1;
  let limit = 25;
  let totalItems = 0;
  let totalPages = 0;
  let currentSearch = '';
  let currentStatus = '';

  const $ = (id: string) => document.getElementById(id);

  async function loadBranches() {
    const tbody = document.querySelector('tbody');
    if (tbody) tbody.innerHTML = '<tr><td colspan="6" class="empty-cell">Cargando...</td></tr>';
    const params = new URLSearchParams();
    params.set('page', String(currentPage));
    params.set('limit', String(limit));
    if (currentSearch) params.set('search', currentSearch);
    if (currentStatus) params.set('is_active', currentStatus);
    try {
      const res = await fetch(`${API_URL}/api/branches?${params.toString()}`, { credentials: 'include' });
      if (res.status === 401) { window.location.href = '/login'; return; }
      if (!res.ok) throw new Error('Error');
      const data = await res.json();
      items = data.data || [];
      totalItems = data.total || 0;
      totalPages = data.pages || 1;
      render();
    } catch (err) {
      if (tbody) tbody.innerHTML = '<tr><td colspan="6" class="empty-cell">Error al cargar</td></tr>';
    }
  }

  function render() {
    const tbody = document.querySelector('tbody');
    if (!tbody) return;
    if (items.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" class="empty-cell">No hay sucursales</td></tr>';
    } else {
      tbody.innerHTML = items.map((b: any) => `<tr>
        <td data-label="Nombre"><strong>${b.name}</strong></td>
        <td data-label="Slug"><code class="slug-badge">${b.slug}</code></td>
        <td data-label="Dirección">${b.address || '—'}</td>
        <td data-label="Teléfono">${b.phone || '—'}</td>
        <td data-label="Estado"><span class="badge ${b.is_active ? 'badge--active' : 'badge--inactive'}"><span class="badge-dot"></span>${b.is_active ? 'Activo' : 'Inactivo'}</span></td>
        <td data-label="Acciones"><div class="cell-actions">
          <button class="ta-btn" onclick="editBranch('${b.id}')" title="Editar">✏️</button>
          <button class="ta-btn ta-btn--delete" onclick="deleteBranch('${b.id}')" title="Desactivar">🗑️</button>
        </div></td>
      </tr>`).join('');
    }
    updatePagination();
  }

  function updatePagination() {
    const start = totalItems === 0 ? 0 : (currentPage - 1) * limit + 1;
    const end = Math.min(currentPage * limit, totalItems);
    $('showing')!.textContent = `Mostrando ${start}–${end} de ${totalItems}`;
    $('page-info')!.textContent = `Página ${currentPage} de ${totalPages}`;
    ($('prev') as HTMLButtonElement).disabled = currentPage <= 1;
    ($('next') as HTMLButtonElement).disabled = currentPage >= totalPages;
  }

  function openModal(isEdit: boolean, branch?: any) {
    const form = $('modal-form') as HTMLFormElement;
    form.reset();
    $('form-error')!.textContent = '';
    $('modal-title')!.textContent = isEdit ? 'Editar Sucursal' : 'Nueva Sucursal';
    ($('modal-id') as HTMLInputElement).value = branch?.id || '';
    ($('slug-group') as HTMLElement).style.display = isEdit ? 'block' : 'none';
    if (branch) {
      form.name.value = branch.name || '';
      form.address.value = branch.address || '';
      form.phone.value = branch.phone || '';
      $('slug-display')!.textContent = branch.slug || '';
    }
    branchModal.open();
  }

  function closeModal() { branchModal.close(); }

  (window as any).editBranch = (id: string) => { const branch = items.find((b: any) => b.id === id); if (branch) openModal(true, branch); };
  (window as any).deleteBranch = async (id: string) => {
    if (!confirm('¿Desactivar esta sucursal?')) return;
    const res = await fetch(`${API_URL}/api/branches/${id}`, { method: 'DELETE', credentials: 'include' });
    if (res.ok) loadBranches();
  };

  let searchTimeout: any;
  document.addEventListener('astro:page-load', () => {
    $('add-branch')?.addEventListener('click', () => openModal(false));
    $('modal-close')?.addEventListener('click', closeModal);
    $('modal-cancel')?.addEventListener('click', closeModal);
    $('modal-overlay')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) closeModal(); });

    $('search')?.addEventListener('input', (e) => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => { currentSearch = (e.target as HTMLInputElement).value; currentPage = 1; loadBranches(); }, 300);
    });
    $('status-filter')?.addEventListener('change', (e) => { currentStatus = (e.target as HTMLSelectElement).value; currentPage = 1; loadBranches(); });
    $('limit')?.addEventListener('change', (e) => { limit = parseInt((e.target as HTMLSelectElement).value); currentPage = 1; loadBranches(); });
    $('prev')?.addEventListener('click', () => { if (currentPage > 1) { currentPage--; loadBranches(); } });
    $('next')?.addEventListener('click', () => { if (currentPage < totalPages) { currentPage++; loadBranches(); } });

    $('modal-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const id = ($('modal-id') as HTMLInputElement).value;
      const isEdit = !!id;
      const body = { name: form.name.value, address: form.address.value || null, phone: form.phone.value || null };
      const res = await fetch(isEdit ? `${API_URL}/api/branches/${id}` : `${API_URL}/api/branches`, {
        method: isEdit ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify(body),
      });
      if (!res.ok) { const err = await res.json(); $('form-error')!.textContent = err.error || 'Error'; return; }
      closeModal(); loadBranches();
    });

    loadBranches();
  });
</script>

<style>
  /* ─── Branches-specific styles ───────────────────────────── */
  .slug-display { display: inline-block; padding: 10px 12px; background-color: rgba(53, 53, 53, 0.5); border: 1px solid rgba(62, 72, 80, 0.3); color: var(--on-surface-variant); font-family: 'Space Mono', monospace; font-size: 12px; border-radius: 0px; }
</style>
