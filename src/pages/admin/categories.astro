---
/**
 * Admin Categories — Manage Sections, Categories, Subcategories
 * 
 * Uses reusable components: DataTable, Badge
 */

import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import DataTable from '../../components/admin/DataTable.astro';
import Button from '../../components/Button.astro';


const sectionColumns = [
  { key: 'name', label: 'Nombre' },
  { key: 'slug', label: 'Slug' },
  { key: 'description', label: 'Descripción' },
  { key: 'status', label: 'Estado' },
  { key: 'actions', label: 'Acciones', width: '100px' },
];

const categoryColumns = [
  { key: 'name', label: 'Nombre' },
  { key: 'section', label: 'Sección' },
  { key: 'slug', label: 'Slug' },
  { key: 'status', label: 'Estado' },
  { key: 'actions', label: 'Acciones', width: '100px' },
];

const subcategoryColumns = [
  { key: 'name', label: 'Nombre' },
  { key: 'category', label: 'Categoría' },
  { key: 'slug', label: 'Slug' },
  { key: 'status', label: 'Estado' },
  { key: 'actions', label: 'Acciones', width: '100px' },
];
---

<AdminLayout title="Categorías — Admin">
  <AdminSidebar active="categories" />
  <main class="admin-main">
    <div class="admin-header">
      <h1 class="headline-lg-mobile">Categorías</h1>
      <p class="body-md admin-subtitle">Sección → Categoría → Subcategoría</p>
    </div>

    <!-- Tabs -->
    <div class="tabs">
      <button class="tab active" data-tab="sections">📁 Secciones</button>
      <button class="tab" data-tab="categories">📦 Categorías</button>
      <button class="tab" data-tab="subcategories">🏷️ Subcategorías</button>
    </div>

    <!-- Sections Tab -->
    <div class="tab-content active" id="tab-sections">
      <div class="content-header">
        <div class="content-info">
          <h2 class="body-lg">Secciones</h2>
          <p class="label-sm content-desc">Grupo macro de artículos</p>
        </div>
        <Button variant="primary" id="add-section">+ Nueva Sección</Button>
      </div>
      <p class="body-md examples">
        Ej: <span class="example-tag">Indumentaria</span> <span class="example-tag">Accesorios</span> <span class="example-tag">Papelería</span>
      </p>
      <DataTable columns={sectionColumns}>
        <tr id="sections-loading"><td colspan="5" class="empty-cell">Cargando...</td></tr>
      </DataTable>
    </div>

    <!-- Categories Tab -->
    <div class="tab-content" id="tab-categories">
      <div class="content-header">
        <div class="content-info">
          <h2 class="body-lg">Categorías</h2>
          <p class="label-sm content-desc">Producto base a sublimar</p>
        </div>
        <Button variant="primary" id="add-category">+ Nueva Categoría</Button>
      </div>
      <p class="body-md examples">
        Ej: <span class="example-tag">Remeras</span> <span class="example-tag">Tazas</span> <span class="example-tag">Termos</span>
      </p>
      <DataTable columns={categoryColumns}>
        <tr id="categories-loading"><td colspan="5" class="empty-cell">Cargando...</td></tr>
      </DataTable>
    </div>

    <!-- Subcategories Tab -->
    <div class="tab-content" id="tab-subcategories">
      <div class="content-header">
        <div class="content-info">
          <h2 class="body-lg">Subcategorías</h2>
          <p class="label-sm content-desc">Detalle técnico o temática</p>
        </div>
        <Button variant="primary" id="add-subcategory">+ Nueva Subcategoría</Button>
      </div>
      <p class="body-md examples">
        Ej: <span class="example-tag">Anime</span> <span class="example-tag">Frases</span> <span class="example-tag">Tazas Mágicas</span>
      </p>
      <DataTable columns={subcategoryColumns}>
        <tr id="subcategories-loading"><td colspan="5" class="empty-cell">Cargando...</td></tr>
      </DataTable>
    </div>

    <!-- Modal -->
    <div class="modal-overlay" id="modal-overlay" style="display: none;">
      <div class="modal">
        <div class="modal-header">
          <h3 class="headline-lg-mobile" id="modal-title">Nuevo</h3>
          <button class="modal-close" id="modal-close">✕</button>
        </div>
        <form class="modal-form" id="modal-form">
          <input type="hidden" id="modal-id" />
          <input type="hidden" id="modal-type" />
          <div class="form-group">
            <label class="label-sm">Nombre *</label>
            <input type="text" name="name" id="modal-name" class="form-input body-md" required />
          </div>
          <div class="form-group">
            <label class="label-sm">Slug</label>
            <input type="text" name="slug" id="modal-slug" class="form-input body-md" placeholder="auto-generado" />
            <p class="label-sm" style="margin-top: 4px; opacity: 0.6;">Si lo dejas vacío se genera solo del nombre. Solo minúsculas, números y guiones.</p>
          </div>
          <div class="form-group" id="parent-group" style="display: none;">
            <label class="label-sm" id="parent-label">Sección</label>
            <select name="parentId" class="form-select body-md" id="parent-select">
              <option value="">Seleccionar...</option>
            </select>
          </div>
          <div class="form-group">
            <label class="label-sm">Descripción</label>
            <textarea name="description" class="form-textarea body-md" rows="2"></textarea>
          </div>
          <div class="form-group">
            <label class="label-sm">Orden</label>
            <input type="number" name="sortOrder" class="form-input body-md" value="0" />
          </div>
          <div class="form-actions">
            <Button variant="secondary" id="modal-cancel">Cancelar</Button>
            <Button variant="primary" type="submit">Guardar</Button>
          </div>
        </form>
      </div>
    </div>
  </main>
</AdminLayout>

<script>
  import { wrapModal } from '../../lib/modalHelper';
  import { escapeHtml } from '../../lib/escape-html';
  const catModal = wrapModal('modal-overlay');

  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
  let sections: any[] = [];
  let categories: any[] = [];
  let subcategories: any[] = [];

  function generateSlug(name: string): string {
    return name.toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '');
  }

  async function loadSections() {
    const res = await fetch(`${API_URL}/api/admin/sections`, { credentials: 'include' });
    if (res.status === 401) { window.location.href = '/login'; return; }
    if (res.ok) { const data = await res.json(); sections = data.sections || []; renderSections(); }
  }

  async function loadCategories() {
    const res = await fetch(`${API_URL}/api/admin/categories`, { credentials: 'include' });
    if (res.status === 401) { window.location.href = '/login'; return; }
    if (res.ok) { const data = await res.json(); categories = data.categories || []; renderCategories(); }
  }

  async function loadSubcategories() {
    const res = await fetch(`${API_URL}/api/admin/subcategories`, { credentials: 'include' });
    if (res.status === 401) { window.location.href = '/login'; return; }
    if (res.ok) { const data = await res.json(); subcategories = data.subcategories || []; renderSubcategories(); }
  }

  async function loadAll() {
    await loadSections();
    await loadCategories();
    await loadSubcategories();
  }

  function renderSections() {
    const tbody = document.querySelector('#tab-sections tbody');
    if (!tbody) return;
    if (sections.length === 0) { tbody.innerHTML = '<tr><td colspan="5" class="empty-cell">No hay secciones</td></tr>'; return; }
    tbody.innerHTML = sections.map((s) => {
      const isActive = !!s.is_active;
      const statusBadge = isActive
        ? `<span class="badge badge--active"><span class="badge-dot"></span>Activo</span>`
        : `<span class="badge badge--inactive"><span class="badge-dot"></span>Inactivo</span>`;
      const actionBtn = isActive
        ? `<button class="ta-btn ta-btn--delete" onclick="deleteItem('section','${escapeHtml(s.id)}')" title="Desactivar">🗑️</button>`
        : `<button class="ta-btn ta-btn--warning" onclick="toggleStatus('${escapeHtml(s.id)}', true, 'section')" title="Reactivar">🔄</button>`;
      return `<tr class="${isActive ? '' : 'row--inactive'}">
        <td data-label="Nombre"><strong>${escapeHtml(s.name)}</strong></td>
        <td data-label="Slug"><code class="slug-badge">${escapeHtml(s.slug)}</code></td>
        <td data-label="Descripción">${escapeHtml(s.description) || '—'}</td>
        <td data-label="Estado">${statusBadge}</td>
        <td data-label="Acciones">
          <div class="cell-actions">
            <button class="ta-btn" onclick="editItem('section','${escapeHtml(s.id)}')" title="Editar">✏️</button>
            ${actionBtn}
          </div>
        </td>
      </tr>`;
    }).join('');
  }

  function renderCategories() {
    const tbody = document.querySelector('#tab-categories tbody');
    if (!tbody) return;
    if (categories.length === 0) { tbody.innerHTML = '<tr><td colspan="5" class="empty-cell">No hay categorías</td></tr>'; return; }
    tbody.innerHTML = categories.map((c) => {
      const sec = sections.find((s) => s.id === c.section_id);
      const parentInactive = !!sec && sec.is_active === 0;
      const isActive = !!c.is_active;
      const statusBadge = parentInactive
        ? `<span class="badge badge--inactive"><span class="badge-dot"></span>Padre inactivo</span>`
        : isActive
          ? `<span class="badge badge--active"><span class="badge-dot"></span>Activo</span>`
          : `<span class="badge badge--inactive"><span class="badge-dot"></span>Inactivo</span>`;
      const actionBtn = parentInactive || !isActive
        ? `<button class="ta-btn ta-btn--warning" onclick="toggleStatus('${escapeHtml(c.id)}', true, 'category')" title="Reactivar">🔄</button>`
        : `<button class="ta-btn ta-btn--delete" onclick="deleteItem('category','${escapeHtml(c.id)}')" title="Desactivar">🗑️</button>`;
      return `<tr class="${parentInactive || !isActive ? 'row--inactive' : ''}">
        <td data-label="Nombre"><strong>${escapeHtml(c.name)}</strong></td>
        <td data-label="Sección"><span class="parent-badge">${escapeHtml(sec?.name) || '—'}</span></td>
        <td data-label="Slug"><code class="slug-badge">${escapeHtml(c.slug)}</code></td>
        <td data-label="Estado">${statusBadge}</td>
        <td data-label="Acciones"><div class="cell-actions">
          <button class="ta-btn" onclick="editItem('category','${escapeHtml(c.id)}')" title="Editar">✏️</button>
          ${actionBtn}
        </div></td>
      </tr>`;
    }).join('');
  }

  function renderSubcategories() {
    const tbody = document.querySelector('#tab-subcategories tbody');
    if (!tbody) return;
    if (subcategories.length === 0) { tbody.innerHTML = '<tr><td colspan="5" class="empty-cell">No hay subcategorías</td></tr>'; return; }
    tbody.innerHTML = subcategories.map((s) => {
      const cat = categories.find((c) => c.id === s.category_id);
      const parentInactive = !!cat && cat.is_active === 0;
      const isActive = !!s.is_active;
      const statusBadge = parentInactive
        ? `<span class="badge badge--inactive"><span class="badge-dot"></span>Padre inactivo</span>`
        : isActive
          ? `<span class="badge badge--active"><span class="badge-dot"></span>Activo</span>`
          : `<span class="badge badge--inactive"><span class="badge-dot"></span>Inactivo</span>`;
      const actionBtn = parentInactive || !isActive
        ? `<button class="ta-btn ta-btn--warning" onclick="toggleStatus('${escapeHtml(s.id)}', true, 'subcategory')" title="Reactivar">🔄</button>`
        : `<button class="ta-btn ta-btn--delete" onclick="deleteItem('subcategory','${escapeHtml(s.id)}')" title="Desactivar">🗑️</button>`;
      return `<tr class="${parentInactive || !isActive ? 'row--inactive' : ''}">
        <td data-label="Nombre"><strong>${escapeHtml(s.name)}</strong></td>
        <td data-label="Categoría"><span class="parent-badge">${escapeHtml(cat?.name) || '—'}</span></td>
        <td data-label="Slug"><code class="slug-badge">${escapeHtml(s.slug)}</code></td>
        <td data-label="Estado">${statusBadge}</td>
        <td data-label="Acciones"><div class="cell-actions">
          <button class="ta-btn" onclick="editItem('subcategory','${escapeHtml(s.id)}')" title="Editar">✏️</button>
          ${actionBtn}
        </div></td>
      </tr>`;
    }).join('');
  }

  function openModal(type: string, mode: string, data?: any) {
    const overlay = document.getElementById('modal-overlay');
    const title = document.getElementById('modal-title');
    const typeInput = document.getElementById('modal-type') as HTMLInputElement;
    const idInput = document.getElementById('modal-id') as HTMLInputElement;
    const parentGroup = document.getElementById('parent-group');
    const parentLabel = document.getElementById('parent-label');
    const parentSelect = document.getElementById('parent-select') as HTMLSelectElement;
    if (!overlay || !title) return;
    typeInput.value = type;
    idInput.value = data?.id || '';
    const typeNames: Record<string, string> = { section: 'Sección', category: 'Categoría', subcategory: 'Subcategoría' };
    title.textContent = mode === 'create' ? `Nueva ${typeNames[type]}` : `Editar ${typeNames[type]}`;
    if (type === 'category') {
      parentGroup.style.display = '';
      parentLabel.textContent = 'Sección *';
      const activeParents = sections.filter((s) => !!s.is_active);
      const parentOptions = activeParents.map((s) => `<option value="${escapeHtml(s.id)}">${escapeHtml(s.name)}</option>`);
      if (data?.section_id) {
        const currentParent = sections.find((s) => s.id === data.section_id);
        if (currentParent && !currentParent.is_active) {
          parentOptions.unshift(`<option value="${escapeHtml(currentParent.id)}" disabled>${escapeHtml(currentParent.name)} (inactivo)</option>`);
        }
      }
      parentSelect.innerHTML = '<option value="">Seleccionar...</option>' + parentOptions.join('');
      if (data?.section_id) parentSelect.value = data.section_id;
    } else if (type === 'subcategory') {
      parentGroup.style.display = '';
      parentLabel.textContent = 'Categoría *';
      const activeParents = categories.filter((c) => !!c.is_active);
      const parentOptions = activeParents.map((c) => `<option value="${escapeHtml(c.id)}">${escapeHtml(c.name)}</option>`);
      if (data?.category_id) {
        const currentParent = categories.find((c) => c.id === data.category_id);
        if (currentParent && !currentParent.is_active) {
          parentOptions.unshift(`<option value="${escapeHtml(currentParent.id)}" disabled>${escapeHtml(currentParent.name)} (inactivo)</option>`);
        }
      }
      parentSelect.innerHTML = '<option value="">Seleccionar...</option>' + parentOptions.join('');
      if (data?.category_id) parentSelect.value = data.category_id;
    } else { parentGroup.style.display = 'none'; }
    if (data) { const form = document.getElementById('modal-form') as HTMLFormElement; form.name.value = data.name || ''; form.description.value = data.description || ''; form.sortOrder.value = data.sort_order || 0; const slugInput = document.getElementById('modal-slug') as HTMLInputElement; slugInput.value = data.slug || ''; slugInput.dataset.manual = data.slug ? 'true' : ''; }
    else { (document.getElementById('modal-form') as HTMLFormElement).reset(); const slugInput = document.getElementById('modal-slug') as HTMLInputElement; slugInput.value = ''; slugInput.dataset.manual = ''; }
    catModal.open();
  }

  function closeModal() { catModal.close(); }

  (window as any).editItem = async function(type: string, id: string) {
    let data; if (type === 'section') data = sections.find((s) => s.id === id); else if (type === 'category') data = categories.find((c) => c.id === id); else data = subcategories.find((s) => s.id === id);
    if (data) openModal(type, 'edit', data);
  };

  (window as any).deleteItem = async function(type: string, id: string) {
    if (!confirm('¿Estás seguro? Se desactivará este elemento.')) return;
    const endpoint = `${API_URL}/api/${type === 'section' ? 'sections' : type === 'category' ? 'categories' : 'subcategories'}/${id}`;
    const res = await fetch(endpoint, { method: 'DELETE', credentials: 'include' });
    if (res.ok) { loadAll(); }
  };

  async function toggleStatus(id: string, activate: boolean, type: string) {
    const item = type === 'section' ? sections.find((s) => s.id === id) : type === 'category' ? categories.find((c) => c.id === id) : subcategories.find((s) => s.id === id);
    const name = item?.name || 'este elemento';
    if (activate) {
      if (!confirm(`¿Reactivar ${name}?`)) return;
    } else {
      if (!confirm(`¿Desactivar ${name}?`)) return;
    }
    const endpoint = type === 'section' ? 'sections' : type === 'category' ? 'categories' : 'subcategories';
    const res = await fetch(`${API_URL}/api/${endpoint}/${id}/status`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ isActive: activate }),
    });
    if (res.ok) { loadAll(); }
    else { const err = await res.json().catch(() => ({})); alert(err.error || 'Error al cambiar estado'); }
  }
  (window as any).toggleStatus = toggleStatus;

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach((t) => t.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach((c) => c.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById(`tab-${(tab as HTMLElement).dataset.tab}`)?.classList.add('active');
      });
    });

    document.getElementById('add-section')?.addEventListener('click', () => openModal('section', 'create'));
    document.getElementById('add-category')?.addEventListener('click', () => openModal('category', 'create'));
    document.getElementById('add-subcategory')?.addEventListener('click', () => openModal('subcategory', 'create'));
    document.getElementById('modal-close')?.addEventListener('click', closeModal);
    document.getElementById('modal-cancel')?.addEventListener('click', closeModal);
    document.getElementById('modal-overlay')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) closeModal(); });

    document.getElementById('modal-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const type = (document.getElementById('modal-type') as HTMLInputElement).value;
      const id = (document.getElementById('modal-id') as HTMLInputElement).value;
      const isEdit = !!id;
      const body: any = { name: form.name.value, description: form.description.value || null, sortOrder: parseInt(form.sortOrder.value) || 0 };
      const slug = form.slug?.value?.trim();
      if (slug) body.slug = slug;
      if (type === 'category') body.sectionId = form.parentId.value;
      if (type === 'subcategory') body.categoryId = form.parentId.value;
      const endpoint = isEdit ? `${API_URL}/api/${type === 'section' ? 'sections' : type === 'category' ? 'categories' : 'subcategories'}/${id}` : `${API_URL}/api/${type === 'section' ? 'sections' : type === 'category' ? 'categories' : 'subcategories'}`;
      const res = await fetch(endpoint, { method: isEdit ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify(body) });
      if (res.ok) { closeModal(); loadAll(); }
      else { const error = await res.json(); alert(error.error || 'Error al guardar'); }
    });

    const slugInput = document.getElementById('modal-slug') as HTMLInputElement;
    const nameInput = document.getElementById('modal-name') as HTMLInputElement;
    nameInput?.addEventListener('input', (e) => {
      if (!slugInput.dataset.manual || slugInput.dataset.manual !== 'true') {
        slugInput.value = generateSlug((e.target as HTMLInputElement).value);
      }
    });
    slugInput?.addEventListener('input', (e) => { const val = (e.target as HTMLInputElement).value; if (val.trim() === '') { slugInput.dataset.manual = ''; } else { slugInput.dataset.manual = 'true'; } });

    loadAll();
  });
</script>

<style>
  /* ─── Categories-specific styles ─────────────────────────── */
  .tabs { display: flex; gap: 0; margin-bottom: var(--space-2xl); border-bottom: 1px solid rgba(62, 72, 80, 0.3); }
  .tab { display: flex; align-items: center; gap: 8px; padding: 12px 24px; background: transparent; border: none; border-bottom: 2px solid transparent; color: var(--on-surface-variant); cursor: pointer; font-family: 'Space Mono', monospace; font-size: 12px; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; transition: all 0.2s ease; margin-bottom: -2px; }
  .tab:hover { color: var(--on-surface); background-color: rgba(255, 255, 255, 0.03); }
  .tab.active { color: var(--primary); border-bottom-color: var(--primary); background-color: rgba(130, 207, 255, 0.08); }
  .tab-content { display: none; animation: fadeIn 0.2s ease; }
  .tab-content.active { display: block; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  .content-info h2 { color: var(--on-surface); margin-bottom: var(--space-xs); }
  .content-desc { color: var(--on-surface-variant); }
  .examples { color: var(--on-surface-variant); margin-bottom: var(--space-xl); }
  .example-tag { display: inline-block; padding: 2px 8px; background-color: rgba(31, 31, 31, 0.5); border: 1px solid rgba(62, 72, 80, 0.3); font-family: 'Space Mono', monospace; font-size: 11px; margin: 0 2px; }
  .parent-badge { display: inline-block; padding: 4px 10px; background-color: rgba(130, 207, 255, 0.1); border: 1px solid rgba(130, 207, 255, 0.3); color: var(--primary); font-family: 'Space Mono', monospace; font-size: 11px; border-radius: 0px; }

  tr.row--inactive { opacity: 0.55; }
  tr.row--inactive:hover { opacity: 0.85; }
</style>
