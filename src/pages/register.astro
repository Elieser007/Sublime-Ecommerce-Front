---
/**
 * Registro page — Sublime E-commerce
 * 
 * Registration form with email/password + OAuth.
 * Uses Better Auth client for actual registration.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Input from '../components/Input.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Crear Cuenta — Sublime E-commerce">
  <section class="auth-page">
    <div class="auth-container">
      <!-- CMYK accent -->
      <div class="cmyk-bar">
        <span></span><span></span><span></span>
      </div>

      <div class="auth-card">
        <h1 class="headline-lg-mobile">Crear Cuenta</h1>

        <!-- OAuth Buttons -->
        <div class="oauth-buttons">
          <button class="oauth-btn oauth-btn--google" id="google-register" type="button">
            <svg width="20" height="20" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Registrarse con Google
          </button>

          <button class="oauth-btn oauth-btn--facebook" id="facebook-register" type="button">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="#1877F2">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            Registrarse con Facebook
          </button>
        </div>

        <div class="auth-divider">
          <span class="label-sm">o</span>
        </div>

        <!-- Email/Password Form -->
        <form class="auth-form" id="register-form">
          <Input
            name="name"
            label="Nombre completo"
            placeholder="Tu nombre"
            required
          />

          <Input
            name="email"
            label="Correo electrónico"
            type="email"
            placeholder="tu@email.com"
            required
          />

          <Input
            name="password"
            label="Contraseña"
            type="password"
            placeholder="Mínimo 8 caracteres"
            required
          />

          <div class="auth-error" id="auth-error" style="display: none;">
            <p class="body-md"></p>
          </div>

          <Button variant="primary" type="submit" class="auth-submit">
            Crear Cuenta
          </Button>
        </form>

        <div class="auth-footer">
          <p class="body-md">¿Ya tenés cuenta?</p>
          <a href="/login" class="auth-link label-sm">Iniciar sesión</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .auth-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 72px);
    padding: var(--space-2xl);
  }

  .auth-container {
    width: 100%;
    max-width: 400px;
  }

  .auth-card {
    background-color: var(--surface-container);
    padding: var(--space-2xl);
    border: var(--border-width) solid var(--outline-variant);
  }

  .auth-card h1 {
    color: var(--on-surface);
    margin-bottom: var(--space-2xl);
    text-align: center;
  }

  /* OAuth Buttons */
  .oauth-buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .oauth-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    width: 100%;
    padding: var(--space-md);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    border: var(--border-width) solid var(--outline-variant);
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .oauth-btn--google {
    background-color: var(--on-surface);
    color: var(--surface);
    border-color: var(--on-surface);
  }

  .oauth-btn--google:hover {
    background-color: var(--on-surface-variant);
  }

  .oauth-btn--facebook {
    background-color: #1877F2;
    color: white;
    border-color: #1877F2;
  }

  .oauth-btn--facebook:hover {
    background-color: #166fe5;
  }

  /* Divider */
  .auth-divider {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    color: var(--outline);
  }

  .auth-divider::before,
  .auth-divider::after {
    content: '';
    flex: 1;
    height: var(--border-width);
    background-color: var(--outline-variant);
  }

  /* Form */
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .auth-submit {
    width: 100%;
    margin-top: var(--space-md);
  }

  /* Error */
  .auth-error {
    background-color: var(--error-container);
    color: var(--on-error-container);
    padding: var(--space-md);
    border: var(--border-width) solid var(--error);
  }

  /* Footer */
  .auth-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: var(--border-width) solid var(--outline-variant);
  }

  .auth-footer p {
    color: var(--on-surface-variant);
  }

  .auth-link {
    color: var(--primary);
    text-decoration: none;
  }

  .auth-link:hover {
    text-decoration: underline;
  }
</style>

<script>
  import { getApiUrl } from '../lib/api-url';
  // Better Auth client import (browser-side)
  const API_URL = getApiUrl();

  function showError(msg: string) {
    const errorEl = document.getElementById('auth-error');
    if (!errorEl) return;
    const p = errorEl.querySelector('p');
    if (p) p.textContent = msg;
    errorEl.style.display = 'block';
  }

  function initRegisterPage() {
    // Already authenticated? Skip the form and go to the dashboard.
    fetch(`${API_URL}/api/me`, { credentials: 'include' })
      .then((meRes) => {
        if (meRes.ok) window.location.href = '/dashboard';
      })
      .catch(() => {});

    // Email/password registration
    const form = document.getElementById('register-form');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form as HTMLFormElement);

      try {
        const res = await fetch(`${API_URL}/api/auth/sign-up/email`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({
            name: formData.get('name'),
            email: formData.get('email'),
            password: formData.get('password'),
          }),
        });

        // Rate limits (app 429 and Cloudflare "error code: 1015") return a
        // non-JSON body — parse defensively so the user gets a clear message.
        let data: any = {};
        try {
          data = await res.json();
        } catch {
          data = {};
        }

        if (!res.ok) {
          showError(
            data.message ||
              (res.status === 429
                ? 'Demasiados intentos. Esperá un minuto y volvé a intentar.'
                : 'Error al crear cuenta')
          );
          return;
        }

        // Success — redirect to protected dashboard
        window.location.href = '/dashboard';
      } catch (err) {
        showError('Error de conexión. Intentá de nuevo.');
      }
    });

    // Google OAuth
    document.getElementById('google-register')?.addEventListener('click', () => {
      window.location.href = `${API_URL}/api/auth/sign-in/social?provider=google&callbackURL=${encodeURIComponent(window.location.origin + '/dashboard')}`;
    });

    // Facebook OAuth
    document.getElementById('facebook-register')?.addEventListener('click', () => {
      window.location.href = `${API_URL}/api/auth/sign-in/social?provider=facebook&callbackURL=${encodeURIComponent(window.location.origin + '/dashboard')}`;
    });
  }

  // ClientRouter re-executes this script per navigation: replace the previous
  // listener instead of stacking one per visit.
  if (window.__registerPageInit) {
    document.removeEventListener('astro:page-load', window.__registerPageInit);
  }
  window.__registerPageInit = initRegisterPage;
  document.addEventListener('astro:page-load', window.__registerPageInit);
</script>
