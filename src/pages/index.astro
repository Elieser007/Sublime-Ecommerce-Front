---
/**
 * Shop — Homepage (/)
 * 
 * Layout:
 * - Promotion sections (top/bottom)
 * - Desktop: sidebar with category tree (3 levels) + filters
 * - Mobile: two buttons (Categorías, Filtros) → slide-in panels
 * - Product grid with search, filters, sort, pagination
 * 
 * SSG: All data fetched at build time via frontmatter.
 * Client-side: category filter, sort, search, price, pagination.
 */

import { formatPrice, getProductImageUrl } from '../lib/public-api';
import BaseLayout from '../layouts/BaseLayout.astro';
import PromotionWall from '../components/PromotionWall.astro';
import Button from '../components/Button.astro';
import CategoryTree from '../components/CategoryTree.astro';
import FilterPanel from '../components/FilterPanel.astro';

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';

// Fetch products, category tree, and promotions at build time (SSG)
let products: any[] = [];
let tree: any[] = [];
let topPromotions: any[] = [];
let topSectionInfo: any = null;
let bottomPromotions: any[] = [];
let bottomSectionInfo: any = null;
try {
  const [productsRes, treeRes, topPromoRes, bottomPromoRes] = await Promise.all([
    fetch(`${API_URL}/api/public/products?limit=1000`),
    fetch(`${API_URL}/api/public/categories/tree`),
    fetch(`${API_URL}/api/public/promotions?section=always-catalog-top`),
    fetch(`${API_URL}/api/public/promotions?section=always-catalog-bottom`),
  ]);
  if (productsRes.ok) {
    const data = await productsRes.json();
    products = data.data || [];
  }
  if (treeRes.ok) {
    const data = await treeRes.json();
    tree = data.tree || [];
  }
  if (topPromoRes.ok) {
    const data = await topPromoRes.json();
    topPromotions = data.promotions || [];
    topSectionInfo = data.section || null;
  }
  if (bottomPromoRes.ok) {
    const data = await bottomPromoRes.json();
    bottomPromotions = data.promotions || [];
    bottomSectionInfo = data.section || null;
  }
} catch (err) {
  console.error('Error fetching catalog data at build time:', err);
}

---

<BaseLayout title="Sublime — Shop">
  <!-- Thin banner at top (SSG — fetched at build time) -->
  <PromotionWall section="always-catalog-top" promotions={topPromotions} sectionInfo={topSectionInfo} />

  <!-- Mobile: Search Bar -->
  <div class="mobile-search-bar" id="mobile-search-bar">
    <input
      type="search"
      class="mobile-search-input"
      placeholder="Buscar productos..."
      id="mobile-search-bar-input"
      autocomplete="off"
    />
  </div>

  <!-- Mobile: Action Buttons -->
  <div class="mobile-actions">
    <button class="mobile-action-btn" id="open-categories">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="7" height="7"/>
        <rect x="14" y="3" width="7" height="7"/>
        <rect x="14" y="14" width="7" height="7"/>
        <rect x="3" y="14" width="7" height="7"/>
      </svg>
      <span class="body-md">Categorías</span>
    </button>
    <button class="mobile-action-btn" id="open-filters">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="4" y1="21" x2="4" y2="14"/>
        <line x1="4" y1="10" x2="4" y2="3"/>
        <line x1="12" y1="21" x2="12" y2="12"/>
        <line x1="12" y1="8" x2="12" y2="3"/>
        <line x1="20" y1="21" x2="20" y2="16"/>
        <line x1="20" y1="12" x2="20" y2="3"/>
        <line x1="1" y1="14" x2="7" y2="14"/>
        <line x1="9" y1="8" x2="15" y2="8"/>
        <line x1="17" y1="16" x2="23" y2="16"/>
      </svg>
      <span class="body-md">Filtros</span>
    </button>
  </div>

  <!-- Main Content: Sidebar + Products -->
  <section class="shop-layout">
    <div class="shop-grid">
      <!-- Desktop Sidebar -->
      <aside class="shop-sidebar">
        <div class="sidebar-tabs">
          <button class="sidebar-tab active" data-sidebar-tab="categories">Categorías</button>
          <button class="sidebar-tab" data-sidebar-tab="filters">Filtros</button>
        </div>

        <div class="sidebar-tab-panel active" id="sidebar-categories">
          <div class="sidebar-section">
            <div id="category-tree-container">
              <CategoryTree tree={tree} idSuffix="desktop" />
            </div>
          </div>
        </div>

        <div class="sidebar-tab-panel" id="sidebar-filters">
          <div class="sidebar-section">
            <FilterPanel variant="desktop" />
          </div>
        </div>
      </aside>

      <!-- Products Grid -->
      <main class="shop-main">
        {products.length > 0 ? (
          <div id="products-container">
            <!-- Product count -->
            <div class="product-count" id="product-count">
              <span id="product-count-text">{products.length} productos encontrados</span>
            </div>

            <!-- Clear filters (hidden by default) -->
            <Button variant="ghost" class="clear-filters-btn" id="clear-filters" style="display: none;">
              Limpiar filtros
            </Button>

            <div class="products-grid" id="products-grid">
              {products.map((product) => {
                const imageUrl = getProductImageUrl(product.image_url);
                const secSlug = product.section_slug || '';
                const catSlug = product.category_slug || '';
                // NULL from DB (no subcategory) → '' which won't match any real slug in filtering
                const subSlug = product.subcategory_slug || '';
                return (
                  <div class="product-wrapper"
                    data-category={secSlug}
                    data-section-slug={secSlug}
                    data-category-slug={catSlug}
                    data-subcategory-slug={subSlug}
                    data-product-name={product.name}
                    data-product-category={secSlug}
                    data-price={product.base_price}>
                    <product-card
                      product={JSON.stringify({
                        id: product.id,
                        slug: product.slug,
                        name: product.name,
                        price: product.base_price,
                        image: imageUrl,
                        category: product.section_name,
                        price_tiers: product.price_tiers || [],
                        has_variants: !!product.has_variants,
                      })}
                    />
                  </div>
                );
              })}
            </div>

            <!-- Pagination -->
            <div class="pagination" id="pagination" style="display: none;">
              <Button variant="primary" class="load-more-btn" id="load-more">
                Cargar más
              </Button>
              <span class="page-indicator body-sm" id="page-indicator"></span>
            </div>

            <!-- Empty state (hidden by default) -->
            <div class="empty-state" id="empty-state" style="display: none;">
              <p class="body-lg">No se encontraron productos</p>
              <p class="body-md" style="color: var(--on-surface-variant); margin-top: var(--space-sm);">Intenta ajustar los filtros o búsqueda</p>
              <Button variant="primary" id="empty-clear-btn" style="margin-top: var(--space-lg);">
                Limpiar filtros
              </Button>
            </div>
          </div>
        ) : (
          <div style="text-align: center; padding: var(--space-4xl) 0; color: var(--on-surface-variant);">
            <p class="body-lg">No hay productos disponibles</p>
          </div>
        )}
      </main>
    </div>
  </section>

  <!-- Bottom banner (SSG — fetched at build time) -->
  <PromotionWall section="always-catalog-bottom" promotions={bottomPromotions} sectionInfo={bottomSectionInfo} />

  <!-- Mobile Category Panel (SSG — rendered server-side, toggled by JS) -->
  <div id="mobile-category-panel" class="mobile-panel-overlay hidden">
    <div class="mobile-panel">
      <div class="mobile-panel-header">
        <h3 class="body-lg">Categorías</h3>
        <button class="mobile-panel-close" id="close-categories" aria-label="Cerrar panel">✕</button>
      </div>
      <div class="mobile-panel-body">
        <CategoryTree tree={tree} idSuffix="mobile" />
      </div>
    </div>
  </div>

  <!-- Mobile Filters Panel (SSG — rendered server-side, toggled by JS) -->
  <div id="mobile-filters-panel" class="mobile-panel-overlay mobile-panel-overlay--right hidden">
    <div class="mobile-panel mobile-panel--right">
      <div class="mobile-panel-header">
        <h3 class="body-lg">Filtros</h3>
        <button class="mobile-panel-close" id="close-filters" aria-label="Cerrar filtros">✕</button>
      </div>
      <div class="mobile-panel-body">
        <FilterPanel variant="mobile" />
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  function initCatalog() {
    // ===== IMPORTS (inline implementations) =====
    function sortProducts(products, mode) {
      const copy = [...products];
      switch (mode) {
        case 'price-asc': return copy.sort((a, b) => a.price - b.price);
        case 'price-desc': return copy.sort((a, b) => b.price - a.price);
        case 'name': return copy.sort((a, b) => a.name.localeCompare(b.name, 'es', { sensitivity: 'base' }));
        default: return copy;
      }
    }

    function filterByPrice(products, min, max) {
      return products.filter((p) => {
        if (min != null && min > 0 && p.price < min) return false;
        if (max != null && p.price > max) return false;
        return true;
      });
    }

    function filterBySearch(products, query) {
      if (!query || query.trim() === '') return products;
      const lower = query.toLowerCase();
      return products.filter((p) => p.name.toLowerCase().includes(lower));
    }

    // ===== STATE =====
    let allProducts = []; // Original product data from DOM
    let filteredProducts = []; // After all filters applied
    let visibleCount = 0;
    let currentSort = 'default';
    let currentCategory = 'all';
    let currentFilterLevel = 0; // 0=all, 1=section, 2=category, 3=subcategory
    let currentSearch = '';
    let currentMinPrice = undefined;
    let currentMaxPrice = undefined;
    const ROWS_PER_BATCH = 6;

    function getItemsPerPage() {
      const width = window.innerWidth;
      if (width < 640) return ROWS_PER_BATCH * 1;
      if (width < 1024) return ROWS_PER_BATCH * 2;
      return ROWS_PER_BATCH * 3;
    }

    // ===== DOM REFS =====
    const productsGrid = document.getElementById('products-grid');
    const productCountText = document.getElementById('product-count-text');
    const clearFiltersBtn = document.getElementById('clear-filters');
    const emptyState = document.getElementById('empty-state');
    const pagination = document.getElementById('pagination');
    const loadMoreBtn = document.getElementById('load-more');
    const pageIndicator = document.getElementById('page-indicator');
    const emptyClearBtn = document.getElementById('empty-clear-btn');

    // ===== SIDEBAR TABS =====
    document.querySelectorAll('.sidebar-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.sidebar-tab').forEach((t) => t.classList.remove('active'));
        document.querySelectorAll('.sidebar-tab-panel').forEach((p) => p.classList.remove('active'));
        tab.classList.add('active');
        const panel = document.getElementById(`sidebar-${tab.dataset.sidebarTab}`);
        if (panel) panel.classList.add('active');
      });
    });

    // ===== INIT: Read product data from DOM =====
    function initProducts() {
      const wrappers = document.querySelectorAll('.product-wrapper');
      allProducts = Array.from(wrappers).map((wrapper) => {
        const card = wrapper.querySelector('product-card');
        const attr = card?.getAttribute('product');
        let data = {};
        if (attr) {
          try { data = JSON.parse(attr); } catch (e) {}
        }
        return {
          ...data,
          _wrapper: wrapper,
          _category: wrapper.dataset.category || '',
          _sectionSlug: wrapper.dataset.sectionSlug || '',
          _categorySlug: wrapper.dataset.categorySlug || '',
          _subcategorySlug: wrapper.dataset.subcategorySlug || '',
          _productName: wrapper.dataset.productName || '',
        };
      });
      filteredProducts = [...allProducts];
    }

    // ===== RENDERING =====
    function render() {
      // Apply all filters
      let result = [...allProducts];

      // Category filter
      if (currentCategory && currentCategory !== 'all') {
        if (currentFilterLevel === 1) {
          // Section filter
          result = result.filter((p) => p._sectionSlug === currentCategory);
        } else if (currentFilterLevel === 2) {
          // Category filter
          result = result.filter((p) => p._categorySlug === currentCategory);
        } else if (currentFilterLevel === 3) {
          // Subcategory filter — direct match
          result = result.filter((p) => p._subcategorySlug === currentCategory);
        }
      }

      // Search filter
      result = filterBySearch(result, currentSearch);

      // Price filter
      result = filterByPrice(result, currentMinPrice, currentMaxPrice);

      // Sort
      result = sortProducts(result, currentSort);

      filteredProducts = result;
      visibleCount = 0;

      renderPage();
      updateUI();
    }

    function renderPage() {
      const total = filteredProducts.length;
      const toShow = filteredProducts.slice(0, Math.min(getItemsPerPage(), total));

      allProducts.forEach((p) => { p._wrapper.style.display = 'none'; });
      toShow.forEach((p) => { p._wrapper.style.display = ''; });
      visibleCount = toShow.length;

      updateLoadMore(total);
    }

    function loadMore() {
      const total = filteredProducts.length;
      const nextBatch = filteredProducts.slice(visibleCount, visibleCount + getItemsPerPage());
      nextBatch.forEach((p) => { p._wrapper.style.display = ''; });
      visibleCount += nextBatch.length;

      updateLoadMore(total);
    }

    function updateLoadMore(total) {
      if (visibleCount >= total) {
        pagination.style.display = '';
        loadMoreBtn.style.display = 'none';
        pageIndicator.textContent = 'No hay más productos';
      } else if (total > getItemsPerPage()) {
        pagination.style.display = '';
        loadMoreBtn.style.display = '';
        const remaining = total - visibleCount;
        pageIndicator.textContent = `${remaining} producto${remaining !== 1 ? 's' : ''} restante${remaining !== 1 ? 's' : ''}`;
      } else {
        pagination.style.display = 'none';
      }
    }

    function updateUI() {
      const count = filteredProducts.length;
      productCountText.textContent = `${count} producto${count !== 1 ? 's' : ''} encontrado${count !== 1 ? 's' : ''}`;

      // Empty state
      if (count === 0) {
        emptyState.style.display = '';
        productsGrid.style.display = 'none';
        pagination.style.display = 'none';
      } else {
        emptyState.style.display = 'none';
        productsGrid.style.display = '';
      }

      // Clear filters button
      const hasActiveFilters = currentCategory !== 'all' || currentSearch !== '' ||
        (currentMinPrice != null && currentMinPrice > 0) || (currentMaxPrice != null) || currentSort !== 'default';
      clearFiltersBtn.style.display = hasActiveFilters ? '' : 'none';
    }

    // ===== SORT =====
    document.querySelectorAll('[data-sort]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-sort]').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentSort = btn.dataset.sort;
        render();
      });
    });

    // ===== PRICE FILTER =====
    document.getElementById('apply-filters-desktop')?.addEventListener('click', () => {
      const minVal = document.getElementById('price-min-desktop')?.value;
      const maxVal = document.getElementById('price-max-desktop')?.value;
      currentMinPrice = minVal ? Number(minVal) : undefined;
      currentMaxPrice = maxVal ? Number(maxVal) : undefined;
      render();
    });

    // ===== CATEGORY FILTER (Desktop sidebar) =====
    document.querySelectorAll('#category-tree-container .tree-label').forEach((el) => {
      el.addEventListener('click', () => {
        const filter = el.dataset.filter;
        const treeItem = el.closest('.tree-item');
        let filterLevel = 0;

        if (treeItem) {
          if (filter === 'all') {
            filterLevel = 0;
          } else if (treeItem.classList.contains('tree-item--root')) {
            filterLevel = 1; // section
          } else if (treeItem.classList.contains('tree-item--cat')) {
            filterLevel = 2; // category
          } else if (treeItem.classList.contains('tree-item--sub')) {
            filterLevel = 3; // subcategory
          }
        }

        // Update active state on labels
        document.querySelectorAll('#category-tree-container .tree-label').forEach((l) => l.classList.remove('active'));
        el.classList.add('active');

        // Update active state on tree items (for visual feedback)
        document.querySelectorAll('#category-tree-container .tree-item').forEach((item) => {
          item.classList.remove('active');
        });
        treeItem?.classList.add('active');

        currentCategory = filter || 'all';
        currentFilterLevel = filterLevel;
        render();
      });
    });

    // ===== CATEGORY TREE TOGGLE (Desktop) =====
    document.querySelectorAll('#category-tree-container .tree-toggle').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.dataset.toggle;
        const sublist = document.getElementById(`tree-sublist-${id}`);
        if (sublist) {
          sublist.classList.toggle('expanded');
          btn.classList.toggle('expanded');
        }
      });
    });

    // ===== SEARCH (wired via Header nav search) =====
    let searchTimeout = null;
    const searchInput = document.getElementById('search-input');
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          currentSearch = searchInput.value;
          render();
        }, 300);
      });
      // Prevent Header search form from navigating away on catalog page
      const searchForm = searchInput?.closest('form');
      if (searchForm) {
        searchForm.addEventListener('submit', (e) => {
          e.preventDefault();
          currentSearch = searchInput.value;
          render();
        });
      }
    }

    // ===== MOBILE SEARCH OVERLAY (Header) =====
    const mobileSearchInput = document.getElementById('search-overlay-input');
    if (mobileSearchInput) {
      mobileSearchInput.addEventListener('input', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          currentSearch = mobileSearchInput.value;
          // Sync mobile search bar input
          const mobileBarInput = document.getElementById('mobile-search-bar-input');
          if (mobileBarInput) mobileBarInput.value = mobileSearchInput.value;
          render();
        }, 300);
      });
      // Also prevent form submit on mobile overlay
      const mobileSearchForm = mobileSearchInput?.closest('form');
      if (mobileSearchForm) {
        mobileSearchForm.addEventListener('submit', (e) => {
          e.preventDefault();
          currentSearch = mobileSearchInput.value;
          render();
          closeMobileSearchOverlay();
        });
      }
    }

    function closeMobileSearchOverlay() {
      window.dispatchEvent(new CustomEvent('search-overlay-close'));
    }

    // ===== MOBILE SEARCH BAR (inline, above category/filter buttons) =====
    const mobileSearchBar = document.getElementById('mobile-search-bar-input');
    if (mobileSearchBar) {
      mobileSearchBar.addEventListener('input', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          currentSearch = mobileSearchBar.value;
          // Sync Header search overlay input
          const overlayInput = document.getElementById('search-overlay-input');
          if (overlayInput) overlayInput.value = mobileSearchBar.value;
          render();
        }, 300);
      });
    }

    // ===== CLEAR FILTERS =====
    function clearAllFilters() {
      currentSort = 'default';
      currentCategory = 'all';
      currentFilterLevel = 0;
      currentSearch = '';
      currentMinPrice = undefined;
      currentMaxPrice = undefined;
      // Reset UI
      document.querySelectorAll('[data-sort]').forEach((b) => b.classList.remove('active'));
      document.querySelector('[data-sort="default"]')?.classList.add('active');
      document.querySelectorAll('.tree-label').forEach((l) => l.classList.remove('active'));
      document.querySelector('.tree-label[data-filter="all"]')?.classList.add('active');
      document.querySelectorAll('.tree-item').forEach((item) => item.classList.remove('active'));
      document.querySelector('.tree-item[data-filter="all"]')?.classList.add('active');
      const minInput = document.getElementById('price-min-desktop');
      const maxInput = document.getElementById('price-max-desktop');
      if (minInput) minInput.value = '';
      if (maxInput) maxInput.value = '';
      const mobileMinInput = document.getElementById('price-min-mobile');
      const mobileMaxInput = document.getElementById('price-max-mobile');
      if (mobileMinInput) mobileMinInput.value = '';
      if (mobileMaxInput) mobileMaxInput.value = '';
      const headerSearchInput = document.getElementById('search-input');
      if (headerSearchInput) headerSearchInput.value = '';
      const mobileSearchOverlay = document.getElementById('search-overlay-input');
      if (mobileSearchOverlay) mobileSearchOverlay.value = '';
      // Clear mobile search bar input
      const mobileBarInput = document.getElementById('mobile-search-bar-input');
      if (mobileBarInput) mobileBarInput.value = '';

      render();
    }

    clearFiltersBtn?.addEventListener('click', clearAllFilters);
    emptyClearBtn?.addEventListener('click', clearAllFilters);

    // ===== LOAD MORE (Pagination) =====
    loadMoreBtn?.addEventListener('click', () => {
      loadMore();
    });

    // ===== PRODUCT-CARD WEB COMPONENT INIT =====
    document.querySelectorAll('product-card').forEach((el) => {
      const attr = el.getAttribute('product');
      if (attr) {
        try {
          const data = JSON.parse(attr);
          el.product = data;
        } catch (e) {}
      }
    });

    // ===== MOBILE CATEGORY PANEL (server-rendered, toggled by class) =====
    function closeCategoriesPanel() {
      const panel = document.getElementById('mobile-category-panel');
      if (!panel) return;
      panel.classList.remove('open');
      document.body.style.overflow = '';
      setTimeout(() => panel.classList.add('hidden'), 300);
    }

    document.getElementById('open-categories')?.addEventListener('click', () => {
      const panel = document.getElementById('mobile-category-panel');
      if (!panel) return;
      panel.classList.remove('hidden');
      requestAnimationFrame(() => panel.classList.add('open'));
      document.body.style.overflowY = 'hidden';
    });

    // ===== MOBILE FILTERS PANEL (server-rendered, toggled by class) =====
    function closeFiltersPanel() {
      const panel = document.getElementById('mobile-filters-panel');
      if (!panel) return;
      panel.classList.remove('open');
      document.body.style.overflow = '';
      setTimeout(() => panel.classList.add('hidden'), 300);
    }

    document.getElementById('open-filters')?.addEventListener('click', () => {
      const panel = document.getElementById('mobile-filters-panel');
      if (!panel) return;
      panel.classList.remove('hidden');
      requestAnimationFrame(() => panel.classList.add('open'));
      document.body.style.overflowY = 'hidden';
    });

    // ===== MOBILE PANEL CLOSE HANDLERS =====
    // Category panel: close button + backdrop click
    const catPanel = document.getElementById('mobile-category-panel');
    if (catPanel) {
      catPanel.querySelector('#close-categories')?.addEventListener('click', closeCategoriesPanel);
      catPanel.addEventListener('click', (e) => {
        if (e.target === catPanel) closeCategoriesPanel();
      });
    }

    // Filters panel: close button + backdrop click
    const filterPanel = document.getElementById('mobile-filters-panel');
    if (filterPanel) {
      filterPanel.querySelector('#close-filters')?.addEventListener('click', closeFiltersPanel);
      filterPanel.addEventListener('click', (e) => {
        if (e.target === filterPanel) closeFiltersPanel();
      });
    }

    // Escape key: close mobile panels
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const catPanel = document.getElementById('mobile-category-panel');
        const filterPanel = document.getElementById('mobile-filters-panel');
        if (catPanel && !catPanel.classList.contains('hidden') && catPanel.classList.contains('open')) {
          closeCategoriesPanel();
        } else if (filterPanel && !filterPanel.classList.contains('hidden') && filterPanel.classList.contains('open')) {
          closeFiltersPanel();
        }
      }
    });

    // ===== MOBILE CATEGORY PANEL: TREE + FILTER INTERACTIONS =====
    if (catPanel) {
      // Tree toggle (expand/collapse subcategories)
      catPanel.querySelectorAll('.tree-toggle').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = btn.dataset.toggle;
          const sublist = document.getElementById(`tree-sublist-${id}`);
          if (sublist) {
            sublist.classList.toggle('expanded');
            btn.classList.toggle('expanded');
          }
        });
      });

      // Category filter click
      catPanel.querySelectorAll('.tree-label').forEach((el) => {
        el.addEventListener('click', () => {
          const filter = el.dataset.filter;
          const treeItem = el.closest('.tree-item');
          let filterLevel = 0;

          if (treeItem) {
            if (filter === 'all') {
              filterLevel = 0;
            } else if (treeItem.classList.contains('tree-item--root')) {
              filterLevel = 1;
            } else if (treeItem.classList.contains('tree-item--cat')) {
              filterLevel = 2;
            } else if (treeItem.classList.contains('tree-item--sub')) {
              filterLevel = 3;
            }
          }

          currentCategory = filter || 'all';
          currentFilterLevel = filterLevel;

          // Sync desktop sidebar active state
          document.querySelectorAll('#category-tree-container .tree-label').forEach((l) => l.classList.remove('active'));
          document.querySelector(`#category-tree-container .tree-label[data-filter="${filter}"]`)?.classList.add('active');

          // Sync desktop tree-item active state
          document.querySelectorAll('#category-tree-container .tree-item').forEach((item) => {
            item.classList.remove('active');
          });
          const desktopItem = document.querySelector(`#category-tree-container .tree-item[data-filter="${filter}"]`);
          desktopItem?.classList.add('active');

          render();
          closeCategoriesPanel();
        });
      });
    }

    // ===== MOBILE FILTER PANEL: SORT + PRICE INTERACTIONS =====
    if (filterPanel) {
      // Sort buttons in mobile panel
      filterPanel.querySelectorAll('[data-sort]').forEach((btn) => {
        btn.addEventListener('click', () => {
          filterPanel.querySelectorAll('[data-sort]').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          currentSort = btn.dataset.sort;
          // Sync desktop sidebar sort buttons
          document.querySelectorAll('[data-sort]').forEach((b) => b.classList.remove('active'));
          document.querySelector(`[data-sort="${currentSort}"]`)?.classList.add('active');
          render();
        });
      });

      // Apply filters button in mobile panel
      filterPanel.querySelector('#apply-filters-mobile')?.addEventListener('click', () => {
        const minVal = filterPanel.querySelector('#price-min-mobile')?.value;
        const maxVal = filterPanel.querySelector('#price-max-mobile')?.value;
        currentMinPrice = minVal ? Number(minVal) : undefined;
        currentMaxPrice = maxVal ? Number(maxVal) : undefined;

        // Sync desktop sort buttons
        document.querySelectorAll('[data-sort]').forEach((b) => b.classList.remove('active'));
        document.querySelector(`[data-sort="${currentSort}"]`)?.classList.add('active');

        render();
        closeFiltersPanel();
      });
    }

    // ===== INIT =====
    initProducts();
    render();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCatalog);
  } else {
    initCatalog();
  }
</script>

