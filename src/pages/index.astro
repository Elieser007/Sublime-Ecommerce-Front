---
/**
 * Shop — Homepage (/)
 * 
 * Layout:
 * - Promotion sections (top/bottom)
 * - Desktop: sidebar with category tree (3 levels) + filters
 * - Mobile: two buttons (Categorías, Filtros) → slide-in panels
 * - Product grid
 * 
 * SSG: All data fetched at build time via frontmatter.
 * Client-side: category filter, sort, mobile panels.
 */

import { formatPrice, getProductImageUrl } from '../lib/public-api';
import BaseLayout from '../layouts/BaseLayout.astro';
import PromotionWall from '../components/PromotionWall.astro';

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';

// Fetch products, category tree, and promotions at build time (SSG)
let products: any[] = [];
let tree: any[] = [];
let topPromotions: any[] = [];
let topSectionInfo: any = null;
let bottomPromotions: any[] = [];
let bottomSectionInfo: any = null;
try {
  const [productsRes, treeRes, topPromoRes, bottomPromoRes] = await Promise.all([
    fetch(`${API_URL}/api/public/products?limit=1000`),
    fetch(`${API_URL}/api/public/categories/tree`),
    fetch(`${API_URL}/api/public/promotions?section=always-catalog-top`),
    fetch(`${API_URL}/api/public/promotions?section=always-catalog-bottom`),
  ]);
  if (productsRes.ok) {
    const data = await productsRes.json();
    products = data.data || [];
  }
  if (treeRes.ok) {
    const data = await treeRes.json();
    tree = data.tree || [];
  }
  if (topPromoRes.ok) {
    const data = await topPromoRes.json();
    topPromotions = data.promotions || [];
    topSectionInfo = data.section || null;
  }
  if (bottomPromoRes.ok) {
    const data = await bottomPromoRes.json();
    bottomPromotions = data.promotions || [];
    bottomSectionInfo = data.section || null;
  }
} catch (err) {
  console.error('Error fetching catalog data at build time:', err);
}

// Helper: normalize string to slug (matches backend slugify)
function slugify(str: string): string {
  if (!str) return '';
  return str.toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}
---

<BaseLayout title="Sublime — Shop">
  <!-- Thin banner at top (SSG — fetched at build time) -->
  <PromotionWall section="always-catalog-top" promotions={topPromotions} sectionInfo={topSectionInfo} />

  <!-- Mobile: Action Buttons -->
  <div class="mobile-actions">
    <button class="mobile-action-btn" id="open-categories">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="7" height="7"/>
        <rect x="14" y="3" width="7" height="7"/>
        <rect x="14" y="14" width="7" height="7"/>
        <rect x="3" y="14" width="7" height="7"/>
      </svg>
      <span class="body-md">Categorías</span>
    </button>
    <button class="mobile-action-btn" id="open-filters">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="4" y1="21" x2="4" y2="14"/>
        <line x1="4" y1="10" x2="4" y2="3"/>
        <line x1="12" y1="21" x2="12" y2="12"/>
        <line x1="12" y1="8" x2="12" y2="3"/>
        <line x1="20" y1="21" x2="20" y2="16"/>
        <line x1="20" y1="12" x2="20" y2="3"/>
        <line x1="1" y1="14" x2="7" y2="14"/>
        <line x1="9" y1="8" x2="15" y2="8"/>
        <line x1="17" y1="16" x2="23" y2="16"/>
      </svg>
      <span class="body-md">Filtros</span>
    </button>
  </div>

  <!-- Main Content: Sidebar + Products -->
  <section class="shop-layout">
    <div class="shop-grid">
      <!-- Desktop Sidebar -->
      <aside class="shop-sidebar">

        <!-- Category Tree Section -->
        <div class="sidebar-section">
          <h2 class="sidebar-title">Categorías</h2>
          <div id="category-tree-container">
            {tree.length > 0 ? (
              <ul class="tree-list">
                <li class="tree-item tree-item--root active" data-filter="all">
                  <span class="tree-label tree-label--root" data-filter="all">Todos</span>
                </li>
                {tree.map((section) => (
                  <li class="tree-item tree-item--root" data-filter={section.slug}>
                    <div class="tree-row">
                      {section.categories && section.categories.length > 0 ? (
                        <button class="tree-toggle" data-toggle={section.slug} aria-label="Expandir">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="6 9 12 15 18 9"/>
                          </svg>
                        </button>
                      ) : (
                        <span class="tree-spacer"></span>
                      )}
                      <span class="tree-label tree-label--root" data-filter={section.slug}>{section.name}</span>
                    </div>
                    {section.categories && section.categories.length > 0 && (
                      <ul class="tree-sublist" id={`tree-sublist-${section.slug}`}>
                        {section.categories.map((cat: any) => (
                          <li class="tree-item tree-item--cat" data-filter={cat.slug}>
                            <div class="tree-row">
                              {cat.subcategories && cat.subcategories.length > 0 ? (
                                <button class="tree-toggle tree-toggle--sm" data-toggle={cat.slug} aria-label="Expandir">
                                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <polyline points="6 9 12 15 18 9"/>
                                  </svg>
                                </button>
                              ) : (
                                <span class="tree-spacer tree-spacer--sm"></span>
                              )}
                              <span class="tree-label tree-label--cat" data-filter={cat.slug}>{cat.name}</span>
                            </div>
                            {cat.subcategories && cat.subcategories.length > 0 && (
                              <ul class="tree-sublist tree-sublist--sub" id={`tree-sublist-${cat.slug}`}>
                                {cat.subcategories.map((sub: any) => (
                                  <li class="tree-item tree-item--sub" data-filter={sub.slug}>
                                    <div class="tree-row">
                                      <span class="tree-spacer tree-spacer--sm"></span>
                                      <span class="tree-label tree-label--sub" data-filter={sub.slug}>{sub.name}</span>
                                    </div>
                                  </li>
                                ))}
                              </ul>
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="body-sm">Sin categorías</p>
            )}
          </div>
        </div>

        <!-- Desktop Filters -->
        <div class="sidebar-section">
          <h2 class="sidebar-title">Filtros</h2>

          <!-- Sort -->
          <div class="filter-group">
            <h3 class="filter-group-title">Ordenar por</h3>
            <div class="filter-options">
              <button class="filter-option active" data-sort="default">Destacados</button>
              <button class="filter-option" data-sort="price-asc">Menor precio</button>
              <button class="filter-option" data-sort="price-desc">Mayor precio</button>
              <button class="filter-option" data-sort="name">Nombre A-Z</button>
            </div>
          </div>

          <!-- Price Range -->
          <div class="filter-group">
            <h3 class="filter-group-title">Precio</h3>
            <div class="price-range">
              <input type="number" class="price-input" placeholder="Mín" id="price-min-desktop" />
              <span class="price-separator">—</span>
              <input type="number" class="price-input" placeholder="Máx" id="price-max-desktop" />
            </div>
          </div>

          <button class="apply-filters-btn btn btn--primary" id="apply-filters-desktop">
            Aplicar
          </button>
        </div>
      </aside>

      <!-- Products Grid -->
      <main class="shop-main">
        {products.length > 0 ? (
          <div id="products-container">
            <div class="products-grid" id="products-grid">
              {products.map((product) => {
                const imageUrl = getProductImageUrl(product.image_url);
                const secSlug = slugify(product.section_name);
                const catSlug = slugify(product.category_name);
                return (
                  <div class="product-wrapper"
                    data-category={secSlug}
                    data-section-slug={secSlug}
                    data-category-slug={catSlug}
                    data-product-name={product.name}
                    data-product-category={secSlug}>
                    <product-card
                      product={JSON.stringify({
                        id: product.id,
                        slug: product.slug,
                        name: product.name,
                        price: product.base_price,
                        image: imageUrl,
                        category: product.section_name,
                        price_tiers: product.price_tiers || [],
                      })}
                    />
                  </div>
                );
              })}
            </div>
          </div>
        ) : (
          <div style="text-align: center; padding: var(--space-4xl) 0; color: var(--on-surface-variant);">
            <p class="body-lg">No hay productos disponibles</p>
          </div>
        )}
      </main>
    </div>
  </section>

  <!-- Bottom banner (SSG — fetched at build time) -->
  <PromotionWall section="always-catalog-bottom" promotions={bottomPromotions} sectionInfo={bottomSectionInfo} />

  <!-- Mobile Panels (rendered by JS) -->
  <div id="mobile-category-panel-container"></div>
</BaseLayout>

<script is:inline>
  // Initialize product-card Web Components
  document.querySelectorAll('product-card').forEach((el) => {
    const attr = el.getAttribute('product');
    if (attr) {
      try {
        const data = JSON.parse(attr);
        el.product = data;
      } catch (e) {}
    }
  });

  // Category tree toggle expand/collapse
  document.querySelectorAll('.tree-toggle').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = btn.dataset.toggle;
      const sublist = document.getElementById(`tree-sublist-${id}`);
      if (sublist) {
        sublist.classList.toggle('expanded');
        btn.classList.toggle('expanded');
      }
    });
  });

  // Category filter selection
  document.querySelectorAll('.tree-label').forEach((el) => {
    el.addEventListener('click', () => {
      const filter = el.dataset.filter;
      document.querySelectorAll('.tree-label').forEach((l) => l.classList.remove('active'));
      el.classList.add('active');
      document.querySelectorAll('.product-wrapper').forEach((card) => {
        if (!filter || card.dataset.category === filter) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Desktop sort filters
  document.querySelectorAll('[data-sort]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-sort]').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });

  // Mobile panels for categories
  document.getElementById('open-categories')?.addEventListener('click', () => {
    const existingPanel = document.getElementById('mobile-category-panel');
    if (existingPanel) { existingPanel.style.display = ''; return; }

    // Clone desktop tree into mobile panel
    const treeHtml = document.getElementById('category-tree-container')?.innerHTML || '';
    const panel = document.createElement('div');
    panel.id = 'mobile-category-panel';
    panel.className = 'mobile-panel-overlay';
    panel.innerHTML = `
      <div class="mobile-panel">
        <div class="mobile-panel-header">
          <h3 class="body-lg">Categorías</h3>
          <button class="mobile-panel-close" id="close-categories">✕</button>
        </div>
        <div class="mobile-panel-body">${treeHtml}</div>
      </div>`;
    document.body.appendChild(panel);
    panel.querySelector('#close-categories')?.addEventListener('click', () => { panel.style.display = 'none'; });
    panel.addEventListener('click', (e) => {
      if (e.target === panel) panel.style.display = 'none';
    });
    // Re-init tree interactions in mobile panel
    panel.querySelectorAll('.tree-toggle').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.dataset.toggle;
        const sublist = document.getElementById(`tree-sublist-${id}`);
        if (sublist) {
          sublist.classList.toggle('expanded');
          btn.classList.toggle('expanded');
        }
      });
    });
    panel.querySelectorAll('.tree-label').forEach((el) => {
      el.addEventListener('click', () => {
        const filter = el.dataset.filter;
        document.querySelectorAll('.product-wrapper').forEach((card) => {
          if (!filter || card.dataset.category === filter) {
            c.style.display = '';
          } else {
            c.style.display = 'none';
          }
        });
        panel.style.display = 'none';
      });
    });
  });
</script>

<style>
  /* Mobile Action Buttons */
  .mobile-actions {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-md) var(--margin-mobile);
    background-color: var(--surface-container);
    border-bottom: var(--border-width) solid var(--outline-variant);
  }

  @media (min-width: 768px) {
    .mobile-actions { display: none; }
  }

  .mobile-action-btn {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    background: none;
    border: var(--border-width) solid var(--outline-variant);
    border-radius: var(--border-radius);
    color: var(--on-surface);
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: var(--font-body);
    font-size: 14px;
  }

  .mobile-action-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  /* Shop Layout */
  .shop-layout { padding: var(--space-2xl) var(--margin-mobile); }
  @media (min-width: 768px) { .shop-layout { padding: var(--space-2xl) var(--margin-desktop); } }

  .shop-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }
  @media (min-width: 768px) { .shop-grid { grid-template-columns: 280px 1fr; } }

  /* Sidebar */
  .shop-sidebar { display: none; }
  @media (min-width: 768px) {
    .shop-sidebar {
      display: block;
      background-color: var(--surface);
      border: var(--border-width) solid var(--outline-variant);
      border-radius: var(--border-radius);
      height: fit-content;
      position: sticky;
      top: 100px;
      overflow: hidden;
    }
  }

  .sidebar-section {
    padding: var(--space-lg);
    border-bottom: var(--border-width) solid var(--outline-variant);
  }

  .sidebar-section:last-child {
    border-bottom: none;
  }

  .sidebar-title {
    color: var(--on-surface);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-lg);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .sidebar-title::before {
    content: '';
    display: block;
    width: 4px;
    height: 16px;
    background: linear-gradient(180deg, var(--primary) 0%, var(--secondary) 100%);
  }

  /* ====== CATEGORY ACCORDION (GLOBAL - dynamically generated) ====== */
  :global(.tree-list) {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  :global(.tree-item) {
    border-bottom: 1px solid var(--outline-variant);
  }

  :global(.tree-item:last-child) {
    border-bottom: none;
  }

  :global(.tree-row) {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-sm);
    cursor: pointer;
    transition: all 0.15s ease;
    position: relative;
  }

  :global(.tree-row:hover) {
    background-color: var(--surface-container);
  }

  :global(.tree-row:hover::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--primary);
  }

  :global(.tree-item--root > .tree-row) {
    padding: var(--space-md);
    font-weight: 500;
  }

  :global(.tree-toggle) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: none;
    border: 1px solid var(--outline-variant);
    border-radius: var(--border-radius);
    color: var(--on-surface-variant);
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  :global(.tree-toggle:hover) {
    border-color: var(--primary);
    color: var(--primary);
    background-color: var(--surface-container);
  }

  :global(.tree-toggle.expanded) {
    transform: rotate(180deg);
    border-color: var(--primary);
    color: var(--primary);
    background-color: var(--primary-container);
  }

  :global(.tree-toggle--sm) {
    width: 16px;
    height: 16px;
  }

  :global(.tree-spacer) {
    width: 20px;
    flex-shrink: 0;
  }

  :global(.tree-spacer--sm) {
    width: 16px;
  }

  :global(.tree-label) {
    flex: 1;
    text-align: left;
    background: none;
    border: none;
    color: var(--on-surface-variant);
    cursor: pointer;
    padding: 0;
    font-family: var(--font-body);
    transition: color 0.15s ease;
    line-height: 1.4;
    user-select: none;
  }

  :global(.tree-label:hover) {
    color: var(--on-surface);
  }

  :global(.tree-label.active) {
    color: var(--primary);
    font-weight: 600;
  }

  :global(.tree-label--root) {
    font-weight: 500;
    font-size: 14px;
    color: var(--on-surface);
  }

  :global(.tree-label--cat) {
    font-size: 13px;
    padding-left: var(--space-sm);
  }

  :global(.tree-label--sub) {
    font-size: 12px;
    padding-left: var(--space-md);
    color: var(--outline);
  }

  :global(.tree-label--sub:hover) {
    color: var(--primary);
  }

  :global(.tree-sublist) {
    list-style: none;
    padding: 0;
    margin: 0;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    background-color: var(--surface-container-low);
  }

  :global(.tree-sublist.expanded) {
    max-height: 2000px;
  }

  :global(.tree-sublist--sub) {
    background-color: var(--surface-container-lowest);
  }

  :global(.tree-item--cat > .tree-sublist) {
    padding-left: var(--space-md);
  }

  :global(.tree-item--sub > .tree-row) {
    padding-left: var(--space-xl);
  }


  /* ====== DESKTOP FILTERS ====== */
  .filter-group {
    margin-bottom: var(--space-lg);
  }

  .filter-group:last-of-type {
    margin-bottom: var(--space-md);
  }

  .filter-group-title {
    color: var(--on-surface-variant);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
  }

  .filter-options {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .filter-option {
    padding: var(--space-sm) var(--space-md);
    background: none;
    border: none;
    border-left: 3px solid transparent;
    color: var(--on-surface-variant);
    cursor: pointer;
    text-align: left;
    transition: all 0.15s ease;
  }

  .filter-option:hover {
    background-color: var(--surface-container);
    color: var(--on-surface);
    border-left-color: var(--outline-variant);
  }

  .filter-option.active {
    color: var(--primary);
    border-left-color: var(--primary);
    background-color: var(--primary-container);
    font-weight: 500;
  }

  .price-range {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .price-input {
    flex: 1;
    padding: var(--space-sm) var(--space-md);
    background-color: var(--surface-container);
    border: var(--border-width) solid var(--outline-variant);
    border-radius: var(--border-radius);
    color: var(--on-surface);
    font-family: var(--font-body);
    font-size: 14px;
    min-width: 0;
    transition: border-color 0.15s ease;
  }

  .price-input:focus {
    outline: none;
    border-color: var(--primary);
    background-color: var(--surface);
  }

  .price-input::placeholder {
    color: var(--outline);
  }

  .price-separator {
    color: var(--outline);
    flex-shrink: 0;
  }

  .apply-filters-btn {
    width: 100%;
    margin-top: var(--space-md);
  }

  /* Products Grid */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--gutter);
  }
  @media (min-width: 768px) { .products-grid { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); } }
  @media (min-width: 1024px) { .products-grid { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); } }

  /* Mobile panel */
  .mobile-panel-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
  }
  .mobile-panel {
    width: 85%;
    max-width: 360px;
    height: 100%;
    background-color: var(--surface);
    border-right: var(--border-width) solid var(--outline-variant);
    overflow-y: auto;
  }
  .mobile-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg);
    border-bottom: var(--border-width) solid var(--outline-variant);
  }
  .mobile-panel-close {
    background: none;
    border: var(--border-width) solid var(--outline-variant);
    width: 36px;
    height: 36px;
    color: var(--on-surface);
    cursor: pointer;
    font-size: 18px;
  }
  .mobile-panel-body { padding: var(--space-md); }
</style>
