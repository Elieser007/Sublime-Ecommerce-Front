---
/**
 * Product Detail — /producto/[slug]
 *
 * Client-side data loading from the public API.
 * Shows product image, name, price, description, category path.
 * Volume price selector with tier table.
 * Variant selector for attribute-based products.
 * Add-to-cart button using the existing LocalStorage pattern.
 * WhatsApp checkout with tier info and warning if qty < tier min.
 *
 * This page uses on-demand rendering (prerender = false)
 * because product slugs are not known at build time.
 * The Cloudflare Worker handles the request at runtime.
 */

export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import VolumePriceSelector from '../../components/VolumePriceSelector.astro';
import PriceTierList from '../../components/PriceTierList.astro';
import VariantSelector from '../../components/product/VariantSelector.astro';
---

<BaseLayout title="Producto — Sublime">
  <!-- Loading state -->
  <div id="detail-loading" class="detail-section">
    <div class="detail-layout">
      <div class="detail-image-skeleton"></div>
      <div class="detail-info-skeleton">
        <div class="skeleton-line skeleton-line--lg"></div>
        <div class="skeleton-line skeleton-line--md"></div>
        <div class="skeleton-line skeleton-line--sm"></div>
        <div class="skeleton-line skeleton-line--lg"></div>
        <div class="skeleton-line skeleton-line--md"></div>
      </div>
    </div>
  </div>

  <!-- Error state -->
  <div id="detail-error" class="detail-state" style="display: none;">
    <h1 class="headline-lg-mobile" style="color: var(--error);">Producto no encontrado</h1>
    <p class="body-lg" id="detail-error-message" style="color: var(--on-surface-variant); margin: var(--space-lg) 0;">
      El producto que buscás no existe o fue eliminado.
    </p>
    <div class="detail-actions">
      <a href="/" class="btn btn--primary">Ver Catálogo</a>
      <button class="btn btn--secondary" id="retry-detail">Reintentar</button>
    </div>
  </div>

  <!-- Product detail (rendered by JS) -->
  <div id="detail-content" class="detail-section" style="display: none;">
    <div class="detail-layout">
      <!-- Image -->
      <div class="detail-image-container">
        <img id="detail-image" class="detail-image" src="/placeholder-product.svg" alt="" width="600" height="600" />
      </div>

      <!-- Info -->
      <div class="detail-info">
        <!-- Breadcrumb -->
        <nav class="detail-breadcrumb body-sm" id="detail-breadcrumb"></nav>

        <h1 class="detail-name headline-lg-mobile" id="detail-name"></h1>
        <p class="detail-price headline-xl" id="detail-price"></p>
        
        <!-- Volume Price Selector + Tier List -->
        <div id="volume-price-section"></div>

        <!-- Variant Selector (attribute modules) -->
        <div id="variant-section"></div>
        
        <!-- Quantity Stepper (shows when tier selected) -->
        <div id="quantity-stepper-section" class="quantity-stepper-section" style="display: none;">
          <label class="quantity-label label-sm">Cantidad</label>
          <div class="quantity-control">
            <button class="qty-btn" data-action="decrease" aria-label="Disminuir cantidad">−</button>
            <input type="number" class="qty-input" id="detail-qty" value="1" min="1" max="999" readonly />
            <button class="qty-btn" data-action="increase" aria-label="Aumentar cantidad">+</button>
          </div>
        </div>

        <div class="detail-description body-lg" id="detail-description"></div>

        <div class="detail-actions">
          <button class="btn btn--primary detail-add-btn" id="detail-add-cart">
            Agregar al carrito
          </button>
          <a class="btn btn--secondary" id="detail-whatsapp" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
              <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/>
            </svg>
            Comprar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    fetchProductBySlug,
    formatPrice,
    getProductImageUrl,
  } from '../../lib/public-api';
  import { getTierPrice, getTierForQuantity } from '../../lib/price-utils';
  import { buildCartMessage, getCartFromStorage, calculateCartTotals } from '../../lib/whatsapp';
  import { computeFinalPrice, isSelectionComplete } from '../../lib/variant-logic';

  const API_URL = (typeof import.meta !== "undefined" && import.meta.env?.PUBLIC_API_URL) || "http://localhost:8787";

  const $loading = document.getElementById('detail-loading');
  const $error = document.getElementById('detail-error');
  const $content = document.getElementById('detail-content');
  const $errorMessage = document.getElementById('detail-error-message');
  const $retry = document.getElementById('retry-detail');
  const $volumeSection = document.getElementById('volume-price-section');
  const $variantSection = document.getElementById('variant-section');
  const $qtySection = document.getElementById('quantity-stepper-section');
  const $detailQty = document.getElementById('detail-qty');
  const $addCart = document.getElementById('detail-add-cart');
  const $whatsappBtn = document.getElementById('detail-whatsapp');

  // Detail elements
  const $image = document.getElementById('detail-image');
  const $name = document.getElementById('detail-name');
  const $price = document.getElementById('detail-price');
  const $description = document.getElementById('detail-description');
  const $breadcrumb = document.getElementById('detail-breadcrumb');

  // Get product slug from URL
  const pathParts = window.location.pathname.split('/').filter(Boolean);
  const productSlug = pathParts[pathParts.length - 1];

  let currentProduct: any = null;
  let currentTiers: any[] = [];
  let selectedTier: any = null;
  let selectedQty = 1;
  let currentVariantModules: any[] = [];
  let variantFinalPrice: number | null = null;

  async function loadProduct(slug: string) {
    try {
      $loading.style.display = '';
      $error.style.display = 'none';
      $content.style.display = 'none';

      const product = await fetchProductBySlug(slug);
      currentProduct = product;
      currentTiers = product.price_tiers || [];

      $loading.style.display = 'none';
      renderProduct(product);
      $content.style.display = '';

      // Load variant data if product has attribute modules
      await loadVariants(product.id);

    } catch (err: any) {
      $loading.style.display = 'none';
      $error.style.display = '';

      if (err.message === 'Not found') {
        $errorMessage.textContent = 'El producto que buscás no existe o fue eliminado.';
      } else {
        $errorMessage.textContent = 'Error al cargar el producto. Verificá tu conexión.';
      }
    }
  }

  async function loadVariants(productId: string) {
    try {
      const res = await fetch(`${API_URL}/api/public/products/${productId}/variants`);
      if (!res.ok) return;

      const json = await res.json();
      const modules = json.data?.available_modules || json.available_modules || [];

      if (modules.length === 0) {
        $variantSection.innerHTML = '';
        return;
      }

      currentVariantModules = modules;
      variantFinalPrice = json.data?.final_price ?? json.final_price ?? null;

      // Render VariantSelector via client-side HTML injection
      // The component is Astro (server-rendered), so we build the HTML here
      renderVariantSelector(modules, productId);
    } catch (err) {
      console.error('Failed to load variants:', err);
      // EC-4: show stale data, don't block interaction
    }
  }

  function renderVariantSelector(modules: any[], productId: string) {
    // Build variant selector HTML
    const sortedModules = [...modules].sort((a: any, b: any) => a.sort_order - b.sort_order);

    let html = `<div class="variant-selector" data-product-id="${productId}" data-base-price="${currentProduct.base_price}" role="group" aria-label="Selección de variantes">`;

    for (const mod of sortedModules) {
      switch (mod.frontend_component) {
        case "SizeSelector":
          html += renderSizeSelector(mod);
          break;
        case "ColorSelector":
          html += renderColorSelector(mod);
          break;
        case "MaterialSelector":
          html += renderMaterialSelector(mod);
          break;
      }
    }

    // Price display
    const formattedPrice = formatPrice(currentProduct.base_price);
    html += `
      <div class="variant-selector__price" aria-live="polite">
        <span class="variant-selector__price-label label-sm">Precio:</span>
        <span class="variant-selector__price-value headline-lg" data-variant-price>Gs. ${formattedPrice}</span>
      </div>
    </div>`;

    $variantSection.innerHTML = html;
    initVariantInteractions();
  }

  function renderSizeSelector(mod: any): string {
    let html = `<div class="size-selector" role="radiogroup" aria-label="${mod.name}">
      <span class="size-selector__label label-sm">${mod.name}</span>
      <div class="size-selector__options">`;

    for (const val of mod.values) {
      const modifier = val.price_modifier !== 0
        ? `<span class="size-selector__modifier">${val.price_modifier > 0 ? '+' : ''}₲${val.price_modifier.toLocaleString('es-PY')}</span>`
        : '';
      html += `
        <button type="button" class="size-selector__btn ${val.available === false ? 'size-selector__btn--disabled' : ''}"
          data-module-id="${mod.module_id}" data-value-id="${val.value_id}" data-price-modifier="${val.price_modifier}"
          role="radio" aria-checked="false" aria-disabled="${val.available === false}" ${val.available === false ? 'disabled' : ''}>
          <span class="size-selector__label-text">${val.label}</span>${modifier}
        </button>`;
    }

    html += `</div></div>`;
    return html;
  }

  function renderColorSelector(mod: any): string {
    let html = `<div class="color-selector" role="radiogroup" aria-label="${mod.name}">
      <span class="color-selector__label label-sm">${mod.name}</span>
      <div class="color-selector__options">`;

    for (const val of mod.values) {
      const hex = val.hex_color || val.raw_value;
      html += `
        <button type="button" class="color-selector__circle ${val.available === false ? 'color-selector__circle--disabled' : ''}"
          data-module-id="${mod.module_id}" data-value-id="${val.value_id}" data-price-modifier="${val.price_modifier}"
          role="radio" aria-checked="false" aria-disabled="${val.available === false}" ${val.available === false ? 'disabled' : ''}
          aria-label="${val.label}" title="${val.label}">
          <span class="color-selector__swatch" style="background-color: ${hex};"></span>
        </button>`;
    }

    html += `</div></div>`;
    return html;
  }

  function renderMaterialSelector(mod: any): string {
    let html = `<div class="material-selector">
      <label class="material-selector__label label-sm" for="material-${mod.module_id}">${mod.name}</label>
      <select id="material-${mod.module_id}" class="material-selector__select" data-module-id="${mod.module_id}">
        <option value="">Seleccionar ${mod.name.toLowerCase()}...</option>`;

    for (const val of mod.values) {
      const modifier = val.price_modifier !== 0
        ? ` (${val.price_modifier > 0 ? '+' : ''}₲${val.price_modifier.toLocaleString('es-PY')})`
        : '';
      html += `<option value="${val.value_id}" disabled="${val.available === false}" data-price-modifier="${val.price_modifier}">${val.label}${modifier}</option>`;
    }

    html += `</select></div>`;
    return html;
  }

  function initVariantInteractions() {
    const container = document.querySelector('.variant-selector') as HTMLElement;
    if (!container) return;

    const selectedAttributes = new Map<string, string>();
    const selectedModifiers = new Map<string, number>();

    function updateVariantPrice() {
      const modifiers = Array.from(selectedModifiers.values());
      const finalPrice = computeFinalPrice(currentProduct.base_price, modifiers);
      const $priceDisplay = container.querySelector('[data-variant-price]') as HTMLElement;
      if ($priceDisplay) {
        $priceDisplay.textContent = `Gs. ${formatPrice(finalPrice)}`;
      }

      // Dispatch event
      window.dispatchEvent(new CustomEvent('variant-change', {
        detail: {
          selectedAttributes: Object.fromEntries(selectedAttributes),
          finalPrice,
          productId: currentProduct.id,
        }
      }));

      // Enable/disable add to cart
      const modules = currentVariantModules.map((m: any) => ({
        ...m,
        values: m.values.map((v: any) => ({ ...v, available: true }))
      }));
      const complete = isSelectionComplete(modules, selectedAttributes);
      if ($addCart) $addCart.disabled = !complete;
    }

    // Size buttons
    container.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.size-selector__btn') as HTMLButtonElement;
      if (!btn || btn.disabled) return;

      const moduleId = btn.dataset.moduleId!;
      const valueId = btn.dataset.valueId!;
      const priceModifier = parseInt(btn.dataset.priceModifier || '0', 10);

      container.querySelectorAll(`.size-selector__btn[data-module-id="${moduleId}"]`).forEach((b) => {
        b.classList.remove('size-selector__btn--selected');
        b.setAttribute('aria-checked', 'false');
      });

      btn.classList.add('size-selector__btn--selected');
      btn.setAttribute('aria-checked', 'true');

      selectedAttributes.set(moduleId, valueId);
      selectedModifiers.set(moduleId, priceModifier);
      updateVariantPrice();
    });

    // Color circles
    container.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.color-selector__circle') as HTMLButtonElement;
      if (!btn || btn.disabled) return;

      const moduleId = btn.dataset.moduleId!;
      const valueId = btn.dataset.valueId!;
      const priceModifier = parseInt(btn.dataset.priceModifier || '0', 10);

      container.querySelectorAll(`.color-selector__circle[data-module-id="${moduleId}"]`).forEach((b) => {
        b.classList.remove('color-selector__circle--selected');
        b.setAttribute('aria-checked', 'false');
      });

      btn.classList.add('color-selector__circle--selected');
      btn.setAttribute('aria-checked', 'true');

      selectedAttributes.set(moduleId, valueId);
      selectedModifiers.set(moduleId, priceModifier);
      updateVariantPrice();
    });

    // Material select
    container.addEventListener('change', (e) => {
      const select = e.target as HTMLSelectElement;
      if (!select.classList.contains('material-selector__select')) return;

      const moduleId = select.dataset.moduleId!;
      const valueId = select.value;

      if (!valueId) {
        selectedAttributes.delete(moduleId);
        selectedModifiers.delete(moduleId);
      } else {
        const priceModifier = parseInt(
          select.options[select.selectedIndex]?.dataset.priceModifier || '0', 10
        );
        selectedAttributes.set(moduleId, valueId);
        selectedModifiers.set(moduleId, priceModifier);
      }
      updateVariantPrice();
    });

    // Keyboard navigation
    container.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      if (!target.classList.contains('size-selector__btn') && !target.classList.contains('color-selector__circle')) return;

      const group = target.closest('[role="radiogroup"]');
      if (!group) return;

      const radios = Array.from(group.querySelectorAll('[role="radio"]:not([disabled])')) as HTMLElement[];
      const currentIndex = radios.indexOf(target);

      let nextIndex = currentIndex;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        nextIndex = (currentIndex + 1) % radios.length;
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        nextIndex = (currentIndex - 1 + radios.length) % radios.length;
      } else if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        target.click();
        return;
      } else {
        return;
      }

      e.preventDefault();
      radios[nextIndex].focus();
      radios[nextIndex].click();
    });
  }

  function renderProduct(product: any) {
    // Image
    const primaryImage = product.images && product.images.length > 0
      ? product.images.find((img: any) => img.is_primary) || product.images[0]
      : null;
    $image.src = getProductImageUrl(primaryImage?.url);
    $image.alt = product.name;

    // Name
    $name.textContent = product.name;

    // Breadcrumb
    const crumbs = [];
    if (product.section_name) crumbs.push(product.section_name);
    if (product.category_name) crumbs.push(product.category_name);
    if (product.subcategory_name) crumbs.push(product.subcategory_name);
    $breadcrumb.textContent = crumbs.join(' / ') || 'Producto';

    // Description
    if (product.description) {
      $description.textContent = product.description;
      $description.style.display = '';
    } else {
      $description.style.display = 'none';
    }

    // Render volume price section if tiers exist
    if (currentTiers.length > 0) {
      renderVolumeSection(currentTiers);
    } else {
      // No tiers - just show base price
      $price.textContent = `Gs. ${formatPrice(product.base_price)}`;
      $volumeSection.innerHTML = '';
      $qtySection.style.display = 'none';
    }
  }

  function renderVolumeSection(tiers: any[]) {
    // Sort tiers by min_quantity
    const sortedTiers = [...tiers].sort((a, b) => a.min_quantity - b.min_quantity);
    const baseTier = sortedTiers.find(t => t.min_quantity === 1);
    
    // Render VolumePriceSelector and PriceTierList via hydration
    $volumeSection.innerHTML = `
      <volume-price-selector price-tiers="${encodeURIComponent(JSON.stringify(sortedTiers))}"></volume-price-selector>
      <price-tier-list price-tiers="${encodeURIComponent(JSON.stringify(sortedTiers))}" selected-qty="${selectedQty}"></price-tier-list>
    `;
    
    // Initialize quantity stepper
    $qtySection.style.display = 'block';
    selectedQty = 1;
    $detailQty.value = '1';
    
    // Listen for tier changes
    window.addEventListener('volume-tier-change', (e: CustomEvent) => {
      const { tier, qty } = e.detail;
      selectedTier = tier;
      selectedQty = qty;
      $detailQty.value = qty.toString();
      updatePriceDisplay();
    });
    
    // Quantity stepper
    $qtySection.querySelectorAll('[data-action]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const action = (btn as HTMLElement).dataset.action;
        let value = parseInt($detailQty.value) || 1;
        if (action === 'increase') value = Math.min(value + 1, 999);
        if (action === 'decrease') value = Math.max(value - 1, 1);
        $detailQty.value = value.toString();
        selectedQty = value;
        updatePriceDisplay();
      });
    });
    
    // Initial price display
    updatePriceDisplay();
  }

  function updatePriceDisplay() {
    if (currentTiers.length === 0) return;
    
    const tierPrice = getTierPrice(currentTiers, selectedQty);
    const applicableTier = getTierForQuantity(currentTiers, selectedQty);
    
    // Update price display
    $price.textContent = `Gs. ${formatPrice(tierPrice)}`;
    
    // Update PriceTierList highlight
    const tierList = $volumeSection.querySelector('price-tier-list');
    if (tierList) {
      tierList.setAttribute('selected-qty', selectedQty.toString());
    }
    
    // Update WhatsApp link
    updateWhatsAppLink(applicableTier);
  }

  function updateWhatsAppLink(tier: any) {
    if (!$whatsappBtn) return;
    
    const cartItem = {
      id: currentProduct.id,
      name: currentProduct.name,
      price: tier ? tier.price : currentProduct.base_price,
      quantity: selectedQty,
      image: getProductImageUrl(
        currentProduct.images && currentProduct.images.length > 0
          ? currentProduct.images[0]?.url
          : null
      ),
      selected_tier_id: tier?.id,
      selected_tier_price: tier?.price,
      selected_tier_min_qty: tier?.min_quantity,
    };
    
    const message = buildCartMessage([cartItem]);
    const encoded = encodeURIComponent(message);
    const phone = '595991969608'; // From config
    $whatsappBtn.href = `https://wa.me/${phone}?text=${encoded}`;
  }

  // Add to cart
  $addCart?.addEventListener('click', () => {
    if (!currentProduct) return;
    
    // Use variant price if available, otherwise tier or base price
    const unitPrice = variantFinalPrice ?? (selectedTier ? selectedTier.price : currentProduct.base_price);
    const tierMinQty = selectedTier?.min_quantity || 1;
    
    // Get selected attributes from variant selector
    const variantContainer = document.querySelector('.variant-selector') as HTMLElement;
    const selectedAttributes: Record<string, { value_id: string; label: string; raw_value: string }> = {};
    
    if (variantContainer) {
      // Size
      const selectedSize = variantContainer.querySelector('.size-selector__btn--selected') as HTMLElement;
      if (selectedSize) {
        selectedAttributes[selectedSize.dataset.moduleId!] = {
          value_id: selectedSize.dataset.valueId!,
          label: selectedSize.querySelector('.size-selector__label-text')?.textContent?.trim() || '',
          raw_value: selectedSize.dataset.valueId!,
        };
      }
      
      // Color
      const selectedColor = variantContainer.querySelector('.color-selector__circle--selected') as HTMLElement;
      if (selectedColor) {
        selectedAttributes[selectedColor.dataset.moduleId!] = {
          value_id: selectedColor.dataset.valueId!,
          label: selectedColor.getAttribute('aria-label') || '',
          raw_value: selectedColor.dataset.valueId!,
        };
      }
      
      // Material
      const selectedMaterial = variantContainer.querySelector('.material-selector__select') as HTMLSelectElement;
      if (selectedMaterial && selectedMaterial.value) {
        const option = selectedMaterial.options[selectedMaterial.selectedIndex];
        selectedAttributes[selectedMaterial.dataset.moduleId!] = {
          value_id: selectedMaterial.value,
          label: option.textContent?.replace(/\s*\(.*\)/, '').trim() || '',
          raw_value: selectedMaterial.value,
        };
      }
    }
    
    const hasAttributes = Object.keys(selectedAttributes).length > 0;
    
    const product = {
      id: currentProduct.id,
      name: currentProduct.name,
      price: unitPrice,
      image: getProductImageUrl(
        currentProduct.images && currentProduct.images.length > 0
          ? currentProduct.images[0]?.url
          : null
      ),
      quantity: selectedQty,
      // Store tier info for WhatsApp
      selected_tier_id: selectedTier?.id,
      selected_tier_price: unitPrice,
      selected_tier_min_qty: tierMinQty,
      // Store variant attributes
      ...(hasAttributes ? { selected_attributes: selectedAttributes } : {}),
    };
    
    const cart = JSON.parse(localStorage.getItem('cart') || '[]');
    const existing = cart.find((item: any) => {
      // Match by id + same attributes
      if (item.id !== product.id) return false;
      if (!hasAttributes && !item.selected_attributes) return true;
      if (hasAttributes && item.selected_attributes) {
        return JSON.stringify(item.selected_attributes) === JSON.stringify(product.selected_attributes);
      }
      return false;
    });
    
    if (existing) { 
      existing.quantity += selectedQty; 
      // Update tier info if same tier
      if (existing.selected_tier_id === product.selected_tier_id) {
        // Keep existing tier
      } else {
        // New tier selected
        existing.selected_tier_id = product.selected_tier_id;
        existing.selected_tier_price = product.selected_tier_price;
        existing.selected_tier_min_qty = product.selected_tier_min_qty;
      }
    } else { 
      cart.push(product); 
    }
    localStorage.setItem('cart', JSON.stringify(cart));
    
    const badge = document.querySelector('.cart-badge');
    if (badge) {
      const total = cart.reduce((sum: number, item: any) => sum + item.quantity, 0);
      badge.textContent = total.toString();
    }
    
    $addCart.textContent = '¡Agregado!';
    setTimeout(() => { $addCart.textContent = 'Agregar al carrito'; }, 1500);
    
    // Update WhatsApp link
    updateWhatsAppLink(selectedTier);
  });

  // Retry
  $retry?.addEventListener('click', () => loadProduct(productSlug));

  // Init
  if (productSlug) {
    loadProduct(productSlug);
  } else {
    $loading.style.display = 'none';
    $error.style.display = '';
    $errorMessage.textContent = 'Slug de producto no válido.';
  }
</script>

<style is:global>
  .detail-section {
    padding: var(--space-2xl) var(--margin-mobile);
    max-width: 1000px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .detail-section { padding: var(--space-3xl) var(--margin-desktop); }
  }

  .detail-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }
  @media (min-width: 768px) {
    .detail-layout { grid-template-columns: 1fr 1fr; }
  }

  /* Image */
  .detail-image-container {
    border: var(--border-width) solid var(--outline-variant);
    background-color: var(--surface-container);
    aspect-ratio: 1;
    overflow: hidden;
  }
  .detail-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
